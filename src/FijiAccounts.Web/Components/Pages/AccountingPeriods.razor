                area);
            LoadReviewModels();
            status = $"{ReviewAreaLabel(area)} query resolved.";
        });
    }

    private async Task UploadReviewAttachments(
        YearEndReviewArea area,
        InputFileChangeEventArgs args)
    {
        if (reviewingPeriodId is null) return;
        uploadingReviewArea = area;
        try
        {
            var files = args.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (file.Size <= 0 || file.Size > YearEndReviewAttachmentService.MaximumAttachmentBytes)
                {
                    throw new InvalidOperationException(
                        $"{file.Name} must be a non-empty file no larger than 10 MB.");
                }

                await using var stream = file.OpenReadStream(
                    YearEndReviewAttachmentService.MaximumAttachmentBytes);
                using var input = new MemoryStream();
                await stream.CopyToAsync(input);
                var original = input.ToArray();
                using var compressed = new MemoryStream();
                using (var brotli = new BrotliStream(
                           compressed,
                           CompressionLevel.Optimal,
                           leaveOpen: true))
                {
                    await brotli.WriteAsync(original);
                }

                var useCompression = compressed.Length < original.Length;
                var stored = useCompression ? compressed.ToArray() : original;
                await ReviewAttachments.AddAsync(
                    userId,
                    OrganisationId,
                    reviewingPeriodId.Value,
                    area,
                    new YearEndReviewAttachmentRequest(
                        file.Name,
                        ReviewAttachmentContentType(file),
                        original.LongLength,
                        stored,
                        useCompression));
            }

            activeReview = await ReviewService.GetAsync(
                userId,
                OrganisationId,
                reviewingPeriodId.Value);
            LoadReviewModels();
            await Reload();
            statusClass = "alert-success";
            status = $"{files.Count} supporting document(s) added to {ReviewAreaLabel(area)}.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or InvalidDataException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
        finally
        {
            uploadingReviewArea = null;
        }
    }

    private bool CanAddReviewAttachment(
        YearEndReviewItem reviewItem,
        AccountingPeriod period) =>
        !period.IsLocked &&
        activeReview?.ApprovedAt is null &&
        (canManage ||
         (reviewItem.Status == YearEndReviewStatus.QueryRaised &&
          reviewItem.QueryAssignedToUserId == userId));

    private static string FormatFileSize(long size) => size < 1024 * 1024
        ? $"{Math.Ceiling(size / 1024m):0} KB"
        : $"{size / (1024m * 1024m):0.0} MB";

    private static string ReviewAttachmentContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType))
        {
            return file.ContentType;
        }

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".pdf" => "application/pdf",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            _ => "application/octet-stream"
        };
    }

    private async Task ApproveReview()
    {
        if (reviewingPeriodId is null) return;
        await RunReviewAction(async () =>
        {
            activeReview = await ReviewService.ApproveAsync(
                userId,
                OrganisationId,
                reviewingPeriodId.Value,
                finalApprovalReference);
            LoadReviewModels();
            status = "Final year-end approval recorded. The period can now be locked.";
        });
    }

    private async Task RunReviewAction(Func<Task> action)
    {
        try
        {
            await action();
            statusClass = "alert-success";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private void LoadReviewModels()
    {
        reviewModels = activeReview?.Items.ToDictionary(
            x => x.Area,
            x => new ReviewItemModel
            {
                Status = x.Status,
                Notes = x.Notes ?? "",
                AssignedToUserId = x.QueryAssignedToUserId,
                DueDate = x.QueryDueDate,
                Response = x.QueryResponse ?? ""
            }) ?? [];
        finalApprovalReference = activeReview?.ApprovalReference ?? "";
    }

    private string AssigneeLabel(string? assigneeUserId) =>
        reviewAssignees.FirstOrDefault(x => x.UserId == assigneeUserId)?.Label ??
        assigneeUserId ??
        "unassigned";

    private static string ReviewAreaLabel(YearEndReviewArea area) => area switch
    {
        YearEndReviewArea.TrialBalance => "Trial balance",
        YearEndReviewArea.FinancialStatements => "Financial statements",
        YearEndReviewArea.VatWorkpaper => "VAT workpaper",
        YearEndReviewArea.BankReconciliations => "Bank reconciliations",
        YearEndReviewArea.AgedReceivables => "Aged receivables",
        YearEndReviewArea.AgedPayables => "Aged payables",
        YearEndReviewArea.FixedAssets => "Fixed assets",
        YearEndReviewArea.InventoryValuation => "Inventory valuation",
        YearEndReviewArea.YearEndAdjustments => "Year-end adjustments",
        _ => area.ToString()
    };

    private static string ReviewStatusLabel(YearEndReviewStatus reviewStatus) => reviewStatus switch
    {
        YearEndReviewStatus.Pending => "Pending",
        YearEndReviewStatus.Reviewed => "Reviewed",
        YearEndReviewStatus.QueryRaised => "Query raised",
        _ => reviewStatus.ToString()
    };

    private void CancelEdit()
    {
        editingPeriodId = null;
        editModel = new();
    }

    private async Task SaveEdit()
    {
        if (editingPeriodId is null)
        {
            return;
        }

        savingEdit = true;

        try
        {
            await PeriodService.UpdateAsync(
                userId,
                new AccountingPeriodUpdateRequest(
                    OrganisationId,
                    editingPeriodId.Value,
                    editModel.Name,
                    editModel.StartsOn,
                    editModel.EndsOn));

            statusClass = "alert-success";
            status = "Accounting period updated.";

            editingPeriodId = null;
            editModel = new();

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
        finally
        {
            savingEdit = false;
        }
    }

    private async Task OpenConfirmation(AccountingPeriod item)
    {
        editingPeriodId = null;
        editModel = new();

        confirmingPeriodId = item.Id;
        periodReadiness = null;
        warningsAcknowledged = false;
        reopeningReason = "";
        status = null;

        if (item.IsLocked)
        {
            return;
        }

        loadingReadiness = true;

        try
        {
            periodReadiness =
                await PeriodService.GetReadinessAsync(
                    userId,
                    OrganisationId,
                    item.Id);
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            confirmingPeriodId = null;
            statusClass = "alert-danger";
            status = ex.Message;
        }
        finally
        {
            loadingReadiness = false;
        }
    }

    private void CancelConfirmation()
{
    confirmingPeriodId = null;
    periodReadiness = null;
    warningsAcknowledged = false;
    reopeningReason = "";
}

    private async Task ConfirmToggle(AccountingPeriod item)
    {
        try
        {
            var wasLocked = item.IsLocked;

            await PeriodService.SetLockedAsync(
    userId,
    OrganisationId,
    item.Id,
    !wasLocked,
    acknowledgeWarnings:
        !wasLocked &&
        periodReadiness is not null &&
        !periodReadiness.IsReady &&
        warningsAcknowledged,
    reopeningReason:
        wasLocked
            ? reopeningReason
            : null);

            statusClass = "alert-success";
            status =
                wasLocked
                    ? "Accounting period unlocked."
                    : "Accounting period locked.";

            confirmingPeriodId = null;
periodReadiness = null;
warningsAcknowledged = false;
reopeningReason = "";

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

