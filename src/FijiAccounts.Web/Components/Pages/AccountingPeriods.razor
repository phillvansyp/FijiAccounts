@page "/o/{OrganisationId:guid}/periods"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject AccountingPeriodService PeriodService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Accounting periods - Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="period-heading">
        <div>
            <p class="eyebrow">Controls</p>
            <h1>Accounting periods</h1>
            <p>Lock completed periods to prevent backdated changes to the books.</p>
        </div>

        @if (canManage)
        {
            <button class="btn btn-primary"
                    @onclick="() => showCreate = !showCreate">
                + New period
            </button>
        }
    </div>

    @if (status is not null)
    {
        <div class="alert @statusClass">@status</div>
    }

    @if (showCreate)
    {
        <section class="create-period">
            <h2>Create accounting period</h2>

            <EditForm Model="model"
                      OnValidSubmit="Create"
                      FormName="create-period">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="period-fields">
                    <div>
                        <label class="form-label">Period name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Name"
                                   @oninput="MarkPeriodNameEdited" />
                    </div>

                    <div>
                        <label class="form-label">Starts</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.StartsOn"
                                   @bind-Value:after="StartDateChanged" />
                    </div>

                    <div>
                        <label class="form-label">Ends</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.EndsOn" />
                    </div>

                    <button class="btn btn-primary">
                        Create period
                    </button>
                </div>
            </EditForm>
        </section>
    }

    <section class="period-list">
        <header>
            <div>
                <h2>Financial calendar</h2>
                <p>@access.Organisation.LegalName &middot; year end @FinancialYearEnd</p>
            </div>

            <span>@periods.Count(x => x.IsLocked) locked</span>
        </header>

        @if (periods.Count == 0)
        {
            <div class="empty-periods">
                <strong>No accounting periods configured</strong>
                <span>
                    Create monthly, quarterly or annual periods when you are ready to close the books.
                </span>
            </div>
        }
        else
        {
            @foreach (var item in periods)
            {
                <div class="period-row">
                    <span class="period-state @(item.IsLocked ? "locked" : "open")">
                        @if (item.IsLocked)
                        {
                            <span>&#128274;</span>
                        }
                        else
                        {
                            <span>&#9675;</span>
                        }
                    </span>

                    <div class="period-details">
                        <strong>@item.Name</strong>
                        <small>
                            @item.StartsOn.ToString("dd MMM yyyy")
                            &ndash;
                            @item.EndsOn.ToString("dd MMM yyyy")
                        </small>
                    </div>

                    <span class="status-pill @(item.IsLocked ? "locked" : "open")">
                        @(item.IsLocked ? "Locked" : "Open")
                    </span>

                    @if (canManage)
                    {
                        <div class="period-row-actions">
                            <button type="button"
                                    class="btn btn-sm @(item.IsLocked ? "btn-outline-secondary" : "btn-outline-danger")"
                                    @onclick="() => OpenConfirmation(item)">
                                @(item.IsLocked ? "Unlock" : "Lock period")
                            </button>

                            @if (!item.IsLocked)
                            {
                                <button type="button"
                                        class="edit-period-button"
                                        title="Edit period"
                                        aria-label="Edit period"
                                        @onclick="() => BeginEdit(item)">
                                    &#9998;
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (editingPeriodId == item.Id)
                {
                    <div class="border-top border-bottom py-3 px-3 mb-2">
                        <h3 class="h5">Edit @item.Name</h3>

                        <EditForm Model="editModel"
                                  OnValidSubmit="SaveEdit"
                                  FormName="@($"edit-period-{item.Id}")">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="period-fields">
                                <div>
                                    <label class="form-label">Period name</label>
                                    <InputText class="form-control"
                                               @bind-Value="editModel.Name" />
                                </div>

                                <div>
                                    <label class="form-label">Starts</label>
                                    <InputDate class="form-control"
                                               @bind-Value="editModel.StartsOn" />
                                </div>

                                <div>
                                    <label class="form-label">Ends</label>
                                    <InputDate class="form-control"
                                               @bind-Value="editModel.EndsOn" />
                                </div>

                                <div class="d-flex align-items-end gap-2">
                                    <button class="btn btn-primary"
                                            disabled="@savingEdit">
                                        @(savingEdit ? "Saving..." : "Save changes")
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="CancelEdit">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }

                @if (confirmingPeriodId == item.Id)
                {
                    <div class="border-top border-bottom py-3 px-3 mb-2">
                        @if (item.IsLocked)
                        {
                            <h3 class="h5">Unlock @item.Name?</h3>

                            <p class="mb-3">
                                Unlocking this period will allow transactions and journals
                                to be posted into dates from
                                <strong>@item.StartsOn.ToString("dd MMM yyyy")</strong>
                                to
                                <strong>@item.EndsOn.ToString("dd MMM yyyy")</strong>.
                                The unlock will be recorded in the audit trail.
                            </p>
                        }
                        else
                        {
                            <h3 class="h5">Lock @item.Name?</h3>

                            <p class="mb-3">
                                Once locked, invoices, bills, receipts, payments and manual
                                journals cannot be posted into dates from
                                <strong>@item.StartsOn.ToString("dd MMM yyyy")</strong>
                                to
                                <strong>@item.EndsOn.ToString("dd MMM yyyy")</strong>
                                until the period is unlocked.
                            </p>

                            @if (loadingReadiness)
                            {
                                <div class="alert alert-secondary mb-3">
                                    Checking period readiness...
                                </div>
                            }
                            else if (periodReadiness is not null)
                            {
                                if (periodReadiness.IsReady)
                                {
                                    <div class="alert alert-success mb-3">
                                        <strong>Ready to lock.</strong>
                                        No unfinished accounting items were found for this period.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-3">
                                        <strong>Review before locking.</strong>

                                        <div>
                                            Fiji Accounts found unfinished items associated with this period.
                                            You can still lock the period if these are expected.
                                        </div>

                                        <ul class="mb-0 mt-2">
                                            @if (periodReadiness.UnreconciledBankStatementLines > 0)
                                            {
                                                <li>
                                                    @periodReadiness.UnreconciledBankStatementLines
                                                    unreconciled bank statement
                                                    @(periodReadiness.UnreconciledBankStatementLines == 1 ? "line" : "lines")
                                                </li>
                                            }

                                            @if (periodReadiness.IncompleteBankReconciliations > 0)
                                            {
                                                <li>
                                                    @periodReadiness.IncompleteBankReconciliations
                                                    incomplete bank
                                                    @(periodReadiness.IncompleteBankReconciliations == 1 ? "reconciliation" : "reconciliations")
                                                </li>
                                            }

                                            @if (periodReadiness.DraftSalesInvoices > 0)
                                            {
                                                <li>
                                                    @periodReadiness.DraftSalesInvoices
                                                    draft sales
                                                    @(periodReadiness.DraftSalesInvoices == 1 ? "invoice" : "invoices")
                                                </li>
                                            }

                                            @if (periodReadiness.DraftSupplierBills > 0)
                                            {
                                                <li>
                                                    @periodReadiness.DraftSupplierBills
                                                    draft supplier
                                                    @(periodReadiness.DraftSupplierBills == 1 ? "bill" : "bills")
                                                </li>
                                            }

                                            @if (periodReadiness.FixedAssetsRequiringDepreciation > 0)
{
    <li>
        @periodReadiness.FixedAssetsRequiringDepreciation
        fixed
        @(periodReadiness.FixedAssetsRequiringDepreciation == 1
            ? "asset requires"
            : "assets require")
        depreciation through the period end
    </li>
}

    @if (periodReadiness.InventoryIntegrityWarnings > 0)
{
    <li>
        @periodReadiness.InventoryIntegrityWarnings
        inventory
        @(periodReadiness.InventoryIntegrityWarnings == 1
            ? "item has"
            : "items have")
        an invalid period-end quantity or carrying value
    </li>
}

                                            <div class="form-check mt-3">
    <InputCheckbox class="form-check-input"
                   @bind-Value="warningsAcknowledged" />
    <label class="form-check-label">
        I have reviewed these outstanding items and want to lock the period anyway.
    </label>
</div>
                                        </ul>
                                    </div>
                                }
                            }
                        }

                        <div class="d-flex gap-2">
                            <button class="btn @(item.IsLocked ? "btn-warning" : "btn-danger")"
                                    disabled="@(
    !item.IsLocked &&
    (
        loadingReadiness ||
        periodReadiness is null ||
        (!periodReadiness.IsReady && !warningsAcknowledged)
    ))"
                                    @onclick="() => ConfirmToggle(item)">
                                @(item.IsLocked ? "Confirm unlock" : "Confirm lock")
                            </button>

                            <button class="btn btn-outline-secondary"
                                    @onclick="CancelConfirmation">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
            }
        }
    </section>

    <div class="control-note">
        <strong>How locking works</strong>
        <span>
            Invoices, bills, receipts, payments and manual journals cannot be posted
            into a locked period. Unlocking is recorded in the audit trail.
        </span>
    </div>
}

<style>
    .edit-period-button {
        border: 0;
        background: transparent;
        color: #0d6efd;
        font-size: 1.35rem;
        line-height: 1;
        padding: .25rem .35rem;
        cursor: pointer;
    }

    .edit-period-button:hover {
        color: #084298;
    }

    .edit-period-button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
        border-radius: .25rem;
    }
</style>
@code {
    [Parameter]
    public Guid OrganisationId { get; set; }

    private AccessibleOrganisation? access;
    private string userId = "";
    private bool canManage;
    private bool showCreate;
    private List<AccountingPeriod> periods = [];

    private PeriodModel model = new();
    private bool periodNameEdited;

    private Guid? editingPeriodId;
    private PeriodModel editModel = new();
    private bool savingEdit;

    private string? status;
    private string statusClass = "alert-success";

    private Guid? confirmingPeriodId;
    private AccountingPeriodReadiness? periodReadiness;
    private bool loadingReadiness;

    private bool warningsAcknowledged;

    private string FinancialYearEnd =>
        new DateOnly(
            2000,
            access!.Organisation.FinancialYearEndMonth,
            access.Organisation.FinancialYearEndDay)
        .ToString("dd MMMM");

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        canManage =
            await TenantAccess.CanManageTeamAsync(
                userId,
                OrganisationId);

        Reset();
        await Reload();
    }

    private async Task Reload()
    {
        periods =
            await Db.AccountingPeriods
                .AsNoTracking()
                .Where(x => x.OrganisationId == OrganisationId)
                .OrderByDescending(x => x.EndsOn)
                .ToListAsync();
    }

    private void Reset()
    {
        var today =
            DateOnly.FromDateTime(DateTime.Today);

        model = new()
        {
            Name = today.ToString("MMMM yyyy"),
            StartsOn = new DateOnly(today.Year, today.Month, 1),
            EndsOn = new DateOnly(
                today.Year,
                today.Month,
                DateTime.DaysInMonth(today.Year, today.Month))
        };

        periodNameEdited = false;
    }

    private void MarkPeriodNameEdited(ChangeEventArgs _)
    {
        periodNameEdited = true;
    }

    private void StartDateChanged()
    {
        if (periodNameEdited)
        {
            return;
        }

        model.Name =
            model.StartsOn.ToString("MMMM yyyy");

        model.EndsOn =
            new DateOnly(
                model.StartsOn.Year,
                model.StartsOn.Month,
                DateTime.DaysInMonth(
                    model.StartsOn.Year,
                    model.StartsOn.Month));
    }

    private async Task Create()
    {
        try
        {
            await PeriodService.CreateAsync(
                userId,
                new AccountingPeriodRequest(
                    OrganisationId,
                    model.Name,
                    model.StartsOn,
                    model.EndsOn));

            statusClass = "alert-success";
            status = "Accounting period created.";
            showCreate = false;

            Reset();
            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private void BeginEdit(AccountingPeriod item)
    {
        editingPeriodId = item.Id;

        editModel = new()
        {
            Name = item.Name,
            StartsOn = item.StartsOn,
            EndsOn = item.EndsOn
        };

        confirmingPeriodId = null;
        periodReadiness = null;
        status = null;
    }

    private void CancelEdit()
    {
        editingPeriodId = null;
        editModel = new();
    }

    private async Task SaveEdit()
    {
        if (editingPeriodId is null)
        {
            return;
        }

        savingEdit = true;

        try
        {
            await PeriodService.UpdateAsync(
                userId,
                new AccountingPeriodUpdateRequest(
                    OrganisationId,
                    editingPeriodId.Value,
                    editModel.Name,
                    editModel.StartsOn,
                    editModel.EndsOn));

            statusClass = "alert-success";
            status = "Accounting period updated.";

            editingPeriodId = null;
            editModel = new();

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
        finally
        {
            savingEdit = false;
        }
    }

    private async Task OpenConfirmation(AccountingPeriod item)
    {
        editingPeriodId = null;
        editModel = new();

        confirmingPeriodId = item.Id;
        periodReadiness = null;
        warningsAcknowledged = false;
        status = null;

        if (item.IsLocked)
        {
            return;
        }

        loadingReadiness = true;

        try
        {
            periodReadiness =
                await PeriodService.GetReadinessAsync(
                    userId,
                    OrganisationId,
                    item.Id);
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            confirmingPeriodId = null;
            statusClass = "alert-danger";
            status = ex.Message;
        }
        finally
        {
            loadingReadiness = false;
        }
    }

    private void CancelConfirmation()
{
    confirmingPeriodId = null;
    periodReadiness = null;
    warningsAcknowledged = false;
}

    private async Task ConfirmToggle(AccountingPeriod item)
    {
        try
        {
            var wasLocked = item.IsLocked;

            await PeriodService.SetLockedAsync(
    userId,
    OrganisationId,
    item.Id,
    !wasLocked,
    acknowledgeWarnings:
        !wasLocked &&
        periodReadiness is not null &&
        !periodReadiness.IsReady &&
        warningsAcknowledged);

            statusClass = "alert-success";
            status =
                wasLocked
                    ? "Accounting period unlocked."
                    : "Accounting period locked.";

            confirmingPeriodId = null;
periodReadiness = null;
warningsAcknowledged = false;

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private sealed class PeriodModel
    {
        [Required, StringLength(80)]
        public string Name { get; set; } = "";

        public DateOnly StartsOn { get; set; }

        public DateOnly EndsOn { get; set; }
    }
}
