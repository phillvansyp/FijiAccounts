    private async Task RespondToQuery(YearEndReviewArea area)
    {
        if (reviewingPeriodId is null) return;
        var reviewModel = reviewModels[area];
        await RunReviewAction(async () =>
        {
            activeReview = await ReviewService.RespondAsync(
                userId,
                OrganisationId,
                reviewingPeriodId.Value,
