    private async Task ResolveQuery(YearEndReviewArea area)
    {
        if (reviewingPeriodId is null) return;
        await RunReviewAction(async () =>
        {
            activeReview = await ReviewService.ResolveQueryAsync(
                userId,
                OrganisationId,
