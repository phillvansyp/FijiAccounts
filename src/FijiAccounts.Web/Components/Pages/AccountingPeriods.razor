@page "/o/{OrganisationId:guid}/periods"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.IO.Compression
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject AccountingPeriodService PeriodService
@inject YearEndReviewService ReviewService
@inject YearEndReviewAttachmentService ReviewAttachments
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Accounting periods - Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="period-heading">
        <div>
            <p class="eyebrow">Controls</p>
            <h1>Accounting periods</h1>
            <p>Lock completed periods to prevent backdated changes to the books.</p>
        </div>

        @if (canManage)
        {
            <button class="btn btn-primary"
                    @onclick="() => showCreate = !showCreate">
                + New period
            </button>
        }
    </div>

    @if (status is not null)
    {
        <div class="alert @statusClass">@status</div>
    }

    @if (showCreate)
    {
        <section class="create-period">
            <h2>Create accounting period</h2>

            <EditForm Model="model"
                      OnValidSubmit="Create"
                      FormName="create-period">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="period-fields">
                    <div>
                        <label class="form-label">Period name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Name"
                                   @oninput="MarkPeriodNameEdited" />
                    </div>

                    <div>
                        <label class="form-label">Starts</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.StartsOn"
                                   @bind-Value:after="StartDateChanged" />
                    </div>

                    <div>
                        <label class="form-label">Ends</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.EndsOn" />
                    </div>

                    <button class="btn btn-primary">
                        Create period
                    </button>
                </div>
            </EditForm>
        </section>
    }

    <section class="period-list">
        <header>
            <div>
                <h2>Financial calendar</h2>
                <p>@access.Organisation.LegalName &middot; year end @FinancialYearEnd</p>
            </div>

            <span>@periods.Count(x => x.IsLocked) locked</span>
        </header>

        @if (periods.Count == 0)
        {
            <div class="empty-periods">
                <strong>No accounting periods configured</strong>
                <span>
                    Create monthly, quarterly or annual periods when you are ready to close the books.
                </span>
            </div>
        }
        else
        {
            @foreach (var item in periods)
            {
                <div class="period-row">
                    <span class="period-state @(item.IsLocked ? "locked" : "open")">
                        @if (item.IsLocked)
                        {
                            <span>&#128274;</span>
                        }
                        else
                        {
                            <span>&#9675;</span>
                        }
                    </span>

                    <div class="period-details">
                        <strong>@item.Name</strong>
                        <small>
                            @item.StartsOn.ToString("dd MMM yyyy")
                            &ndash;
                            @item.EndsOn.ToString("dd MMM yyyy")
                        </small>
                    </div>

                    <span class="status-pill @(item.IsLocked ? "locked" : "open")">
                        @(item.IsLocked ? "Locked" : "Open")
                    </span>

                    @if (canManage)
                    {
                        <div class="period-row-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenReview(item)">
                                Year-end review
                            </button>
                            @if (item.IsLocked)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@($"/api/o/{OrganisationId}/periods/{item.Id}/handover-pack")">
                                    Create handover pack
                                </a>
                            }

                            <button type="button"
                                    class="btn btn-sm @(item.IsLocked ? "btn-outline-secondary" : "btn-outline-danger")"
                                    @onclick="() => OpenConfirmation(item)">
                                @(item.IsLocked ? "Unlock" : "Lock period")
                            </button>

                            @if (!item.IsLocked)
                            {
                                <button type="button"
                                        class="edit-period-button"
                                        title="Edit period"
                                        aria-label="Edit period"
                                        @onclick="() => BeginEdit(item)">
                                    &#9998;
                                </button>
                            }
                        </div>
                    }
                    else if (item.YearEndReview?.Items.Any(x =>
                        x.Status == YearEndReviewStatus.QueryRaised &&
                        x.QueryAssignedToUserId == userId) == true)
                    {
                        <div class="period-row-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenReview(item)">
                                Answer review query
                            </button>
                        </div>
                    }
                </div>

                @if (canManage && item.HandoverPackSnapshots.Count > 0)
                {
                    <div class="border-top py-2 px-3 mb-2 bg-light">
                        <strong class="d-block mb-2">Saved handover packs</strong>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var snapshot in item.HandoverPackSnapshots.OrderByDescending(x => x.Version))
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   title="SHA-256 @snapshot.Sha256"
                                   href="@($"/api/o/{OrganisationId}/periods/{item.Id}/handover-pack/{snapshot.Id}")">
                                    Version @snapshot.Version · @snapshot.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (reviewingPeriodId == item.Id)
                {
                    <div class="border-top border-bottom py-3 px-3 mb-2">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">Year-end review — @item.Name</h3>
                                <p class="text-secondary mb-0">
                                    Clear each supporting schedule, resolve every query, then record final approval before locking.
                                </p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseReview">Close</button>
                        </div>

                        @if (loadingReview)
                        {
                            <div class="alert alert-secondary">Loading the review checklist...</div>
                        }
                        else if (activeReview is null)
                        {
                            @if (item.IsLocked)
                            {
                                <div class="alert alert-secondary">No year-end review was started for this locked period.</div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    Starting this workflow makes final approval mandatory before this period can be locked.
                                </div>
                                <button type="button" class="btn btn-primary" @onclick="() => StartReview(item)">
                                    Start year-end review
                                </button>
                            }
                        }
                        else
                        {
                            <div class="alert @(activeReview.ApprovedAt is null ? "alert-info" : "alert-success")">
                                <strong>@ReviewProgress</strong>
                                @if (activeReview.ApprovedAt is not null)
                                {
                                    <span>
                                        Final approval @activeReview.ApprovalReference recorded
                                        @activeReview.ApprovedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm").
                                    </span>
                                }
                            </div>

                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr><th>Schedule</th><th>Status</th><th>Review evidence</th><th>Reviewed by</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reviewItem in VisibleReviewItems)
                                        {
                                            var reviewModel = reviewModels[reviewItem.Area];
                                            <tr>
                                                <td><strong>@ReviewAreaLabel(reviewItem.Area)</strong></td>
                                                <td>
                                                    <select class="form-select" @bind="reviewModel.Status" disabled="@(!canManage || item.IsLocked || activeReview.ApprovedAt is not null)">
                                                        @foreach (var option in Enum.GetValues<YearEndReviewStatus>())
                                                        {
                                                            <option value="@option">@ReviewStatusLabel(option)</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <textarea class="form-control" rows="2" maxlength="500" @bind="reviewModel.Notes" @bind:event="oninput" disabled="@(!canManage || item.IsLocked || activeReview.ApprovedAt is not null)"></textarea>
                                                    @if (reviewModel.Status == YearEndReviewStatus.QueryRaised || reviewItem.QueryRaisedAt is not null)
                                                    {
                                                        <div class="row g-2 mt-1">
                                                            <div class="col-md-7">
                                                                <label class="form-label small mb-1">Assigned to</label>
                                                                <select class="form-select form-select-sm" @bind="reviewModel.AssignedToUserId" disabled="@(!canManage || reviewModel.Status != YearEndReviewStatus.QueryRaised || item.IsLocked || activeReview.ApprovedAt is not null)">
                                                                    <option value="">Choose a person</option>
                                                                    @foreach (var assignee in reviewAssignees)
                                                                    {
                                                                        <option value="@assignee.UserId">@assignee.Label</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-5">
                                                                <label class="form-label small mb-1">Due date</label>
                                                                <InputDate class="form-control form-control-sm" @bind-Value="reviewModel.DueDate" disabled="@(!canManage || reviewModel.Status != YearEndReviewStatus.QueryRaised || item.IsLocked || activeReview.ApprovedAt is not null)" />
                                                            </div>
                                                        </div>
                                                        @if (reviewItem.QueryRaisedAt is not null)
                                                        {
                                                            <small class="d-block text-secondary mt-2">
                                                                Raised @reviewItem.QueryRaisedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                                                for @AssigneeLabel(reviewItem.QueryAssignedToUserId).
                                                            </small>
                                                        }
                                                        <label class="form-label small mt-2 mb-1">Response</label>
                                                        <textarea class="form-control" rows="2" maxlength="1000" @bind="reviewModel.Response" @bind:event="oninput" disabled="@(reviewItem.Status != YearEndReviewStatus.QueryRaised || item.IsLocked || activeReview.ApprovedAt is not null || (!canManage && reviewItem.QueryAssignedToUserId != userId))"></textarea>
                                                        @if (reviewItem.QueryRespondedAt is not null)
                                                        {
                                                            <small class="d-block text-secondary mt-1">
                                                                Responded @reviewItem.QueryRespondedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") by @reviewItem.QueryRespondedByUserId.
                                                            </small>
                                                        }
                                                        @if (reviewItem.QueryResolvedAt is not null)
                                                        {
                                                            <small class="d-block text-success mt-1">
                                                                Resolved @reviewItem.QueryResolvedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") by @reviewItem.QueryResolvedByUserId.
                                                            </small>
                                                        }
                                                    }
                                                    <div class="mt-3 pt-2 border-top">
                                                        <strong class="small">Supporting documents</strong>
                                                        @if (reviewItem.Attachments.Count == 0)
                                                        {
                                                            <small class="d-block text-secondary">No documents attached.</small>
                                                        }
                                                        else
                                                        {
                                                            <ul class="list-unstyled mb-2">
                                                                @foreach (var attachment in reviewItem.Attachments.OrderBy(x => x.UploadedAt))
                                                                {
                                                                    <li>
                                                                        <a href="@($"/api/o/{OrganisationId}/periods/{item.Id}/review-attachments/{attachment.Id}")">
                                                                            @attachment.FileName
                                                                        </a>
                                                                        <small class="text-secondary">
                                                                            · @FormatFileSize(attachment.OriginalSize)
                                                                            · @attachment.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                                                        </small>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        @if (CanAddReviewAttachment(reviewItem, item))
                                                        {
                                                            <InputFile class="form-control form-control-sm"
                                                                       multiple
                                                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                                                                       disabled="@(uploadingReviewArea is not null)"
                                                                       OnChange="@((InputFileChangeEventArgs e) => UploadReviewAttachments(reviewItem.Area, e))" />
                                                            <small class="text-secondary">Up to five files per upload, 10 MB each.</small>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    @(reviewItem.ReviewedByUserId ?? "—")
                                                    @if (reviewItem.ReviewedAt is not null)
                                                    {
                                                        <small class="d-block text-secondary">@reviewItem.ReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (canManage && !item.IsLocked && activeReview.ApprovedAt is null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveReviewItem(reviewItem.Area)">Save</button>
                                                        @if (reviewItem.Status == YearEndReviewStatus.QueryRaised)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => RespondToQuery(reviewItem.Area)">Save response</button>
                                                            <button type="button" class="btn btn-sm btn-success mt-2" disabled="@(string.IsNullOrWhiteSpace(reviewItem.QueryResponse))" @onclick="() => ResolveQuery(reviewItem.Area)">Resolve</button>
                                                        }
                                                    }
                                                    else if (!item.IsLocked && activeReview.ApprovedAt is null && reviewItem.QueryAssignedToUserId == userId)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => RespondToQuery(reviewItem.Area)">Send response</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (canManage && !item.IsLocked && activeReview.ApprovedAt is null)
                            {
                                <div class="row align-items-end mt-2">
                                    <div class="col-md-8">
                                        <label class="form-label">Final approval reference</label>
                                        <InputText class="form-control" @bind-Value="finalApprovalReference" placeholder="e.g. Partner sign-off YE-2026" />
                                    </div>
                                    <div class="col-md-4 mt-3 mt-md-0">
                                        <button type="button" class="btn btn-success w-100" disabled="@(!AllReviewItemsCleared || string.IsNullOrWhiteSpace(finalApprovalReference))" @onclick="ApproveReview">
                                            Record final approval
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                @if (editingPeriodId == item.Id)
                {
                    <div class="border-top border-bottom py-3 px-3 mb-2">
                        <h3 class="h5">Edit @item.Name</h3>

                        <EditForm Model="editModel"
                                  OnValidSubmit="SaveEdit"
                                  FormName="@($"edit-period-{item.Id}")">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="period-fields">
                                <div>
                                    <label class="form-label">Period name</label>
                                    <InputText class="form-control"
                                               @bind-Value="editModel.Name" />
                                </div>

                                <div>
                                    <label class="form-label">Starts</label>
                                    <InputDate class="form-control"
                                               @bind-Value="editModel.StartsOn" />
                                </div>

                                <div>
                                    <label class="form-label">Ends</label>
                                    <InputDate class="form-control"
                                               @bind-Value="editModel.EndsOn" />
                                </div>

                                <div class="d-flex align-items-end gap-2">
                                    <button class="btn btn-primary"
                                            disabled="@savingEdit">
                                        @(savingEdit ? "Saving..." : "Save changes")
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="CancelEdit">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }

                @if (confirmingPeriodId == item.Id)
                {
                    <div class="border-top border-bottom py-3 px-3 mb-2">
                        @if (item.IsLocked)
                        {
                            <h3 class="h5">Unlock @item.Name?</h3>

                            <p class="mb-3">
                                Unlocking this period will allow transactions and journals
                                to be posted into dates from
                                <strong>@item.StartsOn.ToString("dd MMM yyyy")</strong>
                                to
                                <strong>@item.EndsOn.ToString("dd MMM yyyy")</strong>.
                                The unlock will be recorded in the audit trail.
                            </p>

                            <div class="mb-3">
                                <label class="form-label" for="reopening-reason-@item.Id">
                                    Reason for reopening
                                </label>
                                <textarea id="reopening-reason-@item.Id"
                                          class="form-control"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Explain why entries must be posted or corrected in this closed period."
                                          @bind="reopeningReason"></textarea>
                                <div class="form-text">
                                    Required. This reason is preserved with the original lock details in the audit trail.
                                </div>
                            </div>
                        }
                        else
                        {
                            <h3 class="h5">Lock @item.Name?</h3>

                            <p class="mb-3">
                                Once locked, invoices, bills, receipts, payments and manual
                                journals cannot be posted into dates from
                                <strong>@item.StartsOn.ToString("dd MMM yyyy")</strong>
                                to
                                <strong>@item.EndsOn.ToString("dd MMM yyyy")</strong>
                                until the period is unlocked.
                            </p>

                            @if (loadingReadiness)
                            {
                                <div class="alert alert-secondary mb-3">
                                    Checking period readiness...
                                </div>
                            }
                            else if (periodReadiness is not null)
                            {
                                @if (item.YearEndReview is not null && item.YearEndReview.ApprovedAt is null)
                                {
                                    <div class="alert alert-danger mb-3">
                                        Complete every year-end review item and record final approval before locking this period.
                                    </div>
                                }
                                if (periodReadiness.IsReady)
                                {
                                    <div class="alert alert-success mb-3">
                                        <strong>Ready to lock.</strong>
                                        No unfinished accounting items were found for this period.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert @(periodReadiness.HasBlockingItems ? "alert-danger" : "alert-warning") mb-3">
                                        <strong>@(periodReadiness.HasBlockingItems ? "Resolve before locking." : "Review before locking.")</strong>

                                        <div>
                                            Fiji Accounts found unfinished items associated with this period.
                                            @if (periodReadiness.HasBlockingItems)
                                            {
                                                <span>Pending fiscal documents must be completed or recovered before the period can be locked.</span>
                                            }
                                            else
                                            {
                                                <span>You can still lock the period if these are expected.</span>
                                            }
                                        </div>

                                        <ul class="mb-0 mt-2">
                                            @if (periodReadiness.UnreconciledBankStatementLines > 0)
                                            {
                                                <li>
                                                    @periodReadiness.UnreconciledBankStatementLines
                                                    unreconciled bank statement
                                                    @(periodReadiness.UnreconciledBankStatementLines == 1 ? "line" : "lines")
                                                </li>
                                            }

                                            @if (periodReadiness.IncompleteBankReconciliations > 0)
                                            {
                                                <li>
                                                    @periodReadiness.IncompleteBankReconciliations
                                                    incomplete bank
                                                    @(periodReadiness.IncompleteBankReconciliations == 1 ? "reconciliation" : "reconciliations")
                                                </li>
                                            }

                                            @if (periodReadiness.DraftSalesInvoices > 0)
                                            {
                                                <li>
                                                    @periodReadiness.DraftSalesInvoices
                                                    draft sales
                                                    @(periodReadiness.DraftSalesInvoices == 1 ? "invoice" : "invoices")
                                                </li>
                                            }

                                            @if (periodReadiness.DraftSupplierBills > 0)
                                            {
                                                <li>
                                                    @periodReadiness.DraftSupplierBills
                                                    draft supplier
                                                    @(periodReadiness.DraftSupplierBills == 1 ? "bill" : "bills")
                                                </li>
                                            }

                                            @if (periodReadiness.FixedAssetsRequiringDepreciation > 0)
{
    <li>
        @periodReadiness.FixedAssetsRequiringDepreciation
        fixed
        @(periodReadiness.FixedAssetsRequiringDepreciation == 1
            ? "asset requires"
            : "assets require")
        depreciation through the period end
    </li>
}

    @if (periodReadiness.InventoryIntegrityWarnings > 0)
{
    <li>
        @periodReadiness.InventoryIntegrityWarnings
        inventory
        @(periodReadiness.InventoryIntegrityWarnings == 1
            ? "item has"
            : "items have")
        an invalid period-end quantity or carrying value
    </li>
}

                                            @if (periodReadiness.PendingFiscalDocuments > 0)
                                            {
                                                <li>
                                                    @periodReadiness.PendingFiscalDocuments pending fiscal
                                                    @(periodReadiness.PendingFiscalDocuments == 1 ? "document requires" : "documents require")
                                                    acceptance or recovery
                                                </li>
                                            }

                                            @if (!periodReadiness.HasBlockingItems)
                                            {
                                            <div class="form-check mt-3">
    <InputCheckbox class="form-check-input"
                   @bind-Value="warningsAcknowledged" />
    <label class="form-check-label">
        I have reviewed these outstanding items and want to lock the period anyway.
    </label>
</div>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                        }

                        <div class="d-flex gap-2">
                            <button class="btn @(item.IsLocked ? "btn-warning" : "btn-danger")"
                                    disabled="@(
    item.IsLocked
        ? string.IsNullOrWhiteSpace(reopeningReason)
        : (
        loadingReadiness ||
        periodReadiness is null ||
        periodReadiness.HasBlockingItems ||
        (item.YearEndReview is not null && item.YearEndReview.ApprovedAt is null) ||
        (!periodReadiness.IsReady && !warningsAcknowledged)
    ))"
                                    @onclick="() => ConfirmToggle(item)">
                                @(item.IsLocked ? "Confirm unlock" : "Confirm lock")
                            </button>

                            <button class="btn btn-outline-secondary"
                                    @onclick="CancelConfirmation">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
            }
        }
    </section>

    <div class="control-note">
        <strong>How locking works</strong>
        <span>
            Invoices, bills, receipts, payments and manual journals cannot be posted
            into a locked period. Unlocking is recorded in the audit trail.
        </span>
    </div>
}

<style>
    .edit-period-button {
        border: 0;
        background: transparent;
        color: #0d6efd;
        font-size: 1.35rem;
        line-height: 1;
        padding: .25rem .35rem;
        cursor: pointer;
    }

    .edit-period-button:hover {
        color: #084298;
    }

    .edit-period-button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
        border-radius: .25rem;
    }
</style>
@code {
    [SupplyParameterFromQuery(Name = "review")]
    public Guid? RequestedReviewPeriodId { get; set; }

    [Parameter]
    public Guid OrganisationId { get; set; }

    private AccessibleOrganisation? access;
    private string userId = "";
    private bool canManage;
    private bool showCreate;
    private List<AccountingPeriod> periods = [];

    private PeriodModel model = new();
    private bool periodNameEdited;

    private Guid? editingPeriodId;
    private PeriodModel editModel = new();
    private bool savingEdit;

    private string? status;
    private string statusClass = "alert-success";

    private Guid? confirmingPeriodId;
    private AccountingPeriodReadiness? periodReadiness;
    private bool loadingReadiness;

    private bool warningsAcknowledged;
    private string reopeningReason = "";
    private Guid? reviewingPeriodId;
    private YearEndReview? activeReview;
    private bool loadingReview;
    private string finalApprovalReference = "";
    private Dictionary<YearEndReviewArea, ReviewItemModel> reviewModels = [];
    private List<YearEndReviewAssignee> reviewAssignees = [];
    private YearEndReviewArea? uploadingReviewArea;

    private IEnumerable<YearEndReviewItem> VisibleReviewItems => activeReview is null
        ? []
        : canManage
            ? activeReview.Items.OrderBy(x => x.Area)
            : activeReview.Items
                .Where(x => x.Status == YearEndReviewStatus.QueryRaised && x.QueryAssignedToUserId == userId)
                .OrderBy(x => x.Area);

    private bool AllReviewItemsCleared =>
        activeReview is not null &&
        activeReview.Items.All(x => x.Status == YearEndReviewStatus.Reviewed);

    private string ReviewProgress => activeReview is null
        ? "Not started"
        : activeReview.ApprovedAt is not null
            ? "Review complete."
            : $"{activeReview.Items.Count(x => x.Status == YearEndReviewStatus.Reviewed)} of {activeReview.Items.Count} schedules cleared.";

    private string FinancialYearEnd =>
        new DateOnly(
            2000,
            access!.Organisation.FinancialYearEndMonth,
            access.Organisation.FinancialYearEndDay)
        .ToString("dd MMMM");

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        canManage =
            await TenantAccess.CanManageTeamAsync(
                userId,
                OrganisationId);

        reviewAssignees = canManage
            ? await ReviewService.ListAssigneesAsync(userId, OrganisationId)
            : [];

        Reset();
        await Reload();
        if (RequestedReviewPeriodId is { } reviewPeriodId &&
            periods.FirstOrDefault(x => x.Id == reviewPeriodId) is { } requestedPeriod)
        {
            await OpenReview(requestedPeriod);
        }
    }

    private async Task Reload()
    {
        periods =
            await Db.AccountingPeriods
                .AsNoTracking()
                .Include(x => x.YearEndReview)
                .ThenInclude(x => x!.Items)
                .Include(x => x.HandoverPackSnapshots)
                .Where(x => x.OrganisationId == OrganisationId)
                .OrderByDescending(x => x.EndsOn)
                .ToListAsync();
    }

    private void Reset()
    {
        var today =
            DateOnly.FromDateTime(DateTime.Today);

        model = new()
        {
            Name = today.ToString("MMMM yyyy"),
            StartsOn = new DateOnly(today.Year, today.Month, 1),
            EndsOn = new DateOnly(
                today.Year,
                today.Month,
                DateTime.DaysInMonth(today.Year, today.Month))
        };

        periodNameEdited = false;
    }

    private void MarkPeriodNameEdited(ChangeEventArgs _)
    {
        periodNameEdited = true;
    }

    private void StartDateChanged()
    {
        if (periodNameEdited)
        {
            return;
        }

        model.Name =
            model.StartsOn.ToString("MMMM yyyy");

        model.EndsOn =
            new DateOnly(
                model.StartsOn.Year,
                model.StartsOn.Month,
                DateTime.DaysInMonth(
                    model.StartsOn.Year,
                    model.StartsOn.Month));
    }

    private async Task Create()
    {
        try
        {
            await PeriodService.CreateAsync(
                userId,
                new AccountingPeriodRequest(
                    OrganisationId,
                    model.Name,
                    model.StartsOn,
                    model.EndsOn));

            statusClass = "alert-success";
            status = "Accounting period created.";
            showCreate = false;

            Reset();
            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private void BeginEdit(AccountingPeriod item)
    {
        editingPeriodId = item.Id;

        editModel = new()
        {
            Name = item.Name,
            StartsOn = item.StartsOn,
            EndsOn = item.EndsOn
        };

        confirmingPeriodId = null;
        periodReadiness = null;
        status = null;
    }

    private async Task OpenReview(AccountingPeriod item)
    {
        reviewingPeriodId = item.Id;
        editingPeriodId = null;
        confirmingPeriodId = null;
        loadingReview = true;
        status = null;
        try
        {
            activeReview = await ReviewService.GetAsync(userId, OrganisationId, item.Id);
            LoadReviewModels();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
            reviewingPeriodId = null;
        }
        finally
        {
            loadingReview = false;
        }
    }

    private void CloseReview()
    {
        reviewingPeriodId = null;
        activeReview = null;
        reviewModels = [];
        finalApprovalReference = "";
    }

    private async Task StartReview(AccountingPeriod item)
    {
        await RunReviewAction(async () =>
        {
            activeReview = await ReviewService.StartAsync(userId, OrganisationId, item.Id);
            LoadReviewModels();
            status = "Year-end review started.";
        });
    }

    private async Task SaveReviewItem(YearEndReviewArea area)
    {
        if (reviewingPeriodId is null) return;
        var reviewModel = reviewModels[area];
        await RunReviewAction(async () =>
        {
            activeReview = await ReviewService.UpdateItemAsync(
                userId,
                OrganisationId,
                reviewingPeriodId.Value,
                area,
                reviewModel.Status,
                reviewModel.Notes,
                reviewModel.AssignedToUserId,
                reviewModel.DueDate);
            LoadReviewModels();
            status = $"{ReviewAreaLabel(area)} review saved.";
        });
