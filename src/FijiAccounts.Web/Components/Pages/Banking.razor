    private async Task LoadReconciliationPage(IReadOnlyCollection<Guid> bankAccountIds)
    {
        var query = Db.BankStatementLines
            .AsNoTracking()
            .Where(x =>
                x.OrganisationId == OrganisationId &&
                bankAccountIds.Contains(x.BankAccountId) &&
                (x.ReconciledAt == null ||
                 (x.MatchedPostedJournalLine != null &&
                  x.MatchedPostedJournalLine.DivisionId != null &&
                  accessibleDivisionIds.Contains(x.MatchedPostedJournalLine.DivisionId.Value))));

        if (reconciliationDateFrom is DateOnly dateFrom)
        {
            query = query.Where(x => x.TransactionDate >= dateFrom);
        }

        if (reconciliationDateTo is DateOnly dateTo)
        {
            query = query.Where(x => x.TransactionDate <= dateTo);
        }

        if (!string.IsNullOrWhiteSpace(reconciliationSearch))
        {
            var term = reconciliationSearch.Trim();
            var pattern = $"%{term}%";
            var normalizedAmount = term.Replace("$", string.Empty).Replace(",", string.Empty);
            var hasAmount = decimal.TryParse(
                normalizedAmount,
                System.Globalization.NumberStyles.Number |
                System.Globalization.NumberStyles.AllowLeadingSign,
                System.Globalization.CultureInfo.InvariantCulture,
                out var amount);
            var absoluteAmount = Math.Abs(amount);
            var normalizedTerm = term.ToLowerInvariant();
            var wantsUnreconciled = normalizedTerm == "unreconciled";
            var wantsReconciled = normalizedTerm == "reconciled";
            var wantsMoneyOut = normalizedTerm is "money out" or "payment" or "debit";
            var wantsMoneyIn = normalizedTerm is "money in" or "receipt" or "deposit" or "credit";
            var hasDate = DateOnly.TryParse(term, out var transactionDate);
            var hasBankKind = Enum.TryParse<BankAccountKind>(term.Replace(" ", string.Empty), true, out var bankKind);

            query = query.Where(x =>
                EF.Functions.Like(x.Description, pattern) ||
                (x.Reference != null && EF.Functions.Like(x.Reference, pattern)) ||
                (hasAmount &&
                    ((x.Amount >= amount - 0.005m && x.Amount <= amount + 0.005m) ||
                     (x.Amount >= absoluteAmount - 0.005m && x.Amount <= absoluteAmount + 0.005m) ||
                     (x.Amount >= -absoluteAmount - 0.005m && x.Amount <= -absoluteAmount + 0.005m))) ||
                (wantsUnreconciled && x.ReconciledAt == null) ||
                (wantsReconciled && x.ReconciledAt != null) ||
                (wantsMoneyOut && x.Amount < 0) ||
                (wantsMoneyIn && x.Amount > 0) ||
                (hasDate && x.TransactionDate == transactionDate) ||
                (hasBankKind && x.BankAccount.BankAccountKind == bankKind));
        }

        reconciliationTotalCount = await query.CountAsync();
        reconciliationUnreconciledCount = await query.CountAsync(x => x.ReconciledAt == null);
        var totalPages = Math.Max(1, (int)Math.Ceiling(reconciliationTotalCount / (double)ReconciliationPageSize));
        reconciliationPage = Math.Clamp(reconciliationPage, 1, totalPages);

        statementLines = await query
            .Include(x => x.BankAccount)
            .OrderBy(x => x.ReconciledAt == null ? 0 : 1)
            .ThenByDescending(x => x.TransactionDate)
            .ThenByDescending(x => x.Id)
            .Skip((reconciliationPage - 1) * ReconciliationPageSize)
            .Take(ReconciliationPageSize)
            .ToListAsync();

        if (statementLines.Count == 0)
        {
            matchTransactions = [];
            return;
        }

        var firstDate = statementLines.Min(x => x.TransactionDate).AddDays(-3);
        var lastDate = statementLines.Max(x => x.TransactionDate).AddDays(3);
        var pageBankAccountIds = statementLines.Select(x => x.BankAccountId).Distinct().ToArray();
        matchTransactions = await Db.PostedJournalLines
            .AsNoTracking()
            .Include(x => x.PostedJournal)
            .Include(x => x.LedgerAccount)
            .Where(x =>
                pageBankAccountIds.Contains(x.LedgerAccountId) &&
                x.DivisionId != null && accessibleDivisionIds.Contains(x.DivisionId.Value) &&
                x.PostedJournal.EntryDate >= firstDate &&
                x.PostedJournal.EntryDate <= lastDate &&
                !Db.BankStatementLines.Any(statement =>
                    statement.MatchedPostedJournalLineId == x.Id))
            .OrderByDescending(x => x.PostedJournal.EntryDate)
            .ThenByDescending(x => x.PostedJournal.SequenceNumber)
            .ToListAsync();
    }

    private async Task LoadCodedAccounts()
    {
        codedAccounts = [];
        codedVat = [];
        var matchedIds = statementLines.Where(x => x.MatchedPostedJournalLineId.HasValue).Select(x => x.MatchedPostedJournalLineId!.Value).ToArray();
        if (matchedIds.Length == 0) return;
        var matchedLines = await Db.PostedJournalLines.AsNoTracking().Where(x => matchedIds.Contains(x.Id)).Select(x => new { x.Id, x.PostedJournalId }).ToListAsync();
        var journalIds = matchedLines.Select(x => x.PostedJournalId).Distinct().ToArray();
        var allLines = await Db.PostedJournalLines.AsNoTracking().Include(x => x.LedgerAccount).Where(x => journalIds.Contains(x.PostedJournalId) && x.LedgerAccount.OrganisationId == OrganisationId).ToListAsync();
        var linesByJournal = allLines.GroupBy(x => x.PostedJournalId).ToDictionary(x => x.Key, x => x.ToList());
        var matchedJournals = matchedLines.ToDictionary(x => x.Id, x => x.PostedJournalId);
        foreach (var statement in statementLines.Where(x => x.MatchedPostedJournalLineId.HasValue))
            if (matchedJournals.TryGetValue(statement.MatchedPostedJournalLineId!.Value, out var journalId) && linesByJournal.TryGetValue(journalId, out var lines))
            {
                var codingLine = lines.FirstOrDefault(x => !x.LedgerAccount.IsBankAccount && x.LedgerAccount.Code is not "1150" and not "2100");
                if (codingLine is not null)
                {
                    codedAccounts[statement.Id] = codingLine.LedgerAccount;
                    var vatLine = lines.FirstOrDefault(x => !x.LedgerAccount.IsBankAccount && x.LedgerAccount.Code is "1150" or "2100");
                    var vatAmount = vatLine is null ? 0m : Math.Max(vatLine.Debit, vatLine.Credit);
                    var treatment = vatAmount > 0 ? "Standard VAT" : "Out of scope";
                    codedVat[statement.Id] = new(vatAmount, treatment);
                }
                else
                {
                    var transferLine = lines.FirstOrDefault(x => x.LedgerAccount.IsBankAccount && x.LedgerAccountId != statement.BankAccountId);
                    if (transferLine is not null) codedAccounts[statement.Id] = transferLine.LedgerAccount;
                    codedVat[statement.Id] = new(0m, "Not VAT");
                }
            }
    }
