    private async Task<string> NextAvailableBankCodeAsync()
    {
        var usedCodes = await Db.LedgerAccounts.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId)
            .Select(x => x.Code)
            .ToListAsync();

        var used = new HashSet<int>();
        foreach (var accountCode in usedCodes)
        {
            if (int.TryParse(accountCode, out var value) && value > 0)
            {
                used.Add(value);
            }
        }

        for (var candidate = 1010; ; candidate++)
        {
            if (!used.Contains(candidate))
            {
                return candidate.ToString();
            }
        }
    }
