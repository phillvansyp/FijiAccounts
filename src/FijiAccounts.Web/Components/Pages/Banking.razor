    private async Task BeginCoding(BankStatementLine item)
    {
        codingError = null;
        codingSuggestion = null;
        status = null;
        codingStatementId = item.Id;
        codingMode = "ledger";
        var suggested = SuggestedCodingAccount(item);
        var defaultDivision = branches.SelectMany(x => x.Divisions).FirstOrDefault(x => x.IsDefault)
            ?? branches.SelectMany(x => x.Divisions).FirstOrDefault();
        codingModel = new CodingModel { TargetAccountCode = suggested, Description = item.Description, DivisionId = defaultDivision?.Id ?? Guid.Empty };

        // SQLite cannot order DateTimeOffset values. There will only be a small
        // history for one description, so load the tenant-scoped matches and choose
        // the newest one in .NET instead of crashing the Blazor circuit.
        var normalizedDescription = item.Description.Trim().ToUpper();
        var history = await Db.BankStatementLines.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.Id != item.Id && x.ReconciledAt != null && x.MatchedPostedJournalLineId != null && x.Description.ToUpper() == normalizedDescription)
            .Select(x => new { x.MatchedPostedJournalLineId, x.ReconciledAt })
            .ToListAsync();
        var previous = history.OrderByDescending(x => x.ReconciledAt).FirstOrDefault();
        var previousAccount = previous?.MatchedPostedJournalLineId is Guid matchedId ? await FindCodedAccount(matchedId, item) : null;
        if (previousAccount is not null && codingAccounts.Any(x => x.Code == previousAccount.Code))
        {
            codingModel.TargetAccountCode = previousAccount.Code;
            codingSuggestion = previousAccount.Code;
        }
        if (codingModel.TargetAccountCode == "")
        {
            var previousForReopen = await FindCodedAccount(item.MatchedPostedJournalLineId, item);
            if (previousForReopen is not null && previousForReopen.IsBankAccount)
            {
                codingModel.IsTransfer = true;
                codingMode = "transfer";
                codingModel.TransferToAccountId = previousForReopen.Id;
                codingModel.TargetAccountCode = "";
            }
        }
    }
    private void SetCodingMode(BankStatementLine item, string? mode)
    {
        if (mode is null)
        {
            codingMode = "ledger";
            return;
        }

        if (mode == "transfer" && !CanTransferFromStatement)
        {
            codingMode = "ledger";
            return;
        }

        codingMode = mode;
        codingModel.IsTransfer = codingMode == "transfer";
        if (codingModel.IsTransfer)
        {
            codingModel.TargetAccountCode = "";
            if (codingModel.TransferToAccountId is null || codingModel.TransferToAccountId == Guid.Empty)
            {
                var preferredTarget = accounts.FirstOrDefault(a => a.Id != item.BankAccountId) ?? accounts.FirstOrDefault();
                if (preferredTarget is not null)
                {
                    codingModel.TransferToAccountId = preferredTarget.Id;
                }
            }
        }
        else
        {
            codingModel.TransferToAccountId = null;
            if (string.IsNullOrWhiteSpace(codingModel.TargetAccountCode))
                codingModel.TargetAccountCode = SuggestedCodingAccount(item);
        }
    }
    private string SuggestedCodingAccount(BankStatementLine item) { var preferredType = item.Amount < 0 ? AccountType.Expense : AccountType.Revenue; return codingAccounts.FirstOrDefault(x => x.Type == preferredType)?.Code ?? codingAccounts.FirstOrDefault()?.Code ?? ""; }
    private LedgerAccount? CodedAccount(BankStatementLine item) => codedAccounts.GetValueOrDefault(item.Id);
    private CodedVatInfo CodedVat(BankStatementLine item) => codedVat.GetValueOrDefault(item.Id) ?? new(0m, item.ReconciledAt is null ? "Not coded" : "No VAT");
    private async Task ChangeCoding(BankStatementLine item)
    {
        try
        {
            var previousAccount = CodedAccount(item);
            await TransactionCoding.ReopenCodingAsync(userId, OrganisationId, item.Id);
            await Reload();
            await BeginCoding(statementLines.Single(x => x.Id == item.Id));
            if (previousAccount is not null && !previousAccount.IsBankAccount)
            {
                codingModel.TargetAccountCode = previousAccount.Code;
            }
        if (previousAccount is not null && previousAccount.IsBankAccount)
        {
            codingModel.IsTransfer = true;
            codingMode = "transfer";
            codingModel.TransferToAccountId = previousAccount.Id;
            codingModel.TargetAccountCode = "";
        }
            statusClass = "alert-warning";
            status = "The previous coding was reversed. Choose the correct VAT treatment, then post and reconcile again.";
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Could not change coding: {ex.Message}";
        }
    }
    private async Task<LedgerAccount?> FindCodedAccount(Guid? matchedLineId, BankStatementLine? statementLine = null)
    {
        if (matchedLineId is null) return null;
        var journalId = await Db.PostedJournalLines.AsNoTracking().Where(x => x.Id == matchedLineId.Value).Select(x => (Guid?)x.PostedJournalId).SingleOrDefaultAsync();
        if (journalId is null) return null;
        var lines = await Db.PostedJournalLines.AsNoTracking().Include(x => x.LedgerAccount).Where(x => x.PostedJournalId == journalId.Value && x.LedgerAccount.OrganisationId == OrganisationId).ToListAsync();
        var nonBank = lines.FirstOrDefault(x => !x.LedgerAccount.IsBankAccount && x.LedgerAccount.Code is not "1150" and not "2100");
        if (nonBank is not null) return nonBank.LedgerAccount;
        return lines.FirstOrDefault(x => x.LedgerAccount.IsBankAccount && x.LedgerAccountId != statementLine?.BankAccountId)?.LedgerAccount;
    }
    private void CancelCoding() { codingError = null; codingSuggestion = null; codingStatementId = null; codingModel = new(); codingMode = "ledger"; }
    private async Task PostCoding()
    {
        if (codingStatementId is null || postingCoding) return;
        if (codingModel.IsTransfer &&
    (codingModel.TransferToAccountId is null || codingModel.TransferToAccountId == Guid.Empty))
{
    var statement = statementLines.FirstOrDefault(x => x.Id == codingStatementId);

    codingError = statement?.Amount > 0
        ? "Select the bank account this money was transferred from."
        : "Select the bank account this money was transferred to.";

    return;
}
        if (!codingModel.IsTransfer && string.IsNullOrWhiteSpace(codingModel.TargetAccountCode)) { codingError = "Choose an account before posting."; return; }
        if (codingModel.DivisionId == Guid.Empty) { codingError = "Choose an accessible branch and division before posting."; return; }
        if (string.IsNullOrWhiteSpace(codingModel.Description)) { codingError = "Enter a description before posting."; return; }
        postingCoding = true;
        codingError = null;
        try
        {
            var journal = await TransactionCoding.PostAndReconcileAsync(
                userId,
                new(
                    OrganisationId,
                    codingStatementId.Value,
                    codingModel.IsTransfer ? "" : codingModel.TargetAccountCode,
                    codingModel.Description,
                    codingModel.VatTreatment,
                    codingModel.TransferToAccountId,
                    DivisionId: codingModel.DivisionId));
            statusClass = "alert-success";
status =
    $"Transaction posted as journal {journal.SequenceNumber} " +
    "and reconciled. It is now included in financial reports.";

var statement =
    statementLines.FirstOrDefault(x =>
        x.Id == codingStatementId.Value);

if (statement is not null)
{
    var affectedSessions =
        reconciliationSessions
            .Where(x =>
                !x.IsCompleted &&
                x.BankAccountId == statement.BankAccountId &&
                statement.TransactionDate >= x.StatementStartDate &&
                statement.TransactionDate <= x.StatementEndDate)
            .ToList();

    foreach (var session in affectedSessions)
    {
        await ReconciliationSessions.RefreshAsync(
            userId,
            OrganisationId,
            session.Id);
    }
}

CancelCoding();

await Reload();
        }
        catch (Exception ex)
        {
            codingError = $"Could not post and reconcile: {ex.Message}";
            if (ex is InvalidOperationException && ex.InnerException is not null)
            {
                codingError += $" ({ex.InnerException.Message})";
            }
            statusClass = "alert-danger";
            status = codingError;
        }
        finally { postingCoding = false; }
    }
