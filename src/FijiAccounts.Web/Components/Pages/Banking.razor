private IEnumerable<PostedJournalLine> VisibleTransactions
{
    get
    {
        var query = selectedBankAccountId is null
            ? transactions
            : transactions.Where(
                x => x.LedgerAccountId == selectedBankAccountId);

        return query
            .Where(x =>
                !x.PostedJournal.Reference.StartsWith(
                    "REV-BANK-",
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.PostedJournal.EntryDate)
            .ThenByDescending(x => x.PostedJournal.SequenceNumber);
    }
}

private int HiddenCorrectionCount
{
    get
    {
        var query = selectedBankAccountId is null
            ? transactions
            : transactions.Where(
                x => x.LedgerAccountId == selectedBankAccountId);

        return query.Count(x =>
            x.PostedJournal.Reference.StartsWith(
                "REV-BANK-",
                StringComparison.OrdinalIgnoreCase));
    }
}

