        reconciliationTotalCount == 0
            ? 0
            : (reconciliationPage - 1) * ReconciliationPageSize + 1;

    private int ReconciliationLastItem =>
        Math.Min(reconciliationPage * ReconciliationPageSize, reconciliationTotalCount);

