        statementInputVersion++;
    }

    private async Task SelectStatement(InputFileChangeEventArgs args)
    {
        /*
         * Keep the current InputFile component alive until the browser file
         * has been copied. Replacing it here invalidates the IBrowserFile
         * reference and can cause _blazorFilesById failures during upload.
         */
        selectedStatement = null;
        statementPreview = null;
        statementError = null;
        readingStatement = false;
        status = null;
        var file = args.File;

        try
        {
            await using var input = file.OpenReadStream(MaxStatementBytes);
            using var content = new MemoryStream();
            await input.CopyToAsync(content);
            selectedStatement = new SelectedStatementFile(
                file.Name,
                file.ContentType,
                file.Size,
                content.ToArray());
        }
        catch (Exception ex)
        {
            statementError = ex.Message.Contains("_blazorFilesById", StringComparison.Ordinal)
                ? "The selected file is no longer available. Choose the statement file again."
                : $"We could not load this statement file: {ex.Message}";
            statementInputVersion++;
        }
    }

    private async Task ReadSelectedStatement()
{
    if (selectedStatement is null)
        return;

    readingStatement = true;
    statementError = null;

    try
    {
        var selectedAccount = accounts.FirstOrDefault(
            x => x.Id == importBankAccountId);

        if (selectedAccount is null)
        {
            throw new InvalidOperationException(
                "Select the bank or card account for this statement.");
        }

        await using var stream = new MemoryStream(
            selectedStatement.Content,
            writable: false);

        statementPreview = await StatementImport.ReadAsync(
            stream,
            selectedStatement.Name,
            selectedAccount.BankAccountKind);

        statusClass = "alert-success";

        status =
            $"Read {statementPreview.Lines.Count} " +
            $"transaction{(statementPreview.Lines.Count == 1 ? "" : "s")}. " +
            "Review the preview before importing.";
    }
    catch (Exception ex)
    {
        statementPreview = null;

        statementError = $"We could not read this statement: {ex.Message}";
        status = null;
    }
    finally
    {
        readingStatement = false;
    }
}
    private async Task ImportPreview()
    {
        if (statementPreview is null) return;

        try
        {
            var result = await StatementImport.ImportAsync(
                userId,
                OrganisationId,
                importBankAccountId,
                statementPreview.Lines,
                statementPreview.Format,
                new BankStatementDocumentRequest(
                    selectedStatement!.Name,
                    selectedStatement.ContentType,
                    selectedStatement.Size,
                    selectedStatement.Content));
            statusClass = "alert-success";
            status = $"Imported {result.Imported} statement line{(result.Imported == 1 ? "" : "s")}. " +
                     $"Skipped {result.Skipped} duplicate{(result.Skipped == 1 ? "" : "s")}.";
            ResetStatementSelection();
            showImport = false;
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
        catch (DbUpdateException)
        {
            statusClass = "alert-danger";
            status = "The statement could not be saved. Reload the page and try the import again.";
        }
    }

