    private static string CleanReference(string reference)
{
    if (reference.StartsWith(
            "BANK-",
            StringComparison.OrdinalIgnoreCase))
    {
        return reference;
    }

    return reference;
}

private static string CleanDescription(string description)
{
    if (description.StartsWith(
            "Reverse ",
            StringComparison.OrdinalIgnoreCase))
    {
        return description["Reverse ".Length..];
    }

    return description;
}

private void BeginReconciliationSession()
{
    status = null;
    showStatementReconciliation = true;
    editingReconciliationSessionId = null;

    var bankAccountId =
        selectedBankAccountId ??
        accounts.FirstOrDefault()?.Id ??
        Guid.Empty;

    var today = DateOnly.FromDateTime(DateTime.Today);

    reconciliationModel =
        new ReconciliationSessionModel
        {
            BankAccountId = bankAccountId,
            StatementStartDate =
                new DateOnly(today.Year, today.Month, 1),
            StatementEndDate = today
        };

    showReconciliationSession = true;
}

private void EditReconciliationSession(BankReconciliationSession session)
{
    reconciliationStatus = null;
    showStatementReconciliation = true;
    editingReconciliationSessionId = session.Id;
    reconciliationModel = new ReconciliationSessionModel
    {
        BankAccountId = session.BankAccountId,
        StatementStartDate = session.StatementStartDate,
        StatementEndDate = session.StatementEndDate,
        OpeningStatementBalance = session.OpeningStatementBalance,
        ClosingStatementBalance = session.ClosingStatementBalance
    };
    showReconciliationSession = true;
}

private void CancelReconciliationSession()
{
    showReconciliationSession = false;
    editingReconciliationSessionId = null;
    reconciliationModel = new();
}

private async Task SaveReconciliationSession()
{
    try
    {
        savingReconciliationSession = true;
        status = null;

        var request = new BankReconciliationSessionRequest(
            OrganisationId,
            reconciliationModel.BankAccountId,
            reconciliationModel.StatementStartDate,
            reconciliationModel.StatementEndDate,
            reconciliationModel.OpeningStatementBalance,
            reconciliationModel.ClosingStatementBalance);

        if (editingReconciliationSessionId is Guid sessionId)
        {
            await ReconciliationSessions.UpdateAsync(
                userId,
                OrganisationId,
                sessionId,
                request);
        }
        else
        {
            await ReconciliationSessions.CreateAsync(userId, request);
        }

        statusClass = "alert-success";
        status = editingReconciliationSessionId is null
            ? "Bank reconciliation created."
            : "Bank reconciliation updated.";

        showReconciliationSession = false;
        editingReconciliationSessionId = null;
        reconciliationModel = new();

        await Reload();
    }
    catch (Exception ex)
        when (ex is InvalidOperationException
              or UnauthorizedAccessException)
    {
        statusClass = "alert-danger";
        status = ex.Message;
    }
    finally
    {
        savingReconciliationSession = false;
    }
}

