    private PostedJournalLine? SuggestedMatch(BankStatementLine item)
    {
        var candidates =
            matchTransactions
                .Where(x =>
                    x.LedgerAccountId == item.BankAccountId &&
                    AmountMatches(
                        x.Debit - x.Credit,
                        item.Amount))
                .Select(x => new
                {
                    Line = x,
                    DateDifference = Math.Abs(
                        x.PostedJournal.EntryDate.DayNumber -
                        item.TransactionDate.DayNumber)
                })
                .Where(x => x.DateDifference <= 3)
                .OrderBy(x => x.DateDifference)
                .ThenByDescending(x =>
                    x.Line.PostedJournal.SequenceNumber)
                .ToList();

        return candidates
            .FirstOrDefault()?
            .Line;
    }

    private SupplierBill? SuggestedSupplierBill(BankStatementLine item)
    {
        if (item.Amount >= 0 || item.ReconciledAt is not null)
        {
            return null;
        }

        var amount = Math.Abs(Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero));
        var description = NormalizeMatchText($"{item.Description} {item.Reference}");
        var candidates = outstandingSupplierBills
            .Where(x =>
                Math.Abs(Outstanding(x) - amount) <= 0.01m &&
                x.BillDate <= item.TransactionDate.AddDays(3) &&
                !SupplierReferenceConflicts(x, item))
            .Select(x => new
            {
                Bill = x,
                Score = SupplierBillMatchScore(x, description, item.TransactionDate)
            })
            .OrderByDescending(x => x.Score)
            .ThenBy(x => Math.Abs(x.Bill.BillDate.DayNumber - item.TransactionDate.DayNumber))
            .ToList();

        if (candidates.Count == 0 ||
            candidates[0].Score < 50 ||
            (candidates.Count > 1 && candidates[0].Score == candidates[1].Score))
        {
            return null;
        }

        return candidates[0].Bill;
    }

    private static int SupplierBillMatchScore(
        SupplierBill bill,
        string statementDescription,
        DateOnly statementDate)
    {
        var score = 0;
        var supplierReference = NormalizeMatchText(bill.SupplierReference);
        var billNumber = NormalizeMatchText(bill.BillNumber);
        var supplierName = NormalizeMatchText(bill.Supplier.Name);
        if (supplierReference.Length > 0 && statementDescription.Contains(supplierReference, StringComparison.Ordinal)) score += 100;
        if (billNumber.Length > 0 && statementDescription.Contains(billNumber, StringComparison.Ordinal)) score += 80;
        if (supplierName.Length > 2 && statementDescription.Contains(supplierName, StringComparison.Ordinal)) score += 50;
        score += Math.Max(0, 30 - Math.Abs(statementDate.DayNumber - bill.BillDate.DayNumber));
        return score;
    }

    private static bool SupplierReferenceConflicts(
        SupplierBill bill,
        BankStatementLine statement)
    {
        var billNumbers = LongNumbers(bill.SupplierReference);
        var statementNumbers = LongNumbers($"{statement.Description} {statement.Reference}");
        return billNumbers.Count > 0 &&
               statementNumbers.Count > 0 &&
               !billNumbers.Intersect(statementNumbers, StringComparer.Ordinal).Any();
    }

    private static IReadOnlyList<string> LongNumbers(string? value) =>
        System.Text.RegularExpressions.Regex
            .Matches(value ?? string.Empty, @"\d{5,}")
            .Select(x => x.Value)
            .Distinct(StringComparer.Ordinal)
            .ToList();

    private static string NormalizeMatchText(string? value) =>
        new((value ?? string.Empty)
            .Where(char.IsLetterOrDigit)
            .Select(char.ToUpperInvariant)
            .ToArray());

    private static decimal Outstanding(SupplierBill bill) =>
        bill.Total - bill.AmountPaid - bill.AmountCredited;

    private SalesInvoice? SuggestedSalesInvoice(BankStatementLine item)
    {
        if (item.Amount <= 0 || item.ReconciledAt is not null)
        {
            return null;
        }

        var amount = Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero);
        var description = NormalizeMatchText($"{item.Description} {item.Reference}");
        var candidates = outstandingSalesInvoices
            .Where(x =>
                Math.Abs(Outstanding(x) - amount) <= 0.01m &&
                x.IssueDate <= item.TransactionDate.AddDays(3) &&
                !SalesReferenceConflicts(x, item))
            .Select(x => new
            {
                Invoice = x,
                Score = SalesInvoiceMatchScore(x, description, item.TransactionDate)
            })
            .OrderByDescending(x => x.Score)
            .ThenBy(x => Math.Abs(x.Invoice.IssueDate.DayNumber - item.TransactionDate.DayNumber))
            .ToList();

        if (candidates.Count == 0 ||
            candidates[0].Score < 50 ||
            (candidates.Count > 1 && candidates[0].Score == candidates[1].Score))
        {
            return null;
        }

        return candidates[0].Invoice;
    }

    private static int SalesInvoiceMatchScore(
        SalesInvoice invoice,
        string statementDescription,
        DateOnly statementDate)
    {
        var score = 0;
        var invoiceNumber = NormalizeMatchText(invoice.InvoiceNumber);
        var customerName = NormalizeMatchText(invoice.Customer.Name);
        if (invoiceNumber.Length > 0 && statementDescription.Contains(invoiceNumber, StringComparison.Ordinal)) score += 100;
        if (customerName.Length > 2 && statementDescription.Contains(customerName, StringComparison.Ordinal)) score += 50;
        score += Math.Max(0, 30 - Math.Abs(statementDate.DayNumber - invoice.IssueDate.DayNumber));
        return score;
    }

    private static bool SalesReferenceConflicts(
        SalesInvoice invoice,
        BankStatementLine statement)
    {
        var invoiceNumbers = LongNumbers(invoice.InvoiceNumber);
        var statementNumbers = LongNumbers($"{statement.Description} {statement.Reference}");
        return invoiceNumbers.Count > 0 &&
               statementNumbers.Count > 0 &&
               !invoiceNumbers.Intersect(statementNumbers, StringComparer.Ordinal).Any();
    }

    private static decimal Outstanding(SalesInvoice invoice) =>
        invoice.Total - invoice.AmountPaid - invoice.AmountCredited;

    private async Task ReceiveAndReconcileSalesInvoice(
        BankStatementLine statement,
        SalesInvoice invoice)
    {
        try
        {
            settlingSuggestedDocument = true;
            var reference = string.IsNullOrWhiteSpace(statement.Reference)
                ? invoice.InvoiceNumber
                : statement.Reference;
            await CustomerReceipts.RecordAsync(
                userId,
                new CustomerReceiptRequest(
                    OrganisationId,
                    invoice.Id,
                    statement.TransactionDate,
                    reference,
                    statement.Amount,
                    statement.BankAccountId,
                    statement.Id));
            statusClass = "alert-success";
            status = $"{invoice.Customer.Name} invoice {invoice.InvoiceNumber} received and reconciled.";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = $"Could not receive and reconcile this invoice: {ex.Message}";
        }
        finally
        {
            settlingSuggestedDocument = false;
        }
    }

    private async Task PayAndReconcileSupplierBill(
        BankStatementLine statement,
        SupplierBill bill)
    {
        try
        {
            settlingSuggestedDocument = true;
            var reference = string.IsNullOrWhiteSpace(statement.Reference)
                ? bill.SupplierReference
                : statement.Reference;
            var request = new SupplierPaymentRequest(
                    OrganisationId,
                    bill.Id,
                    statement.TransactionDate,
                    reference,
                    Math.Abs(statement.Amount),
                    statement.BankAccountId,
                    statement.Id);
            if (access?.Organisation.RequireSupplierPaymentApproval == true)
            {
                await Purchasing.RequestPaymentApprovalAsync(userId, request);
            }
            else
            {
                await Purchasing.PayBillAsync(userId, request);
            }
            statusClass = "alert-success";
            status = access?.Organisation.RequireSupplierPaymentApproval == true
                ? $"{bill.Supplier.Name} bill {bill.SupplierReference} submitted for payment approval. The statement line will reconcile when approved."
                : $"{bill.Supplier.Name} bill {bill.SupplierReference} paid and reconciled.";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = $"Could not pay and reconcile this bill: {ex.Message}";
        }
        finally
        {
            settlingSuggestedDocument = false;
        }
    }
