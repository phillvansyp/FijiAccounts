@page "/o/{OrganisationId:guid}/banking"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BankReconciliationService Reconciliation
@inject BankReconciliationSessionService ReconciliationSessions
@inject BankStatementImportService StatementImport
@inject BankTransactionCodingService TransactionCoding
@inject JournalPostingService JournalPosting
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BankAccountService BankAccounts
@inject PurchasingService Purchasing
@inject CustomerReceiptService CustomerReceipts

<PageTitle>Banking - Account Island</PageTitle>
    @if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="bank-heading"><div><p class="eyebrow">Banking</p><h1>Bank accounts</h1><p>Balances, statement lines and reconciliation from the posted ledger.</p></div><div class="heading-actions">@if (canReconcile) { <button class="btn btn-outline-primary" @onclick="() => showFeeds = !showFeeds">Bank feeds</button><button class="btn btn-outline-primary" @onclick="ToggleImportHistory">Import history</button><button class="btn btn-outline-primary" @onclick="ToggleStatementImport">Read statement</button><button class="btn btn-outline-primary" @onclick="() => showStatement = !showStatement">+ Statement line</button> }@if (canManage) { <button class="btn btn-primary" @onclick="ToggleAddAccountForm">+ Add bank account</button> }</div></div>
    @if (status is not null) { <div class="alert @statusClass">@status</div> }
    @if (showAdd)
{
    <section class="add-bank">
        <h2>Add bank account</h2>

        <EditForm Model="model"
                  OnValidSubmit="AddBank"
                  OnInvalidSubmit="AddBankInvalid"
                  FormName="add-bank">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="bank-fields">
                <div>
                    <label class="form-label">Ledger code</label>
                    <InputText class="form-control"
                               @bind-Value="model.Code" />
                </div>

                <div>
                    <label class="form-label">Account name</label>
                    <InputText class="form-control"
                               @bind-Value="model.Name" />
                </div>

                <div>
                    <label class="form-label">Account type</label>
                    <InputSelect class="form-select"
                                 @bind-Value="model.AccountKind">
                        <option value="@BankAccountKind.Bank">Bank account</option>
                        <option value="@BankAccountKind.DebitCard">Debit / EFTPOS card</option>
                        <option value="@BankAccountKind.CreditCard">Credit card</option>
                        <option value="@BankAccountKind.Loan">Loan</option>
                    </InputSelect>
                    <small class="text-muted">This controls ledger classification and statement direction.</small>
                </div>

                <div>
                    <label class="form-label">Account number</label>
                    <InputText class="form-control"
                               @bind-Value="model.AccountNumber" />
                </div>

                <div>
                    <label class="form-label">Opening balance</label>
                    <InputNumber class="form-control"
                                 @bind-Value="model.OpeningBalance" />
                    <small class="text-muted">
                        Enter the bank balance when you begin using Account Island.
                    </small>
                </div>

                <div>
                    <label class="form-label">Balance date</label>
                    <InputDate class="form-control"
                               @bind-Value="model.OpeningBalanceDate" />
                </div>

                <div class="d-flex align-items-end">
                    <button class="btn btn-primary"
                            type="submit">
                        Create account
                    </button>
                </div>
            </div>
        </EditForm>
    </section>
}
    <div class="bank-grid">
    <article class="bank-card bank-card-clickable @(selectedBankAccountId is null ? "selected" : null)"
             @onclick="() => SelectBankAccount(null)">
        <div>
            <span class="bank-icon">$</span>
            <div>
                <h2>All accounts</h2>
                <small>Full banking ledger</small>
            </div>
        </div>

        <span class="currency">@access.Organisation.BaseCurrency</span>

        <strong>
            $@accounts.Sum(x => Balance(x.Id)).ToString("N2")
        </strong>

        <small>Combined ledger balance</small>
    </article>

    @foreach (var account in accounts)
    {
        <article class="bank-card bank-card-clickable @(selectedBankAccountId == account.Id ? "selected" : null)"
                 @onclick="() => SelectBankAccount(account.Id)">
            <div>
                <span class="bank-icon">$</span>

                <div>
                    <h2>@account.Name</h2>

                    <small>
                        @(string.IsNullOrWhiteSpace(account.BankAccountNumber)
                            ? $"Ledger {account.Code}"
                            : account.BankAccountNumber)
                    </small>
                </div>
            </div>

            <span class="currency">
                @access.Organisation.BaseCurrency
            </span>

            <strong>
                $@Balance(account.Id).ToString("N2")
            </strong>

            <small>Ledger balance</small>
        </article>
    }
</div>
    @if (accounts.Count == 0) { <div class="empty-state"><strong>No bank accounts configured</strong><span>Add a bank account to receive customer payments and pay supplier bills.</span></div> }
    @if (showStatement && accounts.Count > 0) { <section class="add-bank"><h2>Add statement line</h2><EditForm Model="statementModel" OnValidSubmit="AddStatement" FormName="add-statement-line"><DataAnnotationsValidator /><ValidationSummary /><div class="statement-fields"><div><label class="form-label">Bank account</label><InputSelect class="form-select" @bind-Value="statementModel.BankAccountId">@foreach (var account in accounts) { <option value="@account.Id">@account.Name</option> }</InputSelect></div><div><label class="form-label">Date</label><InputDate class="form-control" @bind-Value="statementModel.Date" /></div><div><label class="form-label">Description</label><input class="form-control" @bind="statementModel.Description" @bind:event="oninput" /></div><div><label class="form-label">Reference</label><input class="form-control" @bind="statementModel.Reference" @bind:event="oninput" /></div><div><label class="form-label">Amount (+ in / - out)</label><input type="number" step="0.01" class="form-control" @bind="statementModel.Amount" @bind:event="oninput" /></div><button class="btn btn-primary">Add line</button></div></EditForm></section> }
    @if (showFeeds) { <section class="add-bank import-panel"><h2>Fiji bank connections</h2><p>Connection availability depends on the bank, account type and a bank-approved agreement.</p><div class="table-responsive"><table class="table"><thead><tr><th>Bank</th><th>Available method</th><th>Account Island option</th></tr></thead><tbody><tr><td><strong>ANZ Fiji</strong></td><td>Transactive/Fileactive corporate statement delivery</td><td>Contact ANZ relationship manager to approve host-to-host access</td></tr><tr><td><strong>BSP Fiji</strong></td><td>Online banking statement exports</td><td>Download and use Read statement</td></tr><tr><td>Westpac Fiji, BRED, HFC, Bank of Baroda</td><td>Statement export; direct API not publicly confirmed</td><td>Download and use Read statement</td></tr></tbody></table></div><small>Account Island never asks for or stores internet-banking passwords.</small></section> }
    @if (showImport && accounts.Count > 0) { <section class="add-bank import-panel"><h2>Read bank statement</h2><p>Drop in or select a PDF, CSV, OFX, QFX or QIF statement. We read and preview it before anything is imported. Maximum 5 MB.</p>@if (statementError is not null) { <div class="alert alert-danger">@statementError</div> }<div class="import-fields"><div><label class="form-label">Bank account</label><InputSelect class="form-select" @bind-Value="importBankAccountId">@foreach (var account in accounts) { <option value="@account.Id">@account.Name</option> }</InputSelect></div><div><label class="form-label">Statement file</label><InputFile @key="statementInputVersion" class="form-control" OnChange="SelectStatement" accept=".csv,.txt,.ofx,.qfx,.qif,.pdf" />@if (selectedStatement is not null) { <small class="d-block mt-2 text-muted">@selectedStatement.Name - @FormatFileSize(selectedStatement.Size)</small> }</div><div class="d-flex align-items-end"><button type="button" class="btn btn-primary" disabled="@(selectedStatement is null || readingStatement)" @onclick="ReadSelectedStatement">@(readingStatement ? "Reading..." : "Upload and read statement")</button></div></div>
        @if (statementPreview is not null) { <div class="mt-4"><div class="d-flex justify-content-between align-items-center"><div><strong>@statementPreview.Format statement - @statementPreview.Lines.Count transactions</strong><small class="d-block text-muted">Check every date and amount before importing, especially values read from PDF.</small></div><button class="btn btn-primary" @onclick="ImportPreview">Import statement</button></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Reference</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var line in statementPreview.Lines) { <tr><td>@line.Date.ToString("dd MMM yyyy")</td><td>@line.Description</td><td>@line.Reference</td><td class="text-end @(line.Amount >= 0 ? "money-in" : "money-out")">@line.Amount.ToString("N2")</td></tr> }</tbody></table></div></div> }
    </section> }
    @if (showImportHistory)
    {
        <section class="add-bank import-panel">
            <h2>Statement import history</h2>
            <p>Delete a complete import if the wrong statement was uploaded. Fiji imports inside the seven-year retention period and imports containing reconciled transactions are locked.</p>

            @if (statementImports.Count == 0)
            {
                <div class="empty-state">
                    <strong>No statement imports</strong>
                    <span>Imported statement batches will appear here.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Statement period</th>
                                <th>Bank account</th>
                                <th>Format</th>
                                <th>Transactions</th>
                                <th class="text-end">Net amount</th>
                                <th>Imported</th>
                                <th>Statement</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in statementImports)
                            {
                                <tr>
                                    <td>@item.FirstDate.ToString("dd MMM yyyy") – @item.LastDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.BankAccountName</td>
                                    <td>@item.Source</td>
                                    <td>@item.LineCount</td>
                                    <td class="text-end">$@item.NetAmount.ToString("N2")</td>
                                    <td>@item.ImportedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @if (item.DocumentId is not null)
                                        {
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="@StatementDocumentUrl(item.BatchId)"
                                               target="_blank"
                                               rel="noopener">View statement</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not retained</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (confirmingImportBatchId == item.BatchId)
                                        {
                                            <div class="d-flex justify-content-end align-items-center gap-2">
                                                <span class="text-danger">Delete all @item.LineCount lines?</span>
                                                <button type="button" class="btn btn-sm btn-danger" disabled="@deletingImport" @onclick="() => DeleteStatementImport(item.BatchId)">Confirm</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@deletingImport" @onclick="CancelImportDeletion">Cancel</button>
                                            </div>
                                        }
                                        else if (item.CanDelete)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => BeginImportDeletion(item.BatchId)">Delete import</button>
                                        }
                                        else if (item.RetainUntil is not null)
                                        {
                                            <span class="text-muted">Protected until @item.RetainUntil.Value.ToString("dd MMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Locked — reconciled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    <section class="add-bank">
    <div class="reconcile-heading">
        <div>
            <h2>Statement reconciliation</h2>
            <p>@(editingReconciliationSessionId is null ? "Balance a bank statement against the posted ledger." : "Correct the statement period or balances for this in-progress reconciliation.")</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    aria-expanded="@showStatementReconciliation"
                    @onclick="() => showStatementReconciliation = !showStatementReconciliation">
                @(showStatementReconciliation ? "Collapse" : "Expand")
            </button>

            @if (canReconcile && accounts.Count > 0)
            {
                <button type="button"
                        class="btn btn-primary"
                        @onclick="BeginReconciliationSession">
                    + New reconciliation
                </button>
            }
        </div>
    </div>

    @if (showStatementReconciliation)
    {
        RenderFragment reconciliationSessionEditor = @<text>
        <EditForm Model="reconciliationModel"
                  OnValidSubmit="SaveReconciliationSession"
                  FormName="bank-reconciliation-session">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="statement-fields">
                <div>
                    <label class="form-label">Bank account</label>

                    <InputSelect class="form-select"
                                 @bind-Value="reconciliationModel.BankAccountId">
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">
                                @account.Name
                            </option>
                        }
                    </InputSelect>
                </div>

                <div>
                    <label class="form-label">Statement start</label>

                    <InputDate class="form-control"
                               @bind-Value="reconciliationModel.StatementStartDate" />
                </div>

                <div>
                    <label class="form-label">Statement end</label>

                    <InputDate class="form-control"
                               @bind-Value="reconciliationModel.StatementEndDate" />
                </div>

                <div>
                    <label class="form-label">Opening balance</label>

                    <InputNumber class="form-control"
                                 @bind-Value="reconciliationModel.OpeningStatementBalance" />
                </div>

                <div>
                    <label class="form-label">Closing balance</label>

                    <InputNumber class="form-control"
                                 @bind-Value="reconciliationModel.ClosingStatementBalance" />
                </div>

                <div class="d-flex align-items-end gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@savingReconciliationSession">
                        @(savingReconciliationSession
                            ? "Saving..."
                            : editingReconciliationSessionId is null
                                ? "Create reconciliation"
                                : "Save changes")
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CancelReconciliationSession">
                        Cancel
                    </button>
                </div>
            </div>
        </EditForm>
        </text>;

    @if (showReconciliationSession && editingReconciliationSessionId is null)
    {
        @reconciliationSessionEditor
    }

        var visibleSessions =
            selectedBankAccountId is null
                ? reconciliationSessions
                : reconciliationSessions
                    .Where(x =>
                        x.BankAccountId ==
                        selectedBankAccountId.Value)
                    .ToList();

    @if (reconciliationStatus is not null)
{
    <div class="alert @reconciliationStatusClass mt-3">
        @reconciliationStatus
    </div>
}

    @if (visibleSessions.Count == 0)
    {
        <div class="empty-state">
            <strong>No reconciliation history</strong>
            <span>
                Create a reconciliation when you have a bank statement
                period to balance.
            </span>
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th>Bank account</th>
                        <th>Statement period</th>
                        <th class="text-end">Statement balance</th>
                        <th class="text-end">Ledger balance</th>
                        <th class="text-end">Difference</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var session in visibleSessions)
                    {
                        <tr>
                            <td>
                                <strong>@session.BankAccount.Name</strong>
                            </td>

                            <td>
                                @session.StatementStartDate.ToString("dd MMM yyyy")
                                -
                                @session.StatementEndDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-end">
                                $@session.ClosingStatementBalance.ToString("N2")
                            </td>

                            <td class="text-end">
                                $@session.LedgerBalance.ToString("N2")
                            </td>

                            <td class="text-end @(Math.Abs(session.Difference) <= 0.01m ? "money-in" : "money-out")">
                                $@session.Difference.ToString("N2")
                            </td>

                            <td>
                                @if (session.IsCompleted)
                                {
                                    <span class="badge text-bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">
                                        In progress
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                @if (!session.IsCompleted && canReconcile)
                                {
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => EditReconciliationSession(session)">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                @onclick="() => RefreshReconciliationSession(session.Id)">
                                            Refresh
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                @onclick="() => CompleteReconciliationSession(session.Id)">
                                            Complete
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>

                        @if (showReconciliationSession &&
                             editingReconciliationSessionId == session.Id)
                        {
                            <tr class="reconciliation-edit-row">
                                <td colspan="7" class="p-3 bg-light">
                                    @reconciliationSessionEditor
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    }
</section>
    <section class="reconciliation">
        <div class="reconcile-heading">
            <div><h2>Reconciliation</h2><p>Match statement activity to the ledger</p></div>
            <span>@reconciliationUnreconciledCount unreconciled</span>
        </div>
        <div class="reconciliation-filters px-3 pt-3">
            <div class="reconciliation-search-filter">
                <label class="form-label" for="reconciliation-search">Search reconciliation</label>
                <input id="reconciliation-search"
                       class="form-control"
                       @bind="reconciliationSearch"
                       @bind:event="oninput"
                       @bind:after="OnReconciliationSearchChanged"
                       placeholder="Search client/payee, amount, reference or transaction type" />
                <small class="text-muted">Examples: Rentokil, 281.25, money out, debit card, reconciled.</small>
            </div>
            <div>
                <label class="form-label" for="reconciliation-bank-account">Account</label>
                <InputSelect id="reconciliation-bank-account"
                             class="form-select"
                             @bind-Value="selectedBankAccountId"
                             @bind:after="OnReconciliationAccountChanged">
                    <option value="">All accounts</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label class="form-label" for="reconciliation-date-from">From date</label>
                <input id="reconciliation-date-from"
                       type="date"
                       class="form-control"
                       max="@(reconciliationDateTo?.ToString("yyyy-MM-dd"))"
                       @bind="reconciliationDateFrom"
                       @bind:after="OnReconciliationDateRangeChanged" />
            </div>
            <div>
                <label class="form-label" for="reconciliation-date-to">To date</label>
                <input id="reconciliation-date-to"
                       type="date"
                       class="form-control"
                       min="@(reconciliationDateFrom?.ToString("yyyy-MM-dd"))"
                       @bind="reconciliationDateTo"
                       @bind:after="OnReconciliationDateRangeChanged" />
            </div>
            @if (HasActiveReconciliationFilters)
            {
                <button type="button"
                        class="btn btn-outline-secondary reconciliation-clear-filter"
                        @onclick="ClearReconciliationFilters">
                    Clear
                </button>
            }
        </div>
        @if (!VisibleStatementLines.Any()) { <div class="empty-state"><strong>No statement lines</strong><span>@(HasActiveReconciliationFilters ? "No statement lines match the selected filters." : "Add a statement line to begin reconciling.")</span></div> }
        else { @foreach (var item in VisibleStatementLines) { var match = SuggestedMatch(item); var codedAccount = CodedAccount(item); var vat = CodedVat(item); <div class="statement-row"><span class="reconcile-state @(item.ReconciledAt is not null ? "done" : null)">@(item.ReconciledAt is not null ? "OK" : "!")</span><div><strong>@item.Description</strong><small>@item.TransactionDate.ToString("dd MMM yyyy") - @item.BankAccount.Name - @(item.Reference ?? "No reference")</small></div><b class="@(item.Amount >= 0 ? "money-in" : "money-out")">$@item.Amount.ToString("N2")</b><div class="coded-account"><small>Coded to</small>@if (codedAccount is not null) { <strong>@codedAccount.Code - @codedAccount.Name</strong><small class="included-vat">Included VAT: @(vat.Amount > 0 ? $"${vat.Amount:N2}" : "-")</small> } else { <span>-</span> }</div><div class="match-action">@if (item.ReconciledAt is not null) { <span>Reconciled</span>@if (canReconcile && codedAccount is not null) { <button type="button" class="edit-coding" title="Change coding" aria-label="Change coding" @onclick="() => ChangeCoding(item)">Edit</button> } } else if (match is not null) { <div><small>Suggested match</small><strong class="d-block">@match.PostedJournal.EntryDate.ToString("dd MMM yyyy") - $@Math.Abs(match.Debit - match.Credit).ToString("N2")</strong><small class="d-block">@match.LedgerAccount.Name - @match.Description</small></div><button class="btn btn-sm btn-primary" @onclick="() => Reconcile(item.Id, match.Id)">Match</button> } else if (canReconcile) { <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => BeginCoding(item)">Code transaction</button> } else { <span>No exact match</span> }@if (item.MatchedPostedJournalLineId is not null) { <span class="matched-marker" title="Matched" aria-label="Matched">M</span> }</div></div>
            @if (item.ReconciledAt is null && SuggestedMatch(item) is null && SuggestedSupplierBill(item) is { } suggestedBill)
            {
                <div class="alert alert-info mx-3 mb-3 d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <small class="d-block">Suggested supplier bill</small>
                        <strong>@suggestedBill.Supplier.Name - @suggestedBill.SupplierReference</strong>
                        <span class="d-block">Outstanding $@Outstanding(suggestedBill).ToString("N2")</span>
                    </div>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@settlingSuggestedDocument"
                            @onclick="() => PayAndReconcileSupplierBill(item, suggestedBill)">
                        @(settlingSuggestedDocument
                            ? "Processing..."
                            : access?.Organisation.RequireSupplierPaymentApproval == true
                                ? "Request payment approval"
                                : "Pay bill & reconcile")
                    </button>
                </div>
            }
            @if (item.ReconciledAt is null && SuggestedMatch(item) is null && SuggestedSalesInvoice(item) is { } suggestedInvoice)
            {
                <div class="alert alert-info mx-3 mb-3 d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <small class="d-block">Suggested sales invoice</small>
                        <strong>@suggestedInvoice.Customer.Name - @suggestedInvoice.InvoiceNumber</strong>
                        <span class="d-block">Outstanding $@Outstanding(suggestedInvoice).ToString("N2")</span>
                    </div>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@settlingSuggestedDocument"
                            @onclick="() => ReceiveAndReconcileSalesInvoice(item, suggestedInvoice)">
                        @(settlingSuggestedDocument ? "Processing..." : "Receive payment & reconcile")
                    </button>
                </div>
            }
            @if (codingStatementId == item.Id)
            {
                <div class="coding-panel" @key="item.Id">
                    <EditForm Model="codingModel" FormName="@($"code-bank-{item.Id}")">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        @if (codingError is not null) { <div class="alert alert-danger">@codingError</div> }
                        <div class="coding-fields">
                            <div class="mb-3">
                                <label class="form-label">Code as</label>
                                <select class="form-select" value="@codingMode" @onchange="e => SetCodingMode(item, e.Value?.ToString())">
                                    <option value="ledger">Ledger account</option>
                                    <option value="transfer" disabled="@(!CanTransferFromStatement)">Internal transfer</option>
                                </select>
                                @if (!CanTransferFromStatement)
                                {
                                    <small class="text-danger">Need at least 2 active bank accounts to use internal transfers.</small>
                                }
                            </div>
