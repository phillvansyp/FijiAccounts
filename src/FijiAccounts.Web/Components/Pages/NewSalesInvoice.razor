@page "/o/{OrganisationId:guid}/sales/new"
@page "/o/{OrganisationId:guid}/sales/{InvoiceId:guid}/edit"
@page "/o/{OrganisationId:guid}/sales/recurring/{RecurringInvoiceId:guid}/edit"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BusinessPartyService BusinessParties
@inject SalesInvoiceService InvoiceService
@inject ProjectService ProjectService
@inject RecurringSalesInvoiceService RecurringInvoices
@inject TransactionCurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>New invoice - Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else if (!canManage) { <div class="alert alert-danger">You do not have permission to create or edit sales invoices for this organisation. <a href="o/@OrganisationId/sales">Return to sales invoices</a></div> }
else if (customers.Count == 0) { <div class="alert alert-info">Add a customer before creating an invoice. <a href="o/@OrganisationId/contacts">Open contacts</a></div> }
else
{
    <div class="editor-heading"><div><p class="eyebrow">Money in</p><h1>@(RecurringInvoiceId is not null ? "Edit recurring invoice" : InvoiceId is null ? "New sales invoice" : "Edit draft invoice")</h1><p>Create a draft or post it to the ledger when ready.</p></div><a class="btn btn-outline-secondary" href="o/@OrganisationId/sales">Cancel</a></div>
    @if (status is not null) { <div class="alert alert-danger">@status</div> }
    <EditForm Model="model" OnValidSubmit="Post" FormName="advanced-sales-invoice" class="invoice-editor"><DataAnnotationsValidator /><ValidationSummary /><CatalogProductPicker OrganisationId="OrganisationId" OnSelected="AddProductLine" />
        <section class="invoice-parties @(IsBaseCurrency ? null : "foreign-currency")"><div><label class="form-label">Customer</label><InputSelect class="form-select" @bind-Value="model.CustomerId" @bind-Value:after="ApplySelectedCustomerDefaultsAsync">@foreach (var customer in customers) { <option value="@customer.Id">@customer.Name</option> }</InputSelect></div><div><label class="form-label">Issue date</label><InputDate class="form-control" @bind-Value="model.IssueDate" @bind-Value:after="IssueDateChanged" /></div><div><label class="form-label">Due date</label><InputDate class="form-control" @bind-Value="model.DueDate" /></div><div><label class="form-label">Currency</label><InputSelect class="form-select" @bind-Value="model.Currency" @bind-Value:after="CurrencyChanged">@foreach (var currency in currencies.Where(x => x.IsActive)) { <option value="@currency.Code">@currency.Code - @currency.Name</option> }</InputSelect></div>@if (!IsBaseCurrency) { <div><label class="form-label">Exchange rate</label><InputNumber class="form-control" @bind-Value="model.ExchangeRateToBase" step="0.00000001" /><div class="form-text">1 @model.Currency = @model.ExchangeRateToBase.ToString("0.########") @access.Organisation.BaseCurrency</div></div> }</section>
        @if (!IsBaseCurrency && model.ExchangeRateToBase <= 0)
        {
            <div class="alert alert-warning" role="alert">
                No @model.Currency exchange rate is available for @model.IssueDate.ToString("dd MMM yyyy"). Enter a rate above or select @access.Organisation.BaseCurrency before posting.
            </div>
        }
        <div class="mb-4"><label class="form-label">Branch and division</label><InputSelect class="form-select" @bind-Value="model.DivisionId" @bind-Value:after="DimensionChanged">@foreach (var branch in branches) { <optgroup label="@($"{branch.Code} — {branch.Name}")">@foreach (var division in branch.Divisions.Where(x => x.IsActive)) { <option value="@division.Id">@branch.Code — @branch.Name / @division.Code — @division.Name</option> }</optgroup> }</InputSelect></div>
        <section class="line-editor"><div class="line-header"><span>Description</span><span>Customer PO</span><span>Quantity</span><span>Unit price</span><span>Tax</span><span>Account</span><span></span></div>
            @for (var index = 0; index < model.Lines.Count; index++) { var line = model.Lines[index]; var captured = index; <div class="invoice-line"><InputText class="form-control" @bind-Value="line.Description" @bind-Value:event="oninput" /><InputText class="form-control" @bind-Value="line.CustomerPurchaseOrderNumber" @bind-Value:event="oninput" placeholder="PO number" /><InputNumber class="form-control" @bind-Value="line.Quantity" @bind-Value:event="oninput" /><InputNumber class="form-control" @bind-Value="line.UnitPrice" @bind-Value:event="oninput" /><InputSelect class="form-select" @bind-Value="line.VatTreatment">@foreach (var treatment in Enum.GetValues<VatTreatment>()) { <option value="@treatment">@treatment</option> }</InputSelect><InputSelect class="form-select" @bind-Value="line.RevenueAccountId">@foreach (var account in revenueAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect><button type="button" class="remove-line" title="Remove line" @onclick="() => RemoveLine(captured)">×</button></div><div class="project-coding-row"><div><label class="form-label">Project</label><InputSelect class="form-select" @bind-Value="line.ProjectId" @bind-Value:after="() => ProjectChanged(line)"><option value="">No project</option>@foreach (var project in EligibleProjects) { <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option> }</InputSelect></div><div><label class="form-label">Cost code</label><InputSelect class="form-select" @bind-Value="line.ProjectCostCodeId" disabled="@(line.ProjectId is null)"><option value="">No cost code</option>@foreach (var costCode in CostCodes(line.ProjectId)) { <option value="@costCode.Id">@costCode.Code &mdash; @costCode.Name</option> }</InputSelect></div></div> }
            <button type="button" class="add-line" @onclick="AddLine">+ Add another line</button>
        </section>
        @if (InvoiceId is null)
        {
            <section class="mb-4">
                <div class="form-check mb-3">
                    <InputCheckbox id="make-recurring"
                                   class="form-check-input"
                                   @bind-Value="isRecurringInvoice" />

                    <label class="form-check-label"
                           for="make-recurring">
                        Make this a recurring invoice
                    </label>
                </div>

                @if (isRecurringInvoice)
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">
                                Frequency
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="recurringModel.Frequency">
                                @foreach (var frequency in Enum.GetValues<RecurringSalesInvoiceFrequency>())
                                {
                                    <option value="@frequency">
                                        @frequency
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Start date
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="recurringModel.StartDate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Payment due
                            </label>

                            <div class="input-group">
                                <InputNumber class="form-control"
                                             @bind-Value="recurringModel.DueDays" />

                                <span class="input-group-text">
                                    days
                                </span>
                            </div>

                            <ValidationMessage For="@(() => recurringModel.DueDays)" />
                        </div>
                    </div>

                    <div class="form-text mt-2">
                        A sales invoice will be generated automatically on each scheduled date.
                    </div>
                }
            </section>
        }
        <section class="invoice-totals"><div><span>Subtotal</span><strong>@model.Currency @Subtotal.ToString("N2")</strong></div><small>Final tax totals are calculated using the organisation’s effective-dated tax pack when saved.</small></section>
        <footer class="editor-actions">
            @if (isRecurringInvoice && InvoiceId is null)
            {
                <button type="button"
                        class="btn btn-primary"
                        @onclick="CreateRecurringInvoice">
                    @(RecurringInvoiceId is null
                        ? "Create recurring invoice"
                        : "Update recurring invoice")
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="SaveDraft">
                    Save draft
                </button>

                <button class="btn btn-primary">
                    Post invoice
                </button>
            }
        </footer>
    </EditForm>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; } [Parameter] public Guid? InvoiceId { get; set; } [Parameter] public Guid? RecurringInvoiceId { get; set; }
    private AccessibleOrganisation? access; private string userId = ""; private bool canManage; private List<BusinessParty> customers = []; private List<LedgerAccount> revenueAccounts = []; private List<Branch> branches = []; private List<Project> projects = []; private IReadOnlyList<CurrencyOption> currencies = []; private InvoiceEditorModel model = new(); private bool isRecurringInvoice; private RecurringInvoiceEditorModel recurringModel = new(); private string? status; private decimal Subtotal => model.Lines.Sum(x => x.Quantity * x.UnitPrice); private bool IsBaseCurrency => access is not null && string.Equals(model.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase);
    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
            return;

        canManage =
            await TenantAccess.CanPostJournalsAsync(
                userId,
                OrganisationId);

        if (!canManage)
            return;

        currencies = await CurrencyService.ListAsync(userId, OrganisationId);

        customers =
            await Db.BusinessParties
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    (x.Type & PartyType.Customer) != 0)
                .OrderBy(x => x.Name)
                .ToListAsync();

        revenueAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    x.Type == AccountType.Revenue)
                .OrderBy(x => x.Code)
                .ToListAsync();

        branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
        projects = await ProjectService.ListAsync(userId, OrganisationId);
        var accessibleDivisions = branches.SelectMany(x => x.Divisions).ToList();
        model.DivisionId = (accessibleDivisions.FirstOrDefault(x => x.IsDefault) ?? accessibleDivisions.FirstOrDefault())?.Id ?? Guid.Empty;

        if (RecurringInvoiceId is not null)
        {
            var recurring =
                await Db.RecurringSalesInvoices
                    .AsNoTracking()
                    .Include(x => x.Lines)
                    .SingleOrDefaultAsync(x =>
                        x.Id == RecurringInvoiceId &&
                        x.OrganisationId == OrganisationId);

            if (recurring is null)
            {
                status =
                    "Recurring invoice was not found.";

                return;
            }

            isRecurringInvoice = true;

            recurringModel =
                new()
                {
                    Frequency =
                        recurring.Frequency,
                    StartDate =
                        recurring.StartDate,
                    DueDays =
                        recurring.DueDays
                };

            model =
                new()
                {
                    CustomerId =
                        recurring.CustomerId,
                    DivisionId =
                        recurring.DivisionId ?? model.DivisionId,
                    IssueDate =
                        recurring.StartDate,
                    DueDate =
                        recurring.StartDate.AddDays(
                            recurring.DueDays),
                    Currency = recurring.Currency,
                    Lines =
                        recurring.Lines
                            .Select(x =>
                                new InvoiceLineModel
                                {
                                    Description =
                                        x.Description,
                                    Quantity =
                                        x.Quantity,
                                    UnitPrice =
                                        x.UnitPrice,
                                    VatTreatment =
                                        x.VatTreatment,
                                    RevenueAccountId =
                                        x.RevenueAccountId,
                                    ProductItemId =
                                        x.ProductItemId,
                                    ProjectId =
                                        x.ProjectId,
                                    ProjectCostCodeId =
                                        x.ProjectCostCodeId
                                })
                            .ToList()
                };

            await CurrencyChanged();
            return;
        }

        if (InvoiceId is not null)
        {
            var invoice =
                await Db.SalesInvoices
                    .AsNoTracking()
                    .Include(x => x.Lines)
                    .SingleOrDefaultAsync(x =>
                        x.Id == InvoiceId &&
                        x.OrganisationId == OrganisationId &&
                        x.Status == InvoiceStatus.Draft);

            if (invoice is null)
            {
                status =
                    "Only draft invoices can be edited.";

                return;
            }

            model =
                new()
                {
                    CustomerId =
                        invoice.CustomerId,
                    IssueDate =
                        invoice.IssueDate,
                    DueDate =
                        invoice.DueDate,
                    Currency = invoice.Currency,
                    ExchangeRateToBase = invoice.ExchangeRateToBase,
                    DivisionId =
                        invoice.DivisionId ?? model.DivisionId,
                    Lines =
                        invoice.Lines
                            .Select(x =>
                                new InvoiceLineModel
                                {
                                    Description =
                                        x.Description,
                                    CustomerPurchaseOrderNumber =
                                        x.CustomerPurchaseOrderNumber,
                                    Quantity =
                                        x.Quantity,
                                    UnitPrice = x.TransactionUnitPrice,
                                    VatTreatment =
                                        x.VatTreatment,
                                    RevenueAccountId =
                                        x.RevenueAccountId,
                                    ProductItemId =
                                        x.ProductItemId,
                                    ProjectId = x.ProjectId,
                                    ProjectCostCodeId = x.ProjectCostCodeId
                                })
                            .ToList()
                };

        }
        else
        {
            model.CustomerId =
                customers.FirstOrDefault()?.Id
                ?? Guid.Empty;

            AddLine();

            await ApplySelectedCustomerDefaultsAsync();
        }
    }
    private void AddLine() => model.Lines.Add(new InvoiceLineModel { RevenueAccountId = revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty }); private void AddProductLine(ProductItem item) { var line = model.Lines.Count == 1 && string.IsNullOrWhiteSpace(model.Lines[0].Description) ? model.Lines[0] : new InvoiceLineModel(); line.Description = string.IsNullOrWhiteSpace(item.Description) ? item.Name : item.Description; line.Quantity = 1; line.UnitPrice = item.SalePrice; line.VatTreatment = item.SaleTaxTreatment; line.RevenueAccountId = item.RevenueAccountId ?? revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty; line.ProductItemId = item.Id; if (!model.Lines.Contains(line)) model.Lines.Add(line); } private void RemoveLine(int index) { if (model.Lines.Count > 1) model.Lines.RemoveAt(index); }
    private SalesInvoiceRequest Request() => new(OrganisationId, model.CustomerId, model.IssueDate, model.DueDate, model.Lines.Select(x => new SalesInvoiceLineRequest(x.Description, x.Quantity, x.UnitPrice, x.VatTreatment, x.RevenueAccountId, x.ProductItemId, x.CustomerPurchaseOrderNumber, x.ProjectId, x.ProjectCostCodeId)).ToList(), DivisionId: model.DivisionId, Currency: model.Currency, ExchangeRateToBase: model.ExchangeRateToBase);
    private async Task CreateRecurringInvoice()
    {
        try
        {
            var request =
                new RecurringSalesInvoiceRequest(
                    OrganisationId,
                    model.CustomerId,
                    recurringModel.Frequency,
                    recurringModel.StartDate,
                    recurringModel.DueDays,
                    model.Lines
                        .Select(x =>
                            new RecurringSalesInvoiceLineRequest(
                                x.Description,
                                x.Quantity,
                                x.UnitPrice,
                                x.VatTreatment,
                                x.RevenueAccountId,
                                x.ProductItemId,
                                x.ProjectId,
                                x.ProjectCostCodeId))
                        .ToList(),
                    DivisionId: model.DivisionId,
                    Currency: model.Currency);

            if (RecurringInvoiceId is Guid recurringId)
            {
                await RecurringInvoices.UpdateAsync(
                    userId,
                    recurringId,
                    request);
            }
            else
            {
                await RecurringInvoices.CreateAsync(
                    userId,
                    request);
            }

            Navigation.NavigateTo(
                $"o/{OrganisationId}/sales");
        }
        catch (Exception ex)
            when (ex is
                InvalidOperationException or
                UnauthorizedAccessException or
                DomainException)
        {
            status = ex.Message;
        }
    }
    private async Task SaveDraft() { try { var invoice = InvoiceId is null ? await InvoiceService.CreateDraftAsync(userId, Request()) : await InvoiceService.UpdateDraftAsync(userId, InvoiceId.Value, Request()); Navigation.NavigateTo($"o/{OrganisationId}/sales/{invoice.Id}"); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or DomainException) { status = ex.Message; } }
    private async Task ApplySelectedCustomerDefaultsAsync()
    {
        ApplySelectedCustomerPaymentTerms();

        var customer = customers.FirstOrDefault(x => x.Id == model.CustomerId);
        model.Currency = customer?.DefaultSalesCurrency
            ?? access?.Organisation.BaseCurrency
            ?? "FJD";
        await CurrencyChanged();

        var suggestion =
            await GetCustomerCodingSuggestionAsync(
                model.CustomerId);

        if (suggestion is null ||
            model.Lines.Count == 0)
        {
            return;
        }

        if (suggestion.RevenueAccountId is not null)
        {
            model.Lines[0].RevenueAccountId =
                suggestion.RevenueAccountId.Value;
        }

        if (suggestion.VatTreatment is not null)
        {
            model.Lines[0].VatTreatment =
                suggestion.VatTreatment.Value;
        }
    }

    private void ApplySelectedCustomerPaymentTerms()
    {
        var customer =
            customers.FirstOrDefault(
                x => x.Id == model.CustomerId);

        var termType =
            customer?.DefaultSalesInvoicePaymentTermType
            ?? access?.Organisation.DefaultSalesInvoicePaymentTermType
            ?? PaymentTermType.DaysAfterDocumentDate;

        var termValue =
            customer?.DefaultSalesInvoiceDueDays
            ?? access?.Organisation.DefaultSalesInvoiceDueDays
            ?? 30;

        model.DueDate =
            PaymentTermCalculator.CalculateDueDate(
                model.IssueDate,
                termType,
                termValue);
    }
    private async Task IssueDateChanged()
    {
        ApplySelectedCustomerPaymentTerms();
        await CurrencyChanged();
    }

    private async Task CurrencyChanged()
    {
        if (access is null) return;
        model.ExchangeRateToBase = IsBaseCurrency
            ? 1m
            : await CurrencyService.FindRateAsync(
                userId,
                OrganisationId,
                model.Currency,
                model.IssueDate) ?? 0m;
    }
    private async Task<SalesInvoiceCodingSuggestion?> GetCustomerCodingSuggestionAsync(Guid customerId)
    {
        if (customerId == Guid.Empty) return null;
        var customer = customers.FirstOrDefault(x => x.Id == customerId);
        if (customer is null) return null;

        Guid? accountId = customer.DefaultSalesAccountId is Guid defaultAccountId && revenueAccounts.Any(x => x.Id == defaultAccountId)
            ? defaultAccountId
            : null;
        var vatTreatment = customer.DefaultSalesVatTreatment;
        var source = customer.DefaultSalesAccountId is not null || customer.DefaultSalesVatTreatment is not null
            ? "customer settings"
            : null;

        if (accountId is not null && vatTreatment is not null) return new SalesInvoiceCodingSuggestion(accountId, vatTreatment, source ?? "customer settings");

        var previousLine = await Db.SalesInvoiceLines.AsNoTracking()
            .Where(x => x.SalesInvoice.OrganisationId == OrganisationId && x.SalesInvoice.CustomerId == customerId)
            .OrderByDescending(x => x.SalesInvoice.SequenceNumber)
            .ThenByDescending(x => x.Id)
            .Select(x => new { x.RevenueAccountId, x.VatTreatment })
            .FirstOrDefaultAsync();
        if (previousLine is null)
        {
            if (accountId is null && vatTreatment is null) return null;
            return new SalesInvoiceCodingSuggestion(accountId, vatTreatment, source ?? "latest customer coding");
        }

        Guid? fallbackAccount = revenueAccounts.Any(x => x.Id == previousLine.RevenueAccountId) ? previousLine.RevenueAccountId : null;
        var fallbackVat = vatTreatment ?? previousLine.VatTreatment;
        var combinedSource = source is null
            ? "latest customer coding"
            : accountId is null || vatTreatment is null
                ? $"{source}; latest customer coding"
                : source;

        return new SalesInvoiceCodingSuggestion(accountId ?? fallbackAccount, fallbackVat, combinedSource);
    }
    private async Task Post()
    {
        status = null;
        if (model.Lines.Any(x => string.IsNullOrWhiteSpace(x.Description)))
        {
            status = "Enter a description for every invoice line before posting.";
            return;
        }
        if (model.Lines.Sum(x => x.Quantity * x.UnitPrice) <= 0)
        {
            status = "Enter an invoice amount greater than zero before posting.";
            return;
        }

        try
        {
            SalesInvoice invoice;
            if (InvoiceId is null)
            {
                invoice = await InvoiceService.CreateAndPostAsync(userId, Request());
            }
            else
            {
                await InvoiceService.UpdateDraftAsync(userId, InvoiceId.Value, Request());
                invoice = await InvoiceService.PostDraftAsync(userId, OrganisationId, InvoiceId.Value);
            }
            await PersistCustomerInvoiceDefaultsAsync(invoice.CustomerId);
            Navigation.NavigateTo($"o/{OrganisationId}/sales/{invoice.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or DomainException)
        {
            status = ex.Message;
        }
    }
    private async Task PersistCustomerInvoiceDefaultsAsync(Guid customerId)
    {
        if (model.Lines.Count == 0) return;
        var firstLine = model.Lines[0];
        await BusinessParties.LearnCustomerSalesDefaultsAsync(
            userId,
            new LearnCustomerSalesDefaultsRequest(
                OrganisationId,
                customerId,
                firstLine.RevenueAccountId,
                firstLine.VatTreatment));
    }
    private sealed class RecurringInvoiceEditorModel
{
    public RecurringSalesInvoiceFrequency Frequency { get; set; } =
        RecurringSalesInvoiceFrequency.Monthly;

    public DateOnly StartDate { get; set; } =
        DateOnly.FromDateTime(DateTime.Today);

    [Range(0, 3650)]
    public int DueDays { get; set; } = 30;
}

    private sealed class InvoiceEditorModel { public Guid CustomerId { get; set; } public Guid DivisionId { get; set; } public DateOnly IssueDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); public DateOnly DueDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(30)); [Required, StringLength(3, MinimumLength = 3)] public string Currency { get; set; } = "FJD"; [Range(typeof(decimal), "0.00000001", "9999999999", ErrorMessage = "Enter an exchange rate greater than zero before posting.")] public decimal ExchangeRateToBase { get; set; } = 1m; public List<InvoiceLineModel> Lines { get; set; } = []; }
    private IEnumerable<Project> EligibleProjects => projects.Where(x => x.DivisionId == model.DivisionId && x.Status is ProjectStatus.Active or ProjectStatus.OnHold);
    private IEnumerable<ProjectCostCode> CostCodes(Guid? projectId) => projects.SingleOrDefault(x => x.Id == projectId)?.CostCodes.Where(x => x.IsActive) ?? [];
    private Task ProjectChanged(InvoiceLineModel line) { line.ProjectCostCodeId = null; return Task.CompletedTask; }
    private Task DimensionChanged() { foreach (var line in model.Lines) { line.ProjectId = null; line.ProjectCostCodeId = null; } return Task.CompletedTask; }
    private sealed class InvoiceLineModel { [Required, StringLength(300)] public string Description { get; set; } = ""; [StringLength(80)] public string? CustomerPurchaseOrderNumber { get; set; } [Range(.0001, 999999999)] public decimal Quantity { get; set; } = 1; [Range(0, 999999999)] public decimal UnitPrice { get; set; } public VatTreatment VatTreatment { get; set; } = VatTreatment.Standard; public Guid RevenueAccountId { get; set; } public Guid? ProductItemId { get; set; } public Guid? ProjectId { get; set; } public Guid? ProjectCostCodeId { get; set; } }
    private sealed record SalesInvoiceCodingSuggestion(Guid? RevenueAccountId, VatTreatment? VatTreatment, string Source);
}
