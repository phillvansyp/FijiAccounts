@page "/receipts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout ReceiptAppLayout
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using FijiAccounts.Web.Api.Mobile.V1
@inject EmployeeReceiptService Receipts
@inject MobileApiV1Service Mobile
@inject AuthenticationStateProvider Authentication
@inject OrganisationSelectionService OrganisationSelection
@inject NavigationManager Navigation

<PageTitle>Receipts · Account Island</PageTitle>
<h1>@(owner ? "Your business at a glance" : "Your receipts")</h1>
<p>Capture a receipt. Keep the paperwork with the purchase.</p>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (message is not null) { <div class="alert alert-success" role="status">@message</div> }
@if (loading) { <p role="status">Loading your workspace…</p> }
else if (organisations.Count == 0)
{
    <section class="receipt-card"><h2>You’re ready to join</h2><p>Ask your organisation owner to add your verified email to receipt access. You will then be able to submit receipts without access to the company accounts.</p></section>
}
else if (org == Guid.Empty)
{
    <section class="receipt-card"><h2>Receipts are unavailable for the selected organisation</h2><p>Your company choice has not changed. Choose an organisation with receipt access below if you want to switch.</p>
        <label for="receipt-org">Organisation</label>
        <select id="receipt-org" class="form-select" @bind="org" @bind:after="SwitchOrganisation">
            <option value="@Guid.Empty">Choose an organisation</option>
            @foreach (var company in organisations) { <option value="@company.Id">@company.LegalName</option> }
        </select>
    </section>
}
else
{
    <label for="receipt-org">Organisation</label>
    <select id="receipt-org" class="form-select mb-4" @bind="org" @bind:after="SwitchOrganisation" disabled="@busy">
        @foreach (var company in organisations) { <option value="@company.Id">@company.LegalName</option> }
    </select>
    @if (owner && dashboard is not null)
    {
        <section class="receipt-metrics" aria-label="Owner overview">
            <div><span>Cash in accounts</span><strong>@dashboard.Currency @dashboard.CashPosition.ToString("N2")</strong></div>
            <div><span>Customers owe</span><strong>@dashboard.Currency @dashboard.Receivables.ToString("N2")</strong></div>
            <div><span>Bills to pay</span><strong>@dashboard.Currency @dashboard.Payables.ToString("N2")</strong></div>
            <div><span>Receipts to review</span><strong>@items.Count(x => x.Status == "Submitted")</strong></div>
        </section>
        <p><a href="/o/@org">Open accounts overview</a> · <a href="/o/@org/purchases">Purchases</a> · <a href="/o/@org/banking">Bank reconciliation</a></p>
    }
    <section class="receipt-card">
        <h2>Add a receipt</h2>
        <div class="receipt-grid">
            <div><label for="receipt-merchant">Merchant</label><input id="receipt-merchant" class="form-control" maxlength="160" @bind="merchant" disabled="@busy" /></div>
            <div><label for="receipt-date">Receipt date</label><InputDate id="receipt-date" class="form-control" @bind-Value="date" disabled="@busy" /></div>
            <div><label for="receipt-amount">@(amountsIncludeVat ? "Total paid (VAT included)" : "Amount excluding VAT")</label><InputNumber id="receipt-amount" class="form-control" @bind-Value="amount" min="0.01" step="0.01" disabled="@busy" /></div>
            <div><label for="receipt-currency">Currency</label><input id="receipt-currency" class="form-control" maxlength="3" @bind="currency" disabled="@busy" /></div>
            <div><label for="receipt-vat-basis">VAT basis</label><select id="receipt-vat-basis" class="form-select" @bind="amountsIncludeVat" disabled="@busy"><option value="true">VAT included</option><option value="false">VAT excluded</option></select></div>
            @if (!amountsIncludeVat)
            {
                <div><label for="receipt-vat-amount">VAT amount</label><InputNumber id="receipt-vat-amount" class="form-control" @bind-Value="vatAmount" min="0" step="0.01" disabled="@busy" /><small>Enter 0 if no VAT is charged.</small></div>
                <div><strong>Total paid: @currency @((amount + vatAmount).ToString("N2"))</strong></div>
            }
        </div>
        <label for="receipt-purpose">What was it for?</label><textarea id="receipt-purpose" class="form-control mb-3" maxlength="1000" @bind="purpose" disabled="@busy"></textarea>
        <label for="receipt-paid">Who paid?</label><select id="receipt-paid" class="form-select mb-3" @bind="personal" disabled="@busy"><option value="false">Company card or company money</option><option value="true">I paid personally — reimbursement requested</option></select>
        <label class="receipt-drop-zone @(busy ? "is-busy" : null)">
            <InputFile @key="requestId" id="receipt-file" class="receipt-drop-input" accept="image/jpeg,image/png,application/pdf" OnChange="ChooseFile" disabled="@busy" aria-label="Drop a receipt here or choose a photo, JPEG, PNG or PDF" />
            <strong>Drop a receipt here</strong>
            <span>or click to take a photo or choose a file</span>
            <small>JPEG, PNG or PDF · up to 10 MB</small>
        </label>
        @if (file is not null) { <p class="receipt-selected-file" role="status">Selected: @file.Name (@((file.Size / 1024.0).ToString("N0")) KB)</p> }
        <button class="btn btn-primary" disabled="@(busy || file is null)" @onclick="Submit">@(busy ? "Please wait…" : "Submit receipt")</button>
        <p class="receipt-hint">Submitting saves the receipt for review. It does not create a payment or post an expense.</p>
    </section>
    <section class="receipt-card">
        <div class="receipt-heading"><h2>@(owner ? "Receipt inbox" : "My submissions")</h2><button class="btn btn-outline-secondary" disabled="@busy" @onclick="Load">Refresh</button></div>
        @if (items.Count == 0) { <p>No receipts awaiting purchase posting. Posted receipts are available on their purchase bills.</p> }
        @foreach (var receipt in items)
        {
            <article class="receipt-item" @key="receipt.Id">
                <div class="receipt-heading"><h3>@receipt.Merchant</h3><strong>@receipt.Currency @receipt.TotalPaid.ToString("N2")</strong></div>
                <p>@receipt.ReceiptDate.ToString("dd MMM yyyy") · <span class="receipt-status">@receipt.Status</span> · @(receipt.PaidPersonally ? "Paid personally" : "Company paid")</p>
                <p class="receipt-hint">@(receipt.AmountsIncludeVat ? "VAT included" : $"VAT excluded: {receipt.Currency} {receipt.Amount:N2} + VAT {receipt.Currency} {receipt.VatAmount:N2}")</p>
                <p>@receipt.Purpose</p>
                @if (owner) { <p class="receipt-hint">Submitted by @(receipt.SubmittedByUserId == user ? "you" : submitters.GetValueOrDefault(receipt.SubmittedByUserId, "Previous contributor"))</p> }
                <a href="/api/receipts/@org/@receipt.Id/file">Download receipt</a>
                @if (owner && receipt.Status != "Returned" && matches.TryGetValue(receipt.Id, out var receiptMatches))
                {
                    <div class="receipt-matches">
                        <strong>Possible matches for @receipt.Currency @receipt.TotalPaid.ToString("N2")</strong>
                        @if (receiptMatches.Purchases.Count == 0 && receiptMatches.BankTransactions.Count == 0)
                        {
                            <p>@(receipt.PaidPersonally ? "No matching purchase bill found. Company bank transactions are not checked for personally paid receipts." : "No matching purchase bill or bank transaction found by amount and date.")</p>
                        }
                        @foreach (var match in receiptMatches.Purchases)
                        {
                            <p>Purchase bill: <a href="@match.Url">@match.Description</a> · @match.Date.ToString("dd MMM yyyy")</p>
                        }
                        @foreach (var match in receiptMatches.BankTransactions)
                        {
                            <p>Bank transaction: <a href="@match.Url">@match.Description</a> · @match.Date.ToString("dd MMM yyyy") · @(match.Reconciled ? "Reconciled" : "Not reconciled")</p>
                        }
                        <small>Exact total within seven days. Confirm the merchant and document before choosing a bill; a matching amount alone is not proof.</small>
                    </div>
                }
                @if (receipt.ReviewNote is not null) { <p><strong>Review note:</strong> @receipt.ReviewNote</p> }
                @if (receipt.LinkedSupplierBillId is Guid linkedBillId)
                {
                    <p class="receipt-hint">Attached to <a href="/o/@org/purchases/@linkedBillId">purchase bill</a>.</p>
                }
                else if (receipt.LinkedSupplierBillDraftId is Guid linkedDraftId)
                {
                    <p class="receipt-hint">In <a href="/o/@org/purchases?draft=@linkedDraftId">Purchases as a draft</a>. Review the supplier, VAT and expense account before posting.</p>
                }
                @if (owner && receipt.Status == "Submitted" && (receipt.SubmittedByUserId != user || canReviewOwnReceipt))
                {
                    <div class="receipt-review"><label for="note-@receipt.Id">Review note (required when returning)</label><input id="note-@receipt.Id" class="form-control" maxlength="1000" @bind="notes[receipt.Id]" disabled="@busy" />
                    @if (receipt.SubmittedByUserId == user) { <p class="receipt-hint">You are the only organisation owner. Your own approval is recorded in the audit trail; the purchase still needs coding and posting.</p> }
                    <label for="purchase-route-@receipt.Id">Where should this receipt go?</label>
                    <select id="purchase-route-@receipt.Id" class="form-select" @bind="purchaseDecisions[receipt.Id]" disabled="@busy">
                        <option value="">Choose a purchase action</option>
                        @if (matches.TryGetValue(receipt.Id, out var routingMatches))
                        {
                            @foreach (var candidate in routingMatches.Purchases)
                            {
                                <option value="@candidate.Id">Attach to @candidate.Description (@candidate.Date.ToString("dd MMM yyyy"))</option>
                            }
                        }
                        <option value="new">No existing bill matches — create a purchase draft</option>
                    </select>
                    <button class="btn btn-primary" disabled="@(busy || string.IsNullOrEmpty(purchaseDecisions[receipt.Id]))" @onclick="() => Approve(receipt)">@(purchaseDecisions[receipt.Id] == "new" ? "Approve and create purchase draft" : "Approve and attach to bill")</button>
                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="() => Review(receipt, false)">Return</button></div>
                }
                else if (owner && receipt.Status == "Submitted" && receipt.SubmittedByUserId == user)
                {
                    <p class="receipt-hint">Another organisation owner must review this receipt before it can become a purchase.</p>
                }
            </article>
        }
    </section>
    @if (owner)
    {
        <section class="receipt-card"><h2>Employee receipt access</h2><p>Add an employee’s verified Account Island email. This grants receipt submission only.</p><label for="receipt-employee">Employee email</label><input id="receipt-employee" class="form-control mb-3" type="email" @bind="employeeEmail" disabled="@busy" /><button class="btn btn-outline-primary" @onclick="AddEmployee" disabled="@busy">Add employee</button>
            @foreach (var contributor in contributors) { <div class="receipt-item receipt-heading"><span>@contributor.Value</span><button class="btn btn-outline-secondary" disabled="@busy" @onclick="() => RemoveEmployee(contributor.Key)">Remove access</button></div> }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "org")] public Guid? RequestedOrganisationId { get; set; }
    private string user = "", merchant = "", purpose = "", currency = "FJD", employeeEmail = "";
    private Guid org, requestId = Guid.NewGuid();
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today);
    private decimal amount, vatAmount;
    private bool owner, canReviewOwnReceipt, personal, amountsIncludeVat = true, busy, loading = true;
    private string? error, message;
    private IBrowserFile? file;
    private List<Organisation> organisations = [];
    private List<EmployeeReceipt> items = [];
    private Dictionary<Guid, ReceiptMatchSummary> matches = [];
    private Dictionary<Guid, string> purchaseDecisions = [];
    private Dictionary<Guid,string?> notes = [];
    private Dictionary<string,string> contributors = [];
    private Dictionary<string,string> submitters = [];
    private MobileDashboardResponse? dashboard;
    protected override async Task OnInitializedAsync()
    {
        user = (await Authentication.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        try
        {
            organisations = await Receipts.OrganisationsAsync(user);
            var preferredId = await OrganisationSelection.GetAsync(user);
            var selectedId = RequestedOrganisationId ?? preferredId;
            org = selectedId is Guid id
                ? organisations.FirstOrDefault(x => x.Id == id)?.Id ?? Guid.Empty
                : organisations.FirstOrDefault()?.Id ?? Guid.Empty;
            if (RequestedOrganisationId == org && org != Guid.Empty)
                await OrganisationSelection.SelectAsync(user, org);
            if (org != Guid.Empty) await Load();
        }
        finally { loading = false; }
    }
    private async Task Load()
    {
        owner = await Receipts.IsOwnerAsync(user, org);
        canReviewOwnReceipt = owner && await Receipts.CanReviewOwnReceiptAsync(user, org);
        contributors = owner ? await Receipts.ContributorsAsync(user, org) : [];
        submitters = owner ? await Receipts.SubmittersAsync(user, org) : [];
        // A posted purchase bill owns its supporting receipt; keep drafts visible until posting succeeds.
        items = (await Receipts.ListAsync(user, org))
            .Where(x => x.LinkedSupplierBillId is null).ToList();
        purchaseDecisions = items.Where(x => x.Status == "Submitted").ToDictionary(x => x.Id, _ => "");
        matches = [];
        if (owner)
            foreach (var receipt in items.Where(x => x.Status != "Returned"))
                matches[receipt.Id] = await Receipts.FindMatchesAsync(user, org, receipt);
        notes = items.ToDictionary(x => x.Id, x => x.ReviewNote);
        dashboard = owner ? await Mobile.GetDashboardAsync(user, org) : null;
        currency = organisations.Single(x => x.Id == org).BaseCurrency;
    }
    private async Task SwitchOrganisation()
    {
        if (!organisations.Any(x => x.Id == org)) return;
        await OrganisationSelection.SelectAsync(user, org);
        Navigation.NavigateTo($"/receipts?org={org}", forceLoad: true);
    }
    private void ChooseFile(InputFileChangeEventArgs args) { file = args.File; error = null; }
    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null; message = null;
        try { await action(); }
        catch (UnauthorizedAccessException) { error = "Your access has changed. Ask your organisation owner for help."; }
        catch (Exception ex) when (ex is InvalidOperationException or IOException) { error = ex.Message; }
        finally { busy = false; }
    }
    private Task Submit() => Run(async () => {
        if (file is null) return;
        using var stream = file.OpenReadStream(EmployeeReceiptService.MaximumBytes);
        using var buffer = new MemoryStream(); await stream.CopyToAsync(buffer);
        await Receipts.SubmitAsync(user, org, requestId, merchant, purpose, date, amount, currency.Trim().ToUpperInvariant(), personal, file.Name, buffer.ToArray(), amountsIncludeVat, amountsIncludeVat ? 0 : vatAmount);
        requestId = Guid.NewGuid(); file = null; merchant = purpose = ""; amount = vatAmount = 0; amountsIncludeVat = true;
        await Load(); message = "Receipt submitted. You can follow its review status below.";
    });
    private Task Approve(EmployeeReceipt receipt) => Run(async () => {
        var decision = purchaseDecisions[receipt.Id];
        if (decision == "new")
            await Receipts.ReviewAsync(user, org, receipt.Id, receipt.Version, true, notes[receipt.Id], createDraft: true);
        else if (Guid.TryParse(decision, out var billId))
            await Receipts.ReviewAsync(user, org, receipt.Id, receipt.Version, true, notes[receipt.Id], supplierBillId: billId);
        else
            throw new InvalidOperationException("Choose a matching purchase bill or create a purchase draft.");
        await Load(); message = decision == "new" ? "Receipt approved and added to Purchases as a draft. Review its coding and VAT before posting." : "Receipt approved and attached to the existing purchase bill.";
    });
    private Task Review(EmployeeReceipt receipt, bool approve) => Run(async () => {
        await Receipts.ReviewAsync(user, org, receipt.Id, receipt.Version, approve, notes[receipt.Id]);
        await Load(); message = "Receipt returned with your note.";
    });
    private Task AddEmployee() => Run(async () => { await Receipts.AddContributorAsync(user, org, employeeEmail); employeeEmail = ""; await Load(); message = "Receipt access added. The employee can sign in at /receipts."; });
    private Task RemoveEmployee(string employee) => Run(async () => { await Receipts.RemoveContributorAsync(user, org, employee); await Load(); message = "Receipt access removed. Submitted receipts remain available to owners."; });
}
