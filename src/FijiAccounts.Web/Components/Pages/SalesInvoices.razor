@page "/o/{OrganisationId:guid}/sales"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject SalesInvoiceService InvoiceService
@inject RecurringSalesInvoiceService RecurringInvoices
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Sales invoices</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Money in</p>
            <h1>Sales invoices</h1>
            <p class="page-intro">Create invoices, monitor what customers owe, and follow up overdue balances.</p>
        </div>
        <div>
            <a class="btn btn-outline-primary me-2" href="o/@OrganisationId/receipts">Record customer receipt</a>
            <a class="btn btn-primary" href="o/@OrganisationId/sales/new">+ New invoice</a>
        </div>
    </div>

    <div class="invoice-summary">
        <article><span>Total invoiced</span><strong>$@invoices.Sum(x => x.Total).ToString("N2")</strong><small>@invoices.Count invoice@(invoices.Count == 1 ? "" : "s")</small></article>
        <article><span>Outstanding</span><strong>$@invoices.Where(x => x.Status != InvoiceStatus.Voided).Sum(x => x.Total - x.AmountPaid - x.AmountCredited).ToString("N2")</strong><small>Awaiting payment</small></article>
        <article class="@(OverdueTotal > 0 ? "needs-attention" : null)"><span>Overdue</span><strong>$@OverdueTotal.ToString("N2")</strong><small>@OverdueCount invoice@(OverdueCount == 1 ? "" : "s") past due</small></article>
    </div>

    @if (canPost && customers.Count == 0)
    {
        <div class="alert alert-info">Add a customer before creating an invoice. <a href="o/@OrganisationId/contacts">Open contacts</a></div>
    }

    @if (canPost)
    {
        <section class="invoice-list mb-4">
            <div class="list-heading">
                <div>
                    <h2>Recurring invoices</h2>
                    <p>Active and paused customer invoice schedules</p>
                </div>

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="() => showRecurringInvoices = !showRecurringInvoices">
                    @(showRecurringInvoices
                        ? "Hide recurring invoices"
                        : "Open recurring invoices")
                </button>
            </div>

            @if (showRecurringInvoices)
            {
                <div class="d-flex justify-content-end gap-2 flex-wrap mb-3">
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="GenerateRecurringInvoices">
                        Generate due invoices
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="() => showAutomationSettings = !showAutomationSettings">
                        @(showAutomationSettings
                            ? "Hide automation settings"
                            : "Automation settings")
                    </button>
                </div>
            @if (recurringStatus is not null)
            {
                <div class="alert @recurringStatusClass">
                    @recurringStatus
                </div>
            }

            @if (latestAutomationRun is not null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            Automation status
                        </h5>

                        <p class="mb-1">
                            <strong>Last run:</strong>
                            @latestAutomationRun.RunDate.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-1">
                            <strong>Status:</strong>
                            @latestAutomationRun.Status
                        </p>

                        <p class="mb-1">
                            <strong>Generated:</strong>
                            @latestAutomationRun.GeneratedCount invoice@(latestAutomationRun.GeneratedCount == 1 ? "" : "s")
                        </p>

                        @if (latestAutomationRun.ErrorMessage is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0">
                                @latestAutomationRun.ErrorMessage
                            </div>
                        }
                    </div>
                </div>
            }

            @if (showAutomationSettings)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            Automation settings
                        </h5>

                        @if (automationStatus is not null)
                        {
                            <div class="alert alert-success">
                                @automationStatus
                            </div>
                        }

                        <label class="form-check mb-3">
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="automationEnabled" />
                            <span class="form-check-label">
                                Generate recurring invoices automatically
                            </span>
                        </label>

                        <div class="mb-3">
                            <label class="form-label">
                                Daily run time
                            </label>

                            <input type="time"
                                   class="form-control"
                                   value="@automationTime.ToString("HH:mm")"
                                   @onchange="AutomationTimeChanged" />
                        </div>

                        <p class="text-muted">
                            Timezone:
                            @access.Organisation.TimeZoneId
                        </p>

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="SaveAutomationSettings">
                            Save automation settings
                        </button>
                    </div>
                </div>
            }
            @if (recurringInvoices.Count == 0)
            {
                <div class="empty-state">
                    <strong>No recurring invoices yet</strong>
                    <span>Create a recurring invoice to automate regular customer billing.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Customer PO</th>
                            <th>Status</th>
                                <th>Frequency</th>
                                <th>Next invoice</th>
                                <th>Due terms</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recurringInvoices)
                            {
                                <tr>
                                    <td>@item.Customer.Name</td>

                                    <td>
                                        @if (item.Status == RecurringSalesInvoiceStatus.Active)
                                        {
                                            <span class="status-badge status-paid">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-draft">
                                                Paused
                                            </span>
                                        }
                                    </td>

                                    <td>@item.Frequency</td>

                                    <td>
                                        @item.NextInvoiceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.DueDays day@(item.DueDays == 1 ? "" : "s")
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="o/@OrganisationId/sales/recurring/@item.Id/edit">
                                                Edit
                                            </a>

                                            @if (item.Status == RecurringSalesInvoiceStatus.Active)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => PauseRecurringInvoice(item)">
                                                    Pause
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EndRecurringInvoice(item)">
                                                    End
                                                </button>
                                            }
                                            else if (item.Status == RecurringSalesInvoiceStatus.Paused)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success"
                                                        @onclick="() => ResumeRecurringInvoice(item)">
                                                    Resume
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EndRecurringInvoice(item)">
                                                    End
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @if (item.Generations.Count > 0)
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="small text-muted">
                                                <strong>Generated invoices</strong>
                                            </div>

                                            <ul class="mb-0 mt-2">
                                                @foreach (var generation in item.Generations.OrderByDescending(x => x.ScheduledDate))
                                                {
                                                    <li>
                                                        @generation.ScheduledDate.ToString("dd MMM yyyy")
                                                        —
                                                        <a href="o/@OrganisationId/sales/@generation.SalesInvoiceId">
                                                            @generation.SalesInvoice.InvoiceNumber
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            }
        </section>
    }
    <section class="invoice-list">
        <div class="list-heading">
            <div>
                <h2>Invoice activity</h2>
                <p>@FilteredInvoices.Count() of @invoices.Count invoice@(invoices.Count == 1 ? "" : "s")</p>
            </div>

            <div class="invoice-filters">
                <input class="form-control"
                       @bind="invoiceSearch"
                       @bind:event="oninput"
                       placeholder="Search invoice or customer" />

                <InputSelect class="form-select"
                             @bind-Value="invoiceStatusFilter">
                    <option value="">All statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                    <option value="PartPaid">Part paid</option>
                    <option value="Paid">Paid</option>
                    <option value="Overdue">Overdue</option>
                    <option value="Voided">Voided</option>
                </InputSelect>
            </div>
        </div>
        @if (invoices.Count == 0)
        {
            <div class="empty-state"><strong>No invoices yet</strong><span>Your posted invoices will appear here.</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Invoice")'>
                                    Invoice
                                </button>
                            </th>
                            <th>
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Date")'>
                                    Date
                                </button>
                            </th>
                            <th>
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Due")'>
                                    Due
                                </button>
                            </th>
                            <th>
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Customer")'>
                                    Customer
                                </button>
                            </th>
                            <th>Customer PO</th>
                            <th>Status</th>
                            <th class="text-end">Net</th>
                            <th class="text-end">VAT</th>
                            <th class="text-end">
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Total")'>
                                    Total
                                </button>
                            </th>
                            <th class="text-end">
                                <button type="button"
                                        class="btn btn-link p-0 fw-semibold"
                                        @onclick='() => SortInvoicesBy("Outstanding")'>
                                    Outstanding
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var invoice in SortedFilteredInvoices)
                    {
                        var overdue = IsOverdue(invoice);
                        <tr class="@(overdue ? "overdue-row" : null)">
                            <td><a href="o/@OrganisationId/sales/@invoice.Id"><strong>@invoice.InvoiceNumber</strong></a></td>
                            <td>@invoice.IssueDate.ToString("dd MMM yyyy")</td>
                            <td>@invoice.DueDate.ToString("dd MMM yyyy")</td>
                            <td>@invoice.Customer.Name</td>
                            <td class="customer-po-summary">
                                @FormatCustomerPurchaseOrders(invoice)
                            </td>
                            <td><span class="status-badge status-@invoice.Status.ToString().ToLowerInvariant()">@(overdue ? "Overdue" : invoice.Status)</span></td>
                            <td class="text-end">$@invoice.Subtotal.ToString("N2")</td>
                            <td class="text-end">$@invoice.VatTotal.ToString("N2")</td>
                            <td class="text-end">$@invoice.Total.ToString("N2")</td>
                            <td class="text-end outstanding">$@((invoice.Total - invoice.AmountPaid - invoice.AmountCredited).ToString("N2"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access;
    private string userId = string.Empty;
    private bool canPost;
    private bool showRecurringInvoices;
    private List<BusinessParty> customers = [];
    private List<SalesInvoice> invoices = [];
    private string invoiceSearch = string.Empty;
    private string invoiceStatusFilter = string.Empty;
    private string invoiceSort = "Invoice";
    private bool invoiceSortDescending = true;
    private List<RecurringSalesInvoice> recurringInvoices = [];
    private Guid[] accessibleDivisionIds = [];
    private RecurringInvoiceAutomationRun? latestAutomationRun;
    private bool automationEnabled;
    private TimeOnly automationTime;
    private bool showAutomationSettings;
    private string? automationStatus;
    private string? recurringStatus;
    private string recurringStatusClass = "alert-success";
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is null) return;

        automationEnabled =
            access.Organisation.RecurringInvoiceAutomationEnabled;

        automationTime =
            access.Organisation.RecurringInvoiceAutomationTime;

        canPost = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
        accessibleDivisionIds = await TenantAccess.ListAccessibleDivisionIdsAsync(userId, OrganisationId);
        customers = await Db.BusinessParties.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type & PartyType.Customer) != 0)
            .OrderBy(x => x.Name)
            .ToListAsync();

        await Reload();
    }

    private async Task Reload()
    {
        invoices =
            await Db.SalesInvoices
                .AsNoTracking()
                .Include(x => x.Customer)
                .Include(x => x.Lines)
                .Where(x => x.OrganisationId == OrganisationId && x.DivisionId != null && accessibleDivisionIds.Contains(x.DivisionId.Value))
                .OrderByDescending(x => x.SequenceNumber)
                .Take(100)
                .ToListAsync();

        recurringInvoices =
            await Db.RecurringSalesInvoices
                .AsNoTracking()
                .Include(x => x.Customer)
                .Include(x => x.Lines)
.Include(x => x.Generations)
    .ThenInclude(x => x.SalesInvoice)
.AsSplitQuery()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.Status != RecurringSalesInvoiceStatus.Ended)
                .OrderBy(x => x.Status)
                .ThenBy(x => x.NextInvoiceDate)
                .ToListAsync();

        latestAutomationRun =
            await Db.RecurringInvoiceAutomationRuns
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId)
                .OrderByDescending(x => x.RunDate)
                .FirstOrDefaultAsync();
    }

    private void AutomationTimeChanged(
        ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(
                e.Value?.ToString(),
                out var value))
        {
            automationTime = value;
        }
    }

    private async Task SaveAutomationSettings()
    {
        if (access is null)
        {
            return;
        }

        var organisation =
            await Db.Organisations
                .SingleAsync(
                    x => x.Id == OrganisationId);

        organisation.RecurringInvoiceAutomationEnabled =
            automationEnabled;

        organisation.RecurringInvoiceAutomationTime =
            automationTime;

        await Db.SaveChangesAsync();

        automationStatus =
            "Automation settings saved.";
    }
    private async Task GenerateRecurringInvoices()
    {
        try
        {
            var generated =
                await RecurringInvoices.GenerateDueAsync(
                    userId,
                    OrganisationId,
                    DateOnly.FromDateTime(DateTime.Today));

            await Reload();

            recurringStatusClass = "alert-success";
            recurringStatus =
                generated.Count == 0
                    ? "No recurring invoices are due."
                    : $"Generated {generated.Count} recurring invoice{(generated.Count == 1 ? "" : "s")}.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException or
            DomainException)
        {
            recurringStatusClass = "alert-danger";
            recurringStatus = ex.Message;
        }
    }

    private async Task PauseRecurringInvoice(
        RecurringSalesInvoice item)
    {
        try
        {
            await RecurringInvoices.SetActiveAsync(
                userId,
                OrganisationId,
                item.Id,
                false);

            await Reload();

            recurringStatusClass = "alert-success";
            recurringStatus = "Recurring invoice paused.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException)
        {
            recurringStatusClass = "alert-danger";
            recurringStatus = ex.Message;
        }
    }

    private async Task ResumeRecurringInvoice(
        RecurringSalesInvoice item)
    {
        try
        {
            await RecurringInvoices.SetActiveAsync(
                userId,
                OrganisationId,
                item.Id,
                true,
                DateOnly.FromDateTime(DateTime.Today));

            await Reload();

            recurringStatusClass = "alert-success";
            recurringStatus = "Recurring invoice resumed.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException)
        {
            recurringStatusClass = "alert-danger";
            recurringStatus = ex.Message;
        }
    }

    private async Task EndRecurringInvoice(
        RecurringSalesInvoice item)
    {
        try
        {
            await RecurringInvoices.EndAsync(
                userId,
                OrganisationId,
                item.Id);

            await Reload();

            recurringStatusClass = "alert-success";
            recurringStatus = "Recurring invoice ended.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException)
        {
            recurringStatusClass = "alert-danger";
            recurringStatus = ex.Message;
        }
    }
    private IEnumerable<SalesInvoice> FilteredInvoices =>
        invoices.Where(invoice =>
            (
                string.IsNullOrWhiteSpace(invoiceSearch) ||
                invoice.InvoiceNumber.Contains(
                    invoiceSearch,
                    StringComparison.OrdinalIgnoreCase) ||
                invoice.Customer.Name.Contains(
                    invoiceSearch,
                    StringComparison.OrdinalIgnoreCase) ||
                invoice.Lines.Any(line =>
                    !string.IsNullOrWhiteSpace(
                        line.CustomerPurchaseOrderNumber) &&
                    line.CustomerPurchaseOrderNumber.Contains(
                        invoiceSearch,
                        StringComparison.OrdinalIgnoreCase))
            ) &&
            (
                string.IsNullOrWhiteSpace(invoiceStatusFilter) ||
                (
                    invoiceStatusFilter == "Overdue"
                        ? IsOverdue(invoice)
                        : invoice.Status.ToString() == invoiceStatusFilter
                )
            ));

    private IEnumerable<SalesInvoice> SortedFilteredInvoices =>
        invoiceSort switch
        {
            "Date" => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(x => x.IssueDate)
                : FilteredInvoices.OrderBy(x => x.IssueDate),

            "Due" => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(x => x.DueDate)
                : FilteredInvoices.OrderBy(x => x.DueDate),

            "Customer" => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(x => x.Customer.Name)
                : FilteredInvoices.OrderBy(x => x.Customer.Name),

            "Total" => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(x => x.Total)
                : FilteredInvoices.OrderBy(x => x.Total),

            "Outstanding" => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(
                    x => x.Total - x.AmountPaid - x.AmountCredited)
                : FilteredInvoices.OrderBy(
                    x => x.Total - x.AmountPaid - x.AmountCredited),

            _ => invoiceSortDescending
                ? FilteredInvoices.OrderByDescending(x => x.SequenceNumber)
                : FilteredInvoices.OrderBy(x => x.SequenceNumber)
        };

    private void SortInvoicesBy(string sort)
    {
        if (invoiceSort == sort)
        {
            invoiceSortDescending =
                !invoiceSortDescending;

            return;
        }

        invoiceSort = sort;
        invoiceSortDescending = false;
    }

    private static string FormatCustomerPurchaseOrders(
        SalesInvoice invoice)
    {
        var purchaseOrders =
            invoice.Lines
                .Select(x => x.CustomerPurchaseOrderNumber?.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Cast<string>()
                .ToList();

        if (purchaseOrders.Count == 0)
        {
            return "—";
        }

        if (purchaseOrders.Count <= 2)
        {
            return string.Join(", ", purchaseOrders);
        }

        return
            $"{purchaseOrders[0]}, {purchaseOrders[1]} " +
            $"+{purchaseOrders.Count - 2} more";
    }

    private static bool IsOverdue(SalesInvoice invoice) =>
        invoice.Status is not InvoiceStatus.Paid and not InvoiceStatus.Voided and not InvoiceStatus.Credited &&
        invoice.DueDate < DateOnly.FromDateTime(DateTime.Today) &&
        invoice.AmountPaid + invoice.AmountCredited < invoice.Total;

    private int OverdueCount => invoices.Count(IsOverdue);
    private decimal OverdueTotal => invoices.Where(IsOverdue).Sum(x => x.Total - x.AmountPaid - x.AmountCredited);
}
