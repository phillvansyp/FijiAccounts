@page "/o/{OrganisationId:guid}/budgets"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject TenantAccessService TenantAccess
@inject BudgetService BudgetService
@inject BudgetReportingService BudgetReporting
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Budgets &middot; Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else
{
    <div class="page-heading">
        <div><p class="eyebrow">Planning</p><h1>Budget versus actual</h1><p class="page-intro">Compare organisation, branch, or division targets with posted ledger evidence and surface material adverse variances.</p></div>
        <button class="btn btn-outline-secondary no-print" onclick="window.print()">Print report</button>
    </div>

    <section class="report-controls no-print">
        <EditForm Model="filter" OnValidSubmit="Reload" FormName="budget-report-filter">
            <DataAnnotationsValidator />
            <div><label class="form-label">Reporting scope</label><InputSelect class="form-select" @bind-Value="filter.Scope">@foreach (var scope in scopeOptions) { <option value="@scope.Value">@scope.Label</option> }</InputSelect></div>
            <div><label class="form-label">Calendar year</label><InputNumber class="form-control" @bind-Value="filter.Year" /></div>
            <div><label class="form-label">Alert variance %</label><InputNumber class="form-control" @bind-Value="filter.AlertPercent" /></div>
            <div><label class="form-label">Minimum alert amount</label><InputNumber class="form-control" @bind-Value="filter.AlertAmount" /></div>
            <button class="btn btn-primary">Update report</button>
        </EditForm>
    </section>

    @if (message is not null)
    {
        <div class="alert @messageClass">@message</div>
    }

    @if (report is not null)
    {
        @if (canManage && report.Accounts.Count > 0)
        {
            <details class="setup-card mb-4">
                <summary><strong>+ Set monthly budget</strong></summary>
                <EditForm Model="model" OnValidSubmit="Save" FormName="set-budget" class="mt-3">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <div class="row">
                        <div class="col-md-4 mb-3"><label class="form-label">Revenue or expense account</label><InputSelect class="form-select" @bind-Value="model.AccountId">@foreach (var account in report.Accounts.Where(x => x.IsActive)) { <option value="@account.Id">@account.Code &mdash; @account.Name</option> }</InputSelect></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Budget scope</label><InputSelect class="form-select" @bind-Value="model.Scope">@foreach (var scope in scopeOptions) { <option value="@scope.Value">@scope.Label</option> }</InputSelect></div>
                        <div class="col-md-2 mb-3"><label class="form-label">Month</label><InputDate class="form-control" @bind-Value="model.Month" /></div>
                        <div class="col-md-2 mb-3"><label class="form-label">Budget amount</label><InputNumber class="form-control" @bind-Value="model.Amount" /></div>
                        <div class="col-md-1 d-flex align-items-end mb-3"><button class="btn btn-primary w-100">Save</button></div>
                    </div>
                </EditForm>
            </details>
        }

        <div class="row g-3 mb-4">
            <div class="col-md"><div class="detail-card h-100"><span class="eyebrow">Revenue budget</span><h2>$@report.RevenueBudget.ToString("N2")</h2></div></div>
            <div class="col-md"><div class="detail-card h-100"><span class="eyebrow">Actual revenue</span><h2>$@report.RevenueActual.ToString("N2")</h2></div></div>
            <div class="col-md"><div class="detail-card h-100"><span class="eyebrow">Expense budget</span><h2>$@report.ExpenseBudget.ToString("N2")</h2></div></div>
            <div class="col-md"><div class="detail-card h-100"><span class="eyebrow">Actual expenses</span><h2>$@report.ExpenseActual.ToString("N2")</h2></div></div>
            <div class="col-md"><div class="detail-card h-100"><span class="eyebrow">Variance alerts</span><h2 class="@(report.AlertCount > 0 ? "text-danger" : "text-success")">@report.AlertCount</h2></div></div>
        </div>

        <section class="detail-card mb-4">
            <div class="card-heading"><div><span class="eyebrow">Annual comparison</span><h2>@report.Year performance</h2><small>@report.ScopeLabel</small></div><span>@report.AccountsPerformance.Count accounts</span></div>
            @if (report.AccountsPerformance.Count == 0)
            {
                <div class="empty-state"><strong>No budget or actual activity</strong><span>Set a monthly budget or post transactions for this year.</span></div>
            }
            else
            {
                <div class="table-responsive"><table class="table">
                    <thead><tr><th>Account</th><th>Type</th><th class="text-end">Budget</th><th class="text-end">Actual</th><th class="text-end">Variance</th><th class="text-end">Adverse variance</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var row in report.AccountsPerformance)
                    {
                        <tr class="@(row.RequiresAttention ? "table-warning" : null)">
                            <td><a href="@LedgerLink(row.AccountId)"><strong>@row.Code</strong> &mdash; @row.Name</a></td>
                            <td>@row.Type</td>
                            <td class="text-end">$@row.Budget.ToString("N2")</td>
                            <td class="text-end">$@row.Actual.ToString("N2")</td>
                            <td class="text-end @(row.FavourableVariance < 0 ? "text-danger" : "text-success")">@row.FavourableVariance.ToString("+$0.00;-$0.00;$0.00")</td>
                            <td class="text-end">@(row.AdverseVariance == 0 ? "$0.00" : $"${row.AdverseVariance:N2}" + (row.AdverseVariancePercent is decimal percent ? $" / {percent:N1}%" : " / unbudgeted"))</td>
                            <td><span class="risk-badge @(row.RequiresAttention ? "high" : "current")">@(row.RequiresAttention ? "Review" : "On track")</span></td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr><th colspan="2">Net operating result</th><th class="text-end">$@report.BudgetProfit.ToString("N2")</th><th class="text-end">$@report.ActualProfit.ToString("N2")</th><th class="text-end">@((report.ActualProfit - report.BudgetProfit).ToString("+$0.00;-$0.00;$0.00"))</th><th colspan="2"></th></tr></tfoot>
                </table></div>
            }
        </section>

        <section class="detail-card">
            <div class="card-heading"><div><span class="eyebrow">Monthly trend</span><h2>Plan and performance</h2></div><span>Alerts require both configured thresholds</span></div>
            <div class="table-responsive"><table class="table">
                <thead><tr><th>Month</th><th class="text-end">Revenue budget</th><th class="text-end">Revenue actual</th><th class="text-end">Expense budget</th><th class="text-end">Expense actual</th><th class="text-end">Result variance</th><th>Status</th></tr></thead>
                <tbody>@foreach (var month in report.Months) { <tr class="@(month.RequiresAttention ? "table-warning" : null)"><td>@month.Month.ToString("MMM yyyy")</td><td class="text-end">$@month.RevenueBudget.ToString("N2")</td><td class="text-end">$@month.RevenueActual.ToString("N2")</td><td class="text-end">$@month.ExpenseBudget.ToString("N2")</td><td class="text-end">$@month.ExpenseActual.ToString("N2")</td><td class="text-end @(month.FavourableVariance < 0 ? "text-danger" : "text-success")">@month.FavourableVariance.ToString("+$0.00;-$0.00;$0.00")</td><td>@(month.RequiresAttention ? "Review" : "On track")</td></tr> }</tbody>
            </table></div>
        </section>
    }
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access;
    private string userId = "";
    private bool canManage;
    private BudgetPerformanceReport? report;
    private List<ScopeOption> scopeOptions = [];
    private FilterModel filter = new();
    private EntryModel model = new();
    private string? message;
    private string messageClass = "alert-success";

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is null) return;
        canManage = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
        var branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
        var hasFullDimensionAccess = await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId) is null;
        scopeOptions = [];
        if (hasFullDimensionAccess)
        {
            scopeOptions.Add(new("organisation", "Whole organisation", null, null));
        }
        foreach (var branch in branches)
        {
            if (hasFullDimensionAccess)
            {
                scopeOptions.Add(new($"branch:{branch.Id:N}", $"Branch: {branch.Code} — {branch.Name}", branch.Id, null));
            }
            scopeOptions.AddRange(branch.Divisions.Select(division => new ScopeOption(
                $"division:{division.Id:N}",
                $"Division: {branch.Code} — {division.Code} — {division.Name}",
                branch.Id,
                division.Id)));
        }
        if (scopeOptions.Count == 0)
        {
            messageClass = "alert-danger";
            message = "No reporting dimensions are available within your access.";
            return;
        }
        filter.Year = DateTime.Today.Year;
        filter.Scope = scopeOptions[0].Value;
        await Reload();
        Reset();
    }

    private async Task Reload()
    {
        try
        {
            var scope = SelectedScope(filter.Scope);
            report = await BudgetReporting.GetAsync(userId, new BudgetReportRequest(
                OrganisationId, filter.Year, filter.AlertPercent, filter.AlertAmount,
                scope.BranchId, scope.DivisionId));
            if (model.AccountId == Guid.Empty || !report.Accounts.Any(x => x.Id == model.AccountId && x.IsActive)) Reset();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            messageClass = "alert-danger";
            message = ex.Message;
        }
    }

    private void Reset() => model = new EntryModel
    {
        AccountId = report?.Accounts.FirstOrDefault(x => x.IsActive)?.Id ?? Guid.Empty,
        Month = new DateOnly(filter.Year, DateTime.Today.Month, 1),
        Scope = filter.Scope
    };

    private async Task Save()
    {
        try
        {
            var scope = SelectedScope(model.Scope);
            var budget = await BudgetService.SetAsync(userId,
                new(OrganisationId, model.AccountId, model.Month, model.Amount,
                    scope.BranchId, scope.DivisionId));
            messageClass = "alert-success";
            message = $"Budget saved for {budget.Month:MMM yyyy} — {scope.Label}.";
            filter.Scope = model.Scope;
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            messageClass = "alert-danger";
            message = ex.Message;
        }
    }

    private string LedgerLink(Guid accountId)
    {
        var scope = SelectedScope(filter.Scope);
        var dimensionQuery = scope.DivisionId is Guid divisionId
            ? $"&branch={scope.BranchId}&division={divisionId}"
            : scope.BranchId is Guid branchId ? $"&branch={branchId}" : "";
        return $"/o/{OrganisationId}/general-ledger?from={filter.Year}-01-01&to={filter.Year}-12-31&account={accountId}{dimensionQuery}";
    }

    private ScopeOption SelectedScope(string value) =>
        scopeOptions.Single(x => x.Value == value);

    private sealed class FilterModel
    {
        [Range(2000, 2200)] public int Year { get; set; }
        public string Scope { get; set; } = "organisation";
        [Range(0, 10000)] public decimal AlertPercent { get; set; } = 10m;
        [Range(0, 999999999)] public decimal AlertAmount { get; set; } = 100m;
    }

    private sealed class EntryModel
    {
        public Guid AccountId { get; set; }
        public DateOnly Month { get; set; }
        public string Scope { get; set; } = "organisation";
        [Range(0, 999999999)] public decimal Amount { get; set; }
    }

    private sealed record ScopeOption(
        string Value,
        string Label,
        Guid? BranchId,
        Guid? DivisionId);
}
