@page "/invite/{Token}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject OrganisationInvitationService Invitations
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Accept invitation</PageTitle>
<h1>Organisation invitation</h1>
@if (message is null) { <p>Checking your invitation...</p> } else { <div class="alert @alertClass">@message</div> }

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    private string? message; private string alertClass = "alert-danger";
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User); var email = user is null ? null : await UserManager.GetEmailAsync(user);
        var result = await Invitations.AcceptAsync(user!.Id, email, Token);
        alertClass = result.Succeeded ? "alert-success" : "alert-danger";
        message = result.Message;
    }
}
