@page "/o/{OrganisationId:guid}/purchases/{BillId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject PurchasingService Purchasing
@inject PurchaseApprovalPolicyService ApprovalPolicies
@inject SupplierBillAttachmentService BillAttachments
@inject SupplierCreditNoteService SupplierCredits
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>@(bill?.BillNumber ?? "Supplier bill") · Account Island</PageTitle>

@if (bill is null || access is null)
{
    <div class="alert alert-danger">
        Supplier bill not found or access denied.
    </div>
}
else
{
    <div class="bill-page">
        <div class="bill-heading no-print">
            <div>
                <a class="back-link" href="/o/@OrganisationId/purchases">← Supplier bills</a>
                <span class="eyebrow">Purchases</span>

                <div class="title-row">
                    <h1>Supplier Bill</h1>
                    <span class="bill-status status-@bill.Status.ToString().ToLowerInvariant()">
                        @bill.Status
                    </span>
                </div>

                <p class="heading-subtitle">@bill.BillNumber · @bill.Supplier.Name</p>
            </div>

                        <div class="bill-actions">

                <div class="attachment-menu-wrap">

                    @if (bill.Attachments.Count == 0)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary attachment-top-button"
                                disabled>
                            Attachments
                            <span class="attachment-count">0</span>
                        </button>
                    }
                    else if (bill.Attachments.Count == 1)
                    {
                        var attachment = bill.Attachments[0];

                        <a class="btn btn-outline-secondary attachment-top-button"
                           href="@AttachmentUrl(attachment)"
                           target="_blank">
                            Attachments
                            <span class="attachment-count">1</span>
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-outline-secondary attachment-top-button"
                                @onclick="ToggleAttachmentMenu">
                            Attachments
                            <span class="attachment-count">@bill.Attachments.Count</span>
                        </button>

                        @if (showAttachmentMenu)
                        {
                            <div class="attachment-menu">

                                <div class="attachment-menu-title">
                                    <strong>Attachments</strong>
                                    <span>
                                        @bill.Attachments.Count files
                                    </span>
                                </div>

                                @foreach (var attachment in bill.Attachments
                                    .OrderByDescending(x => x.UploadedAt))
                                {
                                    <div class="attachment-menu-row">

                                        <a class="attachment-menu-item"
                                           href="@AttachmentUrl(attachment)"
                                           target="_blank">

                                            <span class="attachment-menu-icon">
                                                @DocumentIcon(attachment.ContentType)
                                            </span>

                                            <span class="attachment-menu-copy">
                                                <strong>@attachment.FileName</strong>
                                                <small>
                                                    @FormatFileSize(attachment.OriginalSize)
                                                </small>
                                            </span>

                                        </a>

                                        @if (canManage)
                                        {
                                            <button type="button"
                                                    class="attachment-delete"
                                                    title="Delete attachment"
                                                    @onclick="() => DeleteDocument(attachment.Id)">
                                                ×
                                            </button>
                                        }

                                    </div>
                                }

                            </div>
                        }
                    }

                </div>

                @if (canManage &&
     AmountDue > 0 &&
     bill.Status is BillStatus.Posted or BillStatus.PartPaid)
{
    <button class="btn btn-primary"
            @onclick="OpenPayment">
        @(RequiresPaymentApproval ? "Request payment" : "Record payment")
    </button>
}

                @if (canManage && AmountDue > 0 && bill.Status != BillStatus.Voided)
                {
                    <button class="btn btn-outline-primary" @onclick="OpenCredit">
                        Supplier credit
                    </button>
                }

                @if (canManage &&
                     bill.Status == BillStatus.Posted &&
                     bill.AmountPaid == 0 &&
                     bill.AmountCredited == 0)
                {
                    <button class="btn btn-outline-danger" @onclick="() => showVoid = true">
                        Void bill
                    </button>
                }

                <button class="btn btn-outline-secondary" onclick="window.print()">
                    Print / Save PDF
                </button>
            </div>
        </div>

        @if (showPayment)
{
    <section class="action-card no-print">

        <div class="action-card-heading">
            <span class="eyebrow">Supplier payment</span>
            <h2>@(RequiresPaymentApproval ? "Request payment approval" : "Record payment")</h2>
            <p>
                @(RequiresPaymentApproval
                    ? "Submit this payment for independent approval. Nothing is posted until it is approved."
                    : "Record a payment against this supplier bill.")
            </p>
        </div>

        <div class="row g-3">

            <div class="col-md-2">
                <label class="form-label">Payment date</label>

                <InputDate class="form-control"
                           @bind-Value="paymentDate" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Bank account</label>

                <InputSelect class="form-select"
                             @bind-Value="paymentBankAccountId">

                    <option value="@Guid.Empty">
                        Choose bank account
                    </option>

                    @foreach (var account in bankAccounts)
                    {
                        <option value="@account.Id">
                            @account.Code - @account.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="col-md-3">
                <label class="form-label">Reference</label>

                <input class="form-control"
                       @bind="paymentReference"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Amount</label>

                <input type="number"
                       step="0.01"
                       class="form-control"
                       @bind="paymentAmount"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">

                <button class="btn btn-primary"
                        @onclick="RecordPayment">
                    @(RequiresPaymentApproval ? "Submit request" : "Record payment")
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="() => showPayment = false">
                    Cancel
                </button>

            </div>

        </div>

    </section>
}

        @if (showCredit)
        {
            <section class="action-card no-print">
                <div class="action-card-heading">
                    <span class="eyebrow">Supplier credit</span>
                    <h2>Post supplier credit note</h2>
                    <p>This reduces Accounts Payable and Fiji input VAT. The credit cannot exceed the unpaid balance.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Credit date</label>
                        <InputDate class="form-control" @bind-Value="creditDate" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Supplier reference / reason</label>
                        <InputText class="form-control" @bind-Value="creditReason" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Amount incl. VAT</label>
                        <InputNumber class="form-control" @bind-Value="creditAmount" />
                    </div>

                    @if (HasTrackedItems)
                    {
                        <div class="col-md-2 d-flex align-items-end">
                            <label class="tracked-check">
                                <InputCheckbox @bind-Value="returnTrackedItems" />
                                Return tracked stock
                            </label>
                        </div>
                    }

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button class="btn btn-primary" @onclick="PostCredit">Post credit</button>
                        <button class="btn btn-outline-secondary" @onclick="() => showCredit = false">Cancel</button>
                    </div>
                </div>
            </section>
        }

        @if (showVoid)
        {
            <section class="action-card danger-card no-print">
                <div class="action-card-heading">
                    <span class="eyebrow danger-eyebrow">Void bill</span>
                    <h2>Void supplier bill</h2>
                    <p>This posts a full reversing journal. Tracked stock received on this bill will be removed.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Void date</label>
                        <InputDate class="form-control" @bind-Value="voidDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Reason</label>
                        <InputText class="form-control" @bind-Value="voidReason" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button class="btn btn-danger" @onclick="VoidBill">Confirm void</button>
                        <button class="btn btn-outline-secondary" @onclick="() => showVoid = false">Cancel</button>
                    </div>
                </div>
            </section>
        }

        @if (status is not null)
        {
            <div class="alert @statusClass no-print">@status</div>
        }

        @if (documentError is not null)
        {
            <div class="alert alert-danger no-print">@documentError</div>
        }

        @if (uploadingDocument)
        {
            <div class="alert alert-info no-print">Uploading attachment…</div>
        }

        <article class="bill-document">
            <div class="bill-document-header">
                <div>
                    <span class="document-brand">Account Island</span>
                    <h2>@bill.Supplier.Name</h2>

                    @if (!string.IsNullOrWhiteSpace(bill.Supplier.Address))
                    {
                        <span class="supplier-detail">@bill.Supplier.Address</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(bill.Supplier.Tin))
                    {
                        <span class="supplier-detail">TIN: @bill.Supplier.Tin</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(bill.Supplier.VatRegistrationNumber))
                    {
                        <span class="supplier-detail">VAT: @bill.Supplier.VatRegistrationNumber</span>
                    }
                </div>

                <div class="document-identity">
                    <span>SUPPLIER BILL</span>
                    <strong>@bill.BillNumber</strong>
                    <span class="bill-status status-@bill.Status.ToString().ToLowerInvariant()">@bill.Status</span>
                </div>
            </div>

            <section class="bill-info-grid">
                <div class="info-panel">
                    <span class="info-label">ORGANISATION</span>
                    <strong>@access.Organisation.LegalName</strong>

                    @if (!string.IsNullOrWhiteSpace(access.Organisation.Tin))
                    {
                        <span>TIN: @access.Organisation.Tin</span>
                    }
                </div>

                <div class="info-panel">
                    <span class="info-label">SUPPLIER</span>
                    <strong>@bill.Supplier.Name</strong>

                    @if (!string.IsNullOrWhiteSpace(bill.SupplierReference))
                    {
                        <span>Reference: @bill.SupplierReference</span>
                    }
                    else
                    {
                        <span class="muted">No supplier reference</span>
                    }

                    @if (bill.Supplier.SupplierAccounts.Count > 0)
                    {
                        <span>Accounts: @string.Join(", ", bill.Supplier.SupplierAccounts.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label).Select(x => $"{x.Label}: {x.AccountNumber}"))</span>
                    }
                </div>

                <div class="info-panel bill-dates">
                    <div>
                        <span>Bill date</span>
                        <strong>@bill.BillDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <span>Due date</span>
                        <strong>@bill.DueDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <span>Currency</span>
                        <strong>@bill.Currency</strong>
                    </div>

                    @if (!string.Equals(bill.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase))
                    {
                        <div>
                            <span>Exchange rate</span>
                            <strong>1 @bill.Currency = @bill.ExchangeRateToBase.ToString("0.########") @access.Organisation.BaseCurrency</strong>
                        </div>
                    }

                    <div>
                        <span>Branch / division</span>
                        <strong>@bill.Branch?.Name / @bill.Division?.Name</strong>
                    </div>
                </div>
            </section>

            <section class="lines-section">
                <div class="section-heading">
                    <span class="eyebrow">Line items</span>
                    <h3>Bill details</h3>
                </div>

                <div class="table-responsive">
                    <table class="bill-lines">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Project</th>
                                <th class="number">Qty</th>
                                <th class="number">Unit price</th>
                                <th>Tax</th>
                                <th class="number">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var line in bill.Lines)
                            {
                                <tr>
                                    <td><strong>@line.Description</strong></td>
                                    <td>@ProjectLabel(line)</td>
                                    <td class="number">@line.Quantity.ToString("N2")</td>
                                    <td class="number">@bill.Currency @line.TransactionUnitPrice.ToString("N2")</td>
                                    <td><span class="tax-pill">@line.VatTreatment</span></td>
                                    <td class="number amount-cell">@bill.Currency @line.TransactionNetAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="bill-summary-area">
                <div class="ledger-info">
                    <span class="info-label">ACCOUNTING</span>
                    <strong>Posted to accounting ledger</strong>
                    <span>Journal @bill.PostedJournalId</span>
                </div>

                <div class="bill-totals">
                    <div><span>Subtotal</span><strong>@bill.Currency @bill.TransactionSubtotal.ToString("N2")</strong></div>
                    <div><span>@access.Organisation.TaxLabel</span><strong>@bill.Currency @bill.TransactionVatTotal.ToString("N2")</strong></div>
                    <div class="total-line"><span>Total</span><strong>@bill.Currency @bill.TransactionTotal.ToString("N2")</strong></div>
                    @if (!string.Equals(bill.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase))
                    {
                        <div><span>Posted value</span><strong>@access.Organisation.BaseCurrency @bill.Total.ToString("N2")</strong></div>
                    }
                    <div><span>Credits (base)</span><strong>@access.Organisation.BaseCurrency @bill.AmountCredited.ToString("N2")</strong></div>
                    <div><span>Paid (base)</span><strong>@access.Organisation.BaseCurrency @bill.AmountPaid.ToString("N2")</strong></div>
                    <div class="amount-due"><span>Amount due (base)</span><strong>@access.Organisation.BaseCurrency @AmountDue.ToString("N2")</strong></div>
                </div>
            </section>

            @if (canManage)
{
    <div class="bill-attachment mt-4 no-print">
        <label class="bill-drop-zone @(uploadingDocument ? "is-reading" : null)"
               @ref="documentDropZone"
               aria-busy="@uploadingDocument">
            <InputFile @key="documentInputKey"
                       id="supplierBillDocumentUpload"
                       class="bill-file-input"
                       OnChange="UploadDocuments"
                       accept=".pdf,.jpg,.jpeg,.png"
                       disabled="@uploadingDocument"
                       multiple />

            <strong>@(uploadingDocument ? "Uploading document..." : "Drop a supplier invoice or supporting document here")</strong>

            <span>
                or click to choose a file. Maximum 10 MB per file.
            </span>
        </label>

        @if (!string.IsNullOrWhiteSpace(documentError))
        {
            <div class="text-danger mt-2">
                @documentError
            </div>
        }
    </div>
}
        </article>

        @if (credits.Count > 0)
        {
            <section class="history-card no-print">
                <div class="history-heading">
                    <span class="eyebrow">Credit history</span>
                    <h2>Supplier credit notes</h2>
                </div>

                <div class="table-responsive">
                    <table class="table history-table">
                        <thead>
                            <tr>
                                <th>Credit note</th>
                                <th>Date</th>
                                <th>Reference / reason</th>
                                <th>Stock return</th>
                                <th class="text-end">Net</th>
                                <th class="text-end">VAT</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
<th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var credit in credits)
                            {
                                <tr>
                                    <td><strong>@credit.CreditNoteNumber</strong></td>
                                    <td>@credit.CreditDate.ToString("dd MMM yyyy")</td>
                                    <td>@credit.Reason</td>
                                    <td>@(credit.ReturnedTrackedItems ? "Yes" : "No")</td>
                                    <td class="text-end">$@credit.Subtotal.ToString("N2")</td>
                                    <td class="text-end">$@credit.VatTotal.ToString("N2")</td>
                                    <td class="text-end"><strong>$@credit.Total.ToString("N2")</strong></td>
                                    @if (creditReversals.TryGetValue(credit.Id, out var reversal))
{
    <td>
        <span class="badge text-bg-secondary">Reversed</span>
        <div class="small text-muted mt-1">
            @reversal.ReversalDate.ToString("dd MMM yyyy")
        </div>
    </td>

    <td class="text-end">
        <span class="text-muted small">
            @reversal.Reason
        </span>
    </td>
}
else
{
    <td>
        <span class="badge text-bg-success">Posted</span>
    </td>

    <td class="text-end">
        @if (canManage)
        {
            <button class="btn btn-sm btn-outline-danger"
                    @onclick="() => OpenCreditReversal(credit.Id)">
                Reverse
            </button>
        }
    </td>
}
</tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (reversingCreditId is not null)
{
    var selectedCredit =
        credits.FirstOrDefault(x => x.Id == reversingCreditId.Value);

    if (selectedCredit is not null)
    {
        <section class="action-card danger-card no-print">
            <div class="action-card-heading">
                <span class="eyebrow danger-eyebrow">
                    Reverse supplier credit
                </span>

                <h2>
                    Reverse @selectedCredit.CreditNoteNumber
                </h2>

                <p>
                    This posts a reversing journal and restores the supplier
                    bill balance. Any tracked-stock return created by the
                    credit note will also be reversed.
                </p>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Reversal date</label>
                    <InputDate class="form-control"
                               @bind-Value="creditReversalDate" />
                </div>

                <div class="col-md-5">
                    <label class="form-label">Reason</label>
                    <InputText class="form-control"
                               @bind-Value="creditReversalReason" />
                </div>

                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button class="btn btn-danger"
                            @onclick="ReverseCredit">
                        Post reversal
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="CancelCreditReversal">
                        Cancel
                    </button>
                </div>
            </div>
        </section>
    }
}

        @if (paymentApprovals.Count > 0)
        {
            <section class="history-card no-print">
                <div class="history-heading">
                    <span class="eyebrow">Payment controls</span>
                    <h2>Approval history</h2>
                </div>
                <div class="table-responsive">
                    <table class="table history-table">
                        <thead><tr><th>Requested</th><th>Date</th><th>Reference</th><th>Bank account</th><th class="text-end">Amount</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var approval in paymentApprovals)
                            {
                                <tr>
                                    <td>@approval.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@approval.PaymentDate.ToString("dd MMM yyyy")</td>
                                    <td>@approval.Reference</td>
                                    <td>@approval.BankAccount.Code &mdash; @approval.BankAccount.Name</td>
                                    <td class="text-end"><strong>$@approval.Amount.ToString("N2")</strong></td>
                                    <td><span class="payment-status approval-@approval.Status.ToString().ToLowerInvariant()">@approval.Status</span></td>
                                    <td class="text-end">
                                        @if (approval.Status == SupplierPaymentApprovalStatus.Pending &&
                                             approval.RequestedByUserId != userId &&
                                             approvalEligibility.GetValueOrDefault(approval.Id))
                                        {
                                            <button class="btn btn-sm btn-primary me-1" @onclick="() => ApprovePayment(approval.Id)">Approve</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => BeginRejectPayment(approval.Id)">Reject</button>
                                        }
                                        else if (approval.Status == SupplierPaymentApprovalStatus.Pending &&
                                                 approval.RequestedByUserId == userId)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => WithdrawPayment(approval.Id)">Withdraw</button>
                                        }
                                    </td>
                                </tr>
                                @if (rejectingApprovalId == approval.Id)
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="d-flex gap-2 align-items-center">
                                                <InputText class="form-control" @bind-Value="paymentRejectionReason" placeholder="Reason for rejection" />
                                                <button class="btn btn-danger text-nowrap" @onclick="RejectPayment">Confirm rejection</button>
                                                <button class="btn btn-outline-secondary" @onclick="() => rejectingApprovalId = null">Cancel</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (payments.Count > 0)
        {
            <section class="history-card no-print">
                <div class="history-heading">
                    <span class="eyebrow">Payment history</span>
                    <h2>Supplier payments</h2>
                </div>

                <div class="table-responsive">
                    <table class="table history-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Reference</th>
                                <th>Bank account</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in payments)
                            {
                                var reversed = reversedPaymentIds.Contains(payment.Id);

                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                    <td>@payment.Reference</td>
                                    <td><strong>@payment.BankAccount.Code — @payment.BankAccount.Name</strong></td>
                                    <td class="text-end">$@payment.Amount.ToString("N2")</td>
                                    <td>
                                        <span class="payment-status @(reversed ? "payment-reversed" : "payment-posted")">
                                            @(reversed ? "Reversed" : "Posted")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        @if (canManage && !reversed && bill.Status != BillStatus.Voided)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => OpenPaymentReversal(payment.Id)">
                                                Reverse
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (reversingPaymentId is not null)
                {
                    <div class="payment-reversal">
                        <h3>Reverse payment</h3>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Reversal date</label>
                                <InputDate class="form-control" @bind-Value="paymentReversalDate" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Reason</label>
                                <InputText class="form-control" @bind-Value="paymentReversalReason" />
                            </div>

                            <div class="col-md-3 d-flex align-items-end gap-2">
                                <button class="btn btn-danger" @onclick="ReversePayment">Confirm reversal</button>
                                <button class="btn btn-outline-secondary" @onclick="() => reversingPaymentId = null">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
}

<style>
    .bill-page { width: 100%; padding-bottom: 2rem; }
.bill-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 1rem; }
.back-link { display: inline-block; margin-bottom: .7rem; color: #0d6efd; text-decoration: none; font-size: .9rem; }
.back-link:hover { text-decoration: underline; }
