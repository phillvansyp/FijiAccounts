@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public Guid BillId { get; set; }

    private AccessibleOrganisation? access;
    private SupplierBill? bill;
    private List<SupplierPayment> payments = [];
    private List<SupplierPaymentApproval> paymentApprovals = [];
    private Dictionary<Guid, bool> approvalEligibility = [];
    private List<SupplierCreditNote> credits = [];
    private Dictionary<Guid, SupplierCreditNoteReversal> creditReversals = [];
    private HashSet<Guid> reversedPaymentIds = [];

    private string userId = "";
    private bool canManage;
    private bool showVoid;
    private bool showCredit;
    private bool showAttachmentMenu;
    private bool uploadingDocument;
    private bool documentDropZoneRegistered;
    private ElementReference documentDropZone;
    private Guid documentInputKey = Guid.NewGuid();

    private string? documentError;
    private string? status;
    private string statusClass = "alert-success";

    private DateOnly voidDate = DateOnly.FromDateTime(DateTime.Today);
    private string voidReason = "";

    private DateOnly creditDate = DateOnly.FromDateTime(DateTime.Today);
    private string creditReason = "";
    private decimal creditAmount;
    private bool returnTrackedItems;
    private Guid? reversingCreditId;
private DateOnly creditReversalDate =
    DateOnly.FromDateTime(DateTime.Today);
private string creditReversalReason = "";

    private Guid? reversingPaymentId;
    private DateOnly paymentReversalDate = DateOnly.FromDateTime(DateTime.Today);
    private string paymentReversalReason = "";

    private const long MaxDocumentSize = 10 * 1024 * 1024;

    private static readonly HashSet<string> AllowedDocumentTypes =
    [
        "application/pdf",
        "image/png",
        "image/jpeg"
    ];

    private bool showPayment;
private List<LedgerAccount> bankAccounts = [];

private DateOnly paymentDate =
    DateOnly.FromDateTime(DateTime.Today);

private string paymentReference = "";
private decimal paymentAmount;
private Guid paymentBankAccountId;
private Guid? rejectingApprovalId;
private string paymentRejectionReason = "";

    private bool RequiresPaymentApproval =>
        access?.Organisation.RequireSupplierPaymentApproval == true;

    private decimal AmountDue =>
        bill is null
            ? 0
            : bill.Total - bill.AmountPaid - bill.AmountCredited;

    private bool HasTrackedItems =>
        bill?.Lines.Any(x => x.ProductItem?.Kind == ProductKind.TrackedItem) == true;

    private static string ProjectLabel(SupplierBillLine line) => line.Project is null
        ? "—"
        : $"{line.Project.ProjectNumber}{(line.ProjectCostCode is null ? "" : $" / {line.ProjectCostCode.Code}")}";

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);

        if (access is null)
        {
            return;
        }

        canManage = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);

        await Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (canManage && bill is not null && !documentDropZoneRegistered)
        {
            await JS.InvokeVoidAsync(
                "fileDrop.register",
                documentDropZone,
                "supplierBillDocumentUpload");

            documentDropZoneRegistered = true;
        }
    }

    private void OpenPayment()
{
    showPayment = true;
    showCredit = false;
    showVoid = false;
    reversingPaymentId = null;
    reversingCreditId = null;

    paymentDate =
        DateOnly.FromDateTime(DateTime.Today);

    paymentReference = "";
    paymentAmount = AmountDue;

    paymentBankAccountId =
        bankAccounts.Count == 1
            ? bankAccounts[0].Id
            : Guid.Empty;
}

private async Task RecordPayment()
{
    try
    {
        var request = new SupplierPaymentRequest(
                OrganisationId,
                BillId,
                paymentDate,
                paymentReference,
                paymentAmount,
                paymentBankAccountId);

        if (RequiresPaymentApproval)
        {
            await Purchasing.RequestPaymentApprovalAsync(userId, request);
        }
        else
        {
            await Purchasing.PayBillAsync(userId, request);
        }

        showPayment = false;

        statusClass = "alert-success";
        status = RequiresPaymentApproval
            ? $"Supplier payment of ${paymentAmount:N2} submitted for independent approval."
            : $"Supplier payment of ${paymentAmount:N2} recorded.";

        await Reload();
    }
    catch (Exception ex)
        when (ex is InvalidOperationException
              or UnauthorizedAccessException)
    {
        statusClass = "alert-danger";
        status = ex.Message;
    }
}

    private async Task Reload()
    {
        var accessibleDivisionIds = await TenantAccess.ListAccessibleDivisionIdsAsync(userId, OrganisationId);
        bill = await Db.SupplierBills
            .AsNoTracking()
            .Include(x => x.Supplier)
                .ThenInclude(x => x.SupplierAccounts)
            .Include(x => x.Branch)
            .Include(x => x.Division)
            .Include(x => x.Lines)
            .ThenInclude(x => x.ProductItem)
            .Include(x => x.Lines)
            .ThenInclude(x => x.Project)
            .Include(x => x.Lines)
            .ThenInclude(x => x.ProjectCostCode)
            .Include(x => x.Attachments)
            .SingleOrDefaultAsync(
                x => x.Id == BillId &&
                     x.OrganisationId == OrganisationId &&
                     x.DivisionId != null &&
                     accessibleDivisionIds.Contains(x.DivisionId.Value));

        bankAccounts =
    await Db.LedgerAccounts
        .AsNoTracking()
        .Where(
            x =>
                x.OrganisationId == OrganisationId &&
                x.IsActive &&
                x.IsBankAccount)
        .OrderBy(x => x.Code)
        .ToListAsync();        

        payments = await Db.SupplierPayments
            .AsNoTracking()
            .Include(x => x.BankAccount)
            .Where(
                x => x.SupplierBillId == BillId &&
                     x.OrganisationId == OrganisationId)
            .OrderByDescending(x => x.PaymentDate)
            .ToListAsync();

        paymentApprovals = (await Db.SupplierPaymentApprovals
            .AsNoTracking()
            .Include(x => x.BankAccount)
            .Where(x => x.SupplierBillId == BillId && x.OrganisationId == OrganisationId)
            .ToListAsync())
            .OrderByDescending(x => x.RequestedAt)
            .ToList();
        approvalEligibility = [];
        foreach (var approval in paymentApprovals.Where(x => x.Status == SupplierPaymentApprovalStatus.Pending))
        {
            approvalEligibility[approval.Id] = await ApprovalPolicies.CanApproveAsync(
                userId, OrganisationId, approval.RequiredApproval);
        }

        credits = await Db.SupplierCreditNotes
            .AsNoTracking()
            .Where(
                x => x.SupplierBillId == BillId &&
                     x.OrganisationId == OrganisationId)
            .OrderByDescending(x => x.CreditDate)
            .ToListAsync();

        var creditIds = credits.Select(x => x.Id).ToArray();

creditReversals =
    (await Db.SupplierCreditNoteReversals
        .AsNoTracking()
        .Where(
            x => x.OrganisationId == OrganisationId &&
                 creditIds.Contains(x.SupplierCreditNoteId))
        .ToListAsync())
    .ToDictionary(x => x.SupplierCreditNoteId);

        var ids = payments.Select(x => x.Id).ToArray();

        reversedPaymentIds =
            (await Db.SupplierPaymentReversals
                .AsNoTracking()
                .Where(x => ids.Contains(x.SupplierPaymentId))
                .Select(x => x.SupplierPaymentId)
                .ToListAsync())
            .ToHashSet();
    }

    private void ToggleAttachmentMenu()
    {
        showAttachmentMenu = !showAttachmentMenu;
    }

    private async Task UploadDocuments(InputFileChangeEventArgs e)
    {
        if (bill is null)
        {
            return;
        }

        documentError = null;
        uploadingDocument = true;

        try
        {
            var files = e.GetMultipleFiles(10);

            if (files.Count == 0)
            {
                return;
            }

            foreach (var file in files)
            {
                if (file.Size <= 0)
                {
                    continue;
                }

                if (file.Size > MaxDocumentSize)
                {
                    throw new InvalidOperationException(
                        $"{file.Name} is larger than the 10 MB limit.");
                }

                var contentType =
                    string.IsNullOrWhiteSpace(file.ContentType)
                        ? "application/octet-stream"
                        : file.ContentType.ToLowerInvariant();

                if (!AllowedDocumentTypes.Contains(contentType))
                {
                    throw new InvalidOperationException(
                        $"{file.Name} is not a supported file type. Use PDF, JPG or PNG.");
                }

                await using var input = file.OpenReadStream(MaxDocumentSize);
                using var memory = new MemoryStream();

                await input.CopyToAsync(memory);

                var content = memory.ToArray();

                await BillAttachments.AddAsync(
                    userId,
                    OrganisationId,
                    BillId,
                    new SupplierBillAttachmentRequest(
                        Path.GetFileName(file.Name),
                        contentType,
                        file.Size,
                        content,
                        false));
            }

            showAttachmentMenu = false;
            statusClass = "alert-success";

            status =
                files.Count == 1
                    ? $"{files[0].Name} attached to {bill.BillNumber}."
                    : $"{files.Count} documents attached to {bill.BillNumber}.";

            await Reload();
        }
        catch (Exception ex)
        {
            documentError = $"Could not add document: {ex.Message}";
        }
        finally
        {
            uploadingDocument = false;
            documentInputKey = Guid.NewGuid();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!documentDropZoneRegistered)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("fileDrop.unregister", documentDropZone);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task DeleteDocument(Guid attachmentId)
    {
        documentError = null;

        try
        {
            var attachment = bill?.Attachments.SingleOrDefault(
                x => x.Id == attachmentId);
            if (attachment is null ||
                !await BillAttachments.DeleteAsync(
                    userId,
                    OrganisationId,
                    BillId,
                    attachmentId))
            {
                throw new InvalidOperationException(
                    "The attachment could not be found.");
            }

            var fileName = attachment.FileName;

            statusClass = "alert-success";
            status = $"{fileName} removed.";

            await Reload();

            if (bill?.Attachments.Count is null or <= 1)
            {
                showAttachmentMenu = false;
            }
        }
        catch (Exception ex)
        {
            documentError = $"Could not remove attachment: {ex.Message}";
        }
    }

    private string AttachmentUrl(
    SupplierBillAttachment attachment)
{
    return
        $"/api/o/{OrganisationId}" +
        $"/purchases/{BillId}" +
        $"/attachments/{attachment.Id}";
}

    private static string DocumentIcon(string contentType)
    {
        if (contentType.Equals(
                "application/pdf",
                StringComparison.OrdinalIgnoreCase))
        {
            return "PDF";
        }

        if (contentType.StartsWith(
                "image/",
                StringComparison.OrdinalIgnoreCase))
        {
            return "IMG";
        }

        return "FILE";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:N1} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:N0} KB";
        }

        return $"{bytes:N0} B";
    }

    private void OpenCredit()
    {
        showCredit = true;
        showVoid = false;

        creditDate = DateOnly.FromDateTime(DateTime.Today);
        creditReason = "";
        creditAmount = AmountDue;
        returnTrackedItems = HasTrackedItems;
    }

    private async Task PostCredit()
    {
        try
        {
            var result = await SupplierCredits.CreateAsync(
                userId,
                new(
                    OrganisationId,
                    BillId,
                    creditDate,
                    creditReason,
                    creditAmount,
                    returnTrackedItems));

            showCredit = false;
            statusClass = "alert-success";
            status =
                $"Supplier credit {result.CreditNoteNumber} posted for ${result.Total:N2}.";

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task VoidBill()
    {
        try
        {
            await Purchasing.VoidBillAsync(
                userId,
                OrganisationId,
                BillId,
                voidDate,
                voidReason);

            showVoid = false;
            statusClass = "alert-success";
            status =
                "Supplier bill voided and its ledger entries reversed.";

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private void OpenPaymentReversal(Guid id)
    {
        reversingPaymentId = id;
        paymentReversalReason = "";
        paymentReversalDate = DateOnly.FromDateTime(DateTime.Today);
        showVoid = false;
        showCredit = false;
    }

    private async Task ApprovePayment(Guid approvalId)
    {
        try
        {
            await Purchasing.ApprovePaymentAsync(userId, OrganisationId, approvalId);
            statusClass = "alert-success";
            status = "Supplier payment approved and posted.";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private void BeginRejectPayment(Guid approvalId)
    {
        rejectingApprovalId = approvalId;
        paymentRejectionReason = "";
    }

    private async Task RejectPayment()
    {
        if (rejectingApprovalId is null) return;
        try
        {
            await Purchasing.RejectPaymentAsync(
                userId, OrganisationId, rejectingApprovalId.Value, paymentRejectionReason);
            rejectingApprovalId = null;
            statusClass = "alert-success";
            status = "Supplier payment request rejected.";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task WithdrawPayment(Guid approvalId)
    {
        try
        {
            await Purchasing.WithdrawPaymentApprovalAsync(userId, OrganisationId, approvalId);
            statusClass = "alert-success";
            status = "Supplier payment request withdrawn.";
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task ReversePayment()
    {
        if (reversingPaymentId is null)
        {
            return;
        }

        try
        {
            await Purchasing.ReversePaymentAsync(
                userId,
                OrganisationId,
                reversingPaymentId.Value,
                paymentReversalDate,
                paymentReversalReason);

            reversingPaymentId = null;
            statusClass = "alert-success";
            status =
                "Supplier payment reversed. The bill is outstanding again.";

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private bool showAttachmentUploader;

private void ToggleAttachmentUploader()
{
    showAttachmentUploader = !showAttachmentUploader;
    showAttachmentMenu = false;
    documentError = null;
}

    private void OpenCreditReversal(Guid creditNoteId)
{
    reversingCreditId = creditNoteId;
    creditReversalDate =
        DateOnly.FromDateTime(DateTime.Today);
    creditReversalReason = "";

    showCredit = false;
    showVoid = false;
    reversingPaymentId = null;
}

private void CancelCreditReversal()
{
    reversingCreditId = null;
    creditReversalReason = "";
}

private async Task ReverseCredit()
{
    if (reversingCreditId is null)
    {
        return;
    }

    try
    {
        var credit =
            credits.Single(x => x.Id == reversingCreditId.Value);

        await SupplierCredits.ReverseAsync(
            userId,
            OrganisationId,
            reversingCreditId.Value,
            creditReversalDate,
            creditReversalReason);

        reversingCreditId = null;
        creditReversalReason = "";

        statusClass = "alert-success";
        status =
            $"Supplier credit {credit.CreditNoteNumber} reversed.";

        await Reload();
    }
    catch (Exception ex)
        when (ex is InvalidOperationException
              or UnauthorizedAccessException)
    {
        statusClass = "alert-danger";
        status = ex.Message;
    }
}
}
