@page "/o/{OrganisationId:guid}/quotes/{QuoteId:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject SalesQuoteService QuoteService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(quote?.QuoteNumber ?? "Quote") · Account Island</PageTitle>
@if (quote is null || access is null) { <div class="alert alert-danger">Quote not found or access denied.</div> }
else
{
    <div class="detail-actions no-print"><a href="o/@OrganisationId/quotes">← Quotes</a><div><button class="btn btn-outline-secondary" onclick="window.print()">Print / Save PDF</button>@if (canManage && DisplayStatus == QuoteStatus.Draft) { <button class="btn btn-outline-primary" @onclick="() => ChangeStatus(QuoteStatus.Sent)">Mark sent</button> }@if (canManage && DisplayStatus == QuoteStatus.Sent) { <button class="btn btn-outline-secondary" @onclick="() => ChangeStatus(QuoteStatus.Declined)">Decline</button><button class="btn btn-primary" @onclick="() => ChangeStatus(QuoteStatus.Accepted)">Accept quote</button> }@if (canManage && DisplayStatus == QuoteStatus.Accepted) { <button class="btn btn-primary" @onclick="Convert">Convert to invoice</button> }</div></div>
    @if (message is not null) { <div class="alert alert-danger no-print">@message</div> }
    <article class="invoice-document"><header><div><span class="document-brand">Account Island</span><h1>Quote</h1></div><div class="document-number"><strong>@quote.QuoteNumber</strong><span class="status-badge status-@DisplayStatus.ToString().ToLowerInvariant()">@DisplayStatus</span></div></header>
        <section class="invoice-meta"><div><small>From</small><strong>@access.Organisation.LegalName</strong><span>@access.Organisation.Tin</span></div><div><small>Prepared for</small><strong>@quote.Customer.Name</strong><span>@quote.Customer.Address</span><span>@quote.Customer.Tin</span></div><dl><dt>Quote date</dt><dd>@quote.QuoteDate.ToString("dd MMM yyyy")</dd><dt>Valid until</dt><dd>@quote.ExpiryDate.ToString("dd MMM yyyy")</dd><dt>Currency</dt><dd>@quote.Currency</dd></dl></section>
        <table class="document-lines"><thead><tr><th>Description</th><th class="number">Qty</th><th class="number">Unit price</th><th>Tax</th><th class="number">Amount</th></tr></thead><tbody>@foreach (var line in quote.Lines) { <tr><td>@line.Description</td><td class="number">@line.Quantity.ToString("N2")</td><td class="number">$@line.UnitPrice.ToString("N2")</td><td>@line.VatTreatment</td><td class="number">$@line.NetAmount.ToString("N2")</td></tr> }</tbody></table>
        <section class="document-totals"><div><span>Subtotal</span><strong>$@quote.Subtotal.ToString("N2")</strong></div><div><span>@access.Organisation.TaxLabel</span><strong>$@quote.VatTotal.ToString("N2")</strong></div><div class="grand-total"><span>Total</span><strong>$@quote.Total.ToString("N2")</strong></div></section>
        <footer>This quote is valid until @quote.ExpiryDate.ToString("dd MMM yyyy") and does not affect the accounting ledger.</footer>
    </article>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; } [Parameter] public Guid QuoteId { get; set; }
    private AccessibleOrganisation? access; private SalesQuote? quote; private string userId = ""; private bool canManage; private string? message;
    private QuoteStatus DisplayStatus => quote is not null && quote.ExpiryDate < DateOnly.FromDateTime(DateTime.Today) && quote.Status is QuoteStatus.Draft or QuoteStatus.Sent ? QuoteStatus.Expired : quote?.Status ?? QuoteStatus.Draft;
    protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is null) return; canManage = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId); await Reload(); }
    private async Task Reload() => quote = await Db.SalesQuotes.AsNoTracking().Include(x => x.Customer).Include(x => x.Lines).SingleOrDefaultAsync(x => x.Id == QuoteId && x.OrganisationId == OrganisationId);
    private async Task ChangeStatus(QuoteStatus status) { try { await QuoteService.SetStatusAsync(userId, OrganisationId, QuoteId, status); await Reload(); } catch (Exception ex) { message = ex.Message; } }
    private async Task Convert() { try { var invoice = await QuoteService.ConvertToDraftInvoiceAsync(userId, OrganisationId, QuoteId); Navigation.NavigateTo($"o/{OrganisationId}/sales/{invoice.Id}/edit"); } catch (Exception ex) { message = ex.Message; } }
}
