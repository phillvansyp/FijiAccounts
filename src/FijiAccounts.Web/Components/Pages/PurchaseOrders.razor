@page "/o/{OrganisationId:guid}/purchase-orders"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject PurchaseOrderService PurchaseOrderService
@inject ProjectService ProjectService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Purchase Orders - Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Money out</p>
            <h1>Purchase Orders</h1>
            <p class="page-intro">
                Create and track supplier orders before they become bills.
            </p>
        </div>

        <div>
            <button class="btn btn-primary"
        @onclick="StartNewOrder">
    + New purchase order
</button>
        </div>
    </div>

    @if (showOrderForm)
{
    <section class="setup-card mb-5">

        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2>New purchase order</h2>
                <p class="text-muted">
                    Create a supplier order before receiving the bill.
                </p>
            </div>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="() => showOrderForm = false">
                Cancel
            </button>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Supplier
            </label>

            <InputSelect class="form-select"
                         @bind-Value="orderModel.SupplierId">

                <option value="@Guid.Empty">
                    Choose supplier
                </option>

                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.Id">
                        @supplier.Name
                    </option>
                }

            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Branch and division</label>
            <InputSelect class="form-select" @bind-Value="orderModel.DivisionId" @bind-Value:after="OrderDimensionChanged">
                @foreach (var branch in branches)
                {
                    <optgroup label="@($"{branch.Code} — {branch.Name}")">
                        @foreach (var division in branch.Divisions.Where(x => x.IsActive))
                        {
                            <option value="@division.Id">@branch.Code — @branch.Name / @division.Code — @division.Name</option>
                        }
                    </optgroup>
                }
            </InputSelect>
        </div>

        <div class="row">

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Order date
                </label>

                <InputDate class="form-control"
                           @bind-Value="orderModel.OrderDate" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Expected date
                </label>

                <InputDate class="form-control"
                           @bind-Value="orderModel.ExpectedDate" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Supplier reference
                </label>

                <InputText class="form-control"
                           @bind-Value="orderModel.SupplierReference" />
            </div>

        </div>

        <div class="mb-3">
            <label class="form-label">
                Notes
            </label>

            <InputTextArea class="form-control"
                           @bind-Value="orderModel.Notes" />
        </div>

        <div class="border rounded p-3 mb-3">

            <h3 class="h5">
                Order line
            </h3>

            <div class="mb-3">
                <label class="form-label">
                    Description
                </label>

                <InputText class="form-control"
                           @bind-Value="lineModel.Description" />
            </div>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <label class="form-label">
                        Quantity
                    </label>

                    <InputNumber class="form-control"
                                 @bind-Value="lineModel.Quantity" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">
                        Unit price
                    </label>

                    <InputNumber class="form-control"
                                 @bind-Value="lineModel.UnitPrice" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Expense account
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="lineModel.ExpenseAccountId">

                        <option value="@Guid.Empty">
                            Choose account
                        </option>

                        @foreach (var account in expenseAccounts)
                        {
                            <option value="@account.Id">
                                @account.Code - @account.Name
                            </option>
                        }

                    </InputSelect>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Project</label>
                    <InputSelect class="form-select" @bind-Value="lineModel.ProjectId" @bind-Value:after="OrderProjectChanged">
                        <option value="">No project</option>
                        @foreach (var project in EligibleProjects)
                        {
                            <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Cost code</label>
                    <InputSelect class="form-select" @bind-Value="lineModel.ProjectCostCodeId" disabled="@(lineModel.ProjectId is null)">
                        <option value="">No cost code</option>
                        @foreach (var costCode in CostCodes(lineModel.ProjectId))
                        {
                            <option value="@costCode.Id">@costCode.Code &mdash; @costCode.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>

        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="SavePurchaseOrder">
            Save draft purchase order
        </button>

    </section>
}

    <div class="bill-summary">

        <article>
            <span>Total purchase orders</span>
            <strong>@orders.Count</strong>
            <small>All statuses</small>
        </article>

        <article>
            <span>Drafts</span>
            <strong>
                @orders.Count(
                    x => x.Status == PurchaseOrderStatus.Draft)
            </strong>
            <small>Not approved</small>
        </article>

        <article>
            <span>Approved</span>
            <strong>
                @orders.Count(
                    x => x.Status == PurchaseOrderStatus.Approved)
            </strong>
            <small>Ready for supplier</small>
        </article>

    </div>

    <section class="setup-card">

        <div class="list-heading">
            <div>
                <h2>Purchase orders</h2>
                <p>Orders waiting for fulfilment</p>
            </div>
        </div>

        @if (orders.Count == 0)
        {
            <div class="empty-state">
                <strong>No purchase orders yet</strong>
                <span>Create an order before receiving supplier invoices.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>PO number</th>
                            <th>Supplier</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in orders)
                        {
                            <tr>
                                <td>
                                    <a href="o/@OrganisationId/purchase-orders/@order.Id">
    <strong>
        @order.PurchaseOrderNumber
    </strong>
</a>
                                </td>

                                <td>
                                    @order.Supplier.Name
                                </td>

                                <td>
                                    @order.OrderDate
                                </td>

                                <td>
                                    @order.Status
                                </td>

                                <td class="text-end">
                                    $@order.Total.ToString("N2")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    private AccessibleOrganisation? access;

private string userId = string.Empty;

private List<PurchaseOrder> orders = [];

    private List<BusinessParty> suppliers = [];

    private List<LedgerAccount> expenseAccounts = [];

    private List<Branch> branches = [];

    private List<Project> projects = [];

private PurchaseOrderLineModel lineModel = new();

    private bool showOrderForm;

    private sealed class PurchaseOrderLineModel
{
    public string Description { get; set; } = "";

    public decimal Quantity { get; set; } = 1;

    public decimal UnitPrice { get; set; }

    public Guid ExpenseAccountId { get; set; }

    public Guid? ProjectId { get; set; }

    public Guid? ProjectCostCodeId { get; set; }
}

    private PurchaseOrderModel orderModel = new();

    private void StartNewOrder()
{
    showOrderForm = true;

    orderModel =
        new PurchaseOrderModel { DivisionId = DefaultDivisionId };
}

    private async Task SavePurchaseOrder()
{
    if (access is null)
    {
        return;
    }

    if (orderModel.SupplierId == Guid.Empty)
    {
        return;
    }

    if (lineModel.ExpenseAccountId == Guid.Empty)
    {
        return;
    }

    var request =
        new PurchaseOrderRequest(
            OrganisationId,
            orderModel.SupplierId,
            orderModel.OrderDate,
            orderModel.ExpectedDate,
            orderModel.SupplierReference,
            orderModel.Notes,
            [
                new PurchaseOrderLineRequest(
                    lineModel.Description,
                    lineModel.Quantity,
                    lineModel.UnitPrice,
                    lineModel.ExpenseAccountId,
                    ProjectId: lineModel.ProjectId,
                    ProjectCostCodeId: lineModel.ProjectCostCodeId)
            ],
            DivisionId: orderModel.DivisionId);

    await PurchaseOrderService.CreateDraftAsync(
        userId,
        request);

    orders =
        await Db.PurchaseOrders
            .AsNoTracking()
            .Include(x => x.Supplier)
            .Where(
                x =>
                    x.OrganisationId == OrganisationId)
            .OrderByDescending(
                x => x.SequenceNumber)
            .ToListAsync();

    showOrderForm = false;

    orderModel =
        new PurchaseOrderModel();

    lineModel =
        new PurchaseOrderLineModel();
}

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        userId =
    UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        suppliers =
            await Db.BusinessParties
                .AsNoTracking()
                .Where(
                    x =>
                        x.OrganisationId == OrganisationId &&
                        x.IsActive &&
                        (x.Type & PartyType.Supplier) != 0)
                .OrderBy(
                    x => x.Name)
                .ToListAsync();

        branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
        projects = await ProjectService.ListAsync(userId, OrganisationId);
        orderModel.DivisionId = DefaultDivisionId;

                        expenseAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(
                    x =>
                        x.OrganisationId == OrganisationId &&
                        x.IsActive &&
                        (x.Type == AccountType.Expense ||
                         x.Code == "1200" ||
                         x.Code == "1500"))
                .OrderBy(
                    x => x.Code)
                .ToListAsync();

        orders =
            await Db.PurchaseOrders
                .AsNoTracking()
                .Include(x => x.Supplier)
                .Where(
                    x =>
                        x.OrganisationId ==
                        OrganisationId)
                .OrderByDescending(
                    x => x.SequenceNumber)
                .ToListAsync();
    }

    private sealed class PurchaseOrderModel
    {
        public Guid SupplierId { get; set; }

        public DateOnly OrderDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? ExpectedDate { get; set; }

        public string SupplierReference { get; set; } = "";

        public string Notes { get; set; } = "";

        public Guid DivisionId { get; set; }
    }

    private Guid DefaultDivisionId => (branches.SelectMany(x => x.Divisions).FirstOrDefault(x => x.IsDefault) ?? branches.SelectMany(x => x.Divisions).FirstOrDefault())?.Id ?? Guid.Empty;
    private IEnumerable<Project> EligibleProjects => projects.Where(x => x.DivisionId == orderModel.DivisionId && x.Status is ProjectStatus.Active or ProjectStatus.OnHold);
    private IEnumerable<ProjectCostCode> CostCodes(Guid? projectId) => projects.SingleOrDefault(x => x.Id == projectId)?.CostCodes.Where(x => x.IsActive) ?? [];
    private Task OrderProjectChanged() { lineModel.ProjectCostCodeId = null; return Task.CompletedTask; }
    private Task OrderDimensionChanged() { lineModel.ProjectId = null; lineModel.ProjectCostCodeId = null; return Task.CompletedTask; }
}
