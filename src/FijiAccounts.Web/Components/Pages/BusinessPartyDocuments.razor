@page "/o/{OrganisationId:guid}/contacts/{PartyId:guid}/documents"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using FijiAccounts.Web.Components.Documents

@attribute [Authorize]

@inject ApplicationDbContext Db
@inject BusinessPartyDocumentService Documents
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider


<PageTitle>Documents · Account Island</PageTitle>

@if (party is null)
{
    <div class="alert alert-danger">
        Contact not found.
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Contact documents</p>
            <h1>@party.Name</h1>
            <p class="page-intro">
                Contracts, agreements, certificates and supporting documents.
            </p>
        </div>
    </div>

    <section class="setup-card mb-4">
        <h2>Add document</h2>

        <div class="mb-3">
            <label class="form-label">Document name</label>
            <InputText class="form-control"
                       @bind-Value="name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Type</label>
            <InputSelect class="form-select"
                         @bind-Value="type">
                @foreach (var item in Enum.GetValues<BusinessPartyDocumentType>())
                {
                    <option value="@item">@item</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Expiry date</label>
            <InputDate class="form-control"
                       @bind-Value="expiryDate" />
        </div>

        <ContactDocumentDropZone Prompt="Drop documents here"
                                 Multiple="true"
                                 OnChange="Upload" />

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="mt-3 alert alert-info">
                @message
            </div>
        }
    </section>

    <section class="setup-card">

        <h2>Documents</h2>

        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Uploaded</th>
                    <th>Original Size</th>
                    <th>Stored Size</th>
                    <th>Status</th>
                    <th>Expiry Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

            @foreach (var group in documents.GroupBy(x => x.Type))
            {
                <tr>
                    <td colspan="8">
                        <strong>@group.Key</strong>
                        <span class="text-muted">
                            (@group.Count())
                        </span>
                    </td>
                </tr>

                @foreach (var document in group)
                {
                    <BusinessPartyDocumentRow
                        Document="document"
                        OrganisationId="OrganisationId"
                        PartyId="PartyId"
                        RetainUntil="RetentionDate(document)"
                        RetentionRequired="recordRetentionRequired"
                        OnDelete="DeleteDocument" />
                }
            }

            </tbody>

        </table>

    </section>
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    [Parameter]
    public Guid PartyId { get; set; }

    private string userId = "";
    private BusinessParty? party;
    private List<BusinessPartyDocument> documents = [];

    private string name = "";
    private BusinessPartyDocumentType type =
        BusinessPartyDocumentType.Contract;

    private DateOnly? expiryDate;

    private string? message;
    private int financialYearEndMonth = 12;
    private int financialYearEndDay = 31;
    private bool recordRetentionRequired;

    protected override async Task OnInitializedAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        var tenant = await TenantAccess.FindAsync(userId, OrganisationId);
        if (tenant is null)
        {
            return;
        }

        financialYearEndMonth = tenant.Organisation.FinancialYearEndMonth;
        financialYearEndDay = tenant.Organisation.FinancialYearEndDay;
        recordRetentionRequired = tenant.Organisation.CountryCode.Equals(
            "FJ",
            StringComparison.OrdinalIgnoreCase);

        party =
            await Db.BusinessParties
                .SingleOrDefaultAsync(
                    x =>
                        x.Id == PartyId &&
                        x.OrganisationId == OrganisationId);

        if (party is not null)
        {
            documents =
                await Documents.GetForPartyAsync(
                    userId,
                    OrganisationId,
                    PartyId);
        }
    }


    private async Task Upload(InputFileChangeEventArgs args)
    {
        const int maximumFiles = 10;
        if (args.FileCount > maximumFiles)
        {
            message = $"Choose up to {maximumFiles} files at a time.";
            return;
        }

        var uploaded = 0;
        var errors = new List<string>();
        var organisationId = OrganisationId;
        var partyId = PartyId;
        var documentType = type;
        var documentName = name;
        var documentExpiryDate = expiryDate;
        foreach (var file in args.GetMultipleFiles(maximumFiles))
        {
            try
            {
                var request = await ContactDocumentDropZone.ReadAsync(
                    file, organisationId, partyId, documentType, documentName, documentExpiryDate);
                await Documents.AddAsync(userId, request);
                uploaded++;
            }
            catch (Exception ex)
            {
                errors.Add($"{file.Name}: {ex.Message}");
            }
        }

        if (uploaded > 0)
        {
            name = "";
            expiryDate = null;
            documents = await Documents.GetForPartyAsync(userId, organisationId, partyId);
        }

        message = $"{uploaded} of {args.FileCount} document(s) uploaded. {string.Join(" ", errors)}".TrimEnd();
    }


    private async Task DeleteDocument(Guid id)
    {
        try
        {
            var deleted = await Documents.DeleteAsync(
                userId,
                OrganisationId,
                id);

            if (!deleted)
            {
                message = "Document not found.";
                return;
            }

            documents = await Documents.GetForPartyAsync(
                userId,
                OrganisationId,
                PartyId);

            message = "Document deleted.";
        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
        }
    }

    private DateOnly RetentionDate(BusinessPartyDocument document) =>
        RecordRetentionPolicy.RetainUntil(
            DateOnly.FromDateTime(document.UploadedAtUtc.UtcDateTime),
            financialYearEndMonth,
            financialYearEndDay);
}
