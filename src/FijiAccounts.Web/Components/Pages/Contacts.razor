@page "/o/{OrganisationId:guid}/contacts"
@page "/o/{OrganisationId:guid}/contacts/{ContactView}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Domain.Accounting
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BusinessPartyService BusinessParties
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@PageHeading</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@PageHeading</h1>

        @if (canEdit)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="() => showAddContact = !showAddContact">
                @(showAddContact ? "Hide add contact" : "+ Add contact")
            </button>
        }
    </div>
    @if (status is not null)
    {
        <div class="alert @statusClass contact-status"
             role="status">
            <span>@status</span>
            <button type="button"
                    class="btn-close"
                    aria-label="Dismiss message"
                    @onclick="DismissStatus">
            </button>
        </div>
    }
    @if (canEdit && showAddContact) { <div class="setup-card"><h2>Add contact</h2><EditForm Model="model" OnValidSubmit="Create" FormName="add-contact"><DataAnnotationsValidator /><ValidationSummary />
        <div class="mb-3"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" /></div>
        <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Email</label><InputText class="form-control" @bind-Value="model.Email" /></div><div class="col-md-6 mb-3"><label class="form-label">TIN</label><InputText class="form-control" @bind-Value="model.Tin" /></div></div>
        <div class="mb-3"><label class="form-label">Type</label><InputSelect class="form-select" @bind-Value="model.Type"><option value="Customer">Customer</option><option value="Supplier">Supplier</option><option value="3">Customer and supplier</option></InputSelect></div>
        @if ((model.Type & PartyType.Customer) != 0) { <div class="row"><div class="col-md-4 mb-3"><label class="form-label">Default sales account</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesAccountId"><option value="">Choose when entering an invoice</option>@foreach (var account in salesAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Default sales VAT</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesVatTreatment"><option value="">Choose when entering an invoice</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Sales invoice payment terms</label><div class="input-group"><InputNumber class="form-control" @bind-Value="model.DefaultSalesInvoiceDueDays" /><span class="input-group-text">days</span></div><div class="form-text">Due date will default to this many days after the invoice date.</div></div></div> }
        @if ((model.Type & PartyType.Supplier) != 0) { <div class="row"><div class="col-md-8 mb-3"><label class="form-label">Default purchase account</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseAccountId"><option value="">Choose when entering a bill</option>@foreach (var account in purchaseAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Default VAT</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseVatTreatment"><option value="">Choose when entering a bill</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div></div> }
        <button class="btn btn-primary">Add contact</button>
    </EditForm></div> }
    @if (!string.IsNullOrWhiteSpace(searchTerm))
    {
        <div class="alert alert-info">
            Showing contacts matching "<strong>@searchTerm</strong>".
            <a href="o/@OrganisationId/contacts" class="ms-2">Clear</a>
        </div>
    }
    <div class="table-responsive mt-5">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Email</th>
                    <th>TIN</th>
                    <th>Payment terms</th>
                    <th>Sales defaults</th>
                    <th>Purchase defaults</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var party in parties)
                {
                    <tr>
                        <td>
                            <strong>@party.Name</strong>
                        </td>

                        <td>@party.Type</td>
                        <td>@party.Email</td>
                        <td>@party.Tin</td>

                        <td>
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                <span>
                                    @FormatPaymentTerms(
                                        party.DefaultSalesInvoicePaymentTermType,
                                        party.DefaultSalesInvoiceDueDays)
                                </span>
                            }
                            else
                            {
                                <span>
                                    @FormatPaymentTerms(
                                        party.DefaultSupplierBillPaymentTermType,
                                        party.DefaultSupplierBillDueDays)
                                </span>
                            }
                        </td>

                        <td>
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                @(party.DefaultSalesAccount is null
                                    ? "—"
                                    : $"{party.DefaultSalesAccount.Code} — {party.DefaultSalesAccount.Name}")

                                @if (party.DefaultSalesVatTreatment is not null)
                                {
                                    <span> · @party.DefaultSalesVatTreatment</span>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>
                            @if ((party.Type & PartyType.Supplier) != 0)
                            {
                                @(party.DefaultPurchaseAccount is null
                                    ? "—"
                                    : $"{party.DefaultPurchaseAccount.Code} — {party.DefaultPurchaseAccount.Name}")

                                @if (party.DefaultPurchaseVatTreatment is not null)
                                {
                                    <span> · @party.DefaultPurchaseVatTreatment</span>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td class="text-end">
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                <a class="btn btn-sm btn-outline-primary me-2"
                                   href="o/@OrganisationId/contacts/@party.Id/statement">
                                    Statement
                                </a>

                                @if (canEdit)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary me-2"
                                            @onclick="() => EditCustomerSettings(party)">
                                        Customer settings
                                    </button>

                                <a class="btn btn-sm btn-outline-secondary"
                                   href="o/@OrganisationId/contacts/@party.Id/documents">
                                    Documents
                                </a>
                                }
                            }

                            @if (canEdit &&
                                (party.Type & PartyType.Supplier) != 0)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => EditDefaults(party)">
                                    Supplier settings
                                </button>

                                <a class="btn btn-sm btn-outline-secondary ms-2"
                                   href="o/@OrganisationId/contacts/@party.Id/documents">
                                    Documents
                                </a>
                            }
                        </td>
                    </tr>

                    @if (editingCustomerPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="setup-card">
                                    <h3>@party.Name customer settings</h3>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales account
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerAccountId">
                                                <option value="">No default</option>
                                                @foreach (var account in salesAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales VAT
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerVatTreatment">
                                                <option value="">No default</option>
                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">@vat</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Sales invoice payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editingCustomerPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after invoice date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editingCustomerPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editingCustomerPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editingCustomerDueDays" />
                                                    <span class="input-group-text">
                                                        days
                                                    </span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Invoice due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveCustomerSettings">
                                            Save customer settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelCustomerSettings">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="setup-card">
                                    <h3>@party.Name purchase defaults</h3>

                                    <div class="row">
                                        <div class="col-md-8">
                                            <label class="form-label">
                                                Default purchase account
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseAccountId">
                                                <option value="">No default</option>

                                                @foreach (var account in purchaseAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default VAT
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseVatTreatment">
                                                <option value="">No default</option>

                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">
                                                        @vat
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4 mt-3">
                                            <label class="form-label">
                                                Supplier bill payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editDefaults.DefaultSupplierBillPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after bill date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editDefaults.DefaultSupplierBillDueDays" />
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Bill due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveDefaults">
                                            Save supplier settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelDefaults">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public string? ContactView { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    private AccessibleOrganisation? access;
    private string userId = string.Empty;
    private bool canEdit;
    private bool showAddContact;
    private List<BusinessParty> parties = [];
    private List<LedgerAccount> salesAccounts = [];
    private List<LedgerAccount> purchaseAccounts = [];
    private ContactModel model = new();
    private Guid? editingPartyId;
    private Guid? editingCustomerPartyId;
    private Guid? editingCustomerAccountId;
    private VatTreatment? editingCustomerVatTreatment;
    private int editingCustomerDueDays = 30;
    private PaymentTermType editingCustomerPaymentTermType = PaymentTermType.DaysAfterDocumentDate;
    private PurchaseDefaultsModel editDefaults = new();
    private string searchTerm = string.Empty;
    private string? status;
    private string statusClass = "alert-success";
    private void DismissStatus() => status = null;

    private string NormalizedView => ContactView?.ToLowerInvariant() switch
    {
        "customers" => "customers",
        "suppliers" => "suppliers",
        _ => "all"
    };
    private string PageHeading => NormalizedView switch
    {
        "customers" => "Customers",
        "suppliers" => "Suppliers",
        _ => "All contacts"
    };
    private static string NormalizeForSearch(string value) => value.Trim().ToUpperInvariant();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is not null)
        {
            canEdit = await TenantAccess.CanManageContactsAsync(userId, OrganisationId);
            searchTerm = Query?.Trim() ?? string.Empty;
            model = new ContactModel
        {
            Type = NormalizedView == "suppliers"
                ? PartyType.Supplier
                : PartyType.Customer,
            DefaultSalesInvoicePaymentTermType =
                access?.Organisation.DefaultSalesInvoicePaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSalesInvoiceDueDays =
                access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
            DefaultSupplierBillPaymentTermType =
                access?.Organisation.DefaultSupplierBillPaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSupplierBillDueDays =
                access?.Organisation.DefaultSupplierBillDueDays ?? 30
        };
            purchaseAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type == AccountType.Expense || x.Code == "1200" || x.Code == "1500")).OrderBy(x => x.Code).ToListAsync();
            salesAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.Type == AccountType.Revenue).OrderBy(x => x.Code).ToListAsync();
            await Reload();
        }
    }

    private async Task Reload()
    {
        var query = Db.BusinessParties.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive);
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalized = NormalizeForSearch(searchTerm);
            query = query.Where(x => x.Name.ToUpper().Contains(normalized) ||
                                     (x.Email ?? "").ToUpper().Contains(normalized) ||
                                     (x.Tin ?? "").ToUpper().Contains(normalized));
        }
        query = NormalizedView switch
        {
            "customers" => query.Where(x => (x.Type & PartyType.Customer) != 0),
            "suppliers" => query.Where(x => (x.Type & PartyType.Supplier) != 0),
            _ => query
        };
        parties = await query
            .Include(x => x.DefaultSalesAccount)
            .Include(x => x.DefaultPurchaseAccount)
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private async Task Create()
    {
        if (!canEdit) return;
        try
        {
            var party = await BusinessParties.CreateAsync(
                userId,
                new CreateBusinessPartyRequest(
                    OrganisationId,
                    model.Name,
                    model.Email,
                    model.Tin,
                    model.Type,
                    model.DefaultSalesAccountId,
                    model.DefaultSalesVatTreatment,
                    model.DefaultPurchaseAccountId,
                    model.DefaultPurchaseVatTreatment,
                    model.DefaultSalesInvoicePaymentTermType,
                    model.DefaultSalesInvoiceDueDays,
                    model.DefaultSupplierBillPaymentTermType,
                    model.DefaultSupplierBillDueDays));
            model = new ContactModel
            {
                Type = NormalizedView == "suppliers"
                    ? PartyType.Supplier
                    : PartyType.Customer,
                DefaultSalesInvoicePaymentTermType =
                    access?.Organisation.DefaultSalesInvoicePaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSalesInvoiceDueDays =
                    access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
                DefaultSupplierBillPaymentTermType =
                    access?.Organisation.DefaultSupplierBillPaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSupplierBillDueDays =
                    access?.Organisation.DefaultSupplierBillDueDays ?? 30
            };
            showAddContact = false;
            statusClass = "alert-success";
            status = $"{party.Name} added successfully.";
            await Reload();
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Contact was not added: {ex.Message}";
        }
    }

    private void EditCustomerSettings(BusinessParty party)
    {
        editingCustomerPartyId = party.Id;
        editingCustomerAccountId = party.DefaultSalesAccountId;
        editingCustomerVatTreatment = party.DefaultSalesVatTreatment;

        editingCustomerPaymentTermType =
            party.DefaultSalesInvoicePaymentTermType;

        editingCustomerDueDays =
            party.DefaultSalesInvoiceDueDays;
    }

    private void CancelCustomerSettings()
    {
        editingCustomerPartyId = null;
        editingCustomerAccountId = null;
        editingCustomerVatTreatment = null;
        editingCustomerDueDays = 30;
        editingCustomerPaymentTermType =
            PaymentTermType.DaysAfterDocumentDate;
    }

    private async Task SaveCustomerSettings()
    {
        if (editingCustomerPartyId is not Guid id ||
            !canEdit)
        {
            return;
        }

        if (editingCustomerDueDays < 0 ||
            editingCustomerDueDays > 365)
        {
            statusClass = "alert-danger";
            status = "Enter customer payment terms between 0 and 365.";
            return;
        }

        try
        {
            await BusinessParties.UpdateCustomerDefaultsAsync(
                userId,
                new UpdateCustomerDefaultsRequest(
                    OrganisationId,
                    id,
                    editingCustomerAccountId,
                    editingCustomerVatTreatment,
                    editingCustomerPaymentTermType,
                    editingCustomerDueDays));
            CancelCustomerSettings();
            statusClass = "alert-success";
            status = "Customer settings saved.";
            await Reload();
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Customer settings were not saved: {ex.Message}";
        }
    }

    private void EditDefaults(BusinessParty party) { editingPartyId = party.Id; editDefaults = new() { DefaultPurchaseAccountId = party.DefaultPurchaseAccountId, DefaultPurchaseVatTreatment = party.DefaultPurchaseVatTreatment, DefaultSupplierBillPaymentTermType = party.DefaultSupplierBillPaymentTermType, DefaultSupplierBillDueDays = party.DefaultSupplierBillDueDays }; }
    private void CancelDefaults() { editingPartyId = null; editDefaults = new(); }
    private async Task SaveDefaults()
    {
        if (editingPartyId is not Guid id || !canEdit) return;
        try
        {
            await BusinessParties.UpdateSupplierDefaultsAsync(
                userId,
                new UpdateSupplierDefaultsRequest(
                    OrganisationId,
                    id,
                    editDefaults.DefaultPurchaseAccountId,
                    editDefaults.DefaultPurchaseVatTreatment,
                    editDefaults.DefaultSupplierBillPaymentTermType,
                    editDefaults.DefaultSupplierBillDueDays));
            CancelDefaults();
            statusClass = "alert-success";
            status = "Supplier settings saved.";
            await Reload();
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Supplier settings were not saved: {ex.Message}";
        }
    }

    private class PurchaseDefaultsModel { public Guid? DefaultSalesAccountId { get; set; } public VatTreatment? DefaultSalesVatTreatment { get; set; } public Guid? DefaultPurchaseAccountId { get; set; } public VatTreatment? DefaultPurchaseVatTreatment { get; set; } public PaymentTermType DefaultSalesInvoicePaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSalesInvoiceDueDays { get; set; } = 30; public PaymentTermType DefaultSupplierBillPaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSupplierBillDueDays { get; set; } = 30; }
    private static string FormatPaymentTerms(
        PaymentTermType type,
        int value)
    {
        return type switch
        {
            PaymentTermType.DaysAfterDocumentDate =>
                $"{value} days",

            PaymentTermType.DayOfFollowingMonth =>
                $"{value}th of following month",

            PaymentTermType.EndOfCurrentMonth =>
                "End of current month",

            PaymentTermType.EndOfFollowingMonth =>
                "End of following month",

            _ =>
                $"{value} days"
        };
    }
    private sealed class ContactModel : PurchaseDefaultsModel
    {
        [Required, StringLength(160)] public string Name { get; set; } = string.Empty;
        [EmailAddress, StringLength(320)] public string? Email { get; set; }
        [StringLength(32)] public string? Tin { get; set; }
        public PartyType Type { get; set; } = PartyType.Customer;
    }
}
