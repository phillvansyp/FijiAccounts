@page "/o/{OrganisationId:guid}/contacts"
@page "/o/{OrganisationId:guid}/contacts/{ContactView}"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using FijiAccounts.Web.Components.Documents
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Domain.Accounting
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BusinessPartyService BusinessParties
@inject TransactionCurrencyService CurrencyService
@inject XeroReportingService XeroReports
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@PageHeading</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="contacts-heading">
        <h1 class="mb-0">@PageHeading</h1>

        @if (canEdit)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="() => showAddContact = !showAddContact">
                @(showAddContact ? "Hide add contact" : "+ Add contact")
            </button>
        }
    </div>
    @if (xeroGroups.Count > 0)
    {
        <details class="setup-card mb-3">
            <summary>Xero contact groups (@xeroGroups.Count)</summary>
            @foreach (var group in xeroGroups)
            {
                <details class="mt-2" @key="group.ContactGroupId">
                    <summary>@group.Name (@group.Contacts.Length)</summary>
                    <ul class="mb-2">
                        @foreach (var member in group.Contacts.OrderBy(contact => contact.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <li @key="member.ContactId">@member.Name</li>
                        }
                    </ul>
                </details>
            }
        </details>
    }
    @if (status is not null)
    {
        <div class="alert @statusClass contact-status"
             role="status">
            <span>@status</span>
            <button type="button"
                    class="btn-close"
                    aria-label="Dismiss message"
                    @onclick="DismissStatus">
            </button>
        </div>
    }
    @if (canEdit && showAddContact) { <div class="setup-card"><h2>Add contact</h2><EditForm Model="model" OnValidSubmit="Create" FormName="add-contact"><DataAnnotationsValidator /><ValidationSummary />
        <div class="mb-3"><label class="form-label">Name</label><input class="form-control" @bind="model.Name" @bind:event="oninput" /></div>
        <div class="row"><div class="col-md-4 mb-3"><label class="form-label">Primary email</label><input class="form-control" @bind="model.Email" @bind:event="oninput" /></div><div class="col-md-4 mb-3"><label class="form-label">Accounts email</label><input class="form-control" @bind="model.AccountsEmail" @bind:event="oninput" /><div class="form-text">Invoices and account documents are sent here when provided.</div></div><div class="col-md-4 mb-3"><label class="form-label">@TaxIdentifierLabel</label><input class="form-control" @bind="model.Tin" @bind:event="oninput" /></div></div>
        <div class="mb-3"><label class="form-label">Address</label><textarea class="form-control" rows="2" @bind="model.Address" @bind:event="oninput"></textarea>@if (access.Organisation.CountryCode == "FJ") { <div class="form-text">Required when issuing a full Fiji tax invoice.</div> }</div>
        <div class="mb-3"><label class="form-label">Type</label><select class="form-select" @bind="contactTypeSelection" disabled="@(readingContract || creatingContact)"><option value="Customer">Customer</option><option value="Supplier">Supplier</option><option value="Both">Customer and supplier</option></select></div>
        @if ((model.Type & PartyType.Customer) != 0) { <div class="row"><div class="col-md-3 mb-3"><label class="form-label">Default sales account</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesAccountId"><option value="">Choose when entering an invoice</option>@foreach (var account in salesAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default sales @access.Organisation.TaxLabel</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesVatTreatment"><option value="">Choose when entering an invoice</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default invoice currency</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesCurrency">@foreach (var currency in currencies.Where(x => x.IsActive)) { <option value="@currency.Code">@currency.Code - @currency.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Sales invoice payment terms</label><div class="input-group"><input type="number" step="1" class="form-control" @bind="model.DefaultSalesInvoiceDueDays" @bind:event="oninput" /><span class="input-group-text">days</span></div><div class="form-text">Due date will default to this many days after the invoice date.</div></div></div> }
        @if ((model.Type & PartyType.Supplier) != 0)
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Supplier account number</label>
                    <input class="form-control" @bind="model.SupplierAccountNumber" @bind:event="oninput" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@access.Organisation.TaxLabel registration number</label>
                    <input class="form-control" @bind="model.VatRegistrationNumber" @bind:event="oninput" />
                </div>
            </div>
            <div class="row"><div class="col-md-5 mb-3"><label class="form-label">Default purchase account</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseAccountId"><option value="">Choose when entering a bill</option>@foreach (var account in purchaseAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default @access.Organisation.TaxLabel</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseVatTreatment"><option value="">Choose when entering a bill</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Default bill currency</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseCurrency">@foreach (var currency in currencies.Where(x => x.IsActive)) { <option value="@currency.Code">@currency.Code - @currency.Name</option> }</InputSelect></div></div>
        }
        @if ((model.Type & PartyType.Supplier) != 0)
        {
            <div class="mb-3">
                <h3 class="h6">Supplier contract <span class="text-muted fw-normal">(optional)</span></h3>
                <ContactDocumentDropZone Prompt="Drop a supplier contract here"
                                         Disabled="creatingContact"
                                         OnChange="SelectContract" />
                @if (initialContract is not null || contractError is not null)
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        @if (contractError is not null)
                        {
                            <span class="text-danger" role="alert">@contractError</span>
                        }
                        else
                        {
                            <span role="status">@initialContract?.FileName will be saved with this supplier.</span>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                disabled="@(readingContract || creatingContact)"
                                @onclick="ClearContract">Clear</button>
                    </div>
                }
            </div>
        }
        <button class="btn btn-primary" disabled="@(readingContract || creatingContact || contractError is not null)">Add contact</button>
    </EditForm></div> }

    <section class="contacts-directory" aria-label="@PageHeading">
        <div class="contacts-toolbar">
            <nav class="contacts-tabs" aria-label="Contact type">
                <a class="@(NormalizedView == "all" ? "active" : null)" aria-current="@(NormalizedView == "all" ? "page" : null)" href="o/@OrganisationId/contacts">All contacts</a>
                <a class="@(NormalizedView == "customers" ? "active" : null)" aria-current="@(NormalizedView == "customers" ? "page" : null)" href="o/@OrganisationId/contacts/customers">Customers</a>
                <a class="@(NormalizedView == "suppliers" ? "active" : null)" aria-current="@(NormalizedView == "suppliers" ? "page" : null)" href="o/@OrganisationId/contacts/suppliers">Suppliers</a>
                <a class="@(NormalizedView == "archive" ? "active" : null)" aria-current="@(NormalizedView == "archive" ? "page" : null)" href="o/@OrganisationId/contacts/archive">Archive</a>
            </nav>
            <form class="contacts-search" @onsubmit="SearchContacts" @onsubmit:preventDefault>
                <label class="visually-hidden" for="contact-search">Search contacts</label>
                <input id="contact-search" type="search" class="form-control" placeholder="Search name, email or account" @bind="searchInput" @bind:event="oninput" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a class="contact-clear" href="@ContactsLink(1, "")">Clear</a>
                }
            </form>
        </div>
        <nav class="d-flex flex-wrap gap-3 px-3 pt-2 small" aria-label="Invoice and bill registers">
            <a href="o/@OrganisationId/sales">All invoices</a>
            <a href="o/@OrganisationId/purchases">All bills</a>
            <a href="o/@OrganisationId/reports/aging/receivables">Customer balances</a>
            <a href="o/@OrganisationId/reports/aging/payables">Supplier balances</a>
        </nav>
        <div class="contacts-results" role="status">
            @if (totalContacts == 0)
            {
                <span>No contacts found.</span>
            }
            else
            {
                <span>@FirstContact–@LastContact of @totalContacts.ToString("N0") contacts</span>
            }
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <span>Matching “@searchTerm”</span>
            }
            @if (NormalizedView == "archive")
            {
                <span>Archived contacts and contacts with no activity for 24 months.</span>
            }
            else if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <span>Includes archived contacts.</span>
            }
        </div>
        <div class="contacts-table-scroll">
        <table class="table contacts-table">
            <thead>
                <tr>
                    <th scope="col">Contact</th>
                    <th scope="col">Email</th>
                    <th scope="col">Payment terms</th>
                    <th scope="col" class="contact-actions-heading">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (parties.Count == 0)
                {
                    <tr><td colspan="4" class="contacts-empty">@(string.IsNullOrWhiteSpace(searchTerm) ? "Contacts will appear here when added." : "Try a different name, email or account number.")</td></tr>
                }
                @foreach (var party in parties)
                {
                    <tr @key="party.Id" class="contact-row">
                        <td>
                            <button type="button" class="contact-name" @onclick="() => ToggleDetails(party.Id)" aria-expanded="@(expandedPartyId == party.Id)" aria-controls="contact-details-@party.Id">@party.Name</button>
                            <a class="small" href="o/@OrganisationId/contacts/@party.Id/balances">Invoices &amp; balances</a>
                            <div class="contact-types">
                                @if (archivedIds.Contains(party.Id))
                                {
                                    <span class="contact-type">Archived</span>
                                }
                                @if (party.Type == 0)
                                {
                                    <span class="contact-muted">No trading role</span>
                                }
                                @if ((party.Type & PartyType.Customer) != 0)
                                {
                                    <span class="contact-type customer">Customer</span>
                                }
                                @if ((party.Type & PartyType.Supplier) != 0)
                                {
                                    <span class="contact-type supplier">Supplier</span>
                                }
                            </div>
                        </td>
                        <td class="contact-emails">
                            @if (!string.IsNullOrWhiteSpace(party.Email))
                            {
                                <span>@party.Email</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(party.AccountsEmail) && !string.Equals(party.AccountsEmail, party.Email, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="contact-accounts-email"><small>Accounts</small> @party.AccountsEmail</span>
                            }
                            @if (string.IsNullOrWhiteSpace(party.Email) && string.IsNullOrWhiteSpace(party.AccountsEmail))
                            {
                                <span class="contact-muted">—</span>
                            }
                        </td>
                        <td class="contact-terms">
                            @if ((party.Type & PartyType.Customer) != 0 && NormalizedView != "suppliers")
                            {
                                <span>@FormatPaymentTerms(party.DefaultSalesInvoicePaymentTermType, party.DefaultSalesInvoiceDueDays)</span>
                            }
                            @if ((party.Type & PartyType.Supplier) != 0 && NormalizedView != "customers")
                            {
                                @if (NormalizedView == "all" && (party.Type & PartyType.Customer) != 0)
                                {
                                    <small>Purchases · @FormatPaymentTerms(party.DefaultSupplierBillPaymentTermType, party.DefaultSupplierBillDueDays)</small>
                                }
                                else
                                {
                                    <span>@FormatPaymentTerms(party.DefaultSupplierBillPaymentTermType, party.DefaultSupplierBillDueDays)</span>
                                }
                            }
                        </td>
                        <td class="contact-actions">
                            <details class="contact-menu">
                                <summary>Actions</summary>
                                <div class="contact-menu-items">
                                    <button type="button" @onclick="() => ToggleDetails(party.Id)">View details</button>
                                    @if (canEdit)
                                    {
                                        <button type="button" @onclick="() => EditEmails(party)">Edit contact</button>
                                    }
                                    @if ((party.Type & PartyType.Customer) != 0)
                                    {
                                        <a href="o/@OrganisationId/contacts/@party.Id/statement">Statement</a>
                                        @if (canEdit)
                                        {
                                            <button type="button" @onclick="() => EditCustomerSettings(party)">Customer settings</button>
                                        }
                                    }
                                    @if (canEdit && (party.Type & PartyType.Supplier) != 0)
                                    {
                                        <button type="button" @onclick="() => EditDefaults(party)">Supplier settings</button>
                                    }
                                    @if (canEdit)
                                    {
                                        <a href="o/@OrganisationId/contacts/@party.Id/documents">Documents</a>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                    @if (expandedPartyId == party.Id)
                    {
                        <tr class="contact-detail-row">
                            <td colspan="4">
                                <div id="contact-details-@party.Id" class="contact-detail-panel">
                                    <dl>
                                        <dt>@TaxIdentifierLabel</dt><dd>@(party.Tin ?? "—")</dd>
                                        <dt>Address</dt><dd class="contact-address">@(party.Address ?? "—")</dd>
                                    </dl>
                                    @if ((party.Type & PartyType.Customer) != 0)
                                    {
                                        <dl>
                                            <dt>Sales account</dt><dd>@(party.DefaultSalesAccount is null ? "Choose on invoice" : $"{party.DefaultSalesAccount.Code} · {party.DefaultSalesAccount.Name}")</dd>
                                            <dt>Sales @access.Organisation.TaxLabel</dt><dd>@(party.DefaultSalesVatTreatment?.ToString() ?? "Choose on invoice")</dd>
                                            <dt>Invoice currency</dt><dd>@(party.DefaultSalesCurrency ?? access.Organisation.BaseCurrency)</dd>
                                        </dl>
                                    }
                                    @if ((party.Type & PartyType.Supplier) != 0)
                                    {
                                        <dl>
                                            <dt>Supplier accounts</dt>
                                            <dd>
                                                @if (party.SupplierAccounts.Count == 0) { <span>—</span> }
                                                @foreach (var account in party.SupplierAccounts.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label))
                                                {
                                                    <div>@account.Label · @account.AccountNumber @(account.IsDefault ? "(default)" : "")</div>
                                                }
                                            </dd>
                                            <dt>@access.Organisation.TaxLabel registration</dt><dd>@(party.VatRegistrationNumber ?? "—")</dd>
                                            <dt>Purchase account</dt><dd>@(party.DefaultPurchaseAccount is null ? "Choose on bill" : $"{party.DefaultPurchaseAccount.Code} · {party.DefaultPurchaseAccount.Name}")</dd>
                                            <dt>Purchase @access.Organisation.TaxLabel</dt><dd>@(party.DefaultPurchaseVatTreatment?.ToString() ?? "Choose on bill")</dd>
                                            <dt>Bill currency</dt><dd>@(party.DefaultPurchaseCurrency ?? access.Organisation.BaseCurrency)</dd>
                                        </dl>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingEmailPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="setup-card">
                                    <h3>@party.Name contact details</h3>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Primary email</label>
                                            <input type="email" class="form-control" @bind="editingEmail" @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Accounts email</label>
                                            <input type="email" class="form-control" @bind="editingAccountsEmail" @bind:event="oninput" />
                                            <div class="form-text">Used first for invoices and account documents.</div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Address</label>
                                        <textarea class="form-control" rows="2" @bind="editingAddress" @bind:event="oninput"></textarea>
                                        @if (access.Organisation.CountryCode == "FJ") { <div class="form-text">Required when issuing a full Fiji tax invoice.</div> }
                                    </div>
                                    <button type="button" class="btn btn-primary me-2" @onclick="SaveContactDetails">Save contact details</button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEmails">Cancel</button>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingCustomerPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="setup-card">
                                    <h3>@party.Name customer settings</h3>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Default invoice currency</label>
                                            <InputSelect class="form-select" @bind-Value="editingCustomerCurrency">
                                                @foreach (var currency in currencies.Where(x => x.IsActive))
                                                {
                                                    <option value="@currency.Code">@currency.Code - @currency.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales account
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerAccountId">
                                                <option value="">No default</option>
                                                @foreach (var account in salesAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales VAT
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerVatTreatment">
                                                <option value="">No default</option>
                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">@vat</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Sales invoice payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editingCustomerPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after invoice date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editingCustomerPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editingCustomerPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editingCustomerDueDays" />
                                                    <span class="input-group-text">
                                                        days
                                                    </span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Invoice due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveCustomerSettings">
                                            Save customer settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelCustomerSettings">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="setup-card">
                                    <h3>@party.Name supplier settings</h3>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@access.Organisation.TaxLabel registration number</label>
                                            <InputText class="form-control"
                                                       @bind-Value="editDefaults.VatRegistrationNumber" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Default bill currency</label>
                                            <InputSelect class="form-select" @bind-Value="editDefaults.DefaultPurchaseCurrency">
                                                @foreach (var currency in currencies.Where(x => x.IsActive))
                                                {
                                                    <option value="@currency.Code">@currency.Code - @currency.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="border rounded p-3 mb-3">
                                        <h4>Supplier accounts</h4>
                                        @if (editingSupplierAccounts.Count == 0)
                                        {
                                            <p class="text-muted">No account numbers have been added.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm align-middle">
                                                    <thead><tr><th>Label</th><th>Account number</th><th></th></tr></thead>
                                                    <tbody>
                                                        @foreach (var account in editingSupplierAccounts)
                                                        {
                                                            <tr>
                                                                <td>@account.Label</td>
                                                                <td>@account.AccountNumber</td>
                                                                <td class="text-end">
                                                                    @if (account.IsDefault)
                                                                    {
                                                                        <span class="badge text-bg-success me-2">Default</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="() => MakeDefaultSupplierAccount(account.Id)">Make default</button>
                                                                    }
                                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSupplierAccount(account.Id)">Delete</button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <div class="row align-items-end">
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Label</label>
                                                <input class="form-control" @bind="newSupplierAccount.Label" @bind:event="oninput" placeholder="e.g. Lautoka" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Account number</label>
                                                <input class="form-control" @bind="newSupplierAccount.AccountNumber" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-2 mb-2 form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="newSupplierAccount.MakeDefault" />
                                                <label class="form-check-label">Default</label>
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <button type="button" class="btn btn-outline-primary w-100" @onclick="AddSupplierAccount">Add account</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="border rounded p-3 mb-3">
                                        <h4>Payment bank accounts</h4>
                                        <p class="text-muted">New bank details stay pending until a different owner or administrator verifies them. Account numbers remain masked after entry.</p>
                                        @if (editingSupplierBankAccounts.Count == 0)
                                        {
                                            <p class="text-muted">No payment bank accounts have been added.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm align-middle">
                                                    <thead><tr><th>Account</th><th>Bank</th><th>Number</th><th>Status</th><th></th></tr></thead>
                                                    <tbody>
                                                        @foreach (var bankAccount in editingSupplierBankAccounts)
                                                        {
                                                            <tr>
                                                                <td>@bankAccount.AccountName</td>
                                                                <td>@(bankAccount.BankName ?? "—")</td>
                                                                <td>@BusinessPartyService.MaskBankAccountNumber(bankAccount.AccountNumber)</td>
                                                                <td>
                                                                    @if (bankAccount.IsVerified)
                                                                    {
                                                                        <span class="badge text-bg-success">Verified</span>
                                                                        @if (bankAccount.IsDefault)
                                                                        {
                                                                            <span class="badge text-bg-primary ms-1">Default</span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge text-bg-warning">Pending</span>
                                                                    }
                                                                </td>
                                                                <td class="text-end">
                                                                    @if (!bankAccount.IsVerified && canVerifyBankAccounts && bankAccount.SubmittedByUserId != userId)
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => VerifySupplierBankAccount(bankAccount.Id)">Verify</button>
                                                                    }
                                                                    @if (canVerifyBankAccounts)
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateSupplierBankAccount(bankAccount.Id)">Remove</button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <div class="row align-items-end">
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">Account name</label>
                                                <input class="form-control" @bind="newSupplierBankAccount.AccountName" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">Bank</label>
                                                <input class="form-control" @bind="newSupplierBankAccount.BankName" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Bank account number</label>
                                                <input class="form-control" autocomplete="off" @bind="newSupplierBankAccount.AccountNumber" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <button type="button" class="btn btn-outline-primary w-100" @onclick="SubmitSupplierBankAccount">Submit</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-8">
                                            <label class="form-label">
                                                Default purchase account
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseAccountId">
                                                <option value="">No default</option>

                                                @foreach (var account in purchaseAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default VAT
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseVatTreatment">
                                                <option value="">No default</option>

                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">
                                                        @vat
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4 mt-3">
                                            <label class="form-label">
                                                Supplier bill payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editDefaults.DefaultSupplierBillPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after bill date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editDefaults.DefaultSupplierBillDueDays" />
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Bill due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveDefaults">
                                            Save supplier settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelDefaults">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
        @if (totalContacts > PageSize)
        {
            <nav class="contacts-pagination" aria-label="Contact pages">
                <span>Page @currentPage of @TotalPages</span>
                <div>
                    @if (currentPage > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@ContactsLink(currentPage - 1, searchTerm)">Previous</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                    }
                    @if (currentPage < TotalPages)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@ContactsLink(currentPage + 1, searchTerm)">Next</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                    }
                </div>
            </nav>
        }
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public string? ContactView { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; } = 1;
    private const int PageSize = 50;
    private int currentPage = 1;
    private int totalContacts;
    private HashSet<Guid> archivedIds = [];
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalContacts / (double)PageSize));
    private int FirstContact => (currentPage - 1) * PageSize + 1;
    private int LastContact => Math.Min(currentPage * PageSize, totalContacts);
    private string searchInput = "";
    private Guid? expandedPartyId;
    private string TaxIdentifierLabel => access?.Organisation.CountryCode == "NZ" ? "IRD number" : "TIN";

    private string ContactsLink(int page, string search)
    {
        var path = $"o/{OrganisationId}/contacts";
        if (NormalizedView != "all") path += $"/{NormalizedView}";
        return $"{path}?q={Uri.EscapeDataString(search)}&page={page}";
    }

    private void SearchContacts() => Navigation.NavigateTo(ContactsLink(1, searchInput.Trim()));

    private void ToggleDetails(Guid partyId) => expandedPartyId = expandedPartyId == partyId ? null : partyId;
    private AccessibleOrganisation? access;
    private string userId = string.Empty;
    private bool canEdit;
    private bool canVerifyBankAccounts;
    private bool showAddContact;
    private List<BusinessParty> parties = [];
    private List<XeroContactGroups.Group> xeroGroups = [];
    private List<LedgerAccount> salesAccounts = [];
    private List<LedgerAccount> purchaseAccounts = [];
    private IReadOnlyList<CurrencyOption> currencies = [];
    private ContactModel model = new();
    private BusinessPartyDocumentUploadRequest? initialContract;
    private string? contractError;
    private bool readingContract;
    private bool creatingContact;
    private string contactTypeSelection
    {
        get => model.Type switch
        {
            PartyType.Customer => "Customer",
            PartyType.Supplier => "Supplier",
            _ => "Both"
        };
        set
        {
            model.Type = value switch
            {
                "Supplier" => PartyType.Supplier,
                "Both" => PartyType.Customer | PartyType.Supplier,
                _ => PartyType.Customer
            };
            if ((model.Type & PartyType.Supplier) == 0) ClearContract();
        }
    }
    private Guid? editingEmailPartyId;
    private string? editingEmail;
    private string? editingAccountsEmail;
    private string? editingAddress;
    private Guid? editingPartyId;
    private Guid? editingCustomerPartyId;
    private Guid? editingCustomerAccountId;
    private VatTreatment? editingCustomerVatTreatment;
    private int editingCustomerDueDays = 30;
    private PaymentTermType editingCustomerPaymentTermType = PaymentTermType.DaysAfterDocumentDate;
    private string editingCustomerCurrency = "FJD";
    private PurchaseDefaultsModel editDefaults = new();
    private List<SupplierAccountProfile> editingSupplierAccounts = [];
    private NewSupplierAccountModel newSupplierAccount = new();
    private List<SupplierBankAccount> editingSupplierBankAccounts = [];
    private NewSupplierBankAccountModel newSupplierBankAccount = new();
    private string searchTerm = string.Empty;
    private string? status;
    private string statusClass = "alert-success";
    private CancellationTokenSource? statusDismissal;

    private void ShowStatus(string message, string cssClass)
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();

        status = message;
        statusClass = cssClass;
        statusDismissal = new CancellationTokenSource();
        _ = DismissStatusAfterDelayAsync(statusDismissal.Token);
    }

    private void DismissStatus()
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();
        statusDismissal = null;
        status = null;
    }

    private async Task DismissStatusAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);
            await InvokeAsync(() =>
            {
                if (!cancellationToken.IsCancellationRequested)
                {
                    status = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // A newer message replaced this one, or it was dismissed manually.
        }
    }

    public void Dispose()
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();
    }

    private string NormalizedView => ContactView?.ToLowerInvariant() switch
    {
        "customers" => "customers",
        "suppliers" => "suppliers",
        "archive" => "archive",
        _ => "all"
    };
    private string PageHeading => NormalizedView switch
    {
        "customers" => "Customers",
        "suppliers" => "Suppliers",
        "archive" => "Contact archive",
        _ => "All contacts"
    };
    private static string NormalizeForSearch(string value) => value.Trim().ToUpperInvariant();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        xeroGroups = [];
        parties = [];
        expandedPartyId = null;
        CancelEmails();
        CancelCustomerSettings();
        CancelDefaults();
        if (access is not null)
        {
            if (NormalizedView == "all" && await XeroReports.UsesXeroAsync(OrganisationId) &&
                await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId) is null)
            {
                var groups = await (
                    from groupRecord in Db.XeroMirrorRecords.AsNoTracking()
                    join connection in Db.XeroConnections.AsNoTracking()
                        on groupRecord.XeroConnectionId equals connection.Id
                    where groupRecord.OrganisationId == OrganisationId && connection.OrganisationId == OrganisationId &&
                          connection.IsActive && connection.ContinuousSyncEnabled &&
                          groupRecord.DatasetKey == XeroContactGroups.Key && !groupRecord.IsArchived
                    orderby groupRecord.DisplayName
                    select groupRecord.SourceJson).ToListAsync();
                xeroGroups = groups.Select(XeroContactGroups.ReadSaved).ToList();
            }
            canEdit = await TenantAccess.CanManageContactsAsync(userId, OrganisationId);
            canVerifyBankAccounts = await TenantAccess.CanManageTeamAsync(userId, OrganisationId);
            searchTerm = Query?.Trim() ?? string.Empty;
            searchInput = searchTerm;
            currentPage = Math.Max(1, Page);
            currencies = await CurrencyService.ListAsync(userId, OrganisationId);
            ClearContract();
            model = new ContactModel
        {
            Type = NormalizedView == "suppliers"
                ? PartyType.Supplier
                : PartyType.Customer,
            DefaultSalesInvoicePaymentTermType =
                access?.Organisation.DefaultSalesInvoicePaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSalesInvoiceDueDays =
                access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
            DefaultSupplierBillPaymentTermType =
                access?.Organisation.DefaultSupplierBillPaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSupplierBillDueDays =
                access?.Organisation.DefaultSupplierBillDueDays ?? 30,
            DefaultSalesCurrency = access!.Organisation.BaseCurrency,
            DefaultPurchaseCurrency = access.Organisation.BaseCurrency
        };
            purchaseAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type == AccountType.Expense || x.Code == "1200" || x.Code == "1500")).OrderBy(x => x.Code).ToListAsync();
            salesAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.Type == AccountType.Revenue).OrderBy(x => x.Code).ToListAsync();
            await Reload();
        }
    }

    private async Task Reload()
    {
        var today = DateOnly.FromDateTime(OrganisationTime.Convert(DateTimeOffset.UtcNow, access!.Organisation).Date);
        archivedIds = await ContactArchive.FindArchivedAsync(Db, access.Organisation, today);
        var query = Db.BusinessParties.AsNoTracking().Where(x => x.OrganisationId == OrganisationId);
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalized = NormalizeForSearch(searchTerm);
            query = query.Where(x => x.Name.ToUpper().Contains(normalized) ||
                                     (x.Email ?? "").ToUpper().Contains(normalized) ||
                                     (x.AccountsEmail ?? "").ToUpper().Contains(normalized) ||
                                     (x.Tin ?? "").ToUpper().Contains(normalized) ||
                                     x.SupplierAccounts.Any(a => a.AccountNumber.ToUpper().Contains(normalized) ||
                                                                 a.Label.ToUpper().Contains(normalized)) ||
                                     (x.VatRegistrationNumber ?? "").ToUpper().Contains(normalized));
        }
        query = NormalizedView switch
        {
            "customers" => query.Where(x => (x.Type & PartyType.Customer) != 0),
            "suppliers" => query.Where(x => (x.Type & PartyType.Supplier) != 0),
            _ => query
        };
        // Filter a compact, ordered list of IDs before paging so counts and search share the same archive rules.
        var roleView = NormalizedView is "customers" or "suppliers";
        var ids = await query.OrderBy(x => roleView && x.Type == (PartyType.Customer | PartyType.Supplier))
            .ThenBy(x => x.Name).ThenBy(x => x.Id).Select(x => x.Id).ToListAsync();
        if (NormalizedView == "archive")
            ids.RemoveAll(id => !archivedIds.Contains(id));
        else if (string.IsNullOrWhiteSpace(searchTerm))
            ids.RemoveAll(archivedIds.Contains);
        totalContacts = ids.Count;
        currentPage = Math.Min(currentPage, TotalPages);
        var pageIds = ids.Skip((currentPage - 1) * PageSize).Take(PageSize).ToArray();
        parties = await query.Where(x => pageIds.Contains(x.Id))
            .Include(x => x.DefaultSalesAccount)
            .Include(x => x.DefaultPurchaseAccount)
            .Include(x => x.SupplierAccounts)
            .Include(x => x.SupplierBankAccounts.Where(a => a.IsActive))
            .OrderBy(x => roleView && x.Type == (PartyType.Customer | PartyType.Supplier))
            .ThenBy(x => x.Name)
            .ThenBy(x => x.Id)
            .ToListAsync();
    }

    private void ClearContract()
    {
        initialContract = null;
        contractError = null;
    }

    private async Task SelectContract(InputFileChangeEventArgs args)
    {
        ClearContract();
        if (args.FileCount != 1)
        {
            contractError = "Choose one supplier contract.";
            return;
        }

        var organisationId = OrganisationId;
        var contact = model;
        readingContract = true;
        try
        {
            var contract = await ContactDocumentDropZone.ReadAsync(
                args.File, organisationId, Guid.Empty, BusinessPartyDocumentType.Contract);
            if (OrganisationId == organisationId && model == contact &&
                (contact.Type & PartyType.Supplier) != 0)
            {
                initialContract = contract;
            }
        }
        catch (InvalidOperationException ex)
        {
            contractError = ex.Message;
        }
        catch (IOException)
        {
            contractError = "The contract could not be read. Choose the file again.";
        }
        finally
        {
            readingContract = false;
        }
    }

    private async Task Create()
    {
        if (!canEdit || readingContract || creatingContact || contractError is not null) return;
        creatingContact = true;
        try
        {
            var party = await BusinessParties.CreateAsync(
                userId,
                new CreateBusinessPartyRequest(
                    OrganisationId,
                    model.Name,
                    model.Email,
                    model.Tin,
                    model.Type,
                    model.DefaultSalesAccountId,
                    model.DefaultSalesVatTreatment,
                    model.DefaultPurchaseAccountId,
                    model.DefaultPurchaseVatTreatment,
                    model.DefaultSalesInvoicePaymentTermType,
                    model.DefaultSalesInvoiceDueDays,
                    model.DefaultSupplierBillPaymentTermType,
                    model.DefaultSupplierBillDueDays,
                    model.SupplierAccountNumber,
                    model.VatRegistrationNumber,
                    model.DefaultSalesCurrency,
                    model.DefaultPurchaseCurrency,
                    model.AccountsEmail,
                    model.Address,
                    initialContract));
            var hasContract = initialContract is not null;
            ClearContract();
            model = new ContactModel
            {
                Type = NormalizedView == "suppliers"
                    ? PartyType.Supplier
                    : PartyType.Customer,
                DefaultSalesInvoicePaymentTermType =
                    access?.Organisation.DefaultSalesInvoicePaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSalesInvoiceDueDays =
                    access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
                DefaultSupplierBillPaymentTermType =
                    access?.Organisation.DefaultSupplierBillPaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSupplierBillDueDays =
                    access?.Organisation.DefaultSupplierBillDueDays ?? 30,
                DefaultSalesCurrency = access?.Organisation.BaseCurrency ?? "FJD",
                DefaultPurchaseCurrency = access?.Organisation.BaseCurrency ?? "FJD"
            };
            showAddContact = false;
            ShowStatus(hasContract ? $"{party.Name} added with its contract." : $"{party.Name} added successfully.", "alert-success");
            await Reload();
        }
        catch (Exception ex)
        {
            ShowStatus($"Contact was not added: {ex.Message}", "alert-danger");
        }
        finally
        {
            creatingContact = false;
        }
    }

    private void EditCustomerSettings(BusinessParty party)
    {
        CancelEmails();
        CancelDefaults();
        editingCustomerPartyId = party.Id;
        editingCustomerAccountId = party.DefaultSalesAccountId;
        editingCustomerVatTreatment = party.DefaultSalesVatTreatment;

        editingCustomerPaymentTermType =
            party.DefaultSalesInvoicePaymentTermType;

        editingCustomerDueDays =
            party.DefaultSalesInvoiceDueDays;
        editingCustomerCurrency =
            party.DefaultSalesCurrency
            ?? access?.Organisation.BaseCurrency
            ?? "FJD";
    }

    private void CancelCustomerSettings()
    {
        editingCustomerPartyId = null;
        editingCustomerAccountId = null;
        editingCustomerVatTreatment = null;
        editingCustomerDueDays = 30;
        editingCustomerPaymentTermType =
            PaymentTermType.DaysAfterDocumentDate;
        editingCustomerCurrency = access?.Organisation.BaseCurrency ?? "FJD";
    }

    private async Task SaveCustomerSettings()
    {
        if (editingCustomerPartyId is not Guid id ||
            !canEdit)
        {
            return;
        }

        if (editingCustomerDueDays < 0 ||
            editingCustomerDueDays > 365)
        {
            ShowStatus("Enter customer payment terms between 0 and 365.", "alert-danger");
            return;
        }

        try
        {
            await BusinessParties.UpdateCustomerDefaultsAsync(
                userId,
                new UpdateCustomerDefaultsRequest(
                    OrganisationId,
                    id,
                    editingCustomerAccountId,
                    editingCustomerVatTreatment,
                    editingCustomerPaymentTermType,
                    editingCustomerDueDays,
                    editingCustomerCurrency));
            CancelCustomerSettings();
            ShowStatus("Customer settings saved.", "alert-success");
            await Reload();
        }
        catch (Exception ex)
        {
            ShowStatus($"Customer settings were not saved: {ex.Message}", "alert-danger");
        }
    }

    private void EditDefaults(BusinessParty party)
    {
        CancelEmails();
        CancelCustomerSettings();
        editingPartyId = party.Id;
        editDefaults = new()
        {
            VatRegistrationNumber = party.VatRegistrationNumber,
            DefaultPurchaseAccountId = party.DefaultPurchaseAccountId,
            DefaultPurchaseVatTreatment = party.DefaultPurchaseVatTreatment,
            DefaultSupplierBillPaymentTermType = party.DefaultSupplierBillPaymentTermType,
            DefaultSupplierBillDueDays = party.DefaultSupplierBillDueDays,
            DefaultPurchaseCurrency = party.DefaultPurchaseCurrency ?? access?.Organisation.BaseCurrency ?? "FJD"
        };
        editingSupplierAccounts = party.SupplierAccounts.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label).ToList();
        editingSupplierBankAccounts = party.SupplierBankAccounts.OrderByDescending(x => x.IsDefault).ThenByDescending(x => x.SubmittedAt).ToList();
        newSupplierAccount = new();
        newSupplierBankAccount = new();
    }
    private void CancelDefaults() { editingPartyId = null; editDefaults = new(); editingSupplierAccounts = []; editingSupplierBankAccounts = []; newSupplierAccount = new(); newSupplierBankAccount = new(); }
    private async Task SaveDefaults()
    {
        if (editingPartyId is not Guid id || !canEdit) return;
        try
        {
            await BusinessParties.UpdateSupplierDefaultsAsync(
                userId,
                new UpdateSupplierDefaultsRequest(
                    OrganisationId,
                    id,
                    editDefaults.DefaultPurchaseAccountId,
                    editDefaults.DefaultPurchaseVatTreatment,
                    editDefaults.DefaultSupplierBillPaymentTermType,
                    editDefaults.DefaultSupplierBillDueDays,
                    editDefaults.VatRegistrationNumber,
                    editDefaults.DefaultPurchaseCurrency));
            CancelDefaults();
            ShowStatus("Supplier settings saved.", "alert-success");
            await Reload();
        }
        catch (Exception ex)
        {
            ShowStatus($"Supplier settings were not saved: {ex.Message}", "alert-danger");
        }
    }

    private void EditEmails(BusinessParty party)
    {
        CancelCustomerSettings();
        CancelDefaults();
        editingEmailPartyId = party.Id;
        editingEmail = party.Email;
        editingAccountsEmail = party.AccountsEmail;
        editingAddress = party.Address;
    }

    private void CancelEmails()
    {
        editingEmailPartyId = null;
        editingEmail = null;
        editingAccountsEmail = null;
        editingAddress = null;
    }

    private async Task SaveContactDetails()
    {
        if (editingEmailPartyId is not Guid id || !canEdit) return;
        try
        {
            await BusinessParties.UpdateContactDetailsAsync(
                userId,
                new UpdateBusinessPartyContactDetailsRequest(
                    OrganisationId,
                    id,
                    editingEmail,
                    editingAccountsEmail,
                    editingAddress));
            CancelEmails();
            ShowStatus("Contact details saved.", "alert-success");
            await Reload();
        }
        catch (Exception ex)
        {
            ShowStatus($"Contact details were not saved: {ex.Message}", "alert-danger");
        }
    }

    private async Task AddSupplierAccount()
    {
        if (editingPartyId is not Guid supplierId || !canEdit) return;
        try
        {
            await BusinessParties.AddSupplierAccountAsync(
                userId,
                new SupplierAccountProfileRequest(
                    OrganisationId,
                    supplierId,
                    newSupplierAccount.Label,
                    newSupplierAccount.AccountNumber,
                    newSupplierAccount.MakeDefault));
            newSupplierAccount = new();
            ShowStatus("Supplier account added.", "alert-success");
            await Reload();
            editingSupplierAccounts = parties.Single(x => x.Id == supplierId).SupplierAccounts
                .OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label).ToList();
        }
        catch (Exception ex)
        {
            ShowStatus($"Supplier account was not added: {ex.Message}", "alert-danger");
        }
    }

    private async Task MakeDefaultSupplierAccount(Guid accountId)
    {
        if (editingPartyId is not Guid supplierId || !canEdit) return;
        try
        {
            await BusinessParties.SetDefaultSupplierAccountAsync(userId, OrganisationId, supplierId, accountId);
            ShowStatus("Default supplier account updated.", "alert-success");
            await Reload();
            editingSupplierAccounts = parties.Single(x => x.Id == supplierId).SupplierAccounts
                .OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label).ToList();
        }
        catch (Exception ex)
        {
            ShowStatus($"Default supplier account was not updated: {ex.Message}", "alert-danger");
        }
    }

    private async Task DeleteSupplierAccount(Guid accountId)
    {
        if (editingPartyId is not Guid supplierId || !canEdit) return;
        try
        {
            await BusinessParties.DeleteSupplierAccountAsync(userId, OrganisationId, supplierId, accountId);
            ShowStatus("Supplier account deleted.", "alert-success");
            await Reload();
            editingSupplierAccounts = parties.Single(x => x.Id == supplierId).SupplierAccounts
                .OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label).ToList();
        }
        catch (Exception ex)
        {
            ShowStatus($"Supplier account was not deleted: {ex.Message}", "alert-danger");
        }
    }

    private async Task SubmitSupplierBankAccount()
    {
        if (editingPartyId is not Guid supplierId || !canEdit) return;
        try
        {
            await BusinessParties.SubmitSupplierBankAccountAsync(
                userId,
                new SupplierBankAccountRequest(
                    OrganisationId,
                    supplierId,
                    newSupplierBankAccount.AccountName,
                    newSupplierBankAccount.BankName,
                    newSupplierBankAccount.AccountNumber));
            newSupplierBankAccount = new();
            ShowStatus("Bank details submitted for independent verification.", "alert-success");
            await Reload();
            RefreshEditingSupplierBankAccounts(supplierId);
        }
        catch (Exception ex)
        {
            ShowStatus($"Bank details were not submitted: {ex.Message}", "alert-danger");
        }
    }

    private async Task VerifySupplierBankAccount(Guid bankAccountId)
    {
        if (editingPartyId is not Guid supplierId || !canVerifyBankAccounts) return;
        try
        {
            await BusinessParties.VerifySupplierBankAccountAsync(
                userId, OrganisationId, supplierId, bankAccountId);
            ShowStatus("Bank details verified and set as the default payment destination.", "alert-success");
            await Reload();
            RefreshEditingSupplierBankAccounts(supplierId);
        }
        catch (Exception ex)
        {
            ShowStatus($"Bank details were not verified: {ex.Message}", "alert-danger");
        }
    }

    private async Task DeactivateSupplierBankAccount(Guid bankAccountId)
    {
        if (editingPartyId is not Guid supplierId || !canVerifyBankAccounts) return;
        try
        {
            await BusinessParties.DeactivateSupplierBankAccountAsync(
                userId, OrganisationId, supplierId, bankAccountId);
            ShowStatus("Bank details removed from active payment destinations.", "alert-success");
            await Reload();
            RefreshEditingSupplierBankAccounts(supplierId);
        }
        catch (Exception ex)
        {
            ShowStatus($"Bank details were not removed: {ex.Message}", "alert-danger");
        }
    }

    private void RefreshEditingSupplierBankAccounts(Guid supplierId) =>
        editingSupplierBankAccounts = parties.Single(x => x.Id == supplierId)
            .SupplierBankAccounts
            .OrderByDescending(x => x.IsDefault)
            .ThenByDescending(x => x.SubmittedAt)
            .ToList();

    private class PurchaseDefaultsModel { [StringLength(80)] public string? VatRegistrationNumber { get; set; } public Guid? DefaultSalesAccountId { get; set; } public VatTreatment? DefaultSalesVatTreatment { get; set; } public Guid? DefaultPurchaseAccountId { get; set; } public VatTreatment? DefaultPurchaseVatTreatment { get; set; } [Required, StringLength(3, MinimumLength = 3)] public string DefaultSalesCurrency { get; set; } = "FJD"; [Required, StringLength(3, MinimumLength = 3)] public string DefaultPurchaseCurrency { get; set; } = "FJD"; public PaymentTermType DefaultSalesInvoicePaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSalesInvoiceDueDays { get; set; } = 30; public PaymentTermType DefaultSupplierBillPaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSupplierBillDueDays { get; set; } = 30; }
    private static string FormatPaymentTerms(
        PaymentTermType type,
        int value)
    {
        return type switch
        {
            PaymentTermType.DaysAfterDocumentDate =>
                $"{value} days",

            PaymentTermType.DayOfFollowingMonth =>
                $"{value}th of following month",

            PaymentTermType.EndOfCurrentMonth =>
                "End of current month",

            PaymentTermType.EndOfFollowingMonth =>
                "End of following month",

            _ =>
                $"{value} days"
        };
    }
