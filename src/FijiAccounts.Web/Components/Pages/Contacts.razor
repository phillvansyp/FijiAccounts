@page "/o/{OrganisationId:guid}/contacts"
@page "/o/{OrganisationId:guid}/contacts/{ContactView}"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Domain.Accounting
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BusinessPartyService BusinessParties
@inject TransactionCurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@PageHeading</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@PageHeading</h1>

        @if (canEdit)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="() => showAddContact = !showAddContact">
                @(showAddContact ? "Hide add contact" : "+ Add contact")
            </button>
        }
    </div>
    @if (status is not null)
    {
        <div class="alert @statusClass contact-status"
             role="status">
            <span>@status</span>
            <button type="button"
                    class="btn-close"
                    aria-label="Dismiss message"
                    @onclick="DismissStatus">
            </button>
        </div>
    }
    @if (canEdit && showAddContact) { <div class="setup-card"><h2>Add contact</h2><EditForm Model="model" OnValidSubmit="Create" FormName="add-contact"><DataAnnotationsValidator /><ValidationSummary />
        <div class="mb-3"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" /></div>
        <div class="row"><div class="col-md-4 mb-3"><label class="form-label">Primary email</label><InputText class="form-control" @bind-Value="model.Email" /></div><div class="col-md-4 mb-3"><label class="form-label">Accounts email</label><InputText class="form-control" @bind-Value="model.AccountsEmail" /><div class="form-text">Invoices and account documents are sent here when provided.</div></div><div class="col-md-4 mb-3"><label class="form-label">TIN</label><InputText class="form-control" @bind-Value="model.Tin" /></div></div>
        <div class="mb-3"><label class="form-label">Type</label><InputSelect class="form-select" @bind-Value="model.Type"><option value="Customer">Customer</option><option value="Supplier">Supplier</option><option value="3">Customer and supplier</option></InputSelect></div>
        @if ((model.Type & PartyType.Customer) != 0) { <div class="row"><div class="col-md-3 mb-3"><label class="form-label">Default sales account</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesAccountId"><option value="">Choose when entering an invoice</option>@foreach (var account in salesAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default sales VAT</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesVatTreatment"><option value="">Choose when entering an invoice</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default invoice currency</label><InputSelect class="form-select" @bind-Value="model.DefaultSalesCurrency">@foreach (var currency in currencies.Where(x => x.IsActive)) { <option value="@currency.Code">@currency.Code - @currency.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Sales invoice payment terms</label><div class="input-group"><InputNumber class="form-control" @bind-Value="model.DefaultSalesInvoiceDueDays" /><span class="input-group-text">days</span></div><div class="form-text">Due date will default to this many days after the invoice date.</div></div></div> }
        @if ((model.Type & PartyType.Supplier) != 0)
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Supplier account number</label>
                    <InputText class="form-control" @bind-Value="model.SupplierAccountNumber" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">VAT registration number</label>
                    <InputText class="form-control" @bind-Value="model.VatRegistrationNumber" />
                </div>
            </div>
            <div class="row"><div class="col-md-5 mb-3"><label class="form-label">Default purchase account</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseAccountId"><option value="">Choose when entering a bill</option>@foreach (var account in purchaseAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Default VAT</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseVatTreatment"><option value="">Choose when entering a bill</option>@foreach (var vat in Enum.GetValues<VatTreatment>()) { <option value="@vat">@vat</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Default bill currency</label><InputSelect class="form-select" @bind-Value="model.DefaultPurchaseCurrency">@foreach (var currency in currencies.Where(x => x.IsActive)) { <option value="@currency.Code">@currency.Code - @currency.Name</option> }</InputSelect></div></div>
        }
        <button class="btn btn-primary">Add contact</button>
    </EditForm></div> }
    @if (!string.IsNullOrWhiteSpace(searchTerm))
    {
        <div class="alert alert-info">
            Showing contacts matching "<strong>@searchTerm</strong>".
            <a href="o/@OrganisationId/contacts" class="ms-2">Clear</a>
        </div>
    }
    <div class="table-responsive mt-5">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Primary email</th>
                    <th>Accounts email</th>
                    <th>TIN</th>
                    <th>Supplier details</th>
                    <th>Payment terms</th>
                    <th>Sales defaults</th>
                    <th>Purchase defaults</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var party in parties)
                {
                    <tr>
                        <td>
                            <strong>@party.Name</strong>
                        </td>

                        <td>@party.Type</td>
                        <td>@party.Email</td>
                        <td>@party.AccountsEmail</td>
                        <td>@party.Tin</td>
                        <td>
                            @if ((party.Type & PartyType.Supplier) != 0)
                            {
                                @if (party.SupplierAccounts.Count == 0)
                                {
                                    <div>Account: -</div>
                                }
                                else
                                {
                                    @foreach (var account in party.SupplierAccounts.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Label))
                                    {
                                        <div>@account.Label: @account.AccountNumber @(account.IsDefault ? "(default)" : "")</div>
                                    }
                                }
                                <div>VAT: @(party.VatRegistrationNumber ?? "-")</div>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                <span>
                                    @FormatPaymentTerms(
                                        party.DefaultSalesInvoicePaymentTermType,
                                        party.DefaultSalesInvoiceDueDays)
                                </span>
                            }
                            else
                            {
                                <span>
                                    @FormatPaymentTerms(
                                        party.DefaultSupplierBillPaymentTermType,
                                        party.DefaultSupplierBillDueDays)
                                </span>
                            }
                        </td>

                        <td>
                            @if (canEdit)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary me-2"
                                        @onclick="() => EditEmails(party)">
                                    Contact emails
                                </button>
                            }
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                @(party.DefaultSalesAccount is null
                                    ? "—"
                                    : $"{party.DefaultSalesAccount.Code} — {party.DefaultSalesAccount.Name}")

                                @if (party.DefaultSalesVatTreatment is not null)
                                {
                                    <span> · @party.DefaultSalesVatTreatment</span>
                                }
                                <span> · @(party.DefaultSalesCurrency ?? access.Organisation.BaseCurrency)</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>
                            @if ((party.Type & PartyType.Supplier) != 0)
                            {
                                @(party.DefaultPurchaseAccount is null
                                    ? "—"
                                    : $"{party.DefaultPurchaseAccount.Code} — {party.DefaultPurchaseAccount.Name}")

                                @if (party.DefaultPurchaseVatTreatment is not null)
                                {
                                    <span> · @party.DefaultPurchaseVatTreatment</span>
                                }
                                <span> · @(party.DefaultPurchaseCurrency ?? access.Organisation.BaseCurrency)</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td class="text-end">
                            @if ((party.Type & PartyType.Customer) != 0)
                            {
                                <a class="btn btn-sm btn-outline-primary me-2"
                                   href="o/@OrganisationId/contacts/@party.Id/statement">
                                    Statement
                                </a>

                                @if (canEdit)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary me-2"
                                            @onclick="() => EditCustomerSettings(party)">
                                        Customer settings
                                    </button>

                                <a class="btn btn-sm btn-outline-secondary"
                                   href="o/@OrganisationId/contacts/@party.Id/documents">
                                    Documents
                                </a>
                                }
                            }

                            @if (canEdit &&
                                (party.Type & PartyType.Supplier) != 0)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => EditDefaults(party)">
                                    Supplier settings
                                </button>

                                <a class="btn btn-sm btn-outline-secondary ms-2"
                                   href="o/@OrganisationId/contacts/@party.Id/documents">
                                    Documents
                                </a>
                            }
                        </td>
                    </tr>

                    @if (editingEmailPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="10">
                                <div class="setup-card">
                                    <h3>@party.Name contact emails</h3>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Primary email</label>
                                            <InputText class="form-control" @bind-Value="editingEmail" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Accounts email</label>
                                            <InputText class="form-control" @bind-Value="editingAccountsEmail" />
                                            <div class="form-text">Used first for invoices and account documents.</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-primary me-2" @onclick="SaveEmails">Save contact emails</button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEmails">Cancel</button>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingCustomerPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="10">
                                <div class="setup-card">
                                    <h3>@party.Name customer settings</h3>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Default invoice currency</label>
                                            <InputSelect class="form-select" @bind-Value="editingCustomerCurrency">
                                                @foreach (var currency in currencies.Where(x => x.IsActive))
                                                {
                                                    <option value="@currency.Code">@currency.Code - @currency.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales account
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerAccountId">
                                                <option value="">No default</option>
                                                @foreach (var account in salesAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default sales VAT
                                            </label>
                                            <InputSelect class="form-select"
                                                         @bind-Value="editingCustomerVatTreatment">
                                                <option value="">No default</option>
                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">@vat</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Sales invoice payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editingCustomerPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after invoice date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editingCustomerPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editingCustomerPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editingCustomerDueDays" />
                                                    <span class="input-group-text">
                                                        days
                                                    </span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Invoice due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveCustomerSettings">
                                            Save customer settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelCustomerSettings">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (editingPartyId == party.Id)
                    {
                        <tr>
                            <td colspan="10">
                                <div class="setup-card">
                                    <h3>@party.Name supplier settings</h3>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">VAT registration number</label>
                                            <InputText class="form-control"
                                                       @bind-Value="editDefaults.VatRegistrationNumber" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Default bill currency</label>
                                            <InputSelect class="form-select" @bind-Value="editDefaults.DefaultPurchaseCurrency">
                                                @foreach (var currency in currencies.Where(x => x.IsActive))
                                                {
                                                    <option value="@currency.Code">@currency.Code - @currency.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="border rounded p-3 mb-3">
                                        <h4>Supplier accounts</h4>
                                        @if (editingSupplierAccounts.Count == 0)
                                        {
                                            <p class="text-muted">No account numbers have been added.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm align-middle">
                                                    <thead><tr><th>Label</th><th>Account number</th><th></th></tr></thead>
                                                    <tbody>
                                                        @foreach (var account in editingSupplierAccounts)
                                                        {
                                                            <tr>
                                                                <td>@account.Label</td>
                                                                <td>@account.AccountNumber</td>
                                                                <td class="text-end">
                                                                    @if (account.IsDefault)
                                                                    {
                                                                        <span class="badge text-bg-success me-2">Default</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="() => MakeDefaultSupplierAccount(account.Id)">Make default</button>
                                                                    }
                                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSupplierAccount(account.Id)">Delete</button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <div class="row align-items-end">
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Label</label>
                                                <InputText class="form-control" @bind-Value="newSupplierAccount.Label" placeholder="e.g. Lautoka" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Account number</label>
                                                <InputText class="form-control" @bind-Value="newSupplierAccount.AccountNumber" />
                                            </div>
                                            <div class="col-md-2 mb-2 form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="newSupplierAccount.MakeDefault" />
                                                <label class="form-check-label">Default</label>
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <button type="button" class="btn btn-outline-primary w-100" @onclick="AddSupplierAccount">Add account</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="border rounded p-3 mb-3">
                                        <h4>Payment bank accounts</h4>
                                        <p class="text-muted">New bank details stay pending until a different owner or administrator verifies them. Account numbers remain masked after entry.</p>
                                        @if (editingSupplierBankAccounts.Count == 0)
                                        {
                                            <p class="text-muted">No payment bank accounts have been added.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm align-middle">
                                                    <thead><tr><th>Account</th><th>Bank</th><th>Number</th><th>Status</th><th></th></tr></thead>
                                                    <tbody>
                                                        @foreach (var bankAccount in editingSupplierBankAccounts)
                                                        {
                                                            <tr>
                                                                <td>@bankAccount.AccountName</td>
                                                                <td>@(bankAccount.BankName ?? "—")</td>
                                                                <td>@BusinessPartyService.MaskBankAccountNumber(bankAccount.AccountNumber)</td>
                                                                <td>
                                                                    @if (bankAccount.IsVerified)
                                                                    {
                                                                        <span class="badge text-bg-success">Verified</span>
                                                                        @if (bankAccount.IsDefault)
                                                                        {
                                                                            <span class="badge text-bg-primary ms-1">Default</span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge text-bg-warning">Pending</span>
                                                                    }
                                                                </td>
                                                                <td class="text-end">
                                                                    @if (!bankAccount.IsVerified && canVerifyBankAccounts && bankAccount.SubmittedByUserId != userId)
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => VerifySupplierBankAccount(bankAccount.Id)">Verify</button>
                                                                    }
                                                                    @if (canVerifyBankAccounts)
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateSupplierBankAccount(bankAccount.Id)">Remove</button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <div class="row align-items-end">
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">Account name</label>
                                                <input class="form-control" @bind="newSupplierBankAccount.AccountName" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">Bank</label>
                                                <input class="form-control" @bind="newSupplierBankAccount.BankName" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Bank account number</label>
                                                <input class="form-control" autocomplete="off" @bind="newSupplierBankAccount.AccountNumber" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <button type="button" class="btn btn-outline-primary w-100" @onclick="SubmitSupplierBankAccount">Submit</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-8">
                                            <label class="form-label">
                                                Default purchase account
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseAccountId">
                                                <option value="">No default</option>

                                                @foreach (var account in purchaseAccounts)
                                                {
                                                    <option value="@account.Id">
                                                        @account.Code — @account.Name
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                Default VAT
                                            </label>

                                            <InputSelect class="form-select"
                                                         @bind-Value="editDefaults.DefaultPurchaseVatTreatment">
                                                <option value="">No default</option>

                                                @foreach (var vat in Enum.GetValues<VatTreatment>())
                                                {
                                                    <option value="@vat">
                                                        @vat
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4 mt-3">
                                            <label class="form-label">
                                                Supplier bill payment terms
                                            </label>

                                            <InputSelect class="form-select mb-2"
                                                         @bind-Value="editDefaults.DefaultSupplierBillPaymentTermType">
                                                <option value="@PaymentTermType.DaysAfterDocumentDate">Days after bill date</option>
                                                <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                                                <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                                                <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                                            </InputSelect>

                                            @if (editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfCurrentMonth &&
                                                 editDefaults.DefaultSupplierBillPaymentTermType != PaymentTermType.EndOfFollowingMonth)
                                            {
                                                <div class="input-group">
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="editDefaults.DefaultSupplierBillDueDays" />
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            }

                                            <div class="form-text">
                                                Bill due dates will use this payment rule.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                class="btn btn-primary me-2"
                                                @onclick="SaveDefaults">
                                            Save supplier settings
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelDefaults">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public string? ContactView { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    private AccessibleOrganisation? access;
    private string userId = string.Empty;
    private bool canEdit;
    private bool canVerifyBankAccounts;
    private bool showAddContact;
    private List<BusinessParty> parties = [];
    private List<LedgerAccount> salesAccounts = [];
    private List<LedgerAccount> purchaseAccounts = [];
    private IReadOnlyList<CurrencyOption> currencies = [];
    private ContactModel model = new();
    private Guid? editingEmailPartyId;
    private string? editingEmail;
    private string? editingAccountsEmail;
    private Guid? editingPartyId;
    private Guid? editingCustomerPartyId;
    private Guid? editingCustomerAccountId;
    private VatTreatment? editingCustomerVatTreatment;
    private int editingCustomerDueDays = 30;
    private PaymentTermType editingCustomerPaymentTermType = PaymentTermType.DaysAfterDocumentDate;
    private string editingCustomerCurrency = "FJD";
    private PurchaseDefaultsModel editDefaults = new();
    private List<SupplierAccountProfile> editingSupplierAccounts = [];
    private NewSupplierAccountModel newSupplierAccount = new();
    private List<SupplierBankAccount> editingSupplierBankAccounts = [];
    private NewSupplierBankAccountModel newSupplierBankAccount = new();
    private string searchTerm = string.Empty;
    private string? status;
    private string statusClass = "alert-success";
    private CancellationTokenSource? statusDismissal;

    private void ShowStatus(string message, string cssClass)
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();

        status = message;
        statusClass = cssClass;
        statusDismissal = new CancellationTokenSource();
        _ = DismissStatusAfterDelayAsync(statusDismissal.Token);
    }

    private void DismissStatus()
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();
        statusDismissal = null;
        status = null;
    }

    private async Task DismissStatusAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);
            await InvokeAsync(() =>
            {
                if (!cancellationToken.IsCancellationRequested)
                {
                    status = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // A newer message replaced this one, or it was dismissed manually.
        }
    }

    public void Dispose()
    {
        statusDismissal?.Cancel();
        statusDismissal?.Dispose();
    }

    private string NormalizedView => ContactView?.ToLowerInvariant() switch
    {
        "customers" => "customers",
        "suppliers" => "suppliers",
        _ => "all"
    };
    private string PageHeading => NormalizedView switch
    {
        "customers" => "Customers",
        "suppliers" => "Suppliers",
        _ => "All contacts"
    };
    private static string NormalizeForSearch(string value) => value.Trim().ToUpperInvariant();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is not null)
        {
            canEdit = await TenantAccess.CanManageContactsAsync(userId, OrganisationId);
            canVerifyBankAccounts = await TenantAccess.CanManageTeamAsync(userId, OrganisationId);
            searchTerm = Query?.Trim() ?? string.Empty;
            currencies = await CurrencyService.ListAsync(userId, OrganisationId);
            model = new ContactModel
        {
            Type = NormalizedView == "suppliers"
                ? PartyType.Supplier
                : PartyType.Customer,
            DefaultSalesInvoicePaymentTermType =
                access?.Organisation.DefaultSalesInvoicePaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSalesInvoiceDueDays =
                access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
            DefaultSupplierBillPaymentTermType =
                access?.Organisation.DefaultSupplierBillPaymentTermType
                ?? PaymentTermType.DaysAfterDocumentDate,
            DefaultSupplierBillDueDays =
                access?.Organisation.DefaultSupplierBillDueDays ?? 30,
            DefaultSalesCurrency = access!.Organisation.BaseCurrency,
            DefaultPurchaseCurrency = access.Organisation.BaseCurrency
        };
            purchaseAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type == AccountType.Expense || x.Code == "1200" || x.Code == "1500")).OrderBy(x => x.Code).ToListAsync();
            salesAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.Type == AccountType.Revenue).OrderBy(x => x.Code).ToListAsync();
            await Reload();
        }
    }

    private async Task Reload()
    {
        var query = Db.BusinessParties.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive);
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var normalized = NormalizeForSearch(searchTerm);
            query = query.Where(x => x.Name.ToUpper().Contains(normalized) ||
                                     (x.Email ?? "").ToUpper().Contains(normalized) ||
                                     (x.AccountsEmail ?? "").ToUpper().Contains(normalized) ||
                                     (x.Tin ?? "").ToUpper().Contains(normalized) ||
                                     x.SupplierAccounts.Any(a => a.AccountNumber.ToUpper().Contains(normalized) ||
                                                                 a.Label.ToUpper().Contains(normalized)) ||
                                     (x.VatRegistrationNumber ?? "").ToUpper().Contains(normalized));
        }
        query = NormalizedView switch
        {
            "customers" => query.Where(x => (x.Type & PartyType.Customer) != 0),
            "suppliers" => query.Where(x => (x.Type & PartyType.Supplier) != 0),
            _ => query
        };
        parties = await query
            .Include(x => x.DefaultSalesAccount)
            .Include(x => x.DefaultPurchaseAccount)
            .Include(x => x.SupplierAccounts)
            .Include(x => x.SupplierBankAccounts.Where(a => a.IsActive))
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private async Task Create()
    {
        if (!canEdit) return;
        try
        {
            var party = await BusinessParties.CreateAsync(
                userId,
                new CreateBusinessPartyRequest(
                    OrganisationId,
                    model.Name,
                    model.Email,
                    model.Tin,
                    model.Type,
                    model.DefaultSalesAccountId,
                    model.DefaultSalesVatTreatment,
                    model.DefaultPurchaseAccountId,
                    model.DefaultPurchaseVatTreatment,
                    model.DefaultSalesInvoicePaymentTermType,
                    model.DefaultSalesInvoiceDueDays,
                    model.DefaultSupplierBillPaymentTermType,
                    model.DefaultSupplierBillDueDays,
                    model.SupplierAccountNumber,
                    model.VatRegistrationNumber,
                    model.DefaultSalesCurrency,
                    model.DefaultPurchaseCurrency,
                    model.AccountsEmail));
            model = new ContactModel
            {
                Type = NormalizedView == "suppliers"
                    ? PartyType.Supplier
                    : PartyType.Customer,
                DefaultSalesInvoicePaymentTermType =
                    access?.Organisation.DefaultSalesInvoicePaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSalesInvoiceDueDays =
                    access?.Organisation.DefaultSalesInvoiceDueDays ?? 30,
                DefaultSupplierBillPaymentTermType =
                    access?.Organisation.DefaultSupplierBillPaymentTermType
                    ?? PaymentTermType.DaysAfterDocumentDate,
                DefaultSupplierBillDueDays =
                    access?.Organisation.DefaultSupplierBillDueDays ?? 30,
                DefaultSalesCurrency = access?.Organisation.BaseCurrency ?? "FJD",
                DefaultPurchaseCurrency = access?.Organisation.BaseCurrency ?? "FJD"
            };
            showAddContact = false;
            ShowStatus($"{party.Name} added successfully.", "alert-success");
            await Reload();
        }
        catch (Exception ex)
        {
            ShowStatus($"Contact was not added: {ex.Message}", "alert-danger");
        }
    }

