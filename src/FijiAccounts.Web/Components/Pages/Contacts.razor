    private class PurchaseDefaultsModel { [StringLength(80)] public string? VatRegistrationNumber { get; set; } public Guid? DefaultSalesAccountId { get; set; } public VatTreatment? DefaultSalesVatTreatment { get; set; } public Guid? DefaultPurchaseAccountId { get; set; } public VatTreatment? DefaultPurchaseVatTreatment { get; set; } [Required, StringLength(3, MinimumLength = 3)] public string DefaultSalesCurrency { get; set; } = "FJD"; [Required, StringLength(3, MinimumLength = 3)] public string DefaultPurchaseCurrency { get; set; } = "FJD"; public PaymentTermType DefaultSalesInvoicePaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSalesInvoiceDueDays { get; set; } = 30; public PaymentTermType DefaultSupplierBillPaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSupplierBillDueDays { get; set; } = 30; }
    private static string FormatPaymentTerms(
        PaymentTermType type,
        int value)
    {
        return type switch
        {
            PaymentTermType.DaysAfterDocumentDate =>
                $"{value} days",

            PaymentTermType.DayOfFollowingMonth =>
                $"{value}th of following month",

            PaymentTermType.EndOfCurrentMonth =>
                "End of current month",

            PaymentTermType.EndOfFollowingMonth =>
                "End of following month",

            _ =>
                $"{value} days"
        };
    }
