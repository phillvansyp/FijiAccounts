@page "/o/{OrganisationId:guid}/notifications"
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@attribute [Authorize]

@inject NotificationService NotificationService
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TenantAccessService TenantAccess
@inject OrganisationUpdateBroker Updates
@inject IServiceScopeFactory ScopeFactory

@if (access is null)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else
{
<h1>Notifications</h1>

<div class="notification-filters">

    <div class="filter-group">
        <button class="@GetCategoryClass(null)"
                @onclick="() => selectedCategory = null">
            All
        </button>

        <button class="@GetCategoryClass(NotificationType.PaymentDueSoon)"
                @onclick="() => selectedCategory = NotificationType.PaymentDueSoon">
            Financial
        </button>

        <button class="@GetCategoryClass(NotificationType.DocumentExpiry)"
                @onclick="() => selectedCategory = NotificationType.DocumentExpiry">
            Documents
        </button>

        <button class="@GetCategoryClass(NotificationType.System)"
                @onclick="() => selectedCategory = NotificationType.System">
            System
        </button>

        <button class="@GetCategoryClass(NotificationType.VatRegistration)"
                @onclick="() => selectedCategory = NotificationType.VatRegistration">
            Tax
        </button>
    </div>


    <div class="filter-group">

        <button class="@GetStatusClass(null)"
                @onclick="() => selectedStatus = null">
            All
        </button>

        <button class="@GetStatusClass(NotificationStatus.Open)"
                @onclick="() => selectedStatus = NotificationStatus.Open">
            Open
        </button>

        <button class="@GetStatusClass(NotificationStatus.Acknowledged)"
                @onclick="() => selectedStatus = NotificationStatus.Acknowledged">
            Acknowledged
        </button>

        <button class="@GetStatusClass(NotificationStatus.Resolved)"
                @onclick="() => selectedStatus = NotificationStatus.Resolved">
            Resolved
        </button>

    </div>

</div>

@if (notifications.Count == 0)
{
    <div class="alert alert-info">
        No notifications.
    </div>
}
else
{
    <div class="notification-table">

        <div class="notification-header">
            <div>Severity</div>
            <div>Alert</div>
            <div>Details</div>
            <div>Amount</div>
            <div>Date</div>
            <div>Actions</div>
        </div>

        @foreach (var notification in FilteredNotifications)
        {
            <div class="notification-row">

                <div>
                    <span class="@GetSeverityClass(notification.Severity)">
                        @GetSeverityText(notification.Severity)
                    </span>
                </div>

                <div>
                    <strong>
                        @notification.Title
                    </strong>
                </div>

                <div class="notification-details">
                    @notification.Message
                </div>

                <div class="notification-amount">

                    @if (notification.Amount.HasValue)
                    {
                        <span class="text-danger fw-bold">
                            @notification.Currency
                            @notification.Amount.Value.ToString("N2")
                        </span>
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

                <div>
                    @(notification.CreatedAt
                        .ToLocalTime()
                        .ToString("dd MMM yyyy"))
                </div>

                <div class="notification-actions">

                    @if (notificationLinks.TryGetValue(
                        notification.Id,
                        out var link))
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           href="@link"
                           target="_blank">
                            Open
                        </a>
                    }

                    @if (notification.Status == NotificationStatus.Open)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => Acknowledge(notification.Id)">
                            Acknowledge
                        </button>
                    }
                    else if (notification.Status == NotificationStatus.Acknowledged)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                @onclick="() => Resolve(notification.Id)">
                            Resolve
                        </button>
                    }
                    else
                    {
                        <span class="text-success">
                            Resolved
                        </span>
                    }

                </div>

            </div>
        }

    </div>
}
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    private static string GetSeverityText(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "Critical",
            NotificationSeverity.Warning => "Warning",
            _ => "Info"
        };
    }


    private static string GetSeverityClass(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "text-danger",
            NotificationSeverity.Warning => "text-warning",
            _ => "text-info"
        };
    }
    private List<Notification> notifications = [];
    private Dictionary<Guid, string> notificationLinks = [];
    private AccessibleOrganisation? access;
    private string userId = "";
    private IDisposable? updateSubscription;
    private bool liveRefreshInProgress;
    private bool liveRefreshRequested;

    private NotificationType? selectedCategory;

    private NotificationStatus? selectedStatus;

    private IEnumerable<Notification> FilteredNotifications =>
        notifications
            .Where(
                x =>
                    (!selectedCategory.HasValue ||
                     x.Type == selectedCategory.Value)
                    &&
                    (!selectedStatus.HasValue ||
                     x.Status == selectedStatus.Value));

    protected override void OnInitialized()
    {
        updateSubscription =
            Updates.Subscribe(OrganisationUpdated);
    }


    private string GetCategoryClass(
        NotificationType? type)
    {
        return selectedCategory == type
            ? "filter-active"
            : "filter-button";
    }


    private string GetStatusClass(
        NotificationStatus? status)
    {
        return selectedStatus == status
            ? "filter-active"
            : "filter-button";
    }

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(userId, OrganisationId);

        if (access is null)
        {
            notifications = [];
            notificationLinks.Clear();
            return;
        }

        ApplyCategoryFilter();

        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync(
        NotificationService? notificationService = null,
        ApplicationDbContext? db = null)
    {
        notificationService ??= NotificationService;
        db ??= Db;

        notifications =
            await notificationService.GetUnreadAsync(
                userId,
                OrganisationId);

        notificationLinks.Clear();

        foreach (var notification in notifications)
        {
            if (notification.RelatedEntityType == "BusinessPartyDocument" &&
                Guid.TryParse(
                    notification.RelatedEntityId,
                    out var documentId))
            {
                var document =
                    await db.BusinessPartyDocuments
                        .AsNoTracking()
                        .SingleOrDefaultAsync(
                            x =>
                                x.Id == documentId &&
                                x.OrganisationId == OrganisationId);

                if (document is not null)
                {
                    notificationLinks[notification.Id] =
                        $"/api/o/{document.OrganisationId}/contacts/{document.BusinessPartyId}/documents/{document.Id}";
                }
            }
            else if (notification.RelatedEntityType == "SalesInvoice" &&
                     Guid.TryParse(
                         notification.RelatedEntityId,
                         out var invoiceId))
            {
                notificationLinks[notification.Id] =
                    $"/o/{OrganisationId}/sales/{invoiceId}";
            }
            else if (notification.RelatedEntityType == "SupplierBill" &&
                     Guid.TryParse(
                         notification.RelatedEntityId,
                         out var billId))
            {
                notificationLinks[notification.Id] =
                    $"/o/{OrganisationId}/purchases/{billId}";
            }
        }
    }

    private async Task Acknowledge(Guid id)
    {
        await NotificationService.AcknowledgeAsync(
            userId,
            OrganisationId,
            id);
    }


    private async Task Resolve(Guid id)
    {
        await NotificationService.ResolveAsync(
            userId,
            OrganisationId,
            id);
    }

    private void ApplyCategoryFilter()
    {
        if (Category == "financial")
        {
            selectedCategory = NotificationType.PaymentDueSoon;
        }
        else if (Category == "documents")
        {
            selectedCategory = NotificationType.DocumentExpiry;
        }
        else if (Category == "system")
        {
            selectedCategory = NotificationType.System;
        }
    }

    private void OrganisationUpdated(Guid organisationId)
    {
        if (organisationId != OrganisationId)
        {
            return;
        }

        _ = InvokeAsync(RefreshFromLiveUpdateAsync);
    }

    private async Task RefreshFromLiveUpdateAsync()
    {
        liveRefreshRequested = true;

        if (liveRefreshInProgress)
        {
            return;
        }

        liveRefreshInProgress = true;

        try
        {
            while (liveRefreshRequested)
            {
                liveRefreshRequested = false;

                await using var scope =
                    ScopeFactory.CreateAsyncScope();

                await LoadNotificationsAsync(
                    scope.ServiceProvider.GetRequiredService<NotificationService>(),
                    scope.ServiceProvider.GetRequiredService<ApplicationDbContext>());

                StateHasChanged();
            }
        }
        finally
        {
            liveRefreshInProgress = false;
        }
    }

    public void Dispose() =>
        updateSubscription?.Dispose();
}
