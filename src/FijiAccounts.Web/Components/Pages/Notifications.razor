@page "/o/{OrganisationId:guid}/notifications"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@attribute [Authorize]

@inject NotificationService NotificationService
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<h1>Notifications</h1>

@if (notifications.Count == 0)
{
    <div class="alert alert-info">
        No notifications.
    </div>
}
else
{
    <div class="list-group">

        @foreach (var notification in notifications)
        {
            <div class="list-group-item">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>

                        <span class="@GetSeverityClass(notification.Severity)">
                            @GetSeverityText(notification.Severity)
                        </span>

                        <span class="ms-2">
                            @notification.Title
                        </span>

                    </strong>

                    <span>
                        @(notification.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy"))
                    </span>

                </div>


                <div>
                    @notification.Message
                </div>
                <div class="mt-2 d-flex gap-2">

                    @if (notificationLinks.TryGetValue(
                        notification.Id,
                        out var link))
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           href="@link"
                           target="_blank">
                            Open document
                        </a>
                    }

                    @if (notification.Status == NotificationStatus.Open)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => Acknowledge(notification.Id)">
                            Acknowledge
                        </button>
                    }
                    else if (notification.Status == NotificationStatus.Acknowledged)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                @onclick="() => Resolve(notification.Id)">
                            Resolve
                        </button>
                    }
                    else
                    {
                        <span class="text-success align-self-center">
                            Resolved
                        </span>
                    }

                </div>

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    private static string GetSeverityText(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "Critical",
            NotificationSeverity.Warning => "Warning",
            _ => "Info"
        };
    }


    private static string GetSeverityClass(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "text-danger",
            NotificationSeverity.Warning => "text-warning",
            _ => "text-info"
        };
    }
    private List<Notification> notifications = [];
    private Dictionary<Guid, string> notificationLinks = [];
    private string userId = "";

    protected override async Task OnInitializedAsync()
    {
        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);

        foreach (var notification in notifications)
        {
            if (notification.RelatedEntityType == "BusinessPartyDocument" &&
                Guid.TryParse(
                    notification.RelatedEntityId,
                    out var documentId))
            {
                var document =
                    await Db.BusinessPartyDocuments
                        .AsNoTracking()
                        .SingleOrDefaultAsync(
                            x => x.Id == documentId);

                if (document is not null)
                {
                    notificationLinks[notification.Id] =
                        $"/api/o/{document.OrganisationId}/contacts/{document.BusinessPartyId}/documents/{document.Id}";
                }
            }
            else if (notification.RelatedEntityType == "SalesInvoice" &&
                     Guid.TryParse(
                         notification.RelatedEntityId,
                         out var invoiceId))
            {
                notificationLinks[notification.Id] =
                    $"/o/{OrganisationId}/sales/{invoiceId}";
            }
        }
    }

    private async Task Acknowledge(Guid id)
    {
        await NotificationService.AcknowledgeAsync(
            id,
            userId);

        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);
    }


    private async Task Resolve(Guid id)
    {
        await NotificationService.ResolveAsync(
            id,
            userId);

        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);
    }

    private async Task MarkRead(Guid id)
    {
        await NotificationService.MarkAsReadAsync(id);

        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);
    }
}
