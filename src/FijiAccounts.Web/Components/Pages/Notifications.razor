@page "/o/{OrganisationId:guid}/notifications"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@attribute [Authorize]

@inject NotificationService NotificationService
@inject ApplicationDbContext Db

<h1>Notifications</h1>

@if (notifications.Count == 0)
{
    <div class="alert alert-info">
        No notifications.
    </div>
}
else
{
    <div class="list-group">

        @foreach (var notification in notifications)
        {
            <div class="list-group-item">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>

                        <span class="@GetSeverityClass(notification.Severity)">
                            @GetSeverityText(notification.Severity)
                        </span>

                        <span class="ms-2">
                            @notification.Title
                        </span>

                    </strong>

                    <span>
                        @(notification.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy"))
                    </span>

                </div>


                <div>
                    @notification.Message
                </div>
                @if (notificationLinks.TryGetValue(
                    notification.Id,
                    out var link))
                {
                    <div class="mt-2">
                        <a class="btn btn-sm btn-outline-primary"
                           href="@link"
                           target="_blank">
                            Open document
                        </a>
                    </div>
                }


                <div class="mt-2">

                    @if (!notification.IsRead)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => MarkRead(notification.Id)">
                            Mark read
                        </button>
                    }

                </div>

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    private static string GetSeverityText(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "Critical",
            NotificationSeverity.Warning => "Warning",
            _ => "Info"
        };
    }


    private static string GetSeverityClass(
        NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Critical => "text-danger",
            NotificationSeverity.Warning => "text-warning",
            _ => "text-info"
        };
    }
    private List<Notification> notifications = [];
    private Dictionary<Guid, string> notificationLinks = [];

    protected override async Task OnInitializedAsync()
    {
        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);

        foreach (var notification in notifications)
        {
            if (notification.RelatedEntityType == "BusinessPartyDocument" &&
                Guid.TryParse(
                    notification.RelatedEntityId,
                    out var documentId))
            {
                var document =
                    await Db.BusinessPartyDocuments
                        .AsNoTracking()
                        .SingleOrDefaultAsync(
                            x => x.Id == documentId);

                if (document is not null)
                {
                    notificationLinks[notification.Id] =
                        $"/api/o/{document.OrganisationId}/contacts/{document.BusinessPartyId}/documents/{document.Id}";
                }
            }
        }
    }

    private async Task MarkRead(Guid id)
    {
        await NotificationService.MarkAsReadAsync(id);

        notifications =
            await NotificationService.GetUnreadAsync(
                OrganisationId);
    }
}
