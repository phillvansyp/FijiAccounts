@page "/o/{OrganisationId:guid}/requisitions"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject PurchaseRequisitionService Requisitions
@inject PurchaseApprovalPolicyService ApprovalPolicies
@inject ProjectService ProjectService
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Purchase requisitions · Account Island</PageTitle>

@if (accessDenied)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Procurement control</p>
            <h1>Purchase requisitions</h1>
            <p class="page-intro">Request, independently approve, and convert planned spending into purchase orders.</p>
        </div>
        @if (canCreate)
        {
            <button class="btn btn-primary" type="button" @onclick="() => showForm = !showForm">+ New requisition</button>
        }
    </div>

    @if (error is not null) { <div class="alert alert-danger">@error</div> }
    @if (message is not null) { <div class="alert alert-success">@message</div> }

    @if (showForm)
    {
        <section class="setup-card mb-4">
            <h2>New purchase requisition</h2>
            <EditForm Model="model" OnValidSubmit="Create" FormName="create-purchase-requisition">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Supplier</label>
                        <InputSelect class="form-select" @bind-Value="model.SupplierId">
                            <option value="@Guid.Empty">Choose supplier</option>
                            @foreach (var supplier in suppliers) { <option value="@supplier.Id">@supplier.Name</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Branch and division</label>
                        <InputSelect class="form-select" @bind-Value="model.DivisionId" @bind-Value:after="DimensionChanged">
                            <option value="@Guid.Empty">Choose scope</option>
                            @foreach (var option in dimensions) { <option value="@option.DivisionId">@option.BranchName · @option.DivisionName</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Request date</label>
                        <InputDate class="form-control" @bind-Value="model.RequestDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Required date</label>
                        <InputDate class="form-control" @bind-Value="model.RequiredDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Estimated total</label>
                        <input class="form-control" value="@((model.Quantity * model.EstimatedUnitPrice).ToString("N2"))" disabled />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Business purpose</label>
                    <textarea class="form-control" @bind="model.Purpose" @bind:event="oninput"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3"><label class="form-label">Description</label><input class="form-control" @bind="model.Description" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Quantity</label><input type="number" min="0.0001" step="0.0001" class="form-control" @bind="model.Quantity" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Estimated unit price</label><input type="number" min="0" step="0.0001" class="form-control" @bind="model.EstimatedUnitPrice" @bind:event="oninput" /></div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Expense or asset account</label>
                        <InputSelect class="form-select" @bind-Value="model.ExpenseAccountId">
                            <option value="@Guid.Empty">Choose account</option>
                            @foreach (var account in accounts) { <option value="@account.Id">@account.Code · @account.Name</option> }
                        </InputSelect>
                    </div>
                </div>
                <div class="row border rounded bg-light py-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Project</label>
                        <InputSelect class="form-select" @bind-Value="model.ProjectId" @bind-Value:after="ProjectChanged">
                            <option value="">No project</option>
                            @foreach (var project in EligibleProjects) { <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cost code</label>
                        <InputSelect class="form-select" @bind-Value="model.ProjectCostCodeId" disabled="@(model.ProjectId is null)">
                            <option value="">No cost code</option>
                            @foreach (var costCode in CostCodes(model.ProjectId)) { <option value="@costCode.Id">@costCode.Code &mdash; @costCode.Name</option> }
                        </InputSelect>
                    </div>
                </div>
                <button class="btn btn-primary" type="submit" disabled="@busy">Save draft</button>
            </EditForm>
        </section>
    }

    @if (canManagePolicies)
    {
        <section class="setup-card mb-4">
            <div class="card-heading"><div><h2>Approval policies</h2><p class="mb-0">More specific division or branch rules take precedence over organisation-wide rules.</p></div><span>@policies.Count</span></div>
            <EditForm Model="policyModel" OnValidSubmit="CreatePolicy" FormName="create-purchase-approval-policy">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3"><label class="form-label">Policy name</label><input class="form-control" @bind="policyModel.Name" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Minimum amount</label><input type="number" step="0.01" class="form-control" @bind="policyModel.MinimumAmount" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Maximum amount</label><input type="number" step="0.01" class="form-control" @bind="policyModel.MaximumAmount" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Required approver</label><InputSelect class="form-select" @bind-Value="policyModel.Requirement"><option value="@PurchaseApprovalRequirement.OwnerOrAdministrator">Owner, administrator or approver</option><option value="@PurchaseApprovalRequirement.OwnerOnly">Owner only</option></InputSelect></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Branch scope</label><InputSelect class="form-select" @bind-Value="policyModel.BranchId"><option value="">All branches</option>@foreach (var branch in branches) { <option value="@branch.Id">@branch.Name</option> }</InputSelect></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Division scope</label><InputSelect class="form-select" @bind-Value="policyModel.DivisionId"><option value="">All divisions</option>@foreach (var option in dimensions) { <option value="@option.DivisionId">@option.BranchName · @option.DivisionName</option> }</InputSelect></div>
                    <div class="col-md-auto mb-3"><button class="btn btn-outline-primary" type="submit" disabled="@busy">Add policy</button></div>
                </div>
            </EditForm>
            @if (policies.Count > 0)
            {
                <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Scope</th><th>Amount band</th><th>Requirement</th><th></th></tr></thead><tbody>
                    @foreach (var policy in policies)
                    {
                        <tr><td>@policy.Name</td><td>@PolicyScope(policy)</td><td>@policy.MinimumAmount.ToString("C2") – @(policy.MaximumAmount?.ToString("C2") ?? "No maximum")</td><td>@ApprovalLabel(policy.Requirement)</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePolicy(policy.Id)">Delete</button></td></tr>
                    }
                </tbody></table></div>
            }
        </section>
    }

    <section class="setup-card">
        <div class="card-heading"><h2>Requests</h2><span>@items.Count</span></div>
        @if (items.Count == 0)
        {
            <p>No purchase requisitions yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Request</th><th>Scope</th><th>Supplier</th><th>Status</th><th class="text-end">Total</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><strong>@item.RequisitionNumber</strong><div><small>@item.Purpose</small></div>@if (item.Lines.FirstOrDefault()?.ProjectId is Guid projectId) { <div><small class="text-secondary">@ProjectLabel(projectId, item.Lines[0].ProjectCostCodeId)</small></div> }</td>
                                <td>@item.Branch.Name · @item.Division.Name</td>
                                <td>@item.Supplier.Name</td>
                                <td><span class="badge text-bg-secondary">@item.Status</span></td>
                                <td class="text-end">@item.Total.ToString("C2")</td>
                                <td>
                                    @if (item.Status == PurchaseRequisitionStatus.Draft && item.CreatedByUserId == userId)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => Submit(item.Id)">Submit</button>
                                    }
                                    @if (item.Status == PurchaseRequisitionStatus.Submitted && CanActOn(item) && item.CreatedByUserId != userId)
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => Approve(item.Id)">Approve</button>
                                        <input class="form-control form-control-sm d-inline-block me-1" style="width: 12rem" placeholder="Rejection reason" @bind="rejectionReasons[item.Id]" />
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(item.Id)">Reject</button>
                                    }
                                    @if (item.Status == PurchaseRequisitionStatus.Submitted)
                                    {
                                        <small class="d-block text-secondary mt-1">Requires @ApprovalLabel(item.RequiredApproval)</small>
                                    }
                                    @if (item.Status == PurchaseRequisitionStatus.Approved)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => Convert(item.Id)">Create purchase order</button>
                                    }
                                    @if (item.Status == PurchaseRequisitionStatus.Converted)
                                    {
                                        <span class="text-secondary">Purchase order created</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private readonly RequisitionModel model = new();
    private readonly PolicyModel policyModel = new();
    private readonly Dictionary<Guid, string> rejectionReasons = [];
    private List<PurchaseRequisition> items = [];
    private List<BusinessParty> suppliers = [];
    private List<LedgerAccount> accounts = [];
    private List<DimensionOption> dimensions = [];
    private List<Branch> branches = [];
    private List<PurchaseApprovalPolicy> policies = [];
    private List<Project> projects = [];
    private string userId = string.Empty;
    private string? error;
    private string? message;
    private bool accessDenied;
    private bool canCreate;
    private bool canManagePolicies;
    private OrganisationRole? currentRole;
    private bool showForm;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User) ?? string.Empty;
        accessDenied = userId.Length == 0 || await TenantAccess.FindAsync(userId, OrganisationId) is null;
        if (accessDenied) return;
        canCreate = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
        canManagePolicies = await TenantAccess.CanManageTeamAsync(userId, OrganisationId);
        currentRole = await Db.OrganisationMemberships.AsNoTracking().Where(x => x.UserId == userId && x.OrganisationId == OrganisationId).Select(x => (OrganisationRole?)x.Role).SingleOrDefaultAsync();

        if (canCreate)
        {
            suppliers = await Db.BusinessParties.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type & PartyType.Supplier) != 0).OrderBy(x => x.Name).ToListAsync();
            accounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type == AccountType.Expense || x.Type == AccountType.Asset)).OrderBy(x => x.Code).ToListAsync();
            branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
            projects = await ProjectService.ListAsync(userId, OrganisationId);
            dimensions = branches
                .SelectMany(branch => branch.Divisions.Select(division => new DimensionOption(branch.Id, branch.Name, division.Id, division.Name))).ToList();
        }
        else if (canManagePolicies)
        {
            branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
            dimensions = branches
                .SelectMany(branch => branch.Divisions.Select(division => new DimensionOption(branch.Id, branch.Name, division.Id, division.Name))).ToList();
        }

        policies = canManagePolicies ? await ApprovalPolicies.ListAsync(userId, OrganisationId) : [];
        await Reload();
    }

    private async Task Create() => await Run(async () =>
    {
        var dimension = dimensions.SingleOrDefault(x => x.DivisionId == model.DivisionId)
            ?? throw new InvalidOperationException("Choose a branch and division.");
        var created = await Requisitions.CreateDraftAsync(userId, new PurchaseRequisitionRequest(
            OrganisationId, dimension.BranchId, dimension.DivisionId, model.SupplierId,
            model.RequestDate, model.RequiredDate, model.Purpose,
            [new PurchaseRequisitionLineRequest(model.Description, model.Quantity, model.EstimatedUnitPrice, model.ExpenseAccountId, ProjectId: model.ProjectId, ProjectCostCodeId: model.ProjectCostCodeId)]));
        message = $"{created.RequisitionNumber} saved as a draft.";
        showForm = false;
        ResetModel();
    });

    private Task Submit(Guid id) => Run(async () => { await Requisitions.SubmitAsync(userId, OrganisationId, id); message = "Requisition submitted for independent approval."; });
    private Task Approve(Guid id) => Run(async () => { await Requisitions.ApproveAsync(userId, OrganisationId, id); message = "Requisition approved."; });
    private Task Reject(Guid id) => Run(async () => { await Requisitions.RejectAsync(userId, OrganisationId, id, rejectionReasons[id]); message = "Requisition rejected."; });
    private Task Convert(Guid id) => Run(async () =>
    {
        var order = await Requisitions.ConvertToPurchaseOrderAsync(userId, OrganisationId, id);
        Navigation.NavigateTo($"/o/{OrganisationId}/purchase-orders/{order.Id}");
    });

    private Task CreatePolicy() => Run(async () =>
    {
        var branchId = policyModel.BranchId;
        if (policyModel.DivisionId is Guid divisionId)
        {
            var dimension = dimensions.SingleOrDefault(x => x.DivisionId == divisionId)
                ?? throw new InvalidOperationException("Choose a valid division scope.");
            if (branchId != null && branchId != dimension.BranchId)
            {
                throw new InvalidOperationException("The division must belong to the selected branch.");
            }
            branchId = dimension.BranchId;
        }
        await ApprovalPolicies.CreateAsync(userId, new PurchaseApprovalPolicyRequest(
            OrganisationId, policyModel.Name, policyModel.MinimumAmount, policyModel.MaximumAmount,
            policyModel.Requirement, branchId, policyModel.DivisionId));
        policyModel.Name = string.Empty;
        policyModel.MinimumAmount = 0;
        policyModel.MaximumAmount = null;
        policyModel.BranchId = policyModel.DivisionId = null;
        message = "Approval policy added.";
    });

    private Task DeletePolicy(Guid id) => Run(async () => { await ApprovalPolicies.DeleteAsync(userId, OrganisationId, id); message = "Approval policy deleted."; });

    private async Task Run(Func<Task> action)
    {
        error = message = null;
        busy = true;
        try { await action(); await Reload(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Reload()
    {
        items = await Requisitions.ListAsync(userId, OrganisationId);
        if (canManagePolicies) policies = await ApprovalPolicies.ListAsync(userId, OrganisationId);
        foreach (var item in items.Where(x => x.Status == PurchaseRequisitionStatus.Submitted))
        {
            rejectionReasons.TryAdd(item.Id, string.Empty);
        }
    }

    private void ResetModel()
    {
        model.SupplierId = Guid.Empty;
        model.DivisionId = Guid.Empty;
        model.RequestDate = DateOnly.FromDateTime(DateTime.Today);
        model.RequiredDate = DateOnly.FromDateTime(DateTime.Today.AddDays(14));
        model.Purpose = model.Description = string.Empty;
        model.Quantity = 1;
        model.EstimatedUnitPrice = 0;
        model.ExpenseAccountId = Guid.Empty;
        model.ProjectId = null;
        model.ProjectCostCodeId = null;
    }

    private IEnumerable<Project> EligibleProjects => projects.Where(x => x.DivisionId == model.DivisionId && x.Status is ProjectStatus.Active or ProjectStatus.OnHold);
    private IEnumerable<ProjectCostCode> CostCodes(Guid? projectId) => projects.SingleOrDefault(x => x.Id == projectId)?.CostCodes.Where(x => x.IsActive) ?? [];
    private Task ProjectChanged() { model.ProjectCostCodeId = null; return Task.CompletedTask; }
    private Task DimensionChanged() { model.ProjectId = null; model.ProjectCostCodeId = null; return Task.CompletedTask; }
    private string ProjectLabel(Guid projectId, Guid? costCodeId)
    {
        var project = projects.SingleOrDefault(x => x.Id == projectId);
        var costCode = project?.CostCodes.SingleOrDefault(x => x.Id == costCodeId);
        return project is null ? "Project coding unavailable" : costCode is null ? $"{project.ProjectNumber} — {project.Name}" : $"{project.ProjectNumber} — {project.Name} / {costCode.Code} — {costCode.Name}";
    }

    private sealed record DimensionOption(Guid BranchId, string BranchName, Guid DivisionId, string DivisionName);
    private bool CanActOn(PurchaseRequisition item) =>
        currentRole == OrganisationRole.Owner ||
        item.RequiredApproval == PurchaseApprovalRequirement.OwnerOrAdministrator &&
        currentRole is OrganisationRole.Administrator or OrganisationRole.Approver;
    private static string ApprovalLabel(PurchaseApprovalRequirement requirement) =>
        requirement == PurchaseApprovalRequirement.OwnerOnly
            ? "owner approval"
            : "owner, administrator or approver approval";
    private static string PolicyScope(PurchaseApprovalPolicy policy) => policy.Division?.Name ?? policy.Branch?.Name ?? "All branches and divisions";

    private sealed class PolicyModel
    {
        [Required, StringLength(120)] public string Name { get; set; } = string.Empty;
        [Range(typeof(decimal), "0", "999999999999")] public decimal MinimumAmount { get; set; }
        public decimal? MaximumAmount { get; set; }
        public PurchaseApprovalRequirement Requirement { get; set; } = PurchaseApprovalRequirement.OwnerOrAdministrator;
        public Guid? BranchId { get; set; }
        public Guid? DivisionId { get; set; }
    }

    private sealed class RequisitionModel
    {
        public Guid SupplierId { get; set; }
        public Guid DivisionId { get; set; }
        [Required] public DateOnly RequestDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly? RequiredDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(14));
        [Required, StringLength(500)] public string Purpose { get; set; } = string.Empty;
        [Required, StringLength(300)] public string Description { get; set; } = string.Empty;
        [Range(typeof(decimal), "0.0001", "999999999")] public decimal Quantity { get; set; } = 1;
        [Range(typeof(decimal), "0", "999999999")] public decimal EstimatedUnitPrice { get; set; }
        public Guid ExpenseAccountId { get; set; }
        public Guid? ProjectId { get; set; }
        public Guid? ProjectCostCodeId { get; set; }
    }
}
