@using FijiAccounts.Web.Services

<section class="report-section">
    <h3>@Title</h3>

    @if (!Rows.Any())
    {
        <div class="report-empty">No activity</div>
    }
    else
    {
        @foreach (var row in Rows)
        {
            <div class="report-line">
                <span>
                    @if (ShowAccountCodes)
                    {
                        <small>@row.Code</small>
                    }
                    @row.Name
                </span>

                <strong class="@(row.DisplayAmount < 0 ? "negative" : null)">
                    @if (DetailUrl is not null)
                    {
                        <a href="@DetailUrl(row)" rel="noopener" title="View transactions">@Money(row.DisplayAmount)</a>
                    }
                    else { @Money(row.DisplayAmount) }
                </strong>
            </div>
        }
    }

    <div class="report-total">
        <span>@TotalLabel</span>
        <strong>@Money(Total)</strong>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public IEnumerable<FinancialAccountBalance> Rows { get; set; } = [];

    [Parameter, EditorRequired]
    public string TotalLabel { get; set; } = "";

    [Parameter]
    public decimal Total { get; set; }

    [Parameter]
    public bool ShowAccountCodes { get; set; } = true;

    [Parameter]
    public bool ShowDecimals { get; set; } = true;

    [Parameter] public Func<FinancialAccountBalance, string>? DetailUrl { get; set; }

    private string Money(decimal value) =>
        ShowDecimals
            ? $"${value:N2}"
            : $"${value:N0}";
}