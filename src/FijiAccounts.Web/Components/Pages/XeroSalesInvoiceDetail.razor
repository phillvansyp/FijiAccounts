@page "/o/{OrganisationId:guid}/sales/xero/{RecordId:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(invoice?.InvoiceNumber ?? "Xero invoice") · Account Island</PageTitle>

@if (loading)
{
    <div class="dashboard-loading">Opening the Xero invoice...</div>
}
else if (access is null || invoice is null)
{
    <div class="alert alert-danger">This Xero invoice is unavailable or you do not have access to it.</div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Money in · Xero read-only</p>
            <h1>@invoice.InvoiceNumber</h1>
            <p class="page-intro">@invoice.ContactName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" href="o/@OrganisationId/sales">Back to sales invoices</a>
            <a class="btn btn-outline-primary" href="o/@OrganisationId/integrations/xero">Xero sync</a>
        </div>
    </div>

    <div class="alert alert-info">
        This invoice is copied from Xero for reporting. Xero remains the source of truth, so changes and payments must be recorded in Xero.
    </div>

    <section class="detail-card mb-4">
        <div class="detail-grid">
            <div><span>Status</span><strong>@invoice.StatusLabel</strong></div>
            <div><span>Invoice date</span><strong>@invoice.IssueDate.ToString("dd MMM yyyy")</strong></div>
            <div><span>Due date</span><strong>@invoice.DueDate.ToString("dd MMM yyyy")</strong></div>
            <div><span>Reference</span><strong>@(string.IsNullOrWhiteSpace(invoice.Reference) ? "—" : invoice.Reference)</strong></div>
            <div><span>Currency</span><strong>@invoice.Currency</strong></div>
            <div><span>Outstanding</span><strong>@invoice.Currency @invoice.AmountDue.ToString("N2")</strong></div>
        </div>
    </section>

    <section class="detail-card mb-4">
        <h2>Invoice lines</h2>
        @if (invoice.Lines.Count == 0)
        {
            <p class="text-muted mb-0">Xero did not return line details for this invoice.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Description</th><th>Account</th><th>Tax</th><th class="text-end">Quantity</th><th class="text-end">Unit price</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var line in invoice.Lines)
                    {
                        <tr>
                            <td>@line.Description</td>
                            <td>@(string.IsNullOrWhiteSpace(line.AccountCode) ? "—" : line.AccountCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(line.TaxType) ? "—" : line.TaxType)</td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@invoice.Currency @line.UnitAmount.ToString("N2")</td>
                            <td class="text-end">@invoice.Currency @line.LineAmount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="totals">
            <div><span>Subtotal</span><strong>@invoice.Currency @invoice.Subtotal.ToString("N2")</strong></div>
            <div><span>Tax</span><strong>@invoice.Currency @invoice.TaxTotal.ToString("N2")</strong></div>
            <div><span>Total</span><strong>@invoice.Currency @invoice.Total.ToString("N2")</strong></div>
            <div><span>Paid / credited</span><strong>@invoice.Currency @((invoice.AmountPaid + invoice.AmountCredited).ToString("N2"))</strong></div>
            <div><span>Amount due</span><strong>@invoice.Currency @invoice.AmountDue.ToString("N2")</strong></div>
            @if (!invoice.Currency.Equals(access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase))
            {
                <div><span>Amount due in @access.Organisation.BaseCurrency</span><strong>@access.Organisation.BaseCurrency @invoice.BaseAmountDue.ToString("N2")</strong></div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public Guid RecordId { get; set; }
    private AccessibleOrganisation? access;
    private XeroSalesInvoiceProjection? invoice;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        invoice = null;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(state.User) ?? string.Empty;
        access = string.IsNullOrWhiteSpace(userId) ? null : await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is not null && await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId) is null)
        {
            var record = await Db.XeroMirrorRecords.AsNoTracking()
                .SingleOrDefaultAsync(x => x.Id == RecordId && x.OrganisationId == OrganisationId &&
                    x.DatasetKey == "sales-invoices" && !x.IsArchived && x.Connection.IsActive);
            if (record is not null && XeroSalesInvoiceProjectionParser.TryParse(record, out var projection))
                invoice = projection;
        }
        loading = false;
    }
}
