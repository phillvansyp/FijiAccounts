@page "/o/{OrganisationId:guid}/projects"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject ProjectService ProjectService
@inject ProjectProfitabilityService ProjectProfitabilityService
@inject ProjectProgressClaimService ProjectProgressClaimService
@inject ProjectRevenueRecognitionService ProjectRevenueRecognitionService
@inject ProjectWipPostingService ProjectWipPostingService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Projects &amp; jobs &middot; Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Operations</p>
            <h1>Projects &amp; jobs</h1>
            <p class="page-intro">Control contract value, variations, progress claims, retentions, forecast cost and cost-code budgets by branch and division.</p>
        </div>
        <button class="btn btn-outline-secondary no-print" onclick="window.print()">Print register</button>
    </div>

    @if (canManage && divisions.Count > 0)
    {
        <details class="setup-card mb-4">
            <summary><strong>+ Create project</strong></summary>
            <EditForm Model="model" OnValidSubmit="SaveProject" FormName="project-register" class="mt-3">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="row">
                    <div class="col-md-2 mb-3"><label class="form-label">Project number</label><input class="form-control" @bind="model.ProjectNumber" @bind:event="oninput" /></div>
                    <div class="col-md-4 mb-3"><label class="form-label">Project name</label><input class="form-control" @bind="model.Name" @bind:event="oninput" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Branch and division</label><InputSelect class="form-select" @bind-Value="model.DivisionId">@foreach (var item in divisions) { <option value="@item.DivisionId">@item.Label</option> }</InputSelect></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Customer</label><InputSelect class="form-select" @bind-Value="model.CustomerId"><option value="">No customer selected</option>@foreach (var customer in customers) { <option value="@customer.Id">@customer.Name</option> }</InputSelect></div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3"><label class="form-label">Start date</label><InputDate class="form-control" @bind-Value="model.StartDate" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Expected completion</label><InputDate class="form-control" @bind-Value="model.ExpectedCompletionDate" /></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Description</label><input class="form-control" @bind="model.Description" @bind:event="oninput" /></div>
                </div>
                <div class="row">
                    <div class="col-md-2 mb-3"><label class="form-label">Original contract</label><input type="number" step="0.01" class="form-control" @bind="model.OriginalContractValue" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Opening variations</label><input type="number" step="0.01" class="form-control" @bind="model.ApprovedVariationValue" @bind:event="oninput" /><div class="form-text">Existing approvals.</div></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Forecast cost</label><input type="number" step="0.01" class="form-control" @bind="model.ForecastCost" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Retention %</label><input type="number" step="0.01" class="form-control" @bind="model.RetentionPercent" @bind:event="oninput" /></div>
                    <div class="col-md-4 mb-3"><label class="form-label">Revenue recognition</label><InputSelect class="form-select" @bind-Value="model.RevenueRecognitionMethod">@foreach (var method in Enum.GetValues<ProjectRevenueRecognitionMethod>()) { <option value="@method">@RecognitionMethodLabel(method)</option> }</InputSelect><div class="form-text">Cost-to-cost uses actual cost / forecast cost. Certified claims uses approved work.</div></div>
                </div>
                <button class="btn btn-primary">Create project</button>
            </EditForm>
        </details>
    }

    @if (canManage && projects.Any(x => x.Status is not ProjectStatus.Completed and not ProjectStatus.Cancelled))
    {
        <details class="setup-card mb-4">
            <summary><strong>+ Add project cost code</strong></summary>
            <EditForm Model="costCodeModel" OnValidSubmit="AddCostCode" FormName="project-cost-code" class="mt-3">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="row">
                    <div class="col-md-3 mb-3"><label class="form-label">Project</label><InputSelect class="form-select" @bind-Value="costCodeModel.ProjectId">@foreach (var project in projects.Where(x => x.Status is not ProjectStatus.Completed and not ProjectStatus.Cancelled)) { <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option> }</InputSelect></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Code</label><input class="form-control" @bind="costCodeModel.Code" @bind:event="oninput" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Name</label><input class="form-control" @bind="costCodeModel.Name" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Category</label><InputSelect class="form-select" @bind-Value="costCodeModel.Category">@foreach (var category in CostCategories) { <option value="@category">@CostCategoryLabel(category)</option> }</InputSelect></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Budget</label><input type="number" step="0.01" class="form-control" @bind="costCodeModel.BudgetAmount" @bind:event="oninput" /></div>
                </div>
                <button class="btn btn-primary">Add cost code</button>
            </EditForm>
        </details>
    }

    @if (canManage && projects.Any(x => x.Status is ProjectStatus.Active or ProjectStatus.OnHold))
    {
        <details class="setup-card mb-4">
            <summary><strong>+ Add contract variation</strong></summary>
            <EditForm Model="variationModel" OnValidSubmit="CreateVariation" FormName="project-variation" class="mt-3">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="row">
                    <div class="col-md-4 mb-3"><label class="form-label">Project</label><InputSelect class="form-select" @bind-Value="variationModel.ProjectId">@foreach (var project in projects.Where(x => x.Status is ProjectStatus.Active or ProjectStatus.OnHold)) { <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option> }</InputSelect></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Variation number</label><input class="form-control" @bind="variationModel.VariationNumber" @bind:event="oninput" /></div>
                    <div class="col-md-4 mb-3"><label class="form-label">Title</label><input class="form-control" @bind="variationModel.Title" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Amount</label><input type="number" step="0.01" class="form-control" @bind="variationModel.Amount" @bind:event="oninput" /></div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3"><label class="form-label">Requested date</label><InputDate class="form-control" @bind-Value="variationModel.RequestedDate" /></div>
                    <div class="col-md-9 mb-3"><label class="form-label">Description</label><textarea class="form-control" @bind="variationModel.Description" @bind:event="oninput"></textarea></div>
                </div>
                <button class="btn btn-primary">Save draft variation</button>
            </EditForm>
        </details>
    }

    @if (canManage && EligibleClaimProjects.Any() && revenueAccounts.Count > 0)
    {
        <details class="setup-card mb-4">
            <summary><strong>+ Add progress claim</strong></summary>
            <EditForm Model="claimModel" OnValidSubmit="CreateClaim" FormName="project-progress-claim" class="mt-3">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="row">
                    <div class="col-md-4 mb-3"><label class="form-label">Project</label><InputSelect class="form-select" @bind-Value="claimModel.ProjectId" @bind-Value:after="ApplyClaimProjectDefaults">@foreach (var project in EligibleClaimProjects) { <option value="@project.Id">@project.ProjectNumber &mdash; @project.Name</option> }</InputSelect></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Claim number</label><input class="form-control" @bind="claimModel.ClaimNumber" @bind:event="oninput" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Period end</label><InputDate class="form-control" @bind-Value="claimModel.ClaimPeriodEnd" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Work completed excl. VAT</label><input type="number" step="0.01" class="form-control" @bind="claimModel.WorkCompletedAmount" @bind:event="oninput" /><div class="form-text">Retention held: $@ClaimRetentionHeld.ToString("N2")</div></div>
                </div>
                <div class="row">
                    <div class="col-md-5 mb-3"><label class="form-label">Description</label><input class="form-control" @bind="claimModel.Description" @bind:event="oninput" /></div>
                    <div class="col-md-2 mb-3"><label class="form-label">Retention released</label><input type="number" step="0.01" class="form-control" @bind="claimModel.RetentionReleasedAmount" @bind:event="oninput" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Revenue account</label><InputSelect class="form-select" @bind-Value="claimModel.RevenueAccountId">@foreach (var account in revenueAccounts) { <option value="@account.Id">@account.Code &mdash; @account.Name</option> }</InputSelect></div>
                    <div class="col-md-2 mb-3"><label class="form-label">VAT</label><InputSelect class="form-select" @bind-Value="claimModel.VatTreatment">@foreach (var treatment in Enum.GetValues<VatTreatment>()) { <option value="@treatment">@VatLabel(treatment)</option> }</InputSelect></div>
                </div>
                <button class="btn btn-primary">Save draft claim</button>
            </EditForm>
        </details>
    }

    @if (message is not null)
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="detail-card h-100"><span class="eyebrow">Open projects</span><h2>@projects.Count(x => x.Status is ProjectStatus.Draft or ProjectStatus.Active or ProjectStatus.OnHold)</h2></div></div>
        <div class="col-md-3"><div class="detail-card h-100"><span class="eyebrow">Actual revenue</span><h2>$@OpenProfitability.Sum(x => x.ActualRevenue).ToString("N2")</h2></div></div>
        <div class="col-md-3"><div class="detail-card h-100"><span class="eyebrow">Actual cost</span><h2>$@OpenProfitability.Sum(x => x.ActualCost).ToString("N2")</h2></div></div>
        <div class="col-md-3"><div class="detail-card h-100"><span class="eyebrow">Actual margin</span><h2>$@OpenProfitability.Sum(x => x.ActualMargin).ToString("N2")</h2></div></div>
    </div>

    <section class="detail-card mb-4">
        <div class="card-heading">
            <div><span class="eyebrow">Revenue recognition</span><h2>Work in progress</h2></div>
            <div class="d-flex gap-2 align-items-center no-print"><label class="small text-muted" for="recognition-as-at">As at</label><InputDate id="recognition-as-at" class="form-control form-control-sm" @bind-Value="recognitionAsAt" /><button class="btn btn-sm btn-outline-primary" @onclick="RefreshRecognition">Refresh</button></div>
        </div>
        <p class="text-muted">Review earned revenue against billed revenue, then manually post the required WIP true-up when the organisation's WIP accounts are configured.</p>
        @if (projects.Count == 0)
        {
            <div class="empty-state"><strong>No projects</strong><span>Create a project to calculate revenue recognition.</span></div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>Project</th><th>Basis</th><th class="text-end">Complete</th><th class="text-end">Revised contract</th><th class="text-end">Earned revenue</th><th class="text-end">Billed revenue</th><th>WIP position</th><th class="text-end">Margin</th></tr></thead>
                <tbody>
                @foreach (var project in projects)
                {
                    var recognition = Recognition(project.Id);
                    <tr>
                        <td><strong>@project.ProjectNumber &mdash; @project.Name</strong><small class="d-block text-muted">$@(recognition?.CertifiedWorkValue.ToString("N2") ?? "0.00") certified &middot; $@(recognition?.OutstandingRetention.ToString("N2") ?? "0.00") retained</small></td>
                        <td>@RecognitionMethodLabel(project.RevenueRecognitionMethod)</td>
                        <td class="text-end">@(recognition?.CompletionPercent is decimal completion ? $"{completion:N2}%" : "—")</td>
                        <td class="text-end">$@(recognition?.RevisedContractValue.ToString("N2") ?? "0.00")</td>
                        <td class="text-end">@(recognition?.RecognizedRevenue is decimal earned ? $"${earned:N2}" : "Needs basis data")</td>
                        <td class="text-end">$@(recognition?.PostedRevenue.ToString("N2") ?? "0.00")</td>
                        <td>
                            @if (recognition?.RevenueAdjustment is null)
                            {
                                <span class="badge text-bg-warning">Not calculable</span>
                            }
                            else if (recognition.ContractAsset > 0)
                            {
                                <span class="badge text-bg-info">Contract asset</span><small class="d-block text-muted">$@recognition.ContractAsset.ToString("N2") earned not posted</small>
                            }
                            else if (recognition.ContractLiability > 0)
                            {
                                <span class="badge text-bg-warning">Contract liability</span><small class="d-block text-muted">$@recognition.ContractLiability.ToString("N2") posted ahead</small>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Aligned</span>
                            }
                            @if (recognition is not null)
                            {
                                <small class="d-block text-muted">$@recognition.PostedWipAmount.ToString("N2") WIP currently posted</small>
                                @if (recognition.IsPostedForAsAt)
                                {
                                    <span class="badge text-bg-success mt-1">Posted for this date</span>
                                }
                                else if (!recognition.WipAccountsConfigured)
                                {
                                    <a class="d-block small mt-1" href="@($"/o/{OrganisationId}/settings")">Configure WIP accounts</a>
                                }
                                else if (canManage && recognition.WipMovementRequired is decimal movement && movement != 0m)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1" @onclick="() => PostWip(project)">Post $@Math.Abs(movement).ToString("N2") true-up</button>
                                }
                                else if (recognition.WipMovementRequired == 0m)
                                {
                                    <small class="d-block text-success">No journal movement required</small>
                                }
                            }
                        </td>
                        <td class="text-end">@(recognition?.ExpectedGrossProfitToDate is decimal margin ? $"${margin:N2} to date" : "—")<small class="d-block text-muted">$@(recognition?.ForecastMargin.ToString("N2") ?? "0.00") forecast</small></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>

    <section class="detail-card mb-4">
        <div class="card-heading"><div><span class="eyebrow">Project costs</span><h2>Cost mix</h2></div><span>Actual + committed / budget</span></div>
        @if (projects.Count == 0)
        {
            <div class="empty-state"><strong>No project costs</strong><span>Create a project and cost codes to track its cost mix.</span></div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>Project</th>@foreach (var category in CostCategories) { <th class="text-end">@CostCategoryLabel(category)</th> }</tr></thead>
                <tbody>
                @foreach (var project in projects)
                {
                    var performance = Profitability(project.Id);
                    <tr>
                        <td><strong>@project.ProjectNumber &mdash; @project.Name</strong></td>
                        @foreach (var category in performance.Categories)
                        {
                            <td class="text-end">$@category.ActualCost.ToString("N2") + $@category.CommittedCost.ToString("N2")<small class="d-block text-muted">$@category.Budget.ToString("N2") budget</small></td>
                        }
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>

    <section class="detail-card">
        <div class="card-heading"><div><span class="eyebrow">Project control</span><h2>Project register</h2></div><span>@projects.Count projects</span></div>
        @if (projects.Count == 0)
        {
            <div class="empty-state"><strong>No projects</strong><span>Create a project to establish contract, forecast and cost-code controls.</span></div>
        }
        else
        {
            <div class="table-responsive"><table class="table">
                <thead><tr><th>Project</th><th>Scope</th><th>Status</th><th class="text-end">Revised contract</th><th class="text-end">Actual revenue</th><th class="text-end">Actual cost</th><th class="text-end">Actual margin</th><th class="text-end">Committed / uncommitted</th><th>Cost codes</th><th class="no-print">Actions</th></tr></thead>
                <tbody>
                @foreach (var project in projects)
                {
                    var performance = Profitability(project.Id);
                    <tr>
                        <td><strong>@project.ProjectNumber &mdash; @project.Name</strong><small class="d-block text-muted">@(project.Customer?.Name ?? "No customer") &middot; @project.StartDate.ToString("dd MMM yyyy")</small></td>
                        <td>@project.Branch.Code &mdash; @project.Division.Code</td>
                        <td><span class="badge @StatusClass(project.Status)">@StatusLabel(project.Status)</span></td>
                        <td class="text-end">$@project.RevisedContractValue.ToString("N2")<small class="d-block text-muted">$@project.CertifiedWorkValue.ToString("N2") certified &middot; $@project.OutstandingRetention.ToString("N2") retained</small></td>
                        <td class="text-end">$@performance.ActualRevenue.ToString("N2")</td>
                        <td class="text-end">$@performance.ActualCost.ToString("N2")</td>
                        <td class="text-end @(performance.ActualMargin < 0 ? "text-danger" : "text-success")">$@performance.ActualMargin.ToString("N2")</td>
                        <td class="text-end">$@performance.CommittedCost.ToString("N2")<small class="d-block text-muted">$@performance.UncommittedForecastCost.ToString("N2") uncommitted</small></td>
                        <td>@if (performance.CostCodes.Count == 0) { <span>&mdash;</span> } else { @foreach (var costCode in performance.CostCodes) { <small class="d-block"><strong>@costCode.Code</strong> <span class="badge text-bg-light">@CostCategoryLabel(costCode.Category)</span> @costCode.Name &middot; $@costCode.ActualCost.ToString("N2") actual + $@costCode.CommittedCost.ToString("N2") committed / $@costCode.Budget.ToString("N2") budget</small> @if (canManage && IsOpen(project)) { <div class="d-flex gap-1 mb-1"><select class="form-select form-select-sm" style="width: 10rem" @bind="costCodeCategories[costCode.CostCodeId]">@foreach (var category in CostCategories) { <option value="@category">@CostCategoryLabel(category)</option> }</select><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => UpdateCostCodeCategory(costCode.CostCodeId)">Save</button></div> } } } @if (performance.UncodedActualCost != 0 || performance.UncodedCommittedCost != 0) { <small class="d-block text-warning"><strong>Uncoded / Other</strong> &middot; $@performance.UncodedActualCost.ToString("N2") actual + $@performance.UncodedCommittedCost.ToString("N2") committed</small> }</td>
                        <td class="no-print"><div class="d-flex flex-wrap gap-1">@if (canManage) { @if (project.Status is ProjectStatus.Draft or ProjectStatus.OnHold) { <button class="btn btn-sm btn-outline-success" @onclick="() => ChangeStatus(project, ProjectStatus.Active)">Activate</button> } @if (project.Status == ProjectStatus.Active) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeStatus(project, ProjectStatus.OnHold)">Hold</button><button class="btn btn-sm btn-outline-success" @onclick="() => ChangeStatus(project, ProjectStatus.Completed)">Complete</button> } @if (project.Status is ProjectStatus.Draft or ProjectStatus.Active or ProjectStatus.OnHold) { <button class="btn btn-sm btn-outline-danger" @onclick="() => ChangeStatus(project, ProjectStatus.Cancelled)">Cancel</button> } }</div></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>

    <section class="detail-card mt-4">
        <div class="card-heading"><div><span class="eyebrow">Contract billing</span><h2>Progress claims &amp; retentions</h2></div><span>@projects.Sum(x => x.ProgressClaims.Count) claims</span></div>
        @if (projects.All(x => x.ProgressClaims.Count == 0))
        {
            <div class="empty-state"><strong>No progress claims</strong><span>Create claims against approved contract value and track retention held and released.</span></div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>Project</th><th>Claim</th><th class="text-end">Work</th><th class="text-end">Retention</th><th class="text-end">Certified</th><th>Status</th><th>Invoice / decision</th><th class="no-print">Actions</th></tr></thead>
                <tbody>
                @foreach (var project in projects)
                {
                    @foreach (var claim in project.ProgressClaims)
                    {
                        <tr>
                            <td><strong>@project.ProjectNumber</strong><small class="d-block text-muted">@project.Name</small></td>
                            <td><strong>@claim.ClaimNumber</strong><small class="d-block text-muted">@claim.ClaimPeriodEnd.ToString("dd MMM yyyy") &middot; @claim.Description</small></td>
                            <td class="text-end">$@claim.WorkCompletedAmount.ToString("N2")</td>
                            <td class="text-end">
                                $@claim.RetentionHeldAmount.ToString("N2") held
                                @if (claim.RetentionReleasedAmount > 0)
                                {
                                    <small class="d-block text-success">$@claim.RetentionReleasedAmount.ToString("N2") released</small>
                                }
                            </td>
                            <td class="text-end">$@claim.CertifiedAmount.ToString("N2")</td>
                            <td><span class="badge @ClaimStatusClass(claim.Status)">@claim.Status</span></td>
                            <td>
                                @if (claim.SalesInvoiceId is Guid invoiceId)
                                {
                                    <a href="@($"/o/{OrganisationId}/sales/{invoiceId}")">@(claim.SalesInvoice?.InvoiceNumber ?? "View invoice")</a>
                                }
                                else
                                {
                                    <span>@(claim.DecisionReason ?? "—")</span>
                                }
                            </td>
                            <td class="no-print">
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    @if (canManage && claim.Status == ProjectProgressClaimStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => SubmitClaim(claim)">Submit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelClaim(claim)">Cancel</button>
                                    }
                                    @if (claim.Status == ProjectProgressClaimStatus.Submitted)
                                    {
                                        @if (canApproveVariations)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => DecideClaim(claim, true)">Approve</button>
                                            <input class="form-control form-control-sm" style="width: 12rem" placeholder="Rejection reason" @bind="claimDecisionReasons[claim.Id]" @bind:event="oninput" />
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DecideClaim(claim, false)">Reject</button>
                                        }
                                        @if (canManage)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelClaim(claim)">Cancel</button>
                                        }
                                    }
                                    @if (canManage && claim.Status == ProjectProgressClaimStatus.Approved)
                                    {
                                        <input type="date" class="form-control form-control-sm" style="width: 9rem" title="Invoice date" @bind="claimInvoiceModels[claim.Id].IssueDate" />
                                        <input type="date" class="form-control form-control-sm" style="width: 9rem" title="Due date" @bind="claimInvoiceModels[claim.Id].DueDate" />
                                        <button class="btn btn-sm btn-primary" @onclick="() => GenerateClaimInvoice(claim)">Create invoice</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table></div>
        }
    </section>

    <section class="detail-card mt-4">
        <div class="card-heading"><div><span class="eyebrow">Contract control</span><h2>Variation register</h2></div><span>@projects.Sum(x => x.Variations.Count) variations</span></div>
        @if (projects.All(x => x.Variations.Count == 0))
        {
            <div class="empty-state"><strong>No contract variations</strong><span>Add variations as scope and contract value change.</span></div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>Project</th><th>Variation</th><th>Requested</th><th class="text-end">Amount</th><th>Status</th><th>Decision</th><th class="no-print">Actions</th></tr></thead>
                <tbody>
                @foreach (var project in projects)
                {
                    @foreach (var variation in project.Variations)
                    {
                        <tr>
                            <td><strong>@project.ProjectNumber</strong><small class="d-block text-muted">@project.Name</small></td>
                            <td><strong>@variation.VariationNumber &mdash; @variation.Title</strong>@if (!string.IsNullOrWhiteSpace(variation.Description)) { <small class="d-block text-muted">@variation.Description</small> }</td>
                            <td>@variation.RequestedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end @(variation.Amount < 0 ? "text-danger" : null)">$@variation.Amount.ToString("N2")</td>
                            <td><span class="badge @VariationStatusClass(variation.Status)">@variation.Status</span></td>
                            <td>@(variation.DecisionReason ?? "—")</td>
                            <td class="no-print">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (canManage && variation.Status == ProjectVariationStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => SubmitVariation(variation)">Submit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelVariation(variation)">Cancel</button>
                                    }
                                    @if (variation.Status == ProjectVariationStatus.Submitted)
                                    {
                                        @if (canApproveVariations)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => DecideVariation(variation, true)">Approve</button>
                                            <input class="form-control form-control-sm" style="width: 12rem" placeholder="Rejection reason" @bind="variationDecisionReasons[variation.Id]" @bind:event="oninput" />
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DecideVariation(variation, false)">Reject</button>
                                        }
                                        @if (canManage)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelVariation(variation)">Cancel</button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table></div>
        }
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access;
    private string userId = "";
    private bool canManage;
    private bool canApproveVariations;
    private List<Project> projects = [];
    private List<ProjectProfitability> profitability = [];
    private List<ProjectRevenueRecognition> revenueRecognition = [];
    private DateOnly recognitionAsAt = DateOnly.FromDateTime(DateTime.Today);
    private static readonly ProjectCostCategory[] CostCategories =
    [
        ProjectCostCategory.Labour,
        ProjectCostCategory.Materials,
        ProjectCostCategory.Equipment,
        ProjectCostCategory.Subcontractors,
        ProjectCostCategory.Other
    ];
    private Dictionary<Guid, ProjectCostCategory> costCodeCategories = [];
    private List<DivisionOption> divisions = [];
    private List<BusinessParty> customers = [];
    private List<LedgerAccount> revenueAccounts = [];
    private ProjectModel model = new();
    private CostCodeModel costCodeModel = new();
    private VariationModel variationModel = new();
    private ClaimModel claimModel = new();
    private readonly Dictionary<Guid, string> variationDecisionReasons = [];
    private readonly Dictionary<Guid, string> claimDecisionReasons = [];
    private readonly Dictionary<Guid, ClaimInvoiceModel> claimInvoiceModels = [];
    private string? message;
    private string messageClass = "alert-success";

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is null) return;
        canManage = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
        canApproveVariations = await TenantAccess.CanManageTeamAsync(userId, OrganisationId);
        var branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);
        divisions = branches.SelectMany(branch => branch.Divisions.Select(division =>
            new DivisionOption(division.Id, $"{branch.Code} — {branch.Name} / {division.Code} — {division.Name}"))).ToList();
        customers = await Db.BusinessParties.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type & PartyType.Customer) != 0)
            .OrderBy(x => x.Name).ToListAsync();
        revenueAccounts = await Db.LedgerAccounts.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.Type == AccountType.Revenue)
            .OrderBy(x => x.Code).ToListAsync();
        ResetModels();
        await Reload();
    }

    private async Task Reload()
    {
        projects = await ProjectService.ListAsync(userId, OrganisationId);
        profitability = (await ProjectProfitabilityService.GetAsync(userId, OrganisationId)).ToList();
        revenueRecognition = (await ProjectRevenueRecognitionService.GetAsync(
            userId, OrganisationId, recognitionAsAt)).ToList();
        costCodeCategories = projects.SelectMany(x => x.CostCodes)
            .ToDictionary(x => x.Id, x => x.Category);
        if (costCodeModel.ProjectId == Guid.Empty || !projects.Any(x => x.Id == costCodeModel.ProjectId && IsOpen(x)))
            costCodeModel.ProjectId = projects.FirstOrDefault(IsOpen)?.Id ?? Guid.Empty;
        if (variationModel.ProjectId == Guid.Empty || !projects.Any(x => x.Id == variationModel.ProjectId && x.Status is ProjectStatus.Active or ProjectStatus.OnHold))
            variationModel.ProjectId = projects.FirstOrDefault(x => x.Status is ProjectStatus.Active or ProjectStatus.OnHold)?.Id ?? Guid.Empty;
        foreach (var variation in projects.SelectMany(x => x.Variations).Where(x => x.Status == ProjectVariationStatus.Submitted))
            variationDecisionReasons.TryAdd(variation.Id, string.Empty);
        if (claimModel.ProjectId == Guid.Empty || !EligibleClaimProjects.Any(x => x.Id == claimModel.ProjectId))
            claimModel.ProjectId = EligibleClaimProjects.FirstOrDefault()?.Id ?? Guid.Empty;
        ApplyClaimProjectDefaults();
        foreach (var project in projects)
        {
            foreach (var claim in project.ProgressClaims)
            {
                if (claim.Status == ProjectProgressClaimStatus.Submitted)
                    claimDecisionReasons.TryAdd(claim.Id, string.Empty);
                if (claim.Status == ProjectProgressClaimStatus.Approved)
                    claimInvoiceModels.TryAdd(claim.Id, NewClaimInvoiceModel(project));
            }
        }
    }

    private async Task SaveProject()
    {
        try
        {
            var project = await ProjectService.SaveAsync(userId, new ProjectRequest(
                OrganisationId, null, model.ProjectNumber, model.Name, model.Description,
                model.DivisionId, model.CustomerId, model.StartDate, model.ExpectedCompletionDate,
                model.OriginalContractValue, model.ApprovedVariationValue, model.ForecastCost,
                model.RetentionPercent, model.RevenueRecognitionMethod));
            Success($"Project {project.ProjectNumber} created.");
            ResetModels();
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task AddCostCode()
    {
        try
        {
            await ProjectService.AddCostCodeAsync(userId, new ProjectCostCodeRequest(
                OrganisationId, costCodeModel.ProjectId, costCodeModel.Code,
                costCodeModel.Name, costCodeModel.BudgetAmount, costCodeModel.Category));
            Success("Project cost code added.");
            costCodeModel = new CostCodeModel { ProjectId = costCodeModel.ProjectId };
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task UpdateCostCodeCategory(Guid costCodeId)
    {
        try
        {
            await ProjectService.SetCostCodeCategoryAsync(
                userId, OrganisationId, costCodeId, costCodeCategories[costCodeId]);
            Success("Project cost category updated.");
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task RefreshRecognition()
    {
        try
        {
            revenueRecognition = (await ProjectRevenueRecognitionService.GetAsync(
                userId, OrganisationId, recognitionAsAt)).ToList();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task PostWip(Project project)
    {
        try
        {
            await ProjectWipPostingService.PostAsync(
                userId, OrganisationId, project.Id, recognitionAsAt);
            Success($"WIP true-up posted for {project.ProjectNumber} at {recognitionAsAt:dd MMM yyyy}.");
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or FijiAccounts.Domain.Accounting.DomainException) { Error(ex.Message); }
    }

    private async Task ChangeStatus(Project project, ProjectStatus status)
    {
        try
        {
            await ProjectService.ChangeStatusAsync(userId, OrganisationId, project.Id, status);
            Success($"Project {project.ProjectNumber} is now {StatusLabel(status).ToLowerInvariant()}.");
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task CreateVariation()
    {
        try
        {
            var variation = await ProjectService.CreateVariationAsync(userId, new(
                OrganisationId, variationModel.ProjectId, variationModel.VariationNumber,
                variationModel.Title, variationModel.Description, variationModel.Amount,
                variationModel.RequestedDate));
            Success($"Variation {variation.VariationNumber} saved as a draft.");
            variationModel = new VariationModel { ProjectId = variationModel.ProjectId, RequestedDate = DateOnly.FromDateTime(DateTime.Today) };
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task SubmitVariation(ProjectVariation variation)
    {
        try { await ProjectService.SubmitVariationAsync(userId, OrganisationId, variation.Id); Success($"Variation {variation.VariationNumber} submitted."); await Reload(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task DecideVariation(ProjectVariation variation, bool approve)
    {
        try
        {
            variationDecisionReasons.TryGetValue(variation.Id, out var reason);
            await ProjectService.DecideVariationAsync(userId, OrganisationId, variation.Id, approve, reason);
            Success($"Variation {variation.VariationNumber} {(approve ? "approved" : "rejected")}.");
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task CancelVariation(ProjectVariation variation)
    {
        try { await ProjectService.CancelVariationAsync(userId, OrganisationId, variation.Id); Success($"Variation {variation.VariationNumber} cancelled."); await Reload(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task CreateClaim()
    {
        try
        {
            var claim = await ProjectProgressClaimService.CreateAsync(userId, new(
                OrganisationId, claimModel.ProjectId, claimModel.ClaimNumber,
                claimModel.Description, claimModel.ClaimPeriodEnd,
                claimModel.WorkCompletedAmount, claimModel.RetentionReleasedAmount,
                claimModel.RevenueAccountId, claimModel.VatTreatment));
            Success($"Progress claim {claim.ClaimNumber} saved as a draft.");
            var projectId = claimModel.ProjectId;
            claimModel = NewClaimModel(projectId);
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task SubmitClaim(ProjectProgressClaim claim)
    {
        try { await ProjectProgressClaimService.SubmitAsync(userId, OrganisationId, claim.Id); Success($"Progress claim {claim.ClaimNumber} submitted."); await Reload(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task DecideClaim(ProjectProgressClaim claim, bool approve)
    {
        try
        {
            claimDecisionReasons.TryGetValue(claim.Id, out var reason);
            await ProjectProgressClaimService.DecideAsync(userId, OrganisationId, claim.Id, approve, reason);
            Success($"Progress claim {claim.ClaimNumber} {(approve ? "approved" : "rejected")}.");
            await Reload();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task GenerateClaimInvoice(ProjectProgressClaim claim)
    {
        try
        {
            var dates = claimInvoiceModels[claim.Id];
            var invoice = await ProjectProgressClaimService.GenerateDraftInvoiceAsync(
                userId, OrganisationId, claim.Id, dates.IssueDate, dates.DueDate);
            Navigation.NavigateTo($"/o/{OrganisationId}/sales/{invoice.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private async Task CancelClaim(ProjectProgressClaim claim)
    {
        try { await ProjectProgressClaimService.CancelAsync(userId, OrganisationId, claim.Id); Success($"Progress claim {claim.ClaimNumber} cancelled."); await Reload(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Error(ex.Message); }
    }

    private void ApplyClaimProjectDefaults()
    {
        var project = projects.FirstOrDefault(x => x.Id == claimModel.ProjectId);
        var customerDefault = project?.Customer?.DefaultSalesAccountId;
        if (claimModel.RevenueAccountId == Guid.Empty || !revenueAccounts.Any(x => x.Id == claimModel.RevenueAccountId))
            claimModel.RevenueAccountId = revenueAccounts.FirstOrDefault(x => x.Id == customerDefault)?.Id ?? revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        claimModel.VatTreatment = project?.Customer?.DefaultSalesVatTreatment ?? claimModel.VatTreatment;
    }

    private void ResetModels()
    {
        model = new ProjectModel
        {
            DivisionId = divisions.FirstOrDefault()?.DivisionId ?? Guid.Empty,
            StartDate = DateOnly.FromDateTime(DateTime.Today)
        };
        costCodeModel = new CostCodeModel { ProjectId = projects.FirstOrDefault(IsOpen)?.Id ?? Guid.Empty };
        variationModel = new VariationModel
        {
            ProjectId = projects.FirstOrDefault(x => x.Status is ProjectStatus.Active or ProjectStatus.OnHold)?.Id ?? Guid.Empty,
            RequestedDate = DateOnly.FromDateTime(DateTime.Today)
        };
        claimModel = NewClaimModel(EligibleClaimProjects.FirstOrDefault()?.Id ?? Guid.Empty);
    }
    private ClaimModel NewClaimModel(Guid projectId)
    {
        var result = new ClaimModel
        {
            ProjectId = projectId,
            ClaimPeriodEnd = DateOnly.FromDateTime(DateTime.Today),
            RevenueAccountId = revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty
        };
        var customer = projects.FirstOrDefault(x => x.Id == projectId)?.Customer;
        if (customer?.DefaultSalesAccountId is Guid accountId && revenueAccounts.Any(x => x.Id == accountId))
            result.RevenueAccountId = accountId;
        result.VatTreatment = customer?.DefaultSalesVatTreatment ?? VatTreatment.Standard;
        return result;
    }
    private ClaimInvoiceModel NewClaimInvoiceModel(Project project)
    {
        var issueDate = DateOnly.FromDateTime(DateTime.Today);
        var termType = project.Customer?.DefaultSalesInvoicePaymentTermType
            ?? access?.Organisation.DefaultSalesInvoicePaymentTermType
            ?? PaymentTermType.DaysAfterDocumentDate;
        var termValue = project.Customer?.DefaultSalesInvoiceDueDays
            ?? access?.Organisation.DefaultSalesInvoiceDueDays
            ?? 30;
        return new ClaimInvoiceModel
        {
            IssueDate = issueDate,
            DueDate = PaymentTermCalculator.CalculateDueDate(issueDate, termType, termValue)
        };
    }
    private void Success(string value) { messageClass = "alert-success"; message = value; }
    private void Error(string value) { messageClass = "alert-danger"; message = value; }
    private static bool IsOpen(Project project) => project.Status is ProjectStatus.Draft or ProjectStatus.Active or ProjectStatus.OnHold;
    private IEnumerable<ProjectProfitability> OpenProfitability => profitability.Where(x => projects.Any(project => project.Id == x.ProjectId && IsOpen(project)));
    private ProjectProfitability Profitability(Guid projectId) => profitability.Single(x => x.ProjectId == projectId);
    private ProjectRevenueRecognition? Recognition(Guid projectId) => revenueRecognition.SingleOrDefault(x => x.ProjectId == projectId);
    private static string StatusLabel(ProjectStatus status) => status == ProjectStatus.OnHold ? "On hold" : status.ToString();
    private static string StatusClass(ProjectStatus status) => status switch { ProjectStatus.Active => "text-bg-success", ProjectStatus.OnHold => "text-bg-warning", ProjectStatus.Completed => "text-bg-primary", ProjectStatus.Cancelled => "text-bg-secondary", _ => "text-bg-light" };
    private static string VariationStatusClass(ProjectVariationStatus status) => status switch { ProjectVariationStatus.Approved => "text-bg-success", ProjectVariationStatus.Submitted => "text-bg-primary", ProjectVariationStatus.Rejected => "text-bg-danger", ProjectVariationStatus.Cancelled => "text-bg-secondary", _ => "text-bg-light" };
    private static string ClaimStatusClass(ProjectProgressClaimStatus status) => status switch { ProjectProgressClaimStatus.Approved => "text-bg-success", ProjectProgressClaimStatus.Invoiced => "text-bg-info", ProjectProgressClaimStatus.Submitted => "text-bg-primary", ProjectProgressClaimStatus.Rejected => "text-bg-danger", ProjectProgressClaimStatus.Cancelled => "text-bg-secondary", _ => "text-bg-light" };
    private static string RecognitionMethodLabel(ProjectRevenueRecognitionMethod method) => method switch { ProjectRevenueRecognitionMethod.CertifiedClaims => "Certified claims", _ => "Cost-to-cost" };
    private static string CostCategoryLabel(ProjectCostCategory category) => category switch { ProjectCostCategory.Subcontractors => "Subcontractors", _ => category.ToString() };
    private static string VatLabel(VatTreatment treatment) => treatment switch { VatTreatment.ZeroRated => "Zero-rated", VatTreatment.OutOfScope => "Out of scope", _ => treatment.ToString() };
    private IEnumerable<Project> EligibleClaimProjects => projects.Where(x => x.CustomerId is not null && x.Status is ProjectStatus.Active or ProjectStatus.OnHold);
    private decimal ClaimRetentionHeld => Math.Round(claimModel.WorkCompletedAmount * (projects.FirstOrDefault(x => x.Id == claimModel.ProjectId)?.RetentionPercent ?? 0m) / 100m, 2, MidpointRounding.AwayFromZero);

    private sealed record DivisionOption(Guid DivisionId, string Label);
    private sealed class ProjectModel
    {
        [Required, StringLength(40)] public string ProjectNumber { get; set; } = "";
        [Required, StringLength(160)] public string Name { get; set; } = "";
        [StringLength(1000)] public string? Description { get; set; }
        [Required] public Guid DivisionId { get; set; }
        public Guid? CustomerId { get; set; }
        public DateOnly StartDate { get; set; }
        public DateOnly? ExpectedCompletionDate { get; set; }
        [Range(0, 999999999999)] public decimal OriginalContractValue { get; set; }
        [Range(0, 999999999999)] public decimal ApprovedVariationValue { get; set; }
        [Range(0, 999999999999)] public decimal ForecastCost { get; set; }
        [Range(0, 100)] public decimal RetentionPercent { get; set; }
        public ProjectRevenueRecognitionMethod RevenueRecognitionMethod { get; set; } = ProjectRevenueRecognitionMethod.CostToCost;
    }
    private sealed class CostCodeModel
    {
        [Required] public Guid ProjectId { get; set; }
        [Required, StringLength(30)] public string Code { get; set; } = "";
        [Required, StringLength(120)] public string Name { get; set; } = "";
        public ProjectCostCategory Category { get; set; } = ProjectCostCategory.Other;
        [Range(0, 999999999999)] public decimal BudgetAmount { get; set; }
    }
    private sealed class VariationModel
    {
        [Required] public Guid ProjectId { get; set; }
        [Required, StringLength(40)] public string VariationNumber { get; set; } = "";
        [Required, StringLength(160)] public string Title { get; set; } = "";
        [StringLength(1000)] public string? Description { get; set; }
        public decimal Amount { get; set; }
        public DateOnly RequestedDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }
    private sealed class ClaimModel
    {
        [Required] public Guid ProjectId { get; set; }
        [Required, StringLength(40)] public string ClaimNumber { get; set; } = "";
        [Required, StringLength(500)] public string Description { get; set; } = "";
        public DateOnly ClaimPeriodEnd { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        [Range(0, 999999999999)] public decimal WorkCompletedAmount { get; set; }
        [Range(0, 999999999999)] public decimal RetentionReleasedAmount { get; set; }
        [Required] public Guid RevenueAccountId { get; set; }
        public VatTreatment VatTreatment { get; set; } = VatTreatment.Standard;
    }
    private sealed class ClaimInvoiceModel
    {
        public DateOnly IssueDate { get; set; }
        public DateOnly DueDate { get; set; }
    }
}
