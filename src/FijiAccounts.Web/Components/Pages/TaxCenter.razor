@page "/o/{OrganisationId:guid}/tax"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject TenantAccessService TenantAccess
@inject VatWorkpaperService VatWorkpapers
@inject NewZealandGstReturnService NewZealandGstReturns
@inject VatTurnoverMonitorService VatTurnoverMonitor
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Tax centre · Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Island compliance</p>
            <h1>@access.Organisation.TaxLabel centre</h1>
            <p class="page-intro">
                Review tax collected and paid before preparing your return.
            </p>
        </div>
        <button class="btn btn-outline-secondary no-print"
                onclick="window.print()">
            Print review
        </button>
    </div>

    @if (!jurisdiction!.TaxPackEnabled)
    {
        <div class="alert alert-warning">
            <strong>@jurisdiction.CountryName tax pack awaiting verification.</strong>
            Tax calculations and return preparation remain locked until local rules
            have been professionally reviewed.
        </div>
    }
    else
    {
        @if (turnover is not null)
        {
            <div class="alert @(turnover.RequiresRegistration ? "alert-danger" : turnover.IsApproachingThreshold ? "alert-warning" : "alert-info")">
                <strong>12-month taxable turnover: @access.Organisation.BaseCurrency @turnover.TaxableTurnover.ToString("N2")</strong>
                <div>
                    @turnover.From.ToString("dd MMM yyyy") to @turnover.To.ToString("dd MMM yyyy") ·
                    @turnover.ThresholdPercentage.ToString("N1")% of the @access.Organisation.BaseCurrency @turnover.RegistrationThreshold.ToString("N2") @access.Organisation.TaxLabel registration threshold.
                </div>
                @if (turnover.RequiresRegistration)
                {
                    <div>@RegistrationGuidance</div>
                }
                else if (turnover.IsApproachingThreshold)
                {
                    <div>@access.Organisation.BaseCurrency @turnover.RemainingBeforeThreshold.ToString("N2") remains before the threshold is reached.</div>
                }
                else if (!turnover.IsVatRegistered)
                {
                    <div>Account Island will warn the organisation as posted taxable turnover approaches the threshold.</div>
                }
                @if (turnover.ExpectedTaxableTurnoverNext12Months is decimal expectedTurnover)
                {
                    <div class="mt-1">
                        Expected taxable turnover for the next 12 months:
                        @access.Organisation.BaseCurrency @expectedTurnover.ToString("N2")
                        (@turnover.ForecastThresholdPercentage?.ToString("N1")% of the threshold).
                    </div>
                    @if (turnover.ForecastUpdatedAt is not null)
                    {
                        <div class="small">Forecast updated @turnover.ForecastUpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm").</div>
                    }
                }
                else
                {
                    <div class="small mt-1">Add expected taxable turnover from future contracts and other forecast supplies to complete the forward-looking check.</div>
                }
            </div>

            @if (canEditForecast)
            {
                <section class="report-controls no-print">
                    <EditForm Model="forecast"
                              OnValidSubmit="SaveForecast"
                              FormName="vat-turnover-forecast">
                        <DataAnnotationsValidator />
                        <div>
                            <label class="form-label">Expected taxable turnover — next 12 months (@access.Organisation.BaseCurrency)</label>
                            <InputNumber class="form-control"
                                         @bind-Value="forecast.ExpectedTaxableTurnoverNext12Months" />
                            <ValidationMessage For="@(() => forecast.ExpectedTaxableTurnoverNext12Months)" />
                        </div>
                        <button class="btn btn-outline-primary" disabled="@savingForecast">
                            @(savingForecast ? "Saving..." : "Save forecast")
                        </button>
                        <span>Use the total expected taxable supplies for the coming 12 months; do not add it to the historical figure.</span>
                    </EditForm>
                    @if (forecastMessage is not null)
                    {
                        <div class="alert @(forecastError ? "alert-danger" : "alert-success") mb-0">@forecastMessage</div>
                    }
                </section>
            }
        }

        <section class="report-controls no-print">
            <EditForm Model="period"
                      OnValidSubmit="Load"
                      FormName="tax-period">
                <div>
                    <label class="form-label">From</label>
                    <InputDate class="form-control" @bind-Value="period.From" />
                </div>
                <div>
                    <label class="form-label">To</label>
                    <InputDate class="form-control" @bind-Value="period.To" />
                </div>
                <button class="btn btn-primary">Update review</button>
            </EditForm>
            <span>@(IsNewZealand ? "Invoice basis" : "Accrual basis") · @access.Organisation.BaseCurrency</span>
        </section>

        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (workpaper is not null)
        {
            <div class="invoice-summary">
                <article>
                    <span>Output @access.Organisation.TaxLabel</span>
                    <strong>$@workpaper.OutputTax.ToString("N2")</strong>
                    <small>Sales tax less credit notes</small>
                </article>
                <article>
                    <span>Input @access.Organisation.TaxLabel</span>
                    <strong>$@workpaper.InputTax.ToString("N2")</strong>
                    <small>Tax on supplier bills</small>
                </article>
                <article class="@(workpaper.NetTax > 0 ? "needs-attention" : null)">
                    <span>Net position</span>
                    <strong>$@Math.Abs(workpaper.NetTax).ToString("N2")</strong>
                    <small>
                        @(workpaper.NetTax >= 0
                            ? "Estimated payable"
                            : "Estimated refundable")
                    </small>
                </article>
            </div>

            @if (nzReturn is not null)
            {
                <section class="financial-report">
                    <header>
                        <div>
                            <h2>New Zealand GST return workpaper</h2>
                            <p>GST101 boxes · invoice basis · @nzReturn.From.ToString("dd MMM yyyy") to @nzReturn.To.ToString("dd MMM yyyy")</p>
                        </div>
                        <strong>@access.Organisation.LegalName</strong>
                    </header>
                    <table class="report-table">
                        <tbody>
                            <tr><td>Box 5 · Total sales and income</td><td class="number">$@nzReturn.Box5TotalSalesAndIncome.ToString("N2")</td></tr>
                            <tr><td>Box 6 · Zero-rated supplies</td><td class="number">$@nzReturn.Box6ZeroRatedSupplies.ToString("N2")</td></tr>
                            <tr><td>Box 7 · Taxable sales</td><td class="number">$@nzReturn.Box7TaxableSales.ToString("N2")</td></tr>
                            <tr><td>Box 8 · GST on sales</td><td class="number">$@nzReturn.Box8GstOnSales.ToString("N2")</td></tr>
                            <tr><td>Box 9 · Debit adjustments</td><td class="number">$@nzReturn.Box9DebitAdjustments.ToString("N2")</td></tr>
                            <tr><td>Box 10 · Total GST collected</td><td class="number">$@nzReturn.Box10TotalGstCollected.ToString("N2")</td></tr>
                            <tr><td>Box 11 · Purchases and expenses</td><td class="number">$@nzReturn.Box11PurchasesAndExpenses.ToString("N2")</td></tr>
                            <tr><td>Box 12 · GST on purchases</td><td class="number">$@nzReturn.Box12GstOnPurchases.ToString("N2")</td></tr>
                            <tr><td>Box 13 · Credit adjustments</td><td class="number">$@nzReturn.Box13CreditAdjustments.ToString("N2")</td></tr>
                            <tr><td>Box 14 · Total GST credits</td><td class="number">$@nzReturn.Box14TotalGstCredits.ToString("N2")</td></tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Box 15 · GST @(nzReturn.IsRefund ? "refund" : "to pay")</th>
                                <th class="number">$@Math.Abs(nzReturn.Box15NetGst).ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="alert alert-warning mt-4 mb-0">
                        Debit and credit adjustments are shown as zero until manual adjustment support is added. Review these boxes and the underlying transactions before filing with Inland Revenue. Account Island has not filed this return.
                    </div>
                </section>
            }

            <section class="financial-report">
                <header>
                    <div>
                        <h2>@access.Organisation.TaxLabel review</h2>
                        <p>
                            @workpaper.From.ToString("dd MMM yyyy") to
                            @workpaper.To.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <strong>@access.Organisation.LegalName</strong>
                </header>

                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Transaction class</th>
                            <th class="number">Net supplies/purchases</th>
                            <th class="number">Tax</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Standard-rated sales</td>
                            <td class="number">$@workpaper.Sales.StandardNet.ToString("N2")</td>
                            <td class="number">$@workpaper.Sales.StandardTax.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Zero-rated sales</td>
                            <td class="number">$@workpaper.Sales.ZeroRatedNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Exempt sales</td>
                            <td class="number">$@workpaper.Sales.ExemptNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Out-of-scope sales</td>
                            <td class="number">$@workpaper.Sales.OutOfScopeNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Sales credit notes</td>
                            <td class="number">($@workpaper.SalesCredits.Net.ToString("N2"))</td>
                            <td class="number">($@workpaper.SalesCredits.Tax.ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td>Standard-rated purchases</td>
                            <td class="number">$@workpaper.Purchases.StandardNet.ToString("N2")</td>
                            <td class="number">$@workpaper.Purchases.StandardTax.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Zero-rated purchases</td>
                            <td class="number">$@workpaper.Purchases.ZeroRatedNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Exempt purchases</td>
                            <td class="number">$@workpaper.Purchases.ExemptNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Out-of-scope purchases</td>
                            <td class="number">$@workpaper.Purchases.OutOfScopeNet.ToString("N2")</td>
                            <td class="number">—</td>
                        </tr>
                        <tr>
                            <td>Supplier credit notes</td>
                            <td class="number">($@workpaper.SupplierCredits.Net.ToString("N2"))</td>
                            <td class="number">($@workpaper.SupplierCredits.Tax.ToString("N2"))</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>
                                Estimated @(workpaper.NetTax >= 0
                                    ? "tax payable"
                                    : "tax refundable")
                            </th>
                            <th></th>
                            <th class="number">
                                $@Math.Abs(workpaper.NetTax).ToString("N2")
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <div class="alert alert-info mt-4 mb-0">
                    Review transaction classifications and supporting documents
                    before filing. Account Island has not submitted this return to
                    the tax authority.
                </div>
            </section>
        }
    }
}

@code {
    [Parameter]
    public Guid OrganisationId { get; set; }

    private AccessibleOrganisation? access;
    private IslandJurisdiction? jurisdiction;
    private readonly PeriodModel period = new();
    private readonly ForecastModel forecast = new();
    private VatWorkpaper? workpaper;
    private NewZealandGstReturn? nzReturn;
    private VatTurnoverAssessment? turnover;
    private string? error;
    private string? userId;
    private bool canEditForecast;
    private bool savingForecast;
    private bool forecastError;
    private string? forecastMessage;

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        jurisdiction =
            IslandJurisdictions.Get(
                access.Organisation.CountryCode);

        var today =
            DateOnly.FromDateTime(
                DateTime.Today);

        period.From =
            new DateOnly(
                today.Year,
                today.Month,
                1)
            .AddMonths(-1);

        period.To =
            new DateOnly(
                today.Year,
                today.Month,
                1)
            .AddDays(-1);

        if (jurisdiction.TaxPackEnabled &&
            (access.Organisation.CountryCode.Equals("FJ", StringComparison.OrdinalIgnoreCase) || IsNewZealand))
        {
            turnover = await VatTurnoverMonitor.GetAssessmentAsync(
                OrganisationId,
                today);
            forecast.ExpectedTaxableTurnoverNext12Months =
                turnover.ExpectedTaxableTurnoverNext12Months;
            canEditForecast = await TenantAccess.CanPostJournalsAsync(
                userId,
                OrganisationId);
            await Load();
        }
    }

    private async Task SaveForecast()
    {
        if (userId is null)
        {
            return;
        }

        savingForecast = true;
        forecastMessage = null;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            turnover = await VatTurnoverMonitor.UpdateForecastAsync(
                userId,
                new UpdateVatTurnoverForecastRequest(
                    OrganisationId,
                    forecast.ExpectedTaxableTurnoverNext12Months),
                today);
            forecastError = false;
            forecastMessage = $"{access?.Organisation.TaxLabel ?? "Tax"} turnover forecast saved and alerts refreshed.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            forecastError = true;
            forecastMessage = ex.Message;
        }
        finally
        {
            savingForecast = false;
        }
    }

    private async Task Load()
    {
        try
        {
            workpaper =
                await VatWorkpapers.GetAsync(
                    OrganisationId,
                    period.From,
                    period.To);

            nzReturn = IsNewZealand
                ? await NewZealandGstReturns.GetInvoiceBasisAsync(
                    OrganisationId,
                    period.From,
                    period.To)
                : null;

            error = null;
        }
        catch (ArgumentException ex)
        {
            workpaper = null;
            nzReturn = null;
            error = ex.Message;
        }
    }

    private bool IsNewZealand =>
        access?.Organisation.CountryCode.Equals("NZ", StringComparison.OrdinalIgnoreCase) == true;

    private string RegistrationGuidance => IsNewZealand
        ? "GST registration may now be required because taxable turnover has reached, or is expected to reach, NZD 60,000 in a 12-month period. Confirm the position with Inland Revenue or your New Zealand tax adviser."
        : "VAT registration may now be required within 21 consecutive days. Confirm the position with FRCS or your Fiji tax practitioner.";

    private sealed class PeriodModel
    {
        public DateOnly From { get; set; }
        public DateOnly To { get; set; }
    }

    private sealed class ForecastModel
    {
        [Range(
            typeof(decimal),
            "0",
            "1000000000000",
            ErrorMessage = "Expected taxable turnover must be between 0.00 and 1,000,000,000,000.00.")]
        public decimal? ExpectedTaxableTurnoverNext12Months { get; set; }
    }
}
