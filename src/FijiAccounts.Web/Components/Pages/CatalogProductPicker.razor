@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@inject ApplicationDbContext Db
@if (products.Count > 0) { <div class="d-flex gap-2 align-items-end m-3 mb-0"><div style="min-width:20rem"><label class="form-label">Add from products &amp; services</label><InputSelect class="form-select" @bind-Value="selectedId"><option value="">Choose an item</option>@foreach (var item in products) { <option value="@item.Id">@item.Code — @item.Name</option> }</InputSelect></div><button type="button" class="btn btn-outline-primary" @onclick="Add">Add item</button></div> }
@code { [Parameter] public Guid OrganisationId { get; set; } [Parameter] public bool ForPurchases { get; set; } [Parameter] public EventCallback<ProductItem> OnSelected { get; set; } private List<ProductItem> products = []; private Guid? selectedId; protected override async Task OnParametersSetAsync() => products = await Db.ProductItems.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (ForPurchases ? x.ExpenseAccountId != null : x.RevenueAccountId != null)).OrderBy(x => x.Code).ToListAsync(); private async Task Add() { var item = products.SingleOrDefault(x => x.Id == selectedId); if (item is not null) { await OnSelected.InvokeAsync(item); selectedId = null; } } }
