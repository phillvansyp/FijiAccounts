@page "/o/{OrganisationId:guid}/reports"
@page "/o/{OrganisationId:guid}/reports/{ReportType}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Text
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Reports · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="report-heading"><div><p class="eyebrow">Reporting</p><h1>@ReportTitle</h1><p>Prepared from posted journals in @access.Organisation.BaseCurrency.</p></div></div>
    <section class="report-controls report-options no-print"><EditForm Model="period" OnValidSubmit="Load" FormName="report-period"><div><label class="form-label">From</label><InputDate class="form-control" @bind-Value="period.From" /></div><div><label class="form-label">To</label><InputDate class="form-control" @bind-Value="period.To" /></div><div><label class="form-label">Compare with</label><InputSelect class="form-select" @bind-Value="period.CompareWith"><option value="none">None</option><option value="previous-period">Previous period</option><option value="previous-year">Previous year</option></InputSelect></div><div><label class="form-label">Tracking</label><InputSelect class="form-select" @bind-Value="period.Tracking"><option value="all">All transactions</option></InputSelect></div><details class="report-more"><summary class="btn btn-outline-secondary">More</summary><div class="report-more-panel"><strong>Display options</strong><label><InputCheckbox @bind-Value="period.ShowAccountCodes" /> Account codes</label><label><InputCheckbox @bind-Value="period.ShowZeroBalances" /> Zero balances</label><label><InputCheckbox @bind-Value="period.ShowDecimals" /> Decimals</label><label><InputCheckbox @bind-Value="period.ShowAccountingBasis" /> Accounting basis</label></div></details><button class="btn btn-primary">Update</button></EditForm></section>
    @if (period.CompareWith != "none") { <div class="comparison-strip no-print"><span><strong>Comparison:</strong> @ComparisonLabel</span><span>@ComparisonMeasureLabel <strong>@Money(ComparisonMeasure)</strong></span></div> }
    @if (NormalisedReportType == "profit-loss") { <section class="financial-report"><header><div><h2>Profit &amp; Loss</h2><p>@period.From.ToString("dd MMM yyyy") to @period.To.ToString("dd MMM yyyy")</p></div><strong>@access.Organisation.LegalName</strong></header><ReportSection Title="Income" Rows="RevenueRows" TotalLabel="Total income" Total="RevenueTotal" ShowAccountCodes="period.ShowAccountCodes" ShowDecimals="period.ShowDecimals" /><ReportSection Title="Expenses" Rows="ExpenseRows" TotalLabel="Total expenses" Total="ExpenseTotal" ShowAccountCodes="period.ShowAccountCodes" ShowDecimals="period.ShowDecimals" /><div class="report-result"><span>Net profit</span><strong class="@(NetProfit < 0 ? "negative" : null)">@Money(NetProfit)</strong></div></section> }
    else if (NormalisedReportType == "balance-sheet") { <section class="financial-report"><header><div><h2>Balance Sheet</h2><p>As at @period.To.ToString("dd MMM yyyy")</p></div><strong>@access.Organisation.LegalName</strong></header><ReportSection Title="Assets" Rows="AssetRows" TotalLabel="Total assets" Total="AssetTotal" ShowAccountCodes="period.ShowAccountCodes" ShowDecimals="period.ShowDecimals" /><ReportSection Title="Liabilities" Rows="LiabilityRows" TotalLabel="Total liabilities" Total="LiabilityTotal" ShowAccountCodes="period.ShowAccountCodes" ShowDecimals="period.ShowDecimals" /><ReportSection Title="Equity" Rows="EquityRows" TotalLabel="Total equity" Total="EquityTotal" ShowAccountCodes="period.ShowAccountCodes" ShowDecimals="period.ShowDecimals" /><div class="report-result"><span>Net assets</span><strong>@Money(AssetTotal - LiabilityTotal)</strong></div></section> }
    else { <section class="financial-report"><header><div><h2>Trial Balance</h2><p>As at @period.To.ToString("dd MMM yyyy")</p></div><strong>@access.Organisation.LegalName</strong></header><table class="report-table"><thead><tr>@if (period.ShowAccountCodes) { <th>Code</th> }<th>Account</th><th class="number">Debit</th><th class="number">Credit</th></tr></thead><tbody>@foreach (var row in VisibleTrialRows) { <tr>@if (period.ShowAccountCodes) { <td>@row.Code</td> }<td>@row.Name</td><td class="number">@MoneyOrDash(row.Debit)</td><td class="number">@MoneyOrDash(row.Credit)</td></tr> }</tbody><tfoot><tr><th colspan="@(period.ShowAccountCodes ? 2 : 1)">Totals</th><th class="number">@Money(TrialDebit)</th><th class="number">@Money(TrialCredit)</th></tr></tfoot></table><div class="balance-check @(TrialDebit == TrialCredit ? "balanced" : "unbalanced")">@(TrialDebit == TrialCredit ? "Trial balance agrees" : $"Trial balance difference: ${Math.Abs(TrialDebit - TrialCredit):N2}")</div></section> }
    <div class="report-bottom-bar no-print"><span>Accrual basis · @access.Organisation.BaseCurrency</span><div><button class="btn btn-outline-secondary" @onclick="SaveView">Save</button><button class="btn btn-outline-secondary" onclick="window.print()">Save as PDF</button><button class="btn btn-primary" @onclick="ExportCsv">Export CSV</button></div></div>
    @if (saveMessage is not null) { <div class="alert alert-success no-print mt-2">@saveMessage</div> }
}

@code {
    [Parameter] public Guid OrganisationId { get; set; } [Parameter] public string? ReportType { get; set; }
    private string NormalisedReportType => ReportType is "balance-sheet" or "trial-balance" ? ReportType : "profit-loss";
    private string ReportTitle => NormalisedReportType switch { "balance-sheet" => "Balance Sheet", "trial-balance" => "Trial Balance", _ => "Profit & Loss" };
    private AccessibleOrganisation? access; private PeriodModel period = new(); private List<AccountBalance> balances = [], comparisonBalances = []; private List<TrialRow> trialRows = []; private string? saveMessage; private DateOnly comparisonFrom, comparisonTo;
    private IEnumerable<TrialRow> VisibleTrialRows => period.ShowZeroBalances ? trialRows : trialRows.Where(x => x.Debit != 0 || x.Credit != 0);
    private IEnumerable<AccountBalance> RevenueRows => balances.Where(x => x.Type == AccountType.Revenue); private IEnumerable<AccountBalance> ExpenseRows => balances.Where(x => x.Type == AccountType.Expense); private IEnumerable<AccountBalance> AssetRows => balances.Where(x => x.Type == AccountType.Asset); private IEnumerable<AccountBalance> LiabilityRows => balances.Where(x => x.Type == AccountType.Liability); private IEnumerable<AccountBalance> EquityRows => balances.Where(x => x.Type == AccountType.Equity);
    private decimal RevenueTotal => RevenueRows.Sum(x => x.DisplayAmount); private decimal ExpenseTotal => ExpenseRows.Sum(x => x.DisplayAmount); private decimal NetProfit => RevenueTotal - ExpenseTotal; private decimal AssetTotal => AssetRows.Sum(x => x.DisplayAmount); private decimal LiabilityTotal => LiabilityRows.Sum(x => x.DisplayAmount); private decimal EquityTotal => EquityRows.Sum(x => x.DisplayAmount) + NetProfit; private decimal TrialDebit => trialRows.Sum(x => x.Debit); private decimal TrialCredit => trialRows.Sum(x => x.Credit);
    private string ComparisonLabel => $"{comparisonFrom:dd MMM yyyy} to {comparisonTo:dd MMM yyyy}"; private string ComparisonMeasureLabel => NormalisedReportType == "profit-loss" ? "Net profit" : "Net assets"; private decimal ComparisonMeasure => NormalisedReportType == "profit-loss" ? comparisonBalances.Where(x => x.Type == AccountType.Revenue).Sum(x => x.DisplayAmount) - comparisonBalances.Where(x => x.Type == AccountType.Expense).Sum(x => x.DisplayAmount) : comparisonBalances.Where(x => x.Type == AccountType.Asset).Sum(x => x.DisplayAmount) - comparisonBalances.Where(x => x.Type == AccountType.Liability).Sum(x => x.DisplayAmount);
    protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is null) return; var today = DateOnly.FromDateTime(DateTime.Today); var month = access.Organisation.FinancialYearEndMonth; var day = Math.Min(access.Organisation.FinancialYearEndDay, DateTime.DaysInMonth(today.Year, month)); var yearEnd = new DateOnly(today.Year, month, day); if (yearEnd > today) yearEnd = yearEnd.AddYears(-1); period.To = today; period.From = yearEnd.AddYears(-1).AddDays(1); await Load(); }
    private async Task Load()
    {
        if (access is null || period.From > period.To) return;
        var all = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && x.PostedJournal.EntryDate <= period.To).GroupBy(x => new { x.LedgerAccount.Code, x.LedgerAccount.Name, x.LedgerAccount.Type }).Select(x => new { x.Key.Code, x.Key.Name, x.Key.Type, Debit = x.Sum(y => y.Debit), Credit = x.Sum(y => y.Credit) }).OrderBy(x => x.Code).ToListAsync();
        trialRows = all.Select(x => { var net = x.Debit - x.Credit; return new TrialRow(x.Code, x.Name, Math.Max(net, 0), Math.Max(-net, 0)); }).ToList();
        var profit = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && x.PostedJournal.EntryDate >= period.From && x.PostedJournal.EntryDate <= period.To && (x.LedgerAccount.Type == AccountType.Revenue || x.LedgerAccount.Type == AccountType.Expense)).GroupBy(x => new { x.LedgerAccount.Code, x.LedgerAccount.Name, x.LedgerAccount.Type }).Select(x => new { x.Key.Code, x.Key.Name, x.Key.Type, Debit = x.Sum(y => y.Debit), Credit = x.Sum(y => y.Credit) }).ToListAsync();
        balances = all.Where(x => x.Type is AccountType.Asset or AccountType.Liability or AccountType.Equity).Select(x => new AccountBalance(x.Code, x.Name, x.Type, x.Type == AccountType.Asset ? x.Debit - x.Credit : x.Credit - x.Debit)).Concat(profit.Select(x => new AccountBalance(x.Code, x.Name, x.Type, x.Type == AccountType.Revenue ? x.Credit - x.Debit : x.Debit - x.Credit))).Where(x => period.ShowZeroBalances || x.DisplayAmount != 0).OrderBy(x => x.Code).ToList();
        comparisonBalances = [];
        if (period.CompareWith != "none")
        {
            if (period.CompareWith == "previous-year") { comparisonFrom = period.From.AddYears(-1); comparisonTo = period.To.AddYears(-1); }
            else { var days = period.To.DayNumber - period.From.DayNumber + 1; comparisonTo = period.From.AddDays(-1); comparisonFrom = comparisonTo.AddDays(1 - days); }
            var comparisonAll = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && x.PostedJournal.EntryDate <= comparisonTo).GroupBy(x => new { x.LedgerAccount.Code, x.LedgerAccount.Name, x.LedgerAccount.Type }).Select(x => new { x.Key.Code, x.Key.Name, x.Key.Type, Debit = x.Sum(y => y.Debit), Credit = x.Sum(y => y.Credit) }).ToListAsync();
            var comparisonProfit = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && x.PostedJournal.EntryDate >= comparisonFrom && x.PostedJournal.EntryDate <= comparisonTo && (x.LedgerAccount.Type == AccountType.Revenue || x.LedgerAccount.Type == AccountType.Expense)).GroupBy(x => new { x.LedgerAccount.Code, x.LedgerAccount.Name, x.LedgerAccount.Type }).Select(x => new { x.Key.Code, x.Key.Name, x.Key.Type, Debit = x.Sum(y => y.Debit), Credit = x.Sum(y => y.Credit) }).ToListAsync();
            comparisonBalances = comparisonAll.Where(x => x.Type is AccountType.Asset or AccountType.Liability or AccountType.Equity).Select(x => new AccountBalance(x.Code, x.Name, x.Type, x.Type == AccountType.Asset ? x.Debit - x.Credit : x.Credit - x.Debit)).Concat(comparisonProfit.Select(x => new AccountBalance(x.Code, x.Name, x.Type, x.Type == AccountType.Revenue ? x.Credit - x.Debit : x.Debit - x.Credit))).ToList();
        }
    }
    private string Money(decimal value) => period.ShowDecimals ? $"${value:N2}" : $"${value:N0}"; private string MoneyOrDash(decimal value) => value == 0 ? "—" : Money(value);
    private void SaveView() => saveMessage = $"{ReportTitle} view saved for this session.";
    private async Task ExportCsv() { var csv = new StringBuilder(); if (NormalisedReportType == "trial-balance") { csv.AppendLine("Code,Account,Debit,Credit"); foreach (var x in VisibleTrialRows) csv.AppendLine($"{Q(x.Code)},{Q(x.Name)},{x.Debit},{x.Credit}"); } else { csv.AppendLine("Code,Account,Type,Amount"); foreach (var x in balances) csv.AppendLine($"{Q(x.Code)},{Q(x.Name)},{x.Type},{x.DisplayAmount}"); } await JS.InvokeVoidAsync("accountIsland.downloadText", $"{NormalisedReportType}-{period.From:yyyyMMdd}-{period.To:yyyyMMdd}.csv", csv.ToString(), "text/csv;charset=utf-8"); }
    private static string Q(string? value) => $"\"{(value ?? "").Replace("\"", "\"\"")}\"";
    public sealed record AccountBalance(string Code, string Name, AccountType Type, decimal DisplayAmount); private sealed record TrialRow(string Code, string Name, decimal Debit, decimal Credit); private sealed class PeriodModel { public DateOnly From { get; set; } public DateOnly To { get; set; } public string CompareWith { get; set; } = "none"; public string Tracking { get; set; } = "all"; public bool ShowAccountCodes { get; set; } = true; public bool ShowZeroBalances { get; set; } public bool ShowDecimals { get; set; } = true; public bool ShowAccountingBasis { get; set; } = true; }
}
