@page "/o/{OrganisationId:guid}/reports"
@page "/o/{OrganisationId:guid}/reports/{ReportType}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Text
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@inject FinancialReportService FinancialReports
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@using System.Text.Json

<PageTitle>Reports · Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="report-heading">
        <div>
            <p class="eyebrow">Reporting</p>
            <h1>@ReportTitle</h1>
            <p>
                Prepared from posted journals in
                @access.Organisation.BaseCurrency.
            </p>
            <p><strong>Scope:</strong> @TrackingLabel</p>
        </div>
    </div>

    <section class="report-controls report-options no-print">
        <EditForm Model="period"
                  OnValidSubmit="Load"
                  FormName="report-period">

            <div>
                <label class="form-label">From</label>
                <InputDate class="form-control"
                           @bind-Value="period.From" @bind-Value:after="Load" disabled="isLoading" />
            </div>

            <div>
                <label class="form-label">To</label>
                <InputDate class="form-control"
                           @bind-Value="period.To" @bind-Value:after="Load" disabled="isLoading" />
            </div>

            <div>
                <label class="form-label">Compare with</label>
                @if (NormalisedReportType == "profit-loss")
                {
                    <ReportComparisonPicker Options="comparisonOptions" Changed="Load" Disabled="isLoading" />
                }
                else
                {
                <InputSelect class="form-select"
                             @bind-Value="period.CompareWith" @bind-Value:after="Load" disabled="isLoading">
                    <option value="none">None</option>
                    <option value="previous-period">
                        Previous period
                    </option>
                    <option value="previous-year">
                        Previous year
                    </option>
                </InputSelect>
                }
            </div>

            <div>
                <label class="form-label">Tracking</label>
                <InputSelect class="form-select"
                             @bind-Value="period.Tracking" @bind-Value:after="Load" disabled="isLoading">
                    <option value="all">All accessible transactions</option>
                    @foreach (var branch in branches)
                    {
                        <option value="@($"branch:{branch.Id}")">@branch.Code — @branch.Name</option>
                        @foreach (var division in branch.Divisions)
                        {
                            <option value="@($"division:{division.Id}")">@branch.Code / @division.Code — @division.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <details class="report-more">
                <summary class="btn btn-outline-secondary">
                    More
                </summary>

                <div class="report-more-panel">
                    <strong>Display options</strong>

                    <label>
                        <InputCheckbox @bind-Value="period.ShowAccountCodes" />
                        Account codes
                    </label>

                    <label>
                        <InputCheckbox @bind-Value="period.ShowZeroBalances" />
                        Zero balances
                    </label>

                    <label>
                        <InputCheckbox @bind-Value="period.ShowDecimals" />
                        Decimals
                    </label>

                    <label>
                        <InputCheckbox @bind-Value="period.ShowAccountingBasis" />
                        Accounting basis
                    </label>
                </div>
            </details>

            <button class="btn btn-primary" disabled="isLoading">
                Update
            </button>
        </EditForm>
    </section>

    @if (isLoading)
    {
        <p role="status">Loading report...</p>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else
    {
    @if (NormalisedReportType != "profit-loss" && period.CompareWith != "none")
    {
        <div class="comparison-strip no-print">
            <span>
                <strong>Comparison:</strong>
                @ComparisonLabel
            </span>

            <span>
                @ComparisonMeasureLabel
                <strong>@Money(ComparisonMeasure)</strong>
            </span>
        </div>
    }

    @if (NormalisedReportType == "profit-loss")
    {
        <section class="financial-report">
            <header>
                <div>
                    <h2>Profit &amp; Loss</h2>
                    <p>
                        @period.From.ToString("dd MMM yyyy")
                        to
                        @period.To.ToString("dd MMM yyyy")
                    </p>
                </div>

                <strong>
                    @access.Organisation.LegalName
                </strong>
            </header>

            @if (ShowProfitComparison)
            {
                <div class="comparison-table-scroll">
                    <table class="report-table profit-comparison" style="min-width:@(360 + (comparisonColumns.Count + 1) * 165)px">
                        <thead>
                            <tr><th scope="col">Account</th><th scope="col" class="number">@PeriodHeading(period.From, period.To)</th>
                                @foreach (var column in comparisonColumns)
                                {
                                    <th scope="col" class="number">@PeriodHeading(column.Period.From, column.Period.To)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in new[] { AccountType.Revenue, AccountType.Expense })
                            {
                                <tr><th colspan="@(comparisonColumns.Count + 2)">@(type == AccountType.Revenue ? "Income" : "Expenses")</th></tr>
                                @foreach (var row in ComparisonRows(type))
                                {
                                    <tr>
                                        <th scope="row">@if (period.ShowAccountCodes) { <small>@row.Code </small> }@row.Name</th>
                                        <td class="number @(row.Current < 0 ? "negative" : null)"><a href="@TransactionUrl(row.Code, period.From, period.To)" rel="noopener" title="View transactions">@Money(row.Current)</a></td>
                                        @for (var columnIndex = 0; columnIndex < row.Previous.Length; columnIndex++)
                                        {
                                            var amount = row.Previous[columnIndex];
                                            var selectedPeriod = comparisonColumns[columnIndex].Period;
                                            <td class="number @(amount < 0 ? "negative" : null)"><a href="@TransactionUrl(row.Code, selectedPeriod.From, selectedPeriod.To)" rel="noopener" title="View transactions">@Money(amount)</a></td>
                                        }
                                    </tr>
                                }
                                <tr class="comparison-total"><th scope="row">@(type == AccountType.Revenue ? "Total income" : "Total expenses")</th><td class="number">@Money(CurrentTotal(type))</td>@foreach (var column in comparisonColumns) { <td class="number">@Money(ColumnTotal(column, type))</td> }</tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th scope="row">Net profit</th><td class="number @(NetProfit < 0 ? "negative" : null)">@Money(NetProfit)</td>@foreach (var column in comparisonColumns) { <td class="number @(ColumnProfit(column) < 0 ? "negative" : null)">@Money(ColumnProfit(column))</td> }</tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
            <ReportSection
                Title="Income"
                DetailUrl="@(row => TransactionUrl(row.Code, period.From, period.To))"
                Rows="RevenueRows"
                TotalLabel="Total income"
                Total="RevenueTotal"
                ShowAccountCodes="period.ShowAccountCodes"
                ShowDecimals="period.ShowDecimals" />

            <ReportSection
                Title="Expenses"
                DetailUrl="@(row => TransactionUrl(row.Code, period.From, period.To))"
                Rows="ExpenseRows"
                TotalLabel="Total expenses"
                Total="ExpenseTotal"
                ShowAccountCodes="period.ShowAccountCodes"
                ShowDecimals="period.ShowDecimals" />

            <div class="report-result">
                <span>Net profit</span>

                <strong class="@(NetProfit < 0 ? "negative" : null)">
                    @Money(NetProfit)
                </strong>
            </div>
            }
        </section>
    }
    else if (NormalisedReportType == "balance-sheet")
    {
        <section class="financial-report">
            <header>
                <div>
                    <h2>Balance Sheet</h2>
                    <p>
                        As at @period.To.ToString("dd MMM yyyy")
                    </p>
                </div>

                <strong>
                    @access.Organisation.LegalName
                </strong>
            </header>

            <ReportSection
                Title="Assets"
                Rows="AssetRows"
                TotalLabel="Total assets"
                Total="AssetTotal"
                ShowAccountCodes="period.ShowAccountCodes"
                ShowDecimals="period.ShowDecimals" />

            <ReportSection
                Title="Liabilities"
                Rows="LiabilityRows"
                TotalLabel="Total liabilities"
                Total="LiabilityTotal"
                ShowAccountCodes="period.ShowAccountCodes"
                ShowDecimals="period.ShowDecimals" />

            <ReportSection
                Title="Equity"
                Rows="EquityRows"
                TotalLabel="Total equity"
                Total="EquityTotal"
                ShowAccountCodes="period.ShowAccountCodes"
                ShowDecimals="period.ShowDecimals" />

            <div class="report-result">
                <span>Net assets</span>
                <strong>
                    @Money(AssetTotal - LiabilityTotal)
                </strong>
            </div>
        </section>
    }
    else
    {
        <section class="financial-report">
            <header>
                <div>
                    <h2>Trial Balance</h2>
                    <p>
                        As at @period.To.ToString("dd MMM yyyy")
                    </p>
                </div>

                <strong>
                    @access.Organisation.LegalName
                </strong>
            </header>

            <table class="report-table">
                <thead>
                    <tr>
                        @if (period.ShowAccountCodes)
                        {
                            <th>Code</th>
                        }

                        <th>Account</th>
                        <th class="number">Debit</th>
                        <th class="number">Credit</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in VisibleTrialRows)
                    {
                        <tr>
                            @if (period.ShowAccountCodes)
                            {
                                <td>@row.Code</td>
                            }

                            <td>@row.Name</td>
                            <td class="number">
                                @MoneyOrDash(row.Debit)
                            </td>
                            <td class="number">
                                @MoneyOrDash(row.Credit)
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="@(period.ShowAccountCodes ? 2 : 1)">
                            Totals
                        </th>
                        <th class="number">
                            @Money(TrialDebit)
                        </th>
                        <th class="number">
                            @Money(TrialCredit)
                        </th>
                    </tr>
                </tfoot>
            </table>

            <div class="balance-check @(TrialDebit == TrialCredit ? "balanced" : "unbalanced")">
                @(TrialDebit == TrialCredit
                    ? "Trial balance agrees"
                    : $"Trial balance difference: ${Math.Abs(TrialDebit - TrialCredit):N2}")
            </div>
        </section>
    }

    <div class="report-bottom-bar no-print">
        <span>
            Accrual basis · @access.Organisation.BaseCurrency
        </span>

        <div>
            <button class="btn btn-outline-secondary"
                    @onclick="SaveView">
                Save
            </button>

            <button class="btn btn-outline-secondary"
                    onclick="window.print()">
                Save as PDF
            </button>

            <button class="btn btn-primary"
                    @onclick="ExportCsv">
                Export CSV
            </button>
        </div>
    </div>

    @if (saveMessage is not null)
    {
        <div class="alert alert-success no-print mt-2">
            @saveMessage
        </div>
    }
}

}

@code {
    [Parameter]
    public Guid OrganisationId { get; set; }

    [Parameter]
    public string? ReportType { get; set; }

    private string NormalisedReportType =>
        ReportType is "balance-sheet" or "trial-balance"
            ? ReportType
            : "profit-loss";

    private string ReportTitle =>
        NormalisedReportType switch
        {
            "balance-sheet" => "Balance Sheet",
            "trial-balance" => "Trial Balance",
            _ => "Profit & Loss"
        };

    private AccessibleOrganisation? access;
    private string userId = "";
    private List<Branch> branches = [];

    [SupplyParameterFromQuery(Name = "view")] public string? ViewState { get; set; }
    private sealed class ReportView
    {
        public PeriodModel Period { get; set; } = new();
        public ReportComparisonOptions Comparison { get; set; } = new();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (access is not null && !isLoading && loadError is null)
            await JS.InvokeVoidAsync("accountIslandNavigation.saveView", JsonSerializer.Serialize(new ReportView { Period = period, Comparison = comparisonOptions }));
    }
    private PeriodModel period = new();

    private FinancialReportData report =
        FinancialReportData.Empty;

    private FinancialReportData comparisonReport =
        FinancialReportData.Empty;

    private string? saveMessage;

    private DateOnly comparisonFrom;
    private DateOnly comparisonTo;
    private bool isLoading;
    private string? loadError;

    private ReportComparisonOptions comparisonOptions = new();
    private List<ReportComparisonColumn> comparisonColumns = [];
    private string TransactionUrl(string code, DateOnly from, DateOnly to) =>
        $"/o/{OrganisationId}/report-transactions?account={Uri.EscapeDataString(code)}&from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&tracking={Uri.EscapeDataString(period.Tracking)}";

    private bool ShowProfitComparison => NormalisedReportType == "profit-loss" && comparisonColumns.Count > 0;

    private static string PeriodHeading(DateOnly from, DateOnly to) =>
        from.Day == 1 && to == from.AddMonths(1).AddDays(-1)
            ? from.ToString("MMMM yyyy")
            : $"{from:dd MMM yyyy} – {to:dd MMM yyyy}";

    private sealed record ComparisonRow(string Code, string Name, decimal Current, decimal[] Previous);

    private IEnumerable<ComparisonRow> ComparisonRows(AccountType type)
    {
        var current = report.Balances.Where(x => x.Type == type).ToDictionary(x => x.Code);
        var previous = comparisonColumns.Select(column => column.Report.Balances.Where(x => x.Type == type).ToDictionary(x => x.Code)).ToArray();
        return current.Keys.Concat(previous.SelectMany(x => x.Keys)).Distinct().OrderBy(x => x, StringComparer.Ordinal)
            .Select(code => new ComparisonRow(code,
                current.GetValueOrDefault(code)?.Name ?? previous.First(x => x.ContainsKey(code))[code].Name,
                current.GetValueOrDefault(code)?.DisplayAmount ?? 0,
                previous.Select(x => x.GetValueOrDefault(code)?.DisplayAmount ?? 0).ToArray()))
            .Where(x => period.ShowZeroBalances || x.Current != 0 || x.Previous.Any(amount => amount != 0));
    }

    private decimal CurrentTotal(AccountType type) => report.Balances.Where(x => x.Type == type).Sum(x => x.DisplayAmount);
    private static decimal ColumnTotal(ReportComparisonColumn column, AccountType type) => column.Report.Balances.Where(x => x.Type == type).Sum(x => x.DisplayAmount);
    private static decimal ColumnProfit(ReportComparisonColumn column) => ColumnTotal(column, AccountType.Revenue) - ColumnTotal(column, AccountType.Expense);
    private static string CsvAmounts(IEnumerable<decimal> amounts) => string.Join(",", amounts.Select(amount => amount.ToString(System.Globalization.CultureInfo.InvariantCulture)));

    private string TrackingLabel
    {
        get
        {
            if (period.Tracking == "all") return "All accessible transactions";
            if (period.Tracking.StartsWith("branch:") && Guid.TryParse(period.Tracking[7..], out var branchId))
            {
                var branch = branches.SingleOrDefault(x => x.Id == branchId);
                return branch is null ? "All accessible transactions" : $"{branch.Code} — {branch.Name}";
            }
            if (period.Tracking.StartsWith("division:") && Guid.TryParse(period.Tracking[9..], out var divisionId))
            {
                var branch = branches.SingleOrDefault(x => x.Divisions.Any(division => division.Id == divisionId));
                var division = branch?.Divisions.Single(x => x.Id == divisionId);
                return division is null ? "All accessible transactions" : $"{branch!.Code} / {division.Code} — {division.Name}";
            }
            return "All accessible transactions";
        }
    }

    private IEnumerable<TrialBalanceRow> VisibleTrialRows =>
        period.ShowZeroBalances
            ? report.TrialBalance
            : report.TrialBalance.Where(
                x => x.Debit != 0 ||
                     x.Credit != 0);

    private IEnumerable<FinancialAccountBalance> VisibleBalances =>
        period.ShowZeroBalances
            ? report.Balances
            : report.Balances.Where(
                x => x.DisplayAmount != 0);

    private IEnumerable<FinancialAccountBalance> RevenueRows =>
        VisibleBalances.Where(
            x => x.Type == AccountType.Revenue);

    private IEnumerable<FinancialAccountBalance> ExpenseRows =>
        VisibleBalances.Where(
            x => x.Type == AccountType.Expense);

    private IEnumerable<FinancialAccountBalance> AssetRows =>
        VisibleBalances.Where(
            x => x.Type == AccountType.Asset);

    private IEnumerable<FinancialAccountBalance> LiabilityRows =>
        VisibleBalances.Where(
            x => x.Type == AccountType.Liability);

    private IEnumerable<FinancialAccountBalance> EquityRows =>
        VisibleBalances.Where(
            x => x.Type == AccountType.Equity);

    private decimal RevenueTotal =>
        RevenueRows.Sum(x => x.DisplayAmount);

    private decimal ExpenseTotal =>
        ExpenseRows.Sum(x => x.DisplayAmount);

    private decimal NetProfit =>
        RevenueTotal - ExpenseTotal;

    private decimal AssetTotal =>
        AssetRows.Sum(x => x.DisplayAmount);

    private decimal LiabilityTotal =>
        LiabilityRows.Sum(x => x.DisplayAmount);

    private decimal EquityTotal =>
    EquityRows.Sum(x => x.DisplayAmount);

    private decimal TrialDebit =>
        report.TrialBalance.Sum(x => x.Debit);

    private decimal TrialCredit =>
        report.TrialBalance.Sum(x => x.Credit);

    private string ComparisonLabel =>
        $"{comparisonFrom:dd MMM yyyy} to {comparisonTo:dd MMM yyyy}";

    private string ComparisonMeasureLabel =>
        NormalisedReportType == "profit-loss"
            ? "Net profit"
            : "Net assets";

    private decimal ComparisonMeasure
    {
        get
        {
            if (NormalisedReportType == "profit-loss")
            {
                var revenue =
                    comparisonReport.Balances
                        .Where(x =>
                            x.Type == AccountType.Revenue)
                        .Sum(x => x.DisplayAmount);

                var expenses =
                    comparisonReport.Balances
                        .Where(x =>
                            x.Type == AccountType.Expense)
                        .Sum(x => x.DisplayAmount);

                return revenue - expenses;
            }

            var assets =
                comparisonReport.Balances
                    .Where(x =>
                        x.Type == AccountType.Asset)
                    .Sum(x => x.DisplayAmount);

            var liabilities =
                comparisonReport.Balances
                    .Where(x =>
                        x.Type == AccountType.Liability)
                    .Sum(x => x.DisplayAmount);

            return assets - liabilities;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        branches = await TenantAccess.ListAccessibleBranchesAsync(userId, OrganisationId);

        var today =
            DateOnly.FromDateTime(DateTime.Today);

        var month =
            access.Organisation.FinancialYearEndMonth;

        var day =
            Math.Min(
                access.Organisation.FinancialYearEndDay,
                DateTime.DaysInMonth(
                    today.Year,
                    month));

        var yearEnd =
            new DateOnly(
                today.Year,
                month,
                day);

        if (yearEnd > today)
        {
            yearEnd =
                yearEnd.AddYears(-1);
        }

        period.To = today;

        period.From =
            yearEnd
                .AddYears(-1)
                .AddDays(1);

        if (NormalisedReportType == "profit-loss")
        {
            period.To = new DateOnly(today.Year, today.Month, 1).AddDays(-1);
            period.From = new DateOnly(period.To.Year, period.To.Month, 1);
            comparisonOptions.CustomFrom = period.From.AddMonths(-1);
            comparisonOptions.CustomTo = period.From.AddDays(-1);
        }

        if (!string.IsNullOrEmpty(ViewState))
        {
            try
            {
                var saved = JsonSerializer.Deserialize<ReportView>(ViewState);
                if (saved?.Period is not null && saved.Comparison is not null)
                {
                    period = saved.Period;
                    comparisonOptions = saved.Comparison;
                }
            }
            catch (JsonException) { }
        }
        await Load();
    }

    private async Task Load()
    {
        if (access is null || isLoading) return;
        loadError = null;
        if (period.From > period.To)
        {
            loadError = "The From date must be on or before the To date.";
            return;
        }

        isLoading = true;
        try
        {
        var comparisonPeriods = NormalisedReportType == "profit-loss" ? comparisonOptions.Periods(period.From, period.To) : [];
        var divisionScope = await ResolveDivisionScope();

        report =
            await FinancialReports.GetAsync(
                OrganisationId,
                period.From,
                period.To,
                divisionIds: divisionScope);

        comparisonReport =
            FinancialReportData.Empty;

        if (NormalisedReportType == "profit-loss")
        {
            var columns = new List<ReportComparisonColumn>();
            foreach (var comparisonPeriod in comparisonPeriods)
            {
                var data = await FinancialReports.GetAsync(OrganisationId, comparisonPeriod.From, comparisonPeriod.To, divisionIds: divisionScope);
                columns.Add(new(comparisonPeriod, data));
            }
            comparisonColumns = columns;
            return;
        }

        if (period.CompareWith == "none")
        {
            return;
        }

        if (period.CompareWith == "previous-year")
        {
            comparisonFrom =
                period.From.AddYears(-1);

            comparisonTo =
                period.To.AddYears(-1);
        }
        else if (period.From.Day == 1 && period.To.Day == DateTime.DaysInMonth(period.To.Year, period.To.Month))
        {
            var months = (period.To.Year - period.From.Year) * 12 + period.To.Month - period.From.Month + 1;
            comparisonFrom = period.From.AddMonths(-months);
            comparisonTo = period.From.AddDays(-1);
        }
        else
        {
            var days =
                period.To.DayNumber -
                period.From.DayNumber +
                1;

            comparisonTo =
                period.From.AddDays(-1);

            comparisonFrom =
                comparisonTo.AddDays(
                    1 - days);
        }

        comparisonReport =
            await FinancialReports.GetAsync(
                OrganisationId,
                comparisonFrom,
                comparisonTo,
                divisionIds: divisionScope);
        }
        catch (ArgumentException ex)
        {
            loadError = ex.Message;
        }
        catch
        {
            loadError = "The report could not be loaded. Please try Update again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<Guid[]?> ResolveDivisionScope()
    {
        if (period.Tracking == "all")
        {
            return await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId);
        }

        if (period.Tracking.StartsWith("branch:") && Guid.TryParse(period.Tracking[7..], out var branchId))
        {
            return branches.SingleOrDefault(x => x.Id == branchId)?.Divisions.Select(x => x.Id).ToArray() ?? [];
        }

        if (period.Tracking.StartsWith("division:") && Guid.TryParse(period.Tracking[9..], out var divisionId) &&
            branches.Any(x => x.Divisions.Any(division => division.Id == divisionId)))
        {
            return [divisionId];
        }

        period.Tracking = "all";
        return await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId);
    }

    private string Money(decimal value) =>
        period.ShowDecimals
            ? $"${value:N2}"
            : $"${value:N0}";

    private string MoneyOrDash(decimal value) =>
        value == 0
            ? "—"
            : Money(value);

    private void SaveView()
    {
        saveMessage =
            $"{ReportTitle} view saved for this session.";
    }

    private async Task ExportCsv()
    {
        var csv =
            new StringBuilder();

        if (ShowProfitComparison)
        {
            csv.AppendLine($"Code,Account,Type,{Q(PeriodHeading(period.From, period.To))},{string.Join(",", comparisonColumns.Select(column => Q(PeriodHeading(column.Period.From, column.Period.To))))}");
            foreach (var type in new[] { AccountType.Revenue, AccountType.Expense })
            {
                foreach (var row in ComparisonRows(type))
                {
                    csv.AppendLine($"{Q(row.Code)},{Q(row.Name)},{type},{CsvAmounts(new[] { row.Current }.Concat(row.Previous))}");
                }
                var label = type == AccountType.Revenue ? "Total income" : "Total expenses";
                csv.AppendLine($",{Q(label)},,{CsvAmounts(new[] { CurrentTotal(type) }.Concat(comparisonColumns.Select(column => ColumnTotal(column, type))))}");
            }
            csv.AppendLine($",Net profit,,{CsvAmounts(new[] { NetProfit }.Concat(comparisonColumns.Select(ColumnProfit)))}");
        }
        else if (NormalisedReportType == "trial-balance")
        {
            csv.AppendLine(
                "Code,Account,Debit,Credit");

            foreach (var x in VisibleTrialRows)
            {
                csv.AppendLine(
                    $"{Q(x.Code)},{Q(x.Name)},{x.Debit},{x.Credit}");
            }
        }
        else
        {
            csv.AppendLine(
                "Code,Account,Type,Amount");

            foreach (var x in VisibleBalances)
            {
                csv.AppendLine(
                    $"{Q(x.Code)},{Q(x.Name)},{x.Type},{x.DisplayAmount}");
            }
        }

        await JS.InvokeVoidAsync(
            "accountIsland.downloadText",
            $"{NormalisedReportType}-{period.From:yyyyMMdd}-{period.To:yyyyMMdd}.csv",
            csv.ToString(),
            "text/csv;charset=utf-8");
    }

    private static string Q(string? value) =>
        $"\"{(value ?? "").Replace("\"", "\"\"")}\"";

    private sealed class PeriodModel
    {
        public DateOnly From { get; set; }

        public DateOnly To { get; set; }

        public string CompareWith { get; set; } =
            "none";

        public string Tracking { get; set; } =
            "all";

        public bool ShowAccountCodes { get; set; } =
            true;

        public bool ShowZeroBalances { get; set; }

        public bool ShowDecimals { get; set; } =
            true;

        public bool ShowAccountingBasis { get; set; } =
            true;
    }
}
