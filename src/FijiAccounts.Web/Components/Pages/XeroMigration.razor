@page "/o/{OrganisationId:guid}/migration/xero"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject XeroMigrationService MigrationService
@inject XeroConnectionService XeroConnection
@inject XeroImportPreparationService ImportPreparation
@inject XeroCutoverImportService CutoverImport
@inject XeroMigrationAssistantService MigrationAssistant
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<XeroMigration> Logger

<PageTitle>Xero migration · Account Island</PageTitle>

@if (loading)
{
    <p role="status">Loading Xero migration...</p>
}
else if (access is null)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else if (!IsNz)
{
    <div class="alert alert-warning">This Xero migration workspace is available for New Zealand organisations.</div>
}
else
{
    <div class="migration-heading">
        <div>
            <p class="eyebrow">Accounting · data migration</p>
            <h1>Move from Xero</h1>
            <p>@OrganisationName · A controlled move of the complete accounting record into Account Island.</p>
        </div>
        <div class="heading-actions">
            @if (migration is not null)
            {
                <a class="btn btn-secondary" href="/o/@OrganisationId/migration/xero/reports">Report library</a>
                @if (canApprove && migration.Status != XeroMigrationStatus.Complete)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="ShowRestartConfirmation" disabled="@busy">Start again</button>
                }
            }
            <span class="status-pill @StatusClass">@StatusLabel</span>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert @messageClass" role="status">@message</div>
    }

    @if (restartConfirmationVisible)
    {
        <section class="restart-panel" role="dialog" aria-labelledby="restart-title" aria-describedby="restart-description">
            <div>
                <p class="step-label">Restart migration</p>
                <h2 id="restart-title">Return to the first step?</h2>
                <p id="restart-description">This clears the selected Xero organisation, copied staging data, uploaded evidence links, mappings and completed checks. Protected source documents and the audit history remain retained.</p>
                <p>Nothing already posted to the live ledger will be removed. If a live cutover exists, Account Island will prevent the restart.</p>
            </div>
            <label class="guided-check restart-check">
                <input type="checkbox" @bind="restartAcknowledged" disabled="@busy" />
                <span>I understand that the current unposted migration progress will be cleared.</span>
            </label>
            <div class="guided-button-row">
                <button type="button" class="btn btn-danger" @onclick="RestartMigration" disabled="@(busy || !restartAcknowledged)">@(busy ? "Restarting..." : "Restart migration")</button>
                <button type="button" class="btn btn-secondary" @onclick="HideRestartConfirmation" disabled="@busy">Keep current progress</button>
            </div>
        </section>
    }

    <section class="migration-assistant" aria-labelledby="migration-assistant-title">
        <div class="assistant-main">
            <div class="assistant-heading">
                <div>
                    <p class="step-label">Migration assistant</p>
                    <h2 id="migration-assistant-title">@assistant.Headline</h2>
                    <p>@assistant.Guidance</p>
                </div>
                <div class="assistant-score">
                    <strong>@assistant.PassedCount/@assistant.TotalCount</strong>
                    <span>checks passed</span>
                </div>
            </div>
            <div class="assistant-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@assistant.TotalCount" aria-valuenow="@assistant.PassedCount">
                <span style="width: @AssistantProgress%"></span>
            </div>
            <div class="assistant-action">
                @switch (assistant.NextAction)
                {
                    case XeroMigrationAssistantAction.SaveSetup:
                        <EditForm Model="model" OnValidSubmit="Save" FormName="guided-xero-migration-setup" class="guided-action-panel">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="guided-setup-grid">
                                <div>
                                    <label class="form-label">Xero organisation name</label>
                                    <InputText class="form-control" @bind-Value="model.SourceOrganisationName" disabled="@(!canPrepare || busy)" />
                                    <small>Use the legal organisation name shown in Xero.</small>
                                </div>
                                <div>
                                    <label class="form-label">First live day in Account Island</label>
                                    <InputDate class="form-control" @bind-Value="model.CutoverDate" disabled="@(!canPrepare || busy)" />
                                    <small>Choose the day after the final day you will use Xero.</small>
                                </div>
                            </div>
                            <label class="guided-check">
                                <InputCheckbox class="form-check-input" @bind-Value="model.IncludeFullHistory" disabled="@(!canPrepare || busy)" />
                                <span>Bring across the complete available transaction history.</span>
                            </label>
                            <button class="btn btn-primary" disabled="@busy">@(busy ? "Saving..." : "Save and continue")</button>
                        </EditForm>
                        break;
                    case XeroMigrationAssistantAction.ConnectXero:
                        if (connectionStatus?.IsConnected == true && connectionStatus.TenantId is null)
                        {
                            <div class="guided-action-panel">
                                <div>
                                    <strong>Choose the Xero organisation that belongs to @OrganisationName</strong>
                                    <p>This confirmation prevents records from another Xero organisation being copied into this workspace.</p>
                                </div>
                                <div class="guided-tenant-choice">
                                    <select class="form-select" @bind="selectedTenantId" disabled="@busy">
                                        <option value="">Choose the Xero organisation</option>
                                        @foreach (var tenant in connectionStatus.AvailableTenants)
                                        {
                                            <option value="@tenant.TenantId">@tenant.TenantName</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-primary" @onclick="ChooseTenant" disabled="@(busy || string.IsNullOrWhiteSpace(selectedTenantId))">Use this organisation and continue</button>
                                </div>
                            </div>
                        }
                        else if (connectionStatus?.IsConnected == true)
                        {
                            <div class="guided-action-panel">
                                <strong>@connectionStatus.TenantName is selected</strong>
                                <p>Account Island will copy every supported read-only dataset, retain its fingerprint, index the records and add safe master data. It cannot change Xero or post financial entries.</p>
                                <button type="button" class="btn btn-primary" @onclick="RunSafeAutomation" disabled="@(!CanRunSafeAutomation)">@(runningAutomation ? "Copying and preparing..." : "Copy and prepare everything")</button>
                            </div>
                        }
                        else if (connectionStatus?.IsConfigured == true && canApprove && migration is not null)
                        {
                            <div class="guided-action-panel">
                                <strong>Connect Xero using read-only access</strong>
                                <p>You will sign in to Xero, choose the source organisation and return here to continue.</p>
                                <a class="btn btn-primary" href="/api/o/@OrganisationId/integrations/xero/connect">Connect Xero</a>
                            </div>
                        }
                        else
                        {
                            <div class="guided-action-panel">
                                <strong>The Xero connection needs administrator setup</strong>
                                <p>An Account Island administrator needs to configure the secure Xero connection before this migration can continue.</p>
                            </div>
                        }
                        break;
                    case XeroMigrationAssistantAction.RunPreparation:
                        <div class="guided-action-panel">
                            <strong>Check and prepare the copied records</strong>
                            <p>Account Island will classify the source, add safe accounts and contacts, and identify only the decisions that need you. No money is posted.</p>
                            <button type="button" class="btn btn-primary" @onclick="RunGuidedPreparation" disabled="@(preparingImport || !canPrepare)">@(preparingImport ? "Preparing safely..." : "Prepare records and continue")</button>
                        </div>
                        break;
                    case XeroMigrationAssistantAction.SupplyEvidence:
                        <div class="guided-action-panel guided-evidence">
                            <div>
                                <strong>Add @CurrentMissingEvidenceCategory</strong>
                                <p>@CurrentEvidenceGuidance</p>
                                <small>@MissingEvidenceCategories.Count required report set(s) remain. The original file is retained with its fingerprint.</small>
                            </div>
                            <InputFile class="form-control" accept=".csv,.xlsx,.pdf,.zip" OnChange="UploadCurrentEvidence" disabled="@(!canPrepare || uploading)" />
                            <span>@(uploading ? "Uploading and checking..." : "Choose the original Xero export to continue")</span>
                        </div>
                        break;
                    case XeroMigrationAssistantAction.ResolveMappings:
                        @if (CurrentMapping is { } currentMapping)
                        {
                            <div class="guided-action-panel guided-mapping">
                                <div>
                                    <small>@MappingKindLabel(currentMapping.Kind)</small>
                                    <strong>@currentMapping.SourceName</strong>
                                    @if (!string.IsNullOrWhiteSpace(currentMapping.Notes))
                                    {
                                        <p><strong>Found in Xero:</strong> @currentMapping.Notes</p>
                                    }
                                    <p>@MappingGuidance(currentMapping)</p>
                                    <details class="source-reference"><summary>Technical Xero reference</summary><code>@currentMapping.SourceKey</code></details>
                                </div>
                                <select class="form-select" value="@MappingSelection(currentMapping.Id)" @onchange="args => mappingSelections[currentMapping.Id] = args.Value?.ToString() ?? string.Empty" disabled="@preparingImport">
                                    <option value="">@MappingPrompt(currentMapping.Kind)</option>
                                    @foreach (var target in Targets(currentMapping.Kind))
                                    {
                                        <option value="@target.Value">@target.Label</option>
                                    }
                                </select>
                                <div class="guided-button-row">
                                    <button type="button" class="btn btn-primary" @onclick="() => SaveMapping(currentMapping)" disabled="@(preparingImport || string.IsNullOrWhiteSpace(MappingSelection(currentMapping.Id)))">Confirm and continue</button>
                                    <button type="button" class="btn btn-link" @onclick="() => IgnoreMapping(currentMapping)" disabled="@preparingImport">Exclude this value</button>
                                </div>
                            </div>
                        }
                        else if (CurrentBlockingIssue is { } blockingIssue)
                        {
                            <div class="guided-action-panel">
                                <strong>Resolve this required item</strong>
                                <p>@blockingIssue.Message</p>
                                <button type="button" class="btn btn-primary" @onclick="RunGuidedPreparation" disabled="@(preparingImport || !canPrepare)">Check again</button>
                                <small>The detailed workspace below contains the affected records when a manual correction is required.</small>
                            </div>
                        }
                        break;
                    case XeroMigrationAssistantAction.CompleteReconciliation:
                        @if (CurrentReconciliationRequirement is { } requirement)
                        {
                            <div class="guided-action-panel">
                                <strong>@requirement.Title</strong>
                                <p>@requirement.Detail</p>
                                <button type="button" class="btn btn-primary" @onclick="() => ConfirmReconciliation(requirement.Property)" disabled="@busy">@(busy ? "Saving..." : "Confirm and continue")</button>
                                <small>@CompletedChecks of 7 reconciliation confirmations completed.</small>
                            </div>
                        }
                        break;
                    case XeroMigrationAssistantAction.RecordApproval:
                        <div class="guided-action-panel">
                            <strong>Approve the verified cutover</strong>
                            <p>All source records, evidence, mappings and control balances are ready. Approval is recorded in the audit trail.</p>
                            <button type="button" class="btn btn-success" @onclick="ApproveCutover" disabled="@(busy || !canApprove || !CutoverCanBeApproved)">@(busy ? "Recording approval..." : "Approve and continue")</button>
                        </div>
                        break;
                    case XeroMigrationAssistantAction.BuildCutover:
                        <button type="button" class="btn btn-success" @onclick="BuildCutover" disabled="@(preparingImport || !canPrepare)">Create verified live cutover</button>
                        break;
                    case XeroMigrationAssistantAction.CompleteMigration:
                        <button type="button" class="btn btn-success" @onclick="CompleteMigration" disabled="@(busy || !canApprove)">Complete migration</button>
                        break;
                    case XeroMigrationAssistantAction.Finished:
                        <button type="button" class="btn btn-secondary" @onclick="VerifyMigration" disabled="@busy">@(busy ? "Verifying..." : "Run verification again")</button>
                        break;
                }
            </div>
        </div>
        <details class="assistant-checks">
            <summary>View the complete migration checklist</summary>
            <div class="assistant-check-grid">
                @foreach (var check in assistant.Checks)
                {
                    <div class="assistant-check @(check.Passed ? "passed" : "pending")">
                        <span aria-hidden="true">@(check.Passed ? "✓" : "○")</span>
                        <div><strong>@check.Title</strong><small>@check.Detail</small></div>
                    </div>
                }
            </div>
        </details>
        <div class="assistant-safeguards">
            <span><strong>Source variations handled</strong> Code-less bank accounts, current assets and standalone supplier credits are classified before cutover.</span>
            <span><strong>Safe automation</strong> The assistant can prepare and explain. Only management can approve, post and complete.</span>
            <span><strong>Automatic final proof</strong> The opening journal, open records, protected history and unresolved review notes are checked after posting.</span>
        </div>
    </section>

    <details class="migration-details">
        <summary><strong>Detailed migration workspace</strong><span>Open reports, mappings, evidence and all reconciliation controls</span></summary>
        <div class="migration-details-body">
    <section class="self-service-hub" aria-labelledby="self-service-title">
        <div class="self-service-copy">
            <p class="step-label">Self-service migration</p>
            <h2 id="self-service-title">Account Island does the preparation for you</h2>
            <p>One safe run copies every available read-only Xero dataset, preserves its fingerprint, creates the import index, adds safe master data and reports the decisions that still need a person.</p>
            <div class="self-service-actions">
                <button type="button" class="btn btn-primary" @onclick="RunSafeAutomation" disabled="@(!CanRunSafeAutomation)">
                    @(runningAutomation ? "Copying and preparing..." : "Copy and prepare everything")
                </button>
                @if (connectionStatus?.IsConnected != true)
                {
                    <span>Connect Xero first.</span>
                }
                else if (connectionStatus.TenantId is null)
                {
                    <span>Choose the Xero organisation first.</span>
                }
                else
                {
                    <span>No approvals or financial entries are posted by this action.</span>
                }
            </div>
        </div>
        <div class="self-service-boundary">
            <strong>@MissingEvidenceCategories.Count source reports still needed</strong>
            @if (MissingEvidenceCategories.Count == 0)
            {
                <span class="complete-note">The required evidence pack is complete.</span>
            }
            else
            {
                <span>Xero does not provide every control report through its API. Add the missing originals below:</span>
                <ul>
                    @foreach (var category in MissingEvidenceCategories.Take(5))
                    {
                        <li>@category</li>
                    }
                    @if (MissingEvidenceCategories.Count > 5)
                    {
                        <li>and @(MissingEvidenceCategories.Count - 5) more</li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="migration-overview">
        <div><span>1</span><strong>Set the cutover</strong><small>Choose the first live day in Account Island.</small></div>
        <div><span>2</span><strong>Collect Xero exports</strong><small>Retain source data and its file fingerprint.</small></div>
        <div><span>3</span><strong>Import to staging</strong><small>Map and validate without changing the live ledger.</small></div>
        <div><span>4</span><strong>Reconcile and approve</strong><small>Prove every control balance before go-live.</small></div>
    </section>

    <section class="migration-card" id="migration-setup">
        <div class="section-heading">
            <div><p class="step-label">Step 1</p><h2>Migration setup</h2></div>
            <span>@(migration is null ? "Not saved" : "Last updated " + migration.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</span>
        </div>
        <EditForm Model="model" OnValidSubmit="Save" FormName="xero-migration-setup">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="setup-grid">
                <div>
                    <label class="form-label">Name shown in Xero</label>
                    <InputText class="form-control" @bind-Value="model.SourceOrganisationName" disabled="@(!canPrepare || busy)" />
                    <small>Used to confirm that every export belongs to the correct organisation.</small>
                </div>
                <div>
                    <label class="form-label">First live day in Account Island</label>
                    <InputDate class="form-control" @bind-Value="model.CutoverDate" disabled="@(!canPrepare || busy)" />
                    <small>Choose the day after the final Xero reporting date. Opening balances are dated the day before.</small>
                </div>
            </div>
            <label class="option-card mt-3">
                <InputCheckbox class="form-check-input" @bind-Value="model.IncludeFullHistory" disabled="@(!canPrepare || busy)" />
                <span><strong>Bring across full transaction history</strong><small>Recommended when replacing Xero. Open invoices, bills, contacts, bank history, assets and archived evidence remain individually traceable.</small></span>
            </label>
            <div class="mt-3">
                <label class="form-label">Migration notes</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" disabled="@(!canPrepare || busy)" />
            </div>
            @if (canPrepare)
            {
                <button class="btn btn-primary mt-3" disabled="@busy">@(busy ? "Saving..." : "Save migration setup")</button>
            }
        </EditForm>
    </section>

    <section class="migration-card" id="source-evidence">
        <div class="section-heading">
            <div><p class="step-label">Step 2</p><h2>Connect Xero and collect the evidence</h2></div>
            <span>@SuppliedRequiredCount of @XeroMigrationService.RequiredCategories.Length required sets supplied</span>
        </div>
        <div class="xero-connect-panel">
            @if (connectionStatus is null || !connectionStatus.IsConfigured)
            {
                <div>
                    <strong>Xero connection awaiting setup</strong>
                    <p>Add the Xero app ID, secret and approved callback address to the deployment settings. The export upload below remains available.</p>
                </div>
            }
            else if (!connectionStatus.IsConnected)
            {
                <div>
                    <strong>Connect using read-only access</strong>
                    <p>Account Island will copy supported accounting records into staging. It cannot create or change anything in Xero.</p>
                </div>
                @if (canApprove && migration is not null)
                {
                    <a class="btn btn-primary" href="/api/o/@OrganisationId/integrations/xero/connect">Connect Xero</a>
                }
                else
                {
                    <span class="status-pill preparing">An owner or administrator connects Xero</span>
                }
            }
            else
            {
                <div>
                    <strong>@(connectionStatus.TenantName ?? "Xero connected")</strong>
                    <p>@(connectionStatus.LastSyncedAt is null ? "No data copied yet." : "Last copied " + connectionStatus.LastSyncedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</p>
                </div>
                @if (connectionStatus.TenantId is null && connectionStatus.AvailableTenants.Count > 0)
                {
                    <div class="tenant-choice">
                        <select class="form-select" @bind="selectedTenantId" disabled="@busy">
                            <option value="">Choose the Xero organisation</option>
                            @foreach (var tenant in connectionStatus.AvailableTenants)
                            {
                                <option value="@tenant.TenantId">@tenant.TenantName</option>
                            }
                        </select>
                        <button type="button" class="btn btn-secondary" @onclick="ChooseTenant" disabled="@(busy || string.IsNullOrWhiteSpace(selectedTenantId))">Use this organisation</button>
                    </div>
                }
                else if (canPrepare)
                {
                    <button type="button" class="btn btn-primary" @onclick="SyncXero" disabled="@syncing">@(syncing ? "Copying from Xero..." : "Copy data from Xero")</button>
                }
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(connectionStatus?.LastSyncError))
        {
            <details class="alert alert-warning">
                <summary>Some Xero datasets need follow-up</summary>
                <p class="mb-0 mt-2">@connectionStatus.LastSyncError</p>
            </details>
        }

        @if (LatestSnapshots.Count > 0)
        {
            <div class="api-snapshot-grid">
                @foreach (var snapshot in LatestSnapshots)
                {
                    <a href="/api/o/@OrganisationId/xero-migration/snapshots/@snapshot.Id" title="SHA-256 @snapshot.Sha256">
                        <strong>@snapshot.DisplayName</strong>
                        <span>@snapshot.RecordCount records · @snapshot.RetrievedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    </a>
                }
            </div>
        }

        <div class="source-instructions">
            <div>
                <strong>Export these control records from Xero</strong>
                <ol>
                    <li>General Ledger for all available dates, with all columns and currencies.</li>
                    <li>Trial Balance at the final Xero date and at each prior financial year end.</li>
                    <li>Balance Sheet and Profit &amp; Loss for every financial year.</li>
                    <li>Chart of Accounts, Contacts, invoices, bills, credit notes, payments, prepayments and overpayments.</li>
                    <li>Receivable Invoice Detail and Payable Invoice Detail, including all open allocations.</li>
                    <li>Bank Reconciliation reports plus statements for every bank, card and loan account.</li>
                    <li>Fixed Asset Reconciliation and asset list for each year, every filed GST return, and annual payroll activity reports.</li>
                    <li>If used, export inventory, budgets and tracking categories. Retain quotes, purchase orders and repeating templates separately. Account Island copies available Xero attachments automatically.</li>
                    <li>Keep every original Xero export unchanged.</li>
                    <li>Before the final copy, allocate or refund any unallocated credit notes, prepayments and overpayments so the opening customer and supplier ledgers can be recreated exactly.</li>
                </ol>
            </div>
            <div class="source-note">
                <strong>Payroll</strong>
                <p>Employee payroll moves to NZ Pay. Account Island receives the historical payroll journals and liability balances, while payroll reports stay in the retained evidence pack.</p>
            </div>
        </div>

        @if (migration is null)
        {
            <div class="alert alert-info mb-0">Save Step 1 before uploading exports.</div>
        }
        else
        {
            <div class="smart-upload">
                <div>
                    <strong>Add the complete export pack</strong>
                    <p>Select up to 50 original Xero CSV, XLSX, PDF or ZIP files together. Account Island identifies standard report names and files each one under the right control.</p>
                </div>
                <div>
                    <InputFile class="form-control" accept=".csv,.xlsx,.pdf,.zip" multiple OnChange="UploadEvidenceBundle" disabled="@(!canPrepare || uploading)" />
                    <small>@(uploading ? "Reading and filing the evidence pack..." : "Ambiguous file names are left for review; Account Island does not guess.")</small>
                </div>
            </div>
            @if (unclassifiedFiles.Count > 0)
            {
                <div class="alert alert-warning">
                    <strong>Choose a category for these files:</strong>
                    @string.Join(", ", unclassifiedFiles)
                </div>
            }
            <div class="upload-panel">
                <div>
                    <label class="form-label">Add one file or resolve an unrecognised file</label>
                    <select class="form-select" @bind="selectedCategory" disabled="@(!canPrepare || uploading)">
                        @foreach (var category in XeroMigrationService.Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Selected Xero export</label>
                    <InputFile class="form-control" accept=".csv,.xlsx,.pdf,.zip" OnChange="Upload" disabled="@(!canPrepare || uploading)" />
                    <small>Up to 25 MB. The selected category is locked when the upload starts. Uploading stores evidence only; it does not post to the ledger.</small>
                </div>
            </div>
        }

        <div class="dataset-grid">
            @foreach (var category in XeroMigrationService.Categories)
            {
                var categoryFiles = files.Where(x => x.Category == category).OrderByDescending(x => x.UploadedAt).ToList();
                var required = XeroMigrationService.RequiredCategories.Contains(category);
                var categorySupplied = migration is not null && XeroMigrationService.HasRequiredEvidenceCategory(migration, category);
                <article class="dataset @(categorySupplied ? "supplied" : string.Empty)">
                    <div>
                        <span class="dataset-check">@(categorySupplied ? "✓" : "○")</span>
                        <div>
                            <strong>@category</strong>
                            <small>@(categoryFiles.Count > 0 ? (required ? "Required · source file retained" : "Source file retained") : categorySupplied ? "Copied directly from Xero" : required ? "Required" : "If used")</small>
                        </div>
                    </div>
                    @foreach (var file in categoryFiles)
                    {
                        <a href="/api/o/@OrganisationId/xero-migration/files/@file.Id" title="SHA-256 @file.Sha256">
                            @file.FileName <small>· @FormatSize(file.Size) · @file.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                        </a>
                    }
                </article>
            }
        </div>
    </section>

    <section class="migration-card" id="prepare-records">
        <div class="section-heading">
            <div><p class="step-label">Step 3</p><h2>Prepare and map the Xero records</h2></div>
            <span>@(workspace.SourceRecordCount == 0 ? "Not prepared" : $"{workspace.SourceRecordCount:N0} source records")</span>
        </div>
        <p class="section-intro">This builds the traceable import index, checks every source identity and matches Xero accounts, GST rates, contacts, currencies, items and tracking options to Account Island. At approved cutover, the final Trial Balance CSV creates one opening journal, open invoices and bills continue as live records with their Xero attachments, active assets enter the asset register, and older transactions and files remain available in the immutable Xero archive. This avoids posting the same history twice.</p>
        <div class="import-actions">
            @if (canPrepare && migration is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="PrepareImport" disabled="@preparingImport">@(preparingImport ? "Checking Xero records..." : "Prepare and check import")</button>
                <button type="button" class="btn btn-secondary" @onclick="ImportMasterData" disabled="@(preparingImport || workspace.SourceRecordCount == 0)">Add accounts, contacts, currencies and items</button>
                <button type="button" class="btn btn-secondary" @onclick="BuildCutover" disabled="@(preparingImport || workspace.SourceRecordCount == 0 || migration?.ManagementApproved != true)">Create approved live cutover</button>
            }
        </div>
        <div class="import-summary">
            <div><strong>@workspace.DatasetCount</strong><span>datasets indexed</span></div>
            <div><strong>@workspace.ReadyCount</strong><span>records ready</span></div>
            <div><strong>@workspace.ImportedCount</strong><span>master records added</span></div>
            <div class="@(workspace.BlockingCount > 0 ? "summary-danger" : string.Empty)"><strong>@workspace.BlockingCount</strong><span>blocking issues</span></div>
            <div class="@(workspace.WarningCount > 0 ? "summary-warning" : string.Empty)"><strong>@workspace.WarningCount</strong><span>warnings</span></div>
        </div>

        @if (workspace.Mappings.Count > 0)
        {
            var unresolvedMappings = workspace.Mappings.Where(x => x.Status == XeroMigrationMappingStatus.Suggested).ToList();
            <details class="mapping-panel" open="@(unresolvedMappings.Count > 0)">
                <summary><strong>Mapping decisions</strong><span>@unresolvedMappings.Count awaiting a choice · @workspace.Mappings.Count(x => x.Status == XeroMigrationMappingStatus.Confirmed) confirmed</span></summary>
                @if (unresolvedMappings.Count == 0)
                {
                    <p class="empty-state">All discovered Xero values have a confirmed destination.</p>
                }
                else
                {
                    <div class="mapping-list">
                        @foreach (var mapping in unresolvedMappings)
                        {
                            <div class="mapping-row">
                                <div><small>@MappingKindLabel(mapping.Kind)</small><strong>@mapping.SourceName</strong></div>
                                <select class="form-select" value="@MappingSelection(mapping.Id)" @onchange="args => mappingSelections[mapping.Id] = args.Value?.ToString() ?? string.Empty" disabled="@preparingImport">
                                    <option value="">Choose an Account Island destination</option>
                                    @foreach (var target in Targets(mapping.Kind))
                                    {
                                        <option value="@target.Value">@target.Label</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-secondary" @onclick="() => SaveMapping(mapping)" disabled="@(preparingImport || string.IsNullOrWhiteSpace(MappingSelection(mapping.Id)))">Confirm</button>
                                <button type="button" class="btn btn-link" @onclick="() => IgnoreMapping(mapping)" disabled="@preparingImport">Exclude</button>
                            </div>
                        }
                    </div>
                }
            </details>
        }

        @if (workspace.Issues.Count > 0)
        {
            <details class="issue-panel" open>
                <summary><strong>Migration plan and items requiring attention</strong><span>@workspace.BlockingCount blocking · @workspace.WarningCount warnings · @workspace.Issues.Count(x => x.Severity == XeroMigrationIssueSeverity.Information) planned</span></summary>
                <div class="issue-list">
                    @foreach (var issue in workspace.Issues)
                    {
                        <div class="issue @issue.Severity.ToString().ToLowerInvariant()">
                            <strong>@(issue.Severity == XeroMigrationIssueSeverity.Blocking ? "Must fix" : issue.Severity.ToString())</strong>
                            <span>@issue.Message</span>
                        </div>
                    }
                </div>
            </details>
        }
    </section>

    <section class="migration-card" id="reconciliation">
        <div class="section-heading">
            <div><p class="step-label">Step 4</p><h2>Reconciliation and cutover</h2></div>
            <span>@CompletedChecks of 7 controls complete</span>
        </div>
        <div class="control-warning">
            <strong>Nothing goes live until these checks pass.</strong>
            <span>Imports are first matched and validated in staging. Any duplicate, missing account, invalid tax treatment or control difference must be resolved before approval.</span>
        </div>
        <div class="control-evidence-grid" aria-label="Source evidence coverage">
            @foreach (var control in ControlEvidence)
            {
                <article class="control-evidence @(control.Ready ? "ready" : "missing")">
                    <span aria-hidden="true">@(control.Ready ? "✓" : "!")</span>
                    <div><strong>@control.Title</strong><small>@control.Detail</small></div>
                </article>
            }
        </div>
        <div class="checklist">
            @Check("Xero entry has stopped", "No transactions are entered into Xero after the final export.", nameof(model.XeroEntryStopped), model.XeroEntryStopped)
            @Check("Trial Balance agrees", "Total debits and credits, and every account balance, agree at the final Xero date.", nameof(model.TrialBalanceReconciled), model.TrialBalanceReconciled)
            @Check("Receivables agree", "Open customer invoices and credits agree to the aged receivables control total.", nameof(model.ReceivablesReconciled), model.ReceivablesReconciled)
            @Check("Payables agree", "Open supplier bills and credits agree to the aged payables control total.", nameof(model.PayablesReconciled), model.PayablesReconciled)
            @Check("Banks agree", "Every bank, card and loan agrees to its final reconciled statement balance.", nameof(model.BankReconciled), model.BankReconciled)
            @Check("Fixed assets agree", "Cost, accumulated depreciation and net book value agree to Xero.", nameof(model.FixedAssetsReconciled), model.FixedAssetsReconciled)
            @Check("GST agrees", "The GST control accounts agree to the last filed return and the next unfiled period.", nameof(model.GstReconciled), model.GstReconciled)
        </div>
        <label class="option-card approval mt-3">
            <InputCheckbox class="form-check-input" @bind-Value="model.ManagementApproved" disabled="@(!canApprove || !CutoverCanBeApproved || busy)" />
            <span><strong>Management approves the cutover</strong><small>This becomes available after all seven controls are complete and the prepared import has no blocking issues.</small></span>
        </label>
        @if (canPrepare && migration is not null)
        {
            <button class="btn btn-primary mt-3" @onclick="Save" disabled="@busy">Save reconciliation progress</button>
            @if (migration.ManagementApproved && migration.Status != XeroMigrationStatus.Complete && canApprove)
            {
                <button class="btn btn-success mt-3 ms-2" @onclick="CompleteMigration" disabled="@busy">Complete migration</button>
            }
        }
    </section>
        </div>
    </details>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [SupplyParameterFromQuery(Name = "xero")] public string? XeroResult { get; set; }
    private AccessibleOrganisation? access;
    private FijiAccounts.Web.Data.XeroMigration? migration;
    private List<XeroMigrationFile> files = [];
    private MigrationModel model = new();
    private XeroConnectionStatus? connectionStatus;
    private XeroMigrationAssistantSummary assistant = new(
        "Start with the migration setup", "Confirm the source and the first live day.",
        XeroMigrationAssistantAction.SaveSetup, [], false, false, 0, 0);
    private XeroImportWorkspace workspace = new(0, 0, 0, 0, 0, 0, 0, [], [], null);
    private readonly Dictionary<XeroMigrationMappingKind, IReadOnlyList<XeroMappingTarget>> mappingTargets = [];
    private readonly Dictionary<Guid, string> mappingSelections = [];
    private string userId = string.Empty;
    private string selectedCategory = XeroMigrationService.Categories[0];
    private string selectedTenantId = string.Empty;
    private string? message;
    private string messageClass = "alert-success";
    private readonly List<string> unclassifiedFiles = [];
    private bool loading = true, busy, uploading, syncing, preparingImport, runningAutomation, canPrepare, canApprove;
    private bool restartConfirmationVisible, restartAcknowledged;
    private bool IsNz => access?.Organisation.CountryCode.Equals("NZ", StringComparison.OrdinalIgnoreCase) == true;
    private string OrganisationName => access is null ? string.Empty : OrganisationDisplay.NameWithCountry(access.Organisation);
    private int SuppliedRequiredCount => migration is null ? 0 : XeroMigrationService.RequiredCategories.Count(category =>
        XeroMigrationService.HasRequiredEvidenceCategory(migration, category));
    private List<string> MissingEvidenceCategories => XeroMigrationService.RequiredCategories
        .Where(category => migration is null || !XeroMigrationService.HasRequiredEvidenceCategory(migration, category))
        .ToList();
    private string CurrentMissingEvidenceCategory => MissingEvidenceCategories.FirstOrDefault() ?? "the next source report";
    private string CurrentEvidenceGuidance => CurrentMissingEvidenceCategory switch
    {
        "General ledger" => "Export the General Ledger for all available dates with every column and currency included.",
        "Trial balance" => "Export the Trial Balance at the final Xero date and at each earlier financial year end.",
        "Balance Sheet and Profit & Loss" => "Export the Balance Sheet and Profit & Loss for every financial year being retained.",
        "Receivable Invoice Detail" => "Export Receivable Invoice Detail at the final Xero date, including open credits and allocations.",
        "Payable Invoice Detail" => "Export Payable Invoice Detail at the final Xero date, including supplier credits and allocations.",
        "Bank statements and reconciliation" => "Export the reconciliation report and final statement for every bank, card and loan account.",
        "Fixed assets and depreciation reconciliation" => "Export the fixed asset list and depreciation reconciliation for each financial year.",
        "GST returns and reconciliation" => "Export every filed GST return and the reconciliation for the next unfiled period.",
        "Payroll history reports" => "Export annual payroll activity and liability reports. Employee payroll records will continue in NZ Pay.",
        "Document attachments" => "Account Island normally copies Xero attachments automatically. If Xero could not provide them, download the supporting documents from Xero and upload the retained ZIP here.",
        _ => $"Export the original {CurrentMissingEvidenceCategory} report from Xero without editing it."
    };
    private XeroMigrationMapping? CurrentMapping => workspace.Mappings
        .FirstOrDefault(x => x.Status == XeroMigrationMappingStatus.Suggested);
    private XeroMigrationIssue? CurrentBlockingIssue => workspace.Issues
        .FirstOrDefault(x => x.Severity == XeroMigrationIssueSeverity.Blocking && !x.IsResolved);
    private ReconciliationRequirement? CurrentReconciliationRequirement =>
        !model.XeroEntryStopped ? new("Stop entries in Xero", "Confirm that no transactions will be entered in Xero after the final copy. Take the final copy first, then stop Xero entry before confirming.", nameof(model.XeroEntryStopped)) :
        !model.TrialBalanceReconciled ? new("Confirm the Trial Balance", "Compare every Account Island opening balance to the final Xero Trial Balance. Total debits and credits must agree.", nameof(model.TrialBalanceReconciled)) :
        !model.ReceivablesReconciled ? new("Confirm receivables", "Compare open customer invoices and credits to Xero's final aged receivables total.", nameof(model.ReceivablesReconciled)) :
        !model.PayablesReconciled ? new("Confirm payables", "Compare open supplier bills and credits to Xero's final aged payables total.", nameof(model.PayablesReconciled)) :
        !model.BankReconciled ? new("Confirm bank balances", "Compare every bank, card and loan account to its final reconciled Xero statement balance.", nameof(model.BankReconciled)) :
        !model.FixedAssetsReconciled ? new("Confirm fixed assets", "Compare asset cost, accumulated depreciation and net book value to the final Xero fixed asset reconciliation.", nameof(model.FixedAssetsReconciled)) :
        !model.GstReconciled ? new("Confirm GST", "Compare the GST control accounts to the last filed return and the next unfiled Xero period.", nameof(model.GstReconciled)) : null;
    private List<XeroApiSnapshot> LatestSnapshots => migration?.ApiSnapshots
        .GroupBy(x => x.DatasetKey)
        .Select(group => group.OrderByDescending(x => x.RetrievedAt).First())
        .OrderBy(x => x.DisplayName)
        .ToList() ?? [];
    private int CompletedChecks => new[] { model.XeroEntryStopped, model.TrialBalanceReconciled, model.ReceivablesReconciled, model.PayablesReconciled, model.BankReconciled, model.FixedAssetsReconciled, model.GstReconciled }.Count(x => x);
    private bool AllChecksComplete => CompletedChecks == 7;
    private int AssistantProgress => assistant.TotalCount == 0 ? 0 : (int)Math.Round(assistant.PassedCount * 100d / assistant.TotalCount);
    private bool CanRunSafeAutomation => canPrepare && migration is not null &&
        migration.Status != XeroMigrationStatus.Complete && connectionStatus?.IsConnected == true &&
        connectionStatus.TenantId is not null && !runningAutomation && !syncing && !preparingImport && !busy;
    private IReadOnlyList<ControlEvidenceItem> ControlEvidence =>
    [
        EvidenceControl("Trial Balance", "Trial balance", "trial-balance", "Final account balances and debits equal credits."),
        EvidenceControl("Receivables", "Receivable Invoice Detail", "sales-invoices", "Customer invoices, credits and open allocations."),
        EvidenceControl("Payables", "Payable Invoice Detail", "bills", "Supplier bills, credits and open allocations."),
        EvidenceControl("Banks", "Bank statements and reconciliation", "bank-transactions", "Final statements support every bank, card and loan."),
        EvidenceControl("Fixed assets", "Fixed assets and depreciation reconciliation", "assets", "The report supports cost and depreciation when Xero cannot return individual assets."),
        EvidenceControl("GST", "GST returns and reconciliation", "tax-rates", "Filed returns and the next unfiled period support the GST control."),
        new("Final Xero stop", model.XeroEntryStopped,
            model.XeroEntryStopped ? "Management has confirmed that no later entries will be made in Xero." : "Confirm this only after the final Xero copy has been taken.")
    ];
    private bool CutoverCanBeApproved => AllChecksComplete &&
        SuppliedRequiredCount == XeroMigrationService.RequiredCategories.Length &&
        !workspace.Issues.Any(x => x.Severity == XeroMigrationIssueSeverity.Blocking && x.Code != "LIVE_IMPORT_PENDING");
    private string StatusLabel => migration?.Status switch
    {
        XeroMigrationStatus.ReadyForImport => "Exports ready",
        XeroMigrationStatus.Reconciliation => "Reconciliation in progress",
        XeroMigrationStatus.ApprovedForCutover => "Approved for cutover",
        XeroMigrationStatus.Complete => "Migration complete",
        _ => "Preparing exports"
    };
    private string StatusClass => migration?.Status switch
    {
        XeroMigrationStatus.ApprovedForCutover or XeroMigrationStatus.Complete => "complete",
        XeroMigrationStatus.Reconciliation => "progress",
        _ => "preparing"
    };
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User) ?? string.Empty;
        access = string.IsNullOrWhiteSpace(userId) ? null : await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is not null)
        {
            canPrepare = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
            canApprove = await TenantAccess.CanManageTeamAsync(userId, OrganisationId);
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            connectionStatus = await XeroConnection.GetStatusAsync(userId, OrganisationId);
            await ReloadWorkspace();
            selectedTenantId = connectionStatus.TenantId?.ToString() ?? string.Empty;
            ApplyMigration();
            await RefreshAssistant();
            if (string.Equals(XeroResult, "connected", StringComparison.OrdinalIgnoreCase))
            {
                message = connectionStatus.TenantId is null
                    ? "Xero is connected. Choose the organisation to import."
                    : $"{connectionStatus.TenantName} is connected and ready to copy.";
                messageClass = "alert-success";
            }
        }
        loading = false;
    }

    private void ApplyMigration()
    {
        files = migration?.Files.OrderByDescending(x => x.UploadedAt).ToList() ?? [];
        model = migration is null
            ? new MigrationModel { SourceOrganisationName = access?.Organisation.LegalName ?? string.Empty, IncludeFullHistory = true }
            : new MigrationModel
            {
                SourceOrganisationName = migration.SourceOrganisationName,
                CutoverDate = migration.CutoverDate,
                IncludeFullHistory = migration.IncludeFullHistory,
                XeroEntryStopped = migration.XeroEntryStopped,
                TrialBalanceReconciled = migration.TrialBalanceReconciled,
                ReceivablesReconciled = migration.ReceivablesReconciled,
                PayablesReconciled = migration.PayablesReconciled,
                BankReconciled = migration.BankReconciled,
                FixedAssetsReconciled = migration.FixedAssetsReconciled,
                GstReconciled = migration.GstReconciled,
                ManagementApproved = migration.ManagementApproved,
                Notes = migration.Notes
            };
    }

    private async Task Save()
    {
        busy = true; message = null;
        try
        {
            if (!CutoverCanBeApproved) model.ManagementApproved = false;
            migration = await MigrationService.SaveAsync(userId, OrganisationId, new(
                model.SourceOrganisationName, model.CutoverDate, model.IncludeFullHistory,
                model.XeroEntryStopped, model.TrialBalanceReconciled, model.ReceivablesReconciled,
                model.PayablesReconciled, model.BankReconciled, model.FixedAssetsReconciled,
                model.GstReconciled, model.ManagementApproved, model.Notes));
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = model.ManagementApproved ? "Cutover approval recorded in the audit trail." : "Migration setup saved.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { busy = false; }
    }

    private async Task Upload(InputFileChangeEventArgs args)
    {
        var uploadCategory = selectedCategory;
        uploading = true; message = null;
        try
        {
            using var stream = args.File.OpenReadStream(XeroMigrationService.MaximumBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await MigrationService.AddFileAsync(userId, OrganisationId, uploadCategory, args.File.Name, args.File.ContentType, buffer.ToArray());
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = $"{args.File.Name} retained under {uploadCategory}.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { uploading = false; }
    }

    private async Task UploadCurrentEvidence(InputFileChangeEventArgs args)
    {
        var category = CurrentMissingEvidenceCategory;
        uploading = true; message = null;
        try
        {
            using var stream = args.File.OpenReadStream(XeroMigrationService.MaximumBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await MigrationService.AddFileAsync(userId, OrganisationId, category, args.File.Name, args.File.ContentType, buffer.ToArray());
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = $"{category} retained. The next requirement is ready.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { uploading = false; }
    }

    private async Task UploadEvidenceBundle(InputFileChangeEventArgs args)
    {
        uploading = true; message = null; unclassifiedFiles.Clear();
        var added = 0;
        try
        {
            foreach (var file in args.GetMultipleFiles(50))
            {
                var category = XeroEvidenceClassifier.Classify(file.Name);
                if (category is null)
                {
                    unclassifiedFiles.Add(file.Name);
                    continue;
                }

                using var stream = file.OpenReadStream(XeroMigrationService.MaximumBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                await MigrationService.AddFileAsync(userId, OrganisationId, category, file.Name, file.ContentType, buffer.ToArray());
                added++;
            }

            migration = await MigrationService.GetAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = unclassifiedFiles.Count == 0
                ? $"Filed {added:N0} source file(s) into the evidence pack."
                : $"Filed {added:N0} source file(s). Review {unclassifiedFiles.Count:N0} file name(s) listed below.";
            messageClass = unclassifiedFiles.Count == 0 ? "alert-success" : "alert-warning";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { uploading = false; }
    }

    private async Task RunSafeAutomation()
    {
        if (!CanRunSafeAutomation) return;
        runningAutomation = true; syncing = true; preparingImport = true; message = null;
        var stage = "copying data from Xero";
        try
        {
            var copied = await XeroConnection.SyncAsync(userId, OrganisationId);
            stage = "checking the copied Xero data";
            await ImportPreparation.PrepareAsync(userId, OrganisationId);
            stage = "adding safe master records";
            var imported = await ImportPreparation.ImportMasterDataAsync(userId, OrganisationId);
            stage = "performing the final preparation check";
            var prepared = await ImportPreparation.PrepareAsync(userId, OrganisationId);
            stage = "refreshing the migration screen";
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            connectionStatus = await XeroConnection.GetStatusAsync(userId, OrganisationId);
            ApplyMigration();
            await ReloadWorkspace();
            message = $"Safe preparation complete: {copied.ImportedRecords:N0} records copied from {copied.ImportedDatasets:N0} datasets, {imported:N0} master record(s) added and {prepared.SourceRecordCount:N0} records checked. ";
            message += prepared.BlockingCount == 0
                ? $"No blocking issues remain. {MissingEvidenceCategories.Count:N0} source report set(s) still need to be added."
                : $"Review {prepared.BlockingCount:N0} blocking issue(s) before cutover.";
            if (copied.Failures.Count > 0)
                message += $" {copied.Failures.Count:N0} Xero dataset(s) were unavailable and are listed under the connection.";
            if (copied.ReconciliationReset)
                message += " Earlier reconciliation approval was cleared because the source changed.";
            messageClass = prepared.BlockingCount == 0 ? "alert-success" : "alert-warning";
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or IOException or UnauthorizedAccessException or XeroApiException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        catch (Exception ex)
        {
            var reference = System.Diagnostics.Activity.Current?.Id ?? Guid.NewGuid().ToString("N");
            Logger.LogError(ex,
                "Xero migration automation failed while {Stage} for organisation {OrganisationId}. Reference {Reference}.",
                stage, OrganisationId, reference);
            message = $"Account Island could not finish while {stage}. Completed Xero datasets remain saved. " +
                      $"Try again after a minute. If it repeats, quote reference {reference}.";
            messageClass = "alert-danger";
        }
        finally
        {
            runningAutomation = false; syncing = false; preparingImport = false;
        }
    }

    private async Task ChooseTenant()
    {
        if (!Guid.TryParse(selectedTenantId, out var tenantId)) return;
        busy = true; message = null;
        try
        {
            await XeroConnection.SelectTenantAsync(userId, OrganisationId, tenantId);
            connectionStatus = await XeroConnection.GetStatusAsync(userId, OrganisationId);
            await RefreshAssistant();
            message = $"{connectionStatus.TenantName} selected for this migration.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { busy = false; }
    }

    private async Task ConfirmReconciliation(string property)
    {
        SetCheck(property, true);
        await Save();
    }

    private async Task ApproveCutover()
    {
        model.ManagementApproved = true;
        await Save();
    }

    private async Task SyncXero()
    {
        syncing = true; message = null;
        try
        {
            var result = await XeroConnection.SyncAsync(userId, OrganisationId);
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            connectionStatus = await XeroConnection.GetStatusAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = result.Failures.Count == 0
                ? $"Copied {result.ImportedRecords:N0} records from {result.ImportedDatasets} Xero datasets into staging."
                : $"Copied {result.ImportedRecords:N0} records from {result.ImportedDatasets} datasets. {result.Failures.Count} unavailable datasets are listed for follow-up.";
            if (result.ReconciliationReset)
                message += " Previous reconciliation approval was cleared because the source data changed.";
            messageClass = result.ImportedDatasets > 0 ? "alert-success" : "alert-danger";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or XeroApiException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { syncing = false; }
    }

    private async Task PrepareImport()
    {
        preparingImport = true; message = null;
        try
        {
            var result = await ImportPreparation.PrepareAsync(userId, OrganisationId);
            await ReloadWorkspace();
            message = result.BlockingCount == 0
                ? $"Checked {result.SourceRecordCount:N0} Xero records. The staged import has no blocking issues."
                : $"Checked {result.SourceRecordCount:N0} Xero records. Resolve {result.BlockingCount} blocking issue(s) shown below.";
            messageClass = result.BlockingCount == 0 ? "alert-success" : "alert-warning";
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private async Task RunGuidedPreparation()
    {
        preparingImport = true; message = null;
        try
        {
            await ImportPreparation.PrepareAsync(userId, OrganisationId);
            var imported = await ImportPreparation.ImportMasterDataAsync(userId, OrganisationId);
            var final = await ImportPreparation.PrepareAsync(userId, OrganisationId);
            await ReloadWorkspace();
            message = final.BlockingCount == 0
                ? $"Guided preparation is complete. {final.SourceRecordCount:N0} records were checked and {imported:N0} new master record(s) were added."
                : $"Preparation added {imported:N0} master record(s). Resolve {final.BlockingCount} remaining blocking issue(s) below.";
            messageClass = final.BlockingCount == 0 ? "alert-success" : "alert-warning";
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private async Task ImportMasterData()
    {
        preparingImport = true; message = null;
        try
        {
            var count = await ImportPreparation.ImportMasterDataAsync(userId, OrganisationId);
            await ReloadWorkspace();
            message = count == 0
                ? "No new accounts, contacts, currencies or items needed to be added."
                : $"Added {count:N0} Xero master record(s) to Account Island and refreshed their mappings.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private async Task BuildCutover()
    {
        preparingImport = true; message = null;
        try
        {
            var result = await CutoverImport.BuildAsync(userId, OrganisationId);
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            await ReloadWorkspace();
            message = $"Created the balanced opening journal with {result.OpeningBalanceLines:N0} lines, added {result.OpenSalesInvoices:N0} open customer invoice(s), {result.OpenSupplierBills:N0} open supplier bill(s), {result.OpenSupplierCredits:N0} open supplier credit(s), and {result.FixedAssets:N0} fixed asset(s), and retained {result.ArchivedSourceRecords:N0} historical source record(s).";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private async Task CompleteMigration()
    {
        busy = true; message = null;
        try
        {
            await MigrationAssistant.VerifyAndRecordAsync(userId, OrganisationId);
            migration = await MigrationService.CompleteAsync(userId, OrganisationId);
            ApplyMigration();
            await RefreshAssistant();
            message = "The Xero migration is complete. Account Island is now the live accounting record from the cutover date.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { busy = false; }
    }

    private void ShowRestartConfirmation()
    {
        restartAcknowledged = false;
        restartConfirmationVisible = true;
        message = null;
    }

    private void HideRestartConfirmation()
    {
        restartAcknowledged = false;
        restartConfirmationVisible = false;
    }

    private async Task RestartMigration()
    {
        if (!restartAcknowledged) return;
        busy = true;
        message = null;
        try
        {
            var result = await MigrationService.RestartAsync(userId, OrganisationId);
            migration = await MigrationService.GetAsync(userId, OrganisationId);
            connectionStatus = await XeroConnection.GetStatusAsync(userId, OrganisationId);
            files = migration?.Files.OrderByDescending(x => x.UploadedAt).ToList() ?? [];
            selectedTenantId = string.Empty;
            ApplyMigration();
            await ReloadWorkspace();
            HideRestartConfirmation();
            message = result.RetainedMasterRecords == 0
                ? "The migration has returned to the first step. Choose the source and cutover date to begin again."
                : $"The migration has returned to the first step. {result.RetainedMasterRecords:N0} master record link(s) already added to Account Island were retained and can be reused.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message;
            messageClass = "alert-danger";
        }
        finally { busy = false; }
    }

    private async Task VerifyMigration()
    {
        busy = true; message = null;
        try
        {
            assistant = await MigrationAssistant.VerifyAndRecordAsync(userId, OrganisationId);
            message = $"Verification passed: {assistant.PassedCount} of {assistant.TotalCount} checks. The result is retained in the audit trail.";
            messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            await RefreshAssistant();
            message = ex.Message; messageClass = "alert-warning";
        }
        finally { busy = false; }
    }

    private async Task ReloadWorkspace()
    {
        workspace = await ImportPreparation.GetWorkspaceAsync(userId, OrganisationId);
        mappingSelections.Clear();
        mappingTargets.Clear();
        foreach (var kind in workspace.Mappings.Where(x => x.Status == XeroMigrationMappingStatus.Suggested).Select(x => x.Kind).Distinct())
            mappingTargets[kind] = await ImportPreparation.GetMappingTargetsAsync(userId, OrganisationId, kind);
        await RefreshAssistant();
    }

    private async Task RefreshAssistant()
    {
        if (access is not null && !string.IsNullOrWhiteSpace(userId))
            assistant = await MigrationAssistant.GetAsync(userId, OrganisationId);
    }

    private IReadOnlyList<XeroMappingTarget> Targets(XeroMigrationMappingKind kind) =>
        mappingTargets.GetValueOrDefault(kind) ?? [];
    private string MappingSelection(Guid mappingId) => mappingSelections.GetValueOrDefault(mappingId) ?? string.Empty;
    private static string MappingKindLabel(XeroMigrationMappingKind kind) => kind switch
    {
        XeroMigrationMappingKind.TaxRate => "GST rate",
        XeroMigrationMappingKind.TrackingCategory => "Xero tracking category",
        XeroMigrationMappingKind.TrackingOption => "Xero tracking value",
        XeroMigrationMappingKind.AssetType => "Fixed asset account",
        _ => kind.ToString()
    };

    private static string MappingPrompt(XeroMigrationMappingKind kind) => kind switch
    {
        XeroMigrationMappingKind.TrackingCategory => "Choose branches or divisions",
        XeroMigrationMappingKind.TrackingOption => "Choose the matching branch or division",
        _ => "Choose an Account Island destination"
    };

    private static string MappingGuidance(XeroMigrationMapping mapping) => mapping.Kind switch
    {
        XeroMigrationMappingKind.TrackingCategory =>
            $"Tell Account Island how Xero's “{mapping.SourceName}” category is organised. Choose branches when its values are offices or locations; choose divisions when its values are departments or business units.",
        XeroMigrationMappingKind.TrackingOption =>
            $"Choose the Account Island branch or division that represents “{mapping.SourceName}”. Transactions carrying this Xero value will use that destination.",
        _ => "Choose the matching Account Island destination. Confirm one decision at a time; the next item will appear automatically."
    };

    private async Task SaveMapping(XeroMigrationMapping mapping)
    {
        var selected = MappingSelection(mapping.Id);
        var target = Targets(mapping.Kind).FirstOrDefault(x => x.Value == selected);
        if (target is null) return;
        preparingImport = true; message = null;
        try
        {
            await ImportPreparation.ConfirmMappingAsync(
                userId, OrganisationId, mapping.Id, target.Id, target.Label, target.EntityType, false);
            await ReloadWorkspace();
            message = $"Mapping saved for {mapping.SourceName}."; messageClass = "alert-success";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private async Task IgnoreMapping(XeroMigrationMapping mapping)
    {
        preparingImport = true; message = null;
        try
        {
            await ImportPreparation.ConfirmMappingAsync(userId, OrganisationId, mapping.Id, null, null, null, true);
            await ReloadWorkspace();
            message = $"{mapping.SourceName} will be excluded and remains listed as a warning.";
            messageClass = "alert-warning";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message; messageClass = "alert-danger";
        }
        finally { preparingImport = false; }
    }

    private ControlEvidenceItem EvidenceControl(string title, string category, string datasetKey, string purpose)
    {
        var evidenceCount = files.Count(x => x.Category.Equals(category, StringComparison.OrdinalIgnoreCase));
        var snapshot = LatestSnapshots.FirstOrDefault(x => x.DatasetKey.Equals(datasetKey, StringComparison.OrdinalIgnoreCase));
        var ready = migration is not null && XeroMigrationService.HasRequiredEvidenceCategory(migration, category);
        var source = snapshot is null ? "No matching API dataset was available" : $"{snapshot.RecordCount:N0} API record(s) copied";
        var reports = evidenceCount > 0
            ? $"{evidenceCount:N0} source report(s) retained"
            : ready ? "the protected API control is sufficient" : "source report missing";
        return new(title, ready, $"{source}; {reports}. {purpose}");
    }

    private RenderFragment Check(string title, string detail, string property, bool value) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "label"); builder.AddAttribute(sequence++, "class", "check-item");
        builder.OpenElement(sequence++, "input"); builder.AddAttribute(sequence++, "type", "checkbox"); builder.AddAttribute(sequence++, "checked", value);
        builder.AddAttribute(sequence++, "disabled", !canPrepare || busy);
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => SetCheck(property, args.Value is true || args.Value?.ToString() == "true")));
        builder.CloseElement();
        builder.OpenElement(sequence++, "span"); builder.OpenElement(sequence++, "strong"); builder.AddContent(sequence++, title); builder.CloseElement();
        builder.OpenElement(sequence++, "small"); builder.AddContent(sequence++, detail); builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
    };

    private void SetCheck(string property, bool value)
    {
        typeof(MigrationModel).GetProperty(property)?.SetValue(model, value);
        if (!CutoverCanBeApproved) model.ManagementApproved = false;
    }

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:N1} MB" : $"{Math.Max(1, bytes / 1024d):N0} KB";

    private sealed class MigrationModel
    {
        [Required, StringLength(160, MinimumLength = 2)] public string SourceOrganisationName { get; set; } = string.Empty;
        public DateOnly? CutoverDate { get; set; }
        public bool IncludeFullHistory { get; set; } = true;
        public bool XeroEntryStopped { get; set; }
        public bool TrialBalanceReconciled { get; set; }
        public bool ReceivablesReconciled { get; set; }
        public bool PayablesReconciled { get; set; }
        public bool BankReconciled { get; set; }
        public bool FixedAssetsReconciled { get; set; }
        public bool GstReconciled { get; set; }
        public bool ManagementApproved { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
    }

    private sealed record ReconciliationRequirement(string Title, string Detail, string Property);
    private sealed record ControlEvidenceItem(string Title, bool Ready, string Detail);
}
