@page "/o/{OrganisationId:guid}/contacts/{ContactId:guid}/balances"
@page "/o/{OrganisationId:guid}/contacts/{ContactId:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(contact is null ? "Client file" : $"{contact.Name} - Client file")</PageTitle>
@if (loading)
{
    <p role="status">Loading contact balances…</p>
}
else if (contact is null || access is null)
{
    <div class="alert alert-warning">Contact unavailable.</div>
}
else
{
    var customerItems = rows.Where(x => !x.Supplier).ToList();
    var supplierItems = rows.Where(x => x.Supplier).ToList();

    <a class="contact-file-back" href="o/@OrganisationId/contacts">Back to contacts</a>

    <header class="contact-file-header">
        <div class="contact-file-identity">
            <span class="contact-file-avatar" aria-hidden="true">@Initials(contact.Name)</span>
            <div>
                <div class="contact-file-kicker">Client file</div>
                <h1>@contact.Name</h1>
                <div class="contact-file-meta">
                    @if (!string.IsNullOrWhiteSpace(contact.Email))
                    {
                        <a href="mailto:@contact.Email">@contact.Email</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(contact.Phone))
                    {
                        <a href="tel:@contact.Phone">@contact.Phone</a>
                    }
                    @if ((contact.Type & PartyType.Customer) != 0)
                    {
                        <span class="contact-file-badge">Customer</span>
                    }
                    @if ((contact.Type & PartyType.Supplier) != 0)
                    {
                        <span class="contact-file-badge supplier">Supplier</span>
                    }
                    @if (contact.TradingStatus != PartyTradingStatus.Active)
                    {
                        <span class="contact-file-badge @(contact.TradingStatus == PartyTradingStatus.Blacklisted ? "blocked" : "paused")">@contact.TradingStatus</span>
                    }
                </div>
            </div>
        </div>
        <div class="contact-file-actions">
            @if ((contact.Type & PartyType.Customer) != 0)
            {
                <a class="btn btn-outline-secondary" href="o/@OrganisationId/contacts/@ContactId/statement">Statement</a>
            }
            <a class="btn btn-primary" href="o/@OrganisationId/contacts/@ContactId/documents">Documents</a>
        </div>
    </header>

    <nav class="contact-file-tabs" aria-label="Client file sections">
        <a href="#activity">Activity</a>
        <a href="#contact-details">Contact details</a>
        <a href="#financial-details">Financial details</a>
        <a href="o/@OrganisationId/contacts/@ContactId/documents">Documents <span>@documentCount</span></a>
    </nav>

    <section id="activity" class="contact-file-section">
        <div class="contact-summary-grid">
            <article class="contact-summary-card">
                <span>Invoices owed to you</span>
                <strong>@BalanceText(customerItems)</strong>
                <small>@OpenCount(customerItems) outstanding</small>
            </article>
            <article class="contact-summary-card">
                <span>Bills you owe</span>
                <strong>@BalanceText(supplierItems)</strong>
                <small>@OpenCount(supplierItems) outstanding</small>
            </article>
            <article class="contact-summary-card">
                <span>Documents</span>
                <strong>@documentCount.ToString("N0")</strong>
                <small>Stored in this client file</small>
            </article>
        </div>

        <div class="contact-file-dataset">
            <XeroDatasetDates OrganisationId="OrganisationId" />
            @if (sourceNote is not null)
            {
                <p class="text-muted">@sourceNote</p>
            }
            @if (incompleteData)
            {
                <p class="alert alert-warning">Some Xero records could not be read. The amounts below are partial.</p>
            }
        </div>

        <div class="contact-register-heading">
            <div>
                <p class="contact-file-kicker">Activity</p>
                <h2>Invoices and bills</h2>
            </div>
            <label><input type="checkbox" @bind="onlyOutstanding" /> Show outstanding items only</label>
        </div>
    @foreach (var supplier in new[] { false, true })
    {
        var items = rows.Where(x => x.Supplier == supplier).ToList();
        if (items.Count == 0 && !contact.Type.HasFlag(supplier ? PartyType.Supplier : PartyType.Customer)) { continue; }
        <section class="contact-register mb-3">
            <h2>@(supplier ? "Supplier bills" : "Customer invoices")</h2>
            @foreach (var group in items.GroupBy(x => x.Currency).OrderBy(x => x.Key))
            {
                var net = group.Sum(x => x.Due);
                <p><strong>@(net < 0 ? "Credit balance" : supplier ? "You owe" : "Owed to you") &nbsp; @group.Key @Math.Abs(net).ToString("N2")</strong>
                    <span class="ms-3">@group.Count(x => x.Due > 0) outstanding</span></p>
            }
            @if (items.Count == 0)
            {
                <p>No documents recorded for this contact in the available data.</p>
            }
            else if (onlyOutstanding && items.All(x => x.Due == 0m))
            {
                <p>No outstanding items.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle">
                    <thead><tr><th>Document</th><th>Date</th><th>Due date</th><th>Status</th><th>Currency</th><th class="text-end">Total</th><th class="text-end">Owing</th></tr></thead>
                    <tbody>
                    @foreach (var item in items.Where(x => !onlyOutstanding || x.Due != 0m).OrderByDescending(x => x.Date).ThenBy(x => x.Number))
                    {
                        <tr><td>@if (item.Path is not null) { <a href="o/@OrganisationId/@item.Path">@item.Number</a> } else { @item.Number }</td>
                            <td>@item.Date?.ToString("dd MMM yyyy")</td><td>@item.DueDate?.ToString("dd MMM yyyy")</td>
                            <td>@item.Status</td><td>@item.Currency</td><td class="text-end">@item.Total?.ToString("N2")</td><td class="text-end">@item.Due.ToString("N2")</td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </section>
    }
    </section>

    <section id="contact-details" class="contact-file-panel">
        <div>
            <p class="contact-file-kicker">Client record</p>
            <h2>Contact details</h2>
        </div>
        <dl class="contact-file-details">
            <dt>Primary email</dt><dd>@Display(contact.Email)</dd>
            <dt>Accounts email</dt><dd>@Display(contact.AccountsEmail)</dd>
            <dt>Phone</dt><dd>@Display(contact.Phone)</dd>
            <dt>Address</dt><dd class="contact-file-address">@Display(contact.Address)</dd>
            <dt>@TaxIdentifierLabel</dt><dd>@Display(contact.Tin)</dd>
            <dt>Trading status</dt><dd>@contact.TradingStatus@if (!string.IsNullOrWhiteSpace(contact.TradingStatusReason)) { <span> - @contact.TradingStatusReason</span> }</dd>
        </dl>
    </section>

    <section id="financial-details" class="contact-file-panel">
        <div>
            <p class="contact-file-kicker">Defaults</p>
            <h2>Financial details</h2>
        </div>
        <dl class="contact-file-details">
            @if ((contact.Type & PartyType.Customer) != 0)
            {
                <dt>Sales account</dt><dd>@AccountText(contact.DefaultSalesAccount, "Choose on invoice")</dd>
                <dt>Sales @access.Organisation.TaxLabel</dt><dd>@(contact.DefaultSalesVatTreatment?.ToString() ?? "Choose on invoice")</dd>
                <dt>Invoice currency</dt><dd>@(contact.DefaultSalesCurrency ?? access.Organisation.BaseCurrency)</dd>
                <dt>Invoice payment terms</dt><dd>@FormatPaymentTerms(contact.DefaultSalesInvoicePaymentTermType, contact.DefaultSalesInvoiceDueDays)</dd>
            }
            @if ((contact.Type & PartyType.Supplier) != 0)
            {
                <dt>Purchase account</dt><dd>@AccountText(contact.DefaultPurchaseAccount, "Choose on bill")</dd>
                <dt>Purchase @access.Organisation.TaxLabel</dt><dd>@(contact.DefaultPurchaseVatTreatment?.ToString() ?? "Choose on bill")</dd>
                <dt>Bill currency</dt><dd>@(contact.DefaultPurchaseCurrency ?? access.Organisation.BaseCurrency)</dd>
                <dt>Bill payment terms</dt><dd>@FormatPaymentTerms(contact.DefaultSupplierBillPaymentTermType, contact.DefaultSupplierBillDueDays)</dd>
                <dt>@access.Organisation.TaxLabel registration</dt><dd>@Display(contact.VatRegistrationNumber)</dd>
            }
        </dl>
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    [Parameter] public Guid ContactId { get; set; }
    private AccessibleOrganisation? access;
    private BusinessParty? contact;
    private List<Entry> rows = [];
    private bool loading = true, onlyOutstanding, incompleteData;
    private string? sourceNote;
    private int documentCount;
    private string TaxIdentifierLabel => access?.Organisation.CountryCode.Equals("NZ", StringComparison.OrdinalIgnoreCase) == true
        ? "IRD number"
        : "TIN";
    private sealed record Entry(bool Supplier, string Number, DateOnly? Date, DateOnly? DueDate, string Status,
        string Currency, decimal? Total, decimal Due, string? Path);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        rows = [];
        contact = null;
        sourceNote = null;
        documentCount = 0;
        incompleteData = false;
        onlyOutstanding = false;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is not null)
        {
            contact = await Db.BusinessParties.AsNoTracking()
                .Include(x => x.DefaultSalesAccount)
                .Include(x => x.DefaultPurchaseAccount)
                .Include(x => x.Documents)
                .SingleOrDefaultAsync(x => x.Id == ContactId && x.OrganisationId == OrganisationId);
            if (contact is not null)
            {
                documentCount = contact.Documents.Count;
                var divisions = await TenantAccess.ListAccessibleDivisionIdsAsync(userId, OrganisationId);
                await LoadLocal(divisions, access.Organisation.BaseCurrency);
                if (await TenantAccess.GetReportDivisionScopeAsync(userId, OrganisationId) is null)
                    await LoadXero(access.Organisation.BaseCurrency);
                else
                    sourceNote = "Showing Account Island documents for your accessible divisions.";
            }
        }
        loading = false;
    }

    private async Task LoadLocal(Guid[] divisions, string currency)
    {
        var invoices = await Db.SalesInvoices.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.CustomerId == ContactId && x.DivisionId.HasValue && divisions.Contains(x.DivisionId.Value))
            .Select(x => new { x.Id, x.InvoiceNumber, x.IssueDate, x.DueDate, x.Status, x.Total, x.AmountPaid, x.AmountCredited }).ToListAsync();
        foreach (var x in invoices)
        {
            var due = x.Status is InvoiceStatus.Posted or InvoiceStatus.PartPaid ? Math.Max(0m, x.Total - x.AmountPaid - x.AmountCredited) : 0m;
            rows.Add(new(false, x.InvoiceNumber, x.IssueDate, x.DueDate, StatusText(x.Status.ToString()), currency, x.Total, due, $"sales/{x.Id}"));
        }
        var bills = await Db.SupplierBills.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.SupplierId == ContactId && x.DivisionId.HasValue && divisions.Contains(x.DivisionId.Value))
            .Select(x => new { x.Id, x.SupplierReference, x.BillNumber, x.BillDate, x.DueDate, x.Status, x.Total, x.AmountPaid, x.AmountCredited }).ToListAsync();
        foreach (var x in bills)
        {
            var due = x.Status is BillStatus.Posted or BillStatus.PartPaid ? Math.Max(0m, x.Total - x.AmountPaid - x.AmountCredited) : 0m;
            rows.Add(new(true, string.IsNullOrWhiteSpace(x.SupplierReference) ? x.BillNumber : x.SupplierReference,
                x.BillDate, x.DueDate, StatusText(x.Status.ToString()), currency, x.Total, due, $"purchases/{x.Id}"));
        }
        var drafts = await Db.SupplierBillDrafts.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.SupplierId == ContactId && x.DivisionId.HasValue && divisions.Contains(x.DivisionId.Value))
            .Select(x => new { x.Id, x.SupplierReference, x.BillDate, x.DueDate, x.Currency }).ToListAsync();
        foreach (var x in drafts)
            rows.Add(new(true, string.IsNullOrWhiteSpace(x.SupplierReference) ? "Draft bill" : x.SupplierReference,
                x.BillDate, x.DueDate, "Draft", x.Currency, null, 0m, $"purchases?draft={x.Id}"));
    }

    private static string StatusText(string status) => status switch
    {
        "Posted" => "Awaiting payment", "PartPaid" => "Part paid", _ => status
    };

    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(words.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string AccountText(LedgerAccount? account, string fallback) =>
        account is null ? fallback : $"{account.Code} - {account.Name}";

    private static int OpenCount(IEnumerable<Entry> items) => items.Count(x => x.Due != 0m);

    private static string BalanceText(IEnumerable<Entry> items)
    {
        var balances = items.GroupBy(x => x.Currency)
            .Select(group => $"{group.Key} {Math.Abs(group.Sum(x => x.Due)):N2}")
            .ToArray();
        return balances.Length == 0 ? "0.00" : string.Join(" / ", balances);
    }

    private static string FormatPaymentTerms(PaymentTermType type, int value) => type switch
    {
        PaymentTermType.DaysAfterDocumentDate => $"{value} days",
        PaymentTermType.DayOfFollowingMonth => $"Day {value} of following month",
        PaymentTermType.EndOfCurrentMonth => "End of current month",
        PaymentTermType.EndOfFollowingMonth => "End of following month",
        _ => $"{value} days"
    };

    private async Task LoadXero(string baseCurrency)
    {
        var connection = await Db.XeroConnections.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive)
            .Select(x => new { x.Id, x.LastSyncedAt }).FirstOrDefaultAsync();
        var credits = await Db.SupplierCreditNotes.AsNoTracking().Where(x => x.OrganisationId == OrganisationId &&
            x.SupplierId == ContactId && x.SupplierBillId == null && !Db.SupplierCreditNoteReversals.Any(r => r.SupplierCreditNoteId == x.Id))
            .Select(x => new { x.CreditNoteNumber, x.CreditDate, x.Total }).ToListAsync();
        foreach (var credit in credits)
            rows.Add(new(true, credit.CreditNoteNumber, credit.CreditDate, null, "Credit", baseCurrency, null, -credit.Total, null));
        if (connection is null) return;
        sourceNote = connection.LastSyncedAt is { } synced
            ? $"Includes saved Xero data. Last sync {synced.UtcDateTime:dd MMM yyyy HH:mm} UTC."
            : "Xero sync is incomplete. Balances reflect available documents.";
        var keys = await Db.XeroMirrorEntityLinks.AsNoTracking().Where(x => x.OrganisationId == OrganisationId &&
            x.XeroConnectionId == connection.Id && x.DatasetKey == "contacts" && x.TargetEntityType == nameof(BusinessParty) && x.TargetEntityId == ContactId)
            .Select(x => x.ExternalId).ToListAsync();
        if (keys.Count == 0)
        {
            sourceNote += " No linked Xero contact was found.";
            return;
        }
        var localNumbers = rows.Where(x => x.Path is not null && x.Status != "Draft")
            .Select(x => (x.Supplier, x.Number.Trim().ToUpperInvariant())).ToHashSet();
        foreach (var key in keys.Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var records = XeroContactDocumentQuery.Read(Db, OrganisationId, connection.Id, key);
            await foreach (var record in records)
            {
                try { ReadMirrorRecord(record, key, baseCurrency, localNumbers); }
                catch (JsonException) { incompleteData = true; }
            }
        }
    }

    private void ReadMirrorRecord(XeroMirrorRecord record, string key, string baseCurrency, HashSet<(bool, string)> localNumbers)
    {
        using var json = JsonDocument.Parse(record.SourceJson);
        var body = json.RootElement;
        if (!body.TryGetProperty("Contact", out var c) || c.ValueKind != JsonValueKind.Object ||
            !c.TryGetProperty("ContactID", out var id) || !string.Equals(id.ToString(), key, StringComparison.OrdinalIgnoreCase)) return;
        var currency = body.TryGetProperty("CurrencyCode", out var code) ? code.ToString() : baseCurrency;
        if (record.DatasetKey is "sales-invoices" or "bills")
        {
            bool supplier = record.DatasetKey == "bills";
            string Field(string field) => body.TryGetProperty(field, out var v) ? v.ToString() : "";
            var number = Field("InvoiceNumber");
            if (string.IsNullOrWhiteSpace(number)) number = record.DisplayName;
            if (localNumbers.Contains((supplier, number.Trim().ToUpperInvariant()))) return;
            var status = Field("Status").ToUpperInvariant();
            decimal? Money(string field) => decimal.TryParse(Field(field), NumberStyles.Number | NumberStyles.AllowExponent,
                CultureInfo.InvariantCulture, out var value) ? value : null;
            var due = status == "AUTHORISED" ? Money("AmountDue") : 0m;
            if (due is null) { incompleteData = true; return; }
            var label = status switch { "AUTHORISED" when due == 0 => "Settled", "AUTHORISED" when Money("AmountPaid") > 0 || Money("AmountCredited") > 0 => "Part paid", "AUTHORISED" => "Awaiting payment", "PAID" => "Paid", "DRAFT" => "Draft", "SUBMITTED" => "Awaiting approval", "VOIDED" => "Voided", _ => status };
            DateOnly? Date(string field) => XeroSalesInvoiceProjectionParser.TryDate(body, field, out var value) ? value : null;
            rows.Add(new(supplier, number, Date("Date"), Date("DueDate"), label, currency,
                Money("Total"), due.Value,
                Date("Date").HasValue && Date("DueDate").HasValue ? $"{(supplier ? "purchases" : "sales")}/xero/{record.Id}" : null));
        }
        else
        {
            foreach (var supplier in new[] { false, true })
                if (XeroOpenBalanceService.TryReadCredit(record, currency, supplier) is { } credit)
                    rows.Add(new(supplier, credit.Document, null, null, "Available credit", currency, null, credit.Amount, null));
        }
    }
}
