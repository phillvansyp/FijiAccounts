@page "/o/{OrganisationId:guid}/receipts"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject CustomerReceiptService ReceiptService
@inject TransactionCurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Customer receipts</PageTitle>
@if (access is null)
{
    <div class="alert alert-danger">You do not have access to this organisation.</div>
}
else
{
    <a href="o/@OrganisationId/sales">&larr; Sales invoices</a>
    <h1>Customer receipts</h1>
    @if (canPost && openInvoices.Count > 0 && bankAccounts.Count > 0)
    {
        <div class="setup-card">
            <h2>Record payment</h2>
            <EditForm Model="model" OnValidSubmit="Record" FormName="customer-receipt">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label">Invoice</label>
                    <InputSelect class="form-select" @bind-Value="model.InvoiceId" @bind-Value:after="SetOutstanding">
                        @foreach (var invoice in openInvoices)
                        {
                            <option value="@invoice.Id">@invoice.InvoiceNumber - @invoice.Customer.Name - @invoice.Currency @((invoice.Total - invoice.AmountPaid - invoice.AmountCredited) / invoice.ExchangeRateToBase).ToString("N2") due</option>
                        }
                    </InputSelect>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Receipt date</label><InputDate class="form-control" @bind-Value="model.Date" @bind-Value:after="RefreshSettlementRate" /></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Reference</label><input class="form-control" @bind="model.Reference" @bind:event="oninput" /></div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Deposit account</label><InputSelect class="form-select" @bind-Value="model.BankAccountId">@foreach (var account in bankAccounts) { <option value="@account.Id">@account.Code - @account.Name</option> }</InputSelect></div>
                    @if (SelectedInvoice is not null && IsForeignInvoice)
                    {
                        <div class="col-md-3 mb-3"><label class="form-label">Amount received (@SelectedInvoice.Currency)</label><input type="number" step="0.01" class="form-control" @bind="model.TransactionAmount" @bind:event="oninput" @bind:after="TransactionAmountChanged" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Actual bank amount (@access.Organisation.BaseCurrency)</label><input type="number" step="0.01" class="form-control" @bind="model.Amount" @bind:event="oninput" /><div class="form-text">Reference rate: 1 @SelectedInvoice.Currency = @model.SettlementRate.ToString("0.########") @access.Organisation.BaseCurrency. Enter the actual banked amount when known.</div></div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3"><label class="form-label">Amount (@access.Organisation.BaseCurrency)</label><input type="number" step="0.01" class="form-control" @bind="model.Amount" @bind:event="oninput" @bind:after="BaseAmountChanged" /></div>
                    }
                </div>
                @if (SelectedInvoice is not null && IsForeignInvoice)
                {
                    <div class="alert alert-info">The invoice remains at its original rate of @SelectedInvoice.ExchangeRateToBase.ToString("0.########"). This receipt will record an estimated realised FX @(FxDifference >= 0 ? "gain" : "loss") of @access.Organisation.BaseCurrency @Math.Abs(FxDifference).ToString("N2").</div>
                }
                <button class="btn btn-primary">Record receipt</button>
            </EditForm>
            @if (status is not null) { <div class="alert @statusClass mt-3">@status</div> }
        </div>
    }
    else if (openInvoices.Count == 0)
    {
        <div class="alert alert-info">There are no outstanding sales invoices.</div>
    }
    <h2 class="mt-5">Receipt history</h2>
    <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Reference</th><th>Customer</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var receipt in receipts) { <tr><td>@receipt.ReceiptDate.ToString("dd MMM yyyy")</td><td>@receipt.Reference</td><td>@receipt.Customer.Name</td><td class="text-end">@receipt.Currency @receipt.TransactionAmount.ToString("N2") (@access.Organisation.BaseCurrency @receipt.Amount.ToString("N2"))</td></tr> }</tbody></table></div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access;
    private string userId = string.Empty;
    private bool canPost;
    private List<SalesInvoice> openInvoices = [];
    private List<LedgerAccount> bankAccounts = [];
    private List<CustomerReceipt> receipts = [];
    private ReceiptModel model = new();
    private string? status;
    private string statusClass = "alert-success";
    private SalesInvoice? SelectedInvoice => openInvoices.SingleOrDefault(x => x.Id == model.InvoiceId);
    private bool IsForeignInvoice => SelectedInvoice is not null && access is not null && !string.Equals(SelectedInvoice.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase);
    private decimal FxDifference => SelectedInvoice is null ? 0m : model.Amount - decimal.Round(model.TransactionAmount * SelectedInvoice.ExchangeRateToBase, 2, MidpointRounding.AwayFromZero);

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(state.User)!;
        access = await TenantAccess.FindAsync(userId, OrganisationId);
        if (access is null) return;
        canPost = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId);
        await Reload();
        await Reset();
    }

    private async Task Reload()
    {
        openInvoices = await Db.SalesInvoices.AsNoTracking().Include(x => x.Customer).Where(x => x.OrganisationId == OrganisationId && x.Status != InvoiceStatus.Paid && x.Status != InvoiceStatus.Voided && x.Status != InvoiceStatus.Draft).OrderBy(x => x.DueDate).ToListAsync();
        bankAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.IsBankAccount).OrderBy(x => x.Code).ToListAsync();
        receipts = await Db.CustomerReceipts.AsNoTracking().Include(x => x.Customer).Where(x => x.OrganisationId == OrganisationId).OrderByDescending(x => x.ReceiptDate).Take(100).ToListAsync();
    }

    private async Task Reset()
    {
        model = new();
        if (openInvoices.Count > 0) { model.InvoiceId = openInvoices[0].Id; await SetOutstanding(); }
        if (bankAccounts.Count > 0) model.BankAccountId = bankAccounts[0].Id;
    }

    private async Task SetOutstanding()
    {
        var invoice = SelectedInvoice;
        if (invoice is null) return;
        model.TransactionAmount = decimal.Round((invoice.Total - invoice.AmountPaid - invoice.AmountCredited) / invoice.ExchangeRateToBase, 2, MidpointRounding.AwayFromZero);
        await RefreshSettlementRate();
    }

    private async Task RefreshSettlementRate()
    {
        var invoice = SelectedInvoice;
        if (invoice is null || access is null) return;
        model.SettlementRate = string.Equals(invoice.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase)
            ? 1m
            : await CurrencyService.FindRateAsync(userId, OrganisationId, invoice.Currency, model.Date) ?? invoice.ExchangeRateToBase;
        TransactionAmountChanged();
    }

    private void TransactionAmountChanged() => model.Amount = decimal.Round(model.TransactionAmount * model.SettlementRate, 2, MidpointRounding.AwayFromZero);
    private void BaseAmountChanged() => model.TransactionAmount = model.Amount;

    private async Task Record()
    {
        try
        {
            var receipt = await ReceiptService.RecordAsync(userId, new(OrganisationId, model.InvoiceId, model.Date, model.Reference, model.Amount, model.BankAccountId, TransactionAmount: model.TransactionAmount));
            statusClass = "alert-success";
            status = $"Receipt {receipt.Reference} recorded for {receipt.Currency} {receipt.TransactionAmount:N2} ({access?.Organisation.BaseCurrency} {receipt.Amount:N2}).";
            await Reload();
            await Reset();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or DomainException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private sealed class ReceiptModel
    {
        public Guid InvoiceId { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        [Required, StringLength(80)] public string Reference { get; set; } = string.Empty;
        [Range(0.01, 999999999)] public decimal TransactionAmount { get; set; }
        [Range(0.01, 999999999)] public decimal Amount { get; set; }
        public decimal SettlementRate { get; set; } = 1m;
        public Guid BankAccountId { get; set; }
    }
}
