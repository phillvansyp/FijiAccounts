@page "/o/{OrganisationId:guid}/assets"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject FixedAssetService AssetService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Fixed assets · Account Island</PageTitle>

@if (access is null)
{
    <div class="alert alert-danger">
        You do not have access to this organisation.
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Accounting</p>
            <h1>Fixed assets</h1>
            <p class="page-intro">
                Maintain the asset register, post acquisitions, depreciation and disposals.
            </p>
        </div>

        <button class="btn btn-outline-secondary no-print"
                onclick="window.print()">
            Print register
        </button>
    </div>

    @if (canManage &&
         assetAccounts.Count > 0 &&
         expenseAccounts.Count > 0 &&
         bankAccounts.Count > 0)
    {
        <details class="setup-card mb-4">
            <summary>
                <strong>+ Register fixed asset</strong>
            </summary>

            <EditForm Model="model"
                      OnValidSubmit="Create"
                      FormName="fixed-asset"
                      class="mt-3">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Name" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Acquired</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.AcquisitionDate" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Cost</label>
                        <InputNumber class="form-control"
                                     @bind-Value="model.Cost" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Residual value</label>
                        <InputNumber class="form-control"
                                     @bind-Value="model.ResidualValue" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Useful life (months)</label>
                        <InputNumber class="form-control"
                                     @bind-Value="model.UsefulLifeMonths" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Asset account</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.AssetAccountId">
                            @foreach (var item in assetAccounts)
                            {
                                <option value="@item.Id">
                                    @item.Code — @item.Name
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Accumulated depreciation</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.AccumulatedAccountId">
                            @foreach (var item in assetAccounts)
                            {
                                <option value="@item.Id">
                                    @item.Code — @item.Name
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Depreciation expense</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.ExpenseAccountId">
                            @foreach (var item in expenseAccounts)
                            {
                                <option value="@item.Id">
                                    @item.Code — @item.Name
                                </option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Paid from account</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.AcquisitionBankAccountId">
                            @foreach (var item in bankAccounts)
                            {
                                <option value="@item.Id">
                                    @item.Code — @item.Name
                                </option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <button class="btn btn-primary">
                    Register and post asset
                </button>
            </EditForm>
        </details>
    }

    @if (message is not null)
    {
        <div class="alert @messageClass">
            @message
        </div>
    }

    <section class="detail-card">
        <div class="card-heading">
            <div>
                <span class="eyebrow">Book register</span>
                <h2>Assets</h2>
            </div>

            <span>@activeAssets active · @disposedAssets disposed</span>
        </div>

        @if (assets.Count == 0)
        {
            <div class="empty-state">
                <strong>No fixed assets</strong>
                <span>Register assets to begin book depreciation.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th>Status</th>
                            <th>Acquired</th>
                            <th class="text-end">Cost</th>
                            <th class="text-end">Accumulated depreciation</th>
                            <th class="text-end">Book value</th>
                            <th class="no-print">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var asset in assets)
                        {
                            var accumulated =
                                asset.DepreciationEntries.Sum(x => x.Amount);

                            var bookValue =
                                asset.Cost - accumulated;

                            <tr>
                                <td>
                                    <strong>@asset.AssetNumber · @asset.Name</strong>

                                    <small class="d-block text-muted">
                                        @asset.AssetAccount.Code — @asset.AssetAccount.Name
                                    </small>
                                </td>

                                <td>
                                    @if (asset.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Disposed</span>
                                    }
                                </td>

                                <td>@asset.AcquisitionDate.ToString("dd MMM yyyy")</td>

                                <td class="text-end">
                                    $@asset.Cost.ToString("N2")
                                </td>

                                <td class="text-end">
                                    $@accumulated.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @if (asset.Disposal is null)
                                    {
                                        <strong>$@bookValue.ToString("N2")</strong>
                                    }
                                    else
                                    {
                                        <strong>$@asset.Disposal.BookValue.ToString("N2")</strong>
                                    }
                                </td>

                                <td class="no-print">
                                    @if (asset.IsActive)
                                    {
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => SelectDepreciation(asset)">
                                                Depreciate
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => SelectDisposal(asset)">
                                                Dispose
                                            </button>
                                        </div>
                                    }
                                    else if (asset.Disposal is not null)
                                    {
                                        <small class="text-muted">
                                            Disposed @asset.Disposal.DisposalDate.ToString("dd MMM yyyy")
                                            · Proceeds $@asset.Disposal.Proceeds.ToString("N2")
                                        </small>
                                    }
                                </td>
                            </tr>

                            @if (selectedDepreciationAssetId == asset.Id && asset.IsActive)
                            {
                                <tr class="no-print">
                                    <td colspan="7">
                                        <div class="border rounded p-3">
                                            <div class="row align-items-end">
    <div class="col-md-3 mb-3">
        <label class="form-label">Depreciate through</label>
        <InputDate class="form-control"
                   @bind-Value="depreciationDate" />
    </div>

    <div class="col-md-3 mb-3">
        <label class="form-label">Depreciation to post</label>
        <div class="form-control bg-light">
            $@DepreciationPreview(asset).ToString("N2")
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <label class="form-label">Book value after posting</label>
        <div class="form-control bg-light">
            $@BookValueAfterPreview(asset).ToString("N2")
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <button class="btn btn-primary"
                disabled="@(DepreciationPreview(asset) <= 0)"
                @onclick="() => Depreciate(asset.Id)">
            Post depreciation
        </button>

        <button class="btn btn-link"
                @onclick="CancelDepreciation">
            Cancel
        </button>
    </div>
</div>

<div class="form-text">
    Straight-line book depreciation is calculated automatically from cost,
    residual value and useful life.
</div>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (selectedDisposalAssetId == asset.Id && asset.IsActive)
                            {
                                <tr class="no-print">
                                    <td colspan="7">
                                        <div class="border rounded p-3">
                                            <h3 class="h6 mb-3">
                                                Dispose @asset.AssetNumber · @asset.Name
                                            </h3>

                                            <div class="row">
                                                <div class="col-md-2 mb-3">
                                                    <label class="form-label">Disposal date</label>
                                                    <InputDate class="form-control"
                                                               @bind-Value="disposalModel.DisposalDate" />
                                                </div>

                                                <div class="col-md-2 mb-3">
                                                    <label class="form-label">Proceeds</label>
                                                    <InputNumber class="form-control"
                                                                 @bind-Value="disposalModel.Proceeds" />
                                                </div>

                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label">Received into</label>
                                                    <InputSelect class="form-select"
                                                                 @bind-Value="disposalModel.BankAccountId">
                                                        @foreach (var item in bankAccounts)
                                                        {
                                                            <option value="@item.Id">
                                                                @item.Code — @item.Name
                                                            </option>
                                                        }
                                                    </InputSelect>
                                                </div>

                                                <div class="col-md-2 mb-3">
                                                    <label class="form-label">Gain account</label>
                                                    <InputSelect class="form-select"
                                                                 @bind-Value="disposalModel.GainAccountId">
                                                        @foreach (var item in revenueAccounts)
                                                        {
                                                            <option value="@item.Id">
                                                                @item.Code — @item.Name
                                                            </option>
                                                        }
                                                    </InputSelect>
                                                </div>

                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label">Loss account</label>
                                                    <InputSelect class="form-select"
                                                                 @bind-Value="disposalModel.LossAccountId">
                                                        @foreach (var item in expenseAccounts)
                                                        {
                                                            <option value="@item.Id">
                                                                @item.Code — @item.Name
                                                            </option>
                                                        }
                                                    </InputSelect>
                                                </div>
                                            </div>

                                            <div class="alert alert-warning">
                                                Disposal is permanent and will post an accounting journal.
                                            </div>

                                            <button class="btn btn-danger"
                                                    @onclick="() => Dispose(asset.Id)">
                                                Dispose asset
                                            </button>

                                            <button class="btn btn-link"
                                                    @onclick="CancelDisposal">
                                                Cancel
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid OrganisationId { get; set; }

    private AccessibleOrganisation? access;
    private string userId = "";
    private bool canManage;

    private List<LedgerAccount> assetAccounts = [];
    private List<LedgerAccount> expenseAccounts = [];
    private List<LedgerAccount> revenueAccounts = [];
    private List<LedgerAccount> bankAccounts = [];
    private List<FixedAsset> assets = [];

    private AssetModel model = new();
    private DisposalModel disposalModel = new();

    private Guid? selectedDepreciationAssetId;
    private Guid? selectedDisposalAssetId;

    private DateOnly depreciationDate =
        DateOnly.FromDateTime(DateTime.Today);

    private string? message;
    private string messageClass = "alert-success";

    private int activeAssets =>
        assets.Count(x => x.IsActive);

    private int disposedAssets =>
        assets.Count(x => !x.IsActive);

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        canManage =
            await TenantAccess.CanPostJournalsAsync(
                userId,
                OrganisationId);

        assetAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    x.Type == AccountType.Asset)
                .OrderBy(x => x.Code)
                .ToListAsync();

        expenseAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    x.Type == AccountType.Expense)
                .OrderBy(x => x.Code)
                .ToListAsync();

        revenueAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    x.Type == AccountType.Revenue)
                .OrderBy(x => x.Code)
                .ToListAsync();

        bankAccounts =
            await Db.LedgerAccounts
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.IsActive &&
                    x.IsBankAccount)
                .OrderBy(x => x.Code)
                .ToListAsync();

        Reset();
        ResetDisposal();

        await Reload();
    }

    private async Task Reload()
    {
        assets =
            await Db.FixedAssets
                .AsNoTracking()
                .Include(x => x.AssetAccount)
                .Include(x => x.AcquisitionBankAccount)
                .Include(x => x.DepreciationEntries)
                .Include(x => x.Disposal)
                .Where(x => x.OrganisationId == OrganisationId)
                .OrderByDescending(x => x.IsActive)
                .ThenBy(x => x.AssetNumber)
                .ToListAsync();
    }

    private void Reset()
    {
        model =
            new AssetModel
            {
                AssetAccountId =
                    assetAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty,

                AccumulatedAccountId =
                    assetAccounts.Skip(1).FirstOrDefault()?.Id ??
                    assetAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty,

                ExpenseAccountId =
                    expenseAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty,

                AcquisitionBankAccountId =
                    bankAccounts.FirstOrDefault()?.Id
            };
    }

    private void ResetDisposal()
    {
        disposalModel =
            new DisposalModel
            {
                DisposalDate =
                    DateOnly.FromDateTime(DateTime.Today),

                BankAccountId =
                    bankAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty,

                GainAccountId =
                    revenueAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty,

                LossAccountId =
                    expenseAccounts.FirstOrDefault()?.Id ??
                    Guid.Empty
            };
    }

    private async Task Create()
    {
        try
        {
            var asset =
                await AssetService.CreateAsync(
                    userId,
                    new FixedAssetRequest(
                        OrganisationId,
                        model.Name,
                        model.AcquisitionDate,
                        model.Cost,
                        model.ResidualValue,
                        model.UsefulLifeMonths,
                        model.AssetAccountId,
                        model.ExpenseAccountId,
                        model.AccumulatedAccountId,
                        model.AcquisitionBankAccountId));

            messageClass = "alert-success";
            message =
                $"Asset {asset.AssetNumber} registered and acquisition posted.";

            Reset();
            await Reload();
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = ex.Message;
        }
    }

    private void SelectDepreciation(FixedAsset asset)
    {
        selectedDepreciationAssetId = asset.Id;
        selectedDisposalAssetId = null;
        depreciationDate =
            DateOnly.FromDateTime(DateTime.Today);
    }

    private void CancelDepreciation()
    {
        selectedDepreciationAssetId = null;
    }

    private decimal DepreciationPreview(FixedAsset asset)
{
    if (depreciationDate < asset.AcquisitionDate)
    {
        return 0m;
    }

    var months =
        Math.Min(
            asset.UsefulLifeMonths,
            (depreciationDate.Year - asset.AcquisitionDate.Year) * 12 +
            depreciationDate.Month -
            asset.AcquisitionDate.Month +
            1);

    var target =
        Math.Round(
            (asset.Cost - asset.ResidualValue) *
            months /
            asset.UsefulLifeMonths,
            2);

    var alreadyPosted =
        asset.DepreciationEntries.Sum(x => x.Amount);

    return Math.Max(
        0m,
        target - alreadyPosted);
}

private decimal BookValueAfterPreview(FixedAsset asset)
{
    var alreadyPosted =
        asset.DepreciationEntries.Sum(x => x.Amount);

    return Math.Max(
        asset.ResidualValue,
        asset.Cost -
        alreadyPosted -
        DepreciationPreview(asset));
}

    private async Task Depreciate(Guid id)
    {
        try
        {
            var entry =
                await AssetService.DepreciateThroughAsync(
                    userId,
                    OrganisationId,
                    id,
                    depreciationDate);

            messageClass = "alert-success";
            message =
                $"Book depreciation of ${entry.Amount:N2} posted.";

            selectedDepreciationAssetId = null;
            await Reload();
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = ex.Message;
        }
    }

    private void SelectDisposal(FixedAsset asset)
    {
        selectedDisposalAssetId = asset.Id;
        selectedDepreciationAssetId = null;

        ResetDisposal();

        disposalModel.DisposalDate =
            DateOnly.FromDateTime(DateTime.Today);
    }

    private void CancelDisposal()
    {
        selectedDisposalAssetId = null;
        ResetDisposal();
    }

    private async Task Dispose(Guid id)
    {
        try
        {
            var disposal =
                await AssetService.DisposeAsync(
                    userId,
                    new FixedAssetDisposalRequest(
                        OrganisationId,
                        id,
                        disposalModel.DisposalDate,
                        disposalModel.Proceeds,
                        disposalModel.BankAccountId,
                        disposalModel.GainAccountId,
                        disposalModel.LossAccountId));

            var resultText =
                disposal.GainLoss > 0
                    ? $"gain of ${disposal.GainLoss:N2}"
                    : disposal.GainLoss < 0
                        ? $"loss of ${Math.Abs(disposal.GainLoss):N2}"
                        : "no gain or loss";

            messageClass = "alert-success";
            message =
                $"Asset disposed. Book value ${disposal.BookValue:N2}; {resultText}.";

            selectedDisposalAssetId = null;
            ResetDisposal();

            await Reload();
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = ex.Message;
        }
    }

    private sealed class AssetModel
    {
        [Required]
        [StringLength(160)]
        public string Name { get; set; } = "";

        public DateOnly AcquisitionDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        [Range(.01, 999999999)]
        public decimal Cost { get; set; }

        [Range(0, 999999999)]
        public decimal ResidualValue { get; set; }

        [Range(1, 1200)]
        public int UsefulLifeMonths { get; set; } = 60;

        public Guid AssetAccountId { get; set; }

        public Guid AccumulatedAccountId { get; set; }

        public Guid ExpenseAccountId { get; set; }

        [Required]
        public Guid? AcquisitionBankAccountId { get; set; }
    }

    private sealed class DisposalModel
    {
        public DateOnly DisposalDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        [Range(0, 999999999)]
        public decimal Proceeds { get; set; }

        public Guid BankAccountId { get; set; }

        public Guid GainAccountId { get; set; }

        public Guid LossAccountId { get; set; }
    }
}