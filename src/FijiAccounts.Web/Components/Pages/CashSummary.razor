@page "/o/{OrganisationId:guid}/reports/cash-summary"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Text
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Cash summary · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="page-heading"><div><p class="eyebrow">Reporting</p><h1>Cash summary</h1><p class="page-intro">Understand cash received, cash paid, and movement across bank accounts.</p></div><div class="d-flex gap-2 no-print"><button class="btn btn-outline-secondary" @onclick="ExportCsv">Export CSV</button><button class="btn btn-outline-secondary" onclick="window.print()">Print</button></div></div>
    <section class="report-controls no-print"><EditForm Model="filter" OnValidSubmit="Load" FormName="cash-filter"><div><label class="form-label">From</label><InputDate class="form-control" @bind-Value="filter.From" /></div><div><label class="form-label">To</label><InputDate class="form-control" @bind-Value="filter.To" /></div><div><label class="form-label">Bank account</label><InputSelect class="form-select" @bind-Value="filter.BankAccountId"><option value="">All bank accounts</option>@foreach (var account in bankAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><button class="btn btn-primary">Update</button></EditForm></section>
    <div class="row g-3 mb-4"><div class="col"><div class="detail-card h-100"><span class="eyebrow">Opening cash</span><h2>$@OpeningCash.ToString("N2")</h2></div></div><div class="col"><div class="detail-card h-100"><span class="eyebrow">Cash in</span><h2 class="text-success">$@CashIn.ToString("N2")</h2></div></div><div class="col"><div class="detail-card h-100"><span class="eyebrow">Cash out</span><h2 class="text-danger">$@CashOut.ToString("N2")</h2></div></div><div class="col"><div class="detail-card h-100"><span class="eyebrow">Net movement</span><h2>$@NetMovement.ToString("N2")</h2></div></div><div class="col"><div class="detail-card h-100"><span class="eyebrow">Closing cash</span><h2>$@ClosingCash.ToString("N2")</h2></div></div></div>
    <div class="row g-4 mb-4"><div class="col-lg-6"><section class="detail-card h-100"><div class="card-heading"><div><span class="eyebrow">By account</span><h2>Bank movement</h2></div></div><table class="table"><thead><tr><th>Account</th><th class="text-end">Opening</th><th class="text-end">Movement</th><th class="text-end">Closing</th></tr></thead><tbody>@foreach (var item in accountSummaries) { <tr><td><strong>@item.Code</strong> — @item.Name</td><td class="text-end">$@item.Opening.ToString("N2")</td><td class="text-end">$@item.Movement.ToString("N2")</td><td class="text-end"><strong>$@item.Closing.ToString("N2")</strong></td></tr> }</tbody></table></section></div><div class="col-lg-6"><section class="detail-card h-100"><div class="card-heading"><div><span class="eyebrow">By month</span><h2>Cash in and out</h2></div></div><table class="table"><thead><tr><th>Month</th><th class="text-end">Cash in</th><th class="text-end">Cash out</th><th class="text-end">Net</th></tr></thead><tbody>@foreach (var item in monthly) { <tr><td>@item.Month.ToString("MMM yyyy")</td><td class="text-end">$@item.In.ToString("N2")</td><td class="text-end">$@item.Out.ToString("N2")</td><td class="text-end"><strong>$@item.Net.ToString("N2")</strong></td></tr> }</tbody></table></section></div></div>
    <section class="detail-card"><div class="card-heading"><div><span class="eyebrow">Cash evidence</span><h2>Transactions</h2></div><span>@rows.Count movements</span></div>@if (rows.Count == 0) { <div class="empty-state"><strong>No cash movements</strong><span>No posted bank-account journal lines match this period.</span></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Journal</th><th>Reference</th><th>Bank account</th><th>Description</th><th class="text-end">Cash in</th><th class="text-end">Cash out</th></tr></thead><tbody>@foreach (var row in rows) { <tr><td>@row.Date.ToString("dd MMM yyyy")</td><td><a href="o/@OrganisationId/journals/@row.JournalId">J-@row.Sequence.ToString("D6")</a></td><td>@row.Reference</td><td>@row.AccountCode — @row.AccountName</td><td>@row.Description</td><td class="text-end">@(row.Amount > 0 ? $"${row.Amount:N2}" : "—")</td><td class="text-end">@(row.Amount < 0 ? $"${-row.Amount:N2}" : "—")</td></tr> }</tbody></table></div> }</section>
    <div class="alert alert-info mt-4">This report summarises posted movements in accounts marked as bank accounts. A statutory cash flow statement will be added after operating, investing and financing mappings are configured.</div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access; private List<LedgerAccount> bankAccounts = []; private List<CashRow> rows = []; private List<AccountSummary> accountSummaries = []; private List<MonthSummary> monthly = []; private FilterModel filter = new(); private decimal OpeningCash => accountSummaries.Sum(x => x.Opening); private decimal CashIn => rows.Where(x => x.Amount > 0).Sum(x => x.Amount); private decimal CashOut => -rows.Where(x => x.Amount < 0).Sum(x => x.Amount); private decimal NetMovement => CashIn - CashOut; private decimal ClosingCash => OpeningCash + NetMovement;
    protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is null) return; bankAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.IsBankAccount).OrderBy(x => x.Code).ToListAsync(); filter.To = DateOnly.FromDateTime(DateTime.Today); filter.From = filter.To.AddMonths(-6).AddDays(1); await Load(); }
    private async Task Load() { if (filter.From > filter.To) return; var accountQuery = bankAccounts.AsEnumerable(); if (filter.BankAccountId is not null) accountQuery = accountQuery.Where(x => x.Id == filter.BankAccountId); var ids = accountQuery.Select(x => x.Id).ToArray(); var openings = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && ids.Contains(x.LedgerAccountId) && x.PostedJournal.EntryDate < filter.From).GroupBy(x => x.LedgerAccountId).Select(x => new { x.Key, Amount = x.Sum(y => y.Debit - y.Credit) }).ToDictionaryAsync(x => x.Key, x => x.Amount); var raw = await Db.PostedJournalLines.AsNoTracking().Where(x => x.PostedJournal.OrganisationId == OrganisationId && ids.Contains(x.LedgerAccountId) && x.PostedJournal.EntryDate >= filter.From && x.PostedJournal.EntryDate <= filter.To).OrderBy(x => x.PostedJournal.EntryDate).ThenBy(x => x.PostedJournal.SequenceNumber).Select(x => new CashRow(x.PostedJournalId, x.PostedJournal.EntryDate, x.PostedJournal.SequenceNumber, x.PostedJournal.Reference, x.LedgerAccountId, x.LedgerAccount.Code, x.LedgerAccount.Name, x.Description, x.Debit - x.Credit)).Take(5000).ToListAsync(); rows = raw; accountSummaries = accountQuery.Select(x => { var opening = openings.GetValueOrDefault(x.Id); var movement = rows.Where(y => y.AccountId == x.Id).Sum(y => y.Amount); return new AccountSummary(x.Code, x.Name, opening, movement, opening + movement); }).ToList(); monthly = rows.GroupBy(x => new DateOnly(x.Date.Year, x.Date.Month, 1)).Select(x => new MonthSummary(x.Key, x.Where(y => y.Amount > 0).Sum(y => y.Amount), -x.Where(y => y.Amount < 0).Sum(y => y.Amount))).OrderBy(x => x.Month).ToList(); }
    private async Task ExportCsv() { var csv = new StringBuilder("Date,Journal,Reference,Bank Account,Description,Cash In,Cash Out\r\n"); foreach (var x in rows) csv.AppendLine(string.Join(',', Q(x.Date.ToString("yyyy-MM-dd")), Q($"J-{x.Sequence:D6}"), Q(x.Reference), Q($"{x.AccountCode} - {x.AccountName}"), Q(x.Description), x.Amount > 0 ? x.Amount : 0, x.Amount < 0 ? -x.Amount : 0)); await JS.InvokeVoidAsync("accountIsland.downloadText", $"cash-summary-{filter.From:yyyyMMdd}-{filter.To:yyyyMMdd}.csv", csv.ToString(), "text/csv;charset=utf-8"); }
    private static string Q(string? value) => $"\"{(value ?? "").Replace("\"", "\"\"")}\"";
    private sealed class FilterModel { public DateOnly From { get; set; } public DateOnly To { get; set; } public Guid? BankAccountId { get; set; } }
    private sealed record CashRow(Guid JournalId, DateOnly Date, long Sequence, string Reference, Guid AccountId, string AccountCode, string AccountName, string Description, decimal Amount);
    private sealed record AccountSummary(string Code, string Name, decimal Opening, decimal Movement, decimal Closing); private sealed record MonthSummary(DateOnly Month, decimal In, decimal Out) { public decimal Net => In - Out; }
}
