@page "/o/{OrganisationId:guid}/settings"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject EnterpriseStructureService EnterpriseStructures
@inject OrganisationSettingsService SettingsService
@inject OrganisationBrandingService BrandingService
@inject TransactionCurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Organisation settings · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="settings-heading"><div><p class="eyebrow">Organisation</p><h1>Business settings</h1><p>Identity, regional accounting and compliance configuration.</p></div><span class="tax-pack @(jurisdiction.TaxPackEnabled ? "enabled" : "pending")">@(jurisdiction.TaxPackEnabled ? "Tax pack enabled" : "Tax pack pending verification")</span></div>
    @if (status is not null) { <div class="alert @statusClass">@status</div> }
    <section class="settings-card mb-3">
        <h2>Organisation group</h2>
        <p>
            The parent group contains separate legal companies. Company ledgers
            and user access remain isolated.
        </p>
        @if (canManageGroup)
        {
            <EditForm Model="groupModel"
                      OnValidSubmit="SaveGroup"
                      FormName="organisation-group-settings">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row align-items-end">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Group name</label>
                        <InputText class="form-control"
                                   @bind-Value="groupModel.Name" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <button class="btn btn-outline-primary">Save group name</button>
                    </div>
                </div>
            </EditForm>
        }
        else
        {
            <dl class="jurisdiction-list">
                <div><dt>Group</dt><dd>@groupName</dd></div>
            </dl>
        }

        <div class="table-responsive mt-2">
            <table class="table">
                <thead><tr><th>Legal company</th><th>Jurisdiction</th><th>Currency</th><th>Access</th><th></th></tr></thead>
                <tbody>
                    @foreach (var company in GroupCompanies)
                    {
                        <tr>
                            <td>
                                <strong>@company.LegalName</strong>
                                @if (company.Id == OrganisationId)
                                {
                                    <span class="badge text-bg-light ms-1">Current</span>
                                }
                            </td>
                            <td>@CountryName(company.CountryCode)</td>
                            <td>@company.BaseCurrency</td>
                            <td>@(accessibleCompanyIds.Contains(company.Id) ? "Direct access" : "No ledger access")</td>
                            <td class="text-end">
                                @if (accessibleCompanyIds.Contains(company.Id))
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="o/@company.Id">Open</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (canManageGroup)
        {
            <details class="mt-3">
                <summary><strong>Add a legal company to @groupName</strong></summary>
                <EditForm Model="companyModel"
                          OnValidSubmit="CreateCompany"
                          FormName="add-group-company"
                          class="mt-3">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label">Legal name</label><InputText class="form-control" @bind-Value="companyModel.LegalName" /></div>
                        <div class="col-md-6 mb-3"><label class="form-label">Trading name (optional)</label><InputText class="form-control" @bind-Value="companyModel.TradingName" /></div>
                        <div class="col-md-4 mb-3"><label class="form-label">Jurisdiction</label><InputSelect class="form-select" @bind-Value="companyModel.CountryCode">@foreach (var item in IslandJurisdictions.All) { <option value="@item.CountryCode">@item.CountryName — @item.CurrencyCode</option> }</InputSelect></div>
                        <div class="col-md-4 mb-3"><label class="form-label">Tax identification number</label><InputText class="form-control" @bind-Value="companyModel.Tin" /></div>
                        <div class="col-md-4 mb-3"><label class="form-label">Company type</label><InputSelect class="form-select" @bind-Value="companyModel.Kind"><option value="Business">Business</option><option value="AccountingPractice">Accounting practice</option></InputSelect></div>
                    </div>
                    <button class="btn btn-primary">Create company</button>
                </EditForm>
            </details>
        }
    </section>
    <div class="settings-grid">
        <section class="settings-card"><h2>Business details</h2><p>Used on transactions, reports and tax documents.</p>
            <EditForm Model="model" OnValidSubmit="Save" FormName="organisation-settings"><DataAnnotationsValidator /><ValidationSummary />
                <div class="company-logo-setting">
                    <div class="company-logo-preview">
                        @if (branding is not null)
                        {
                            <img src="@LogoDataUrl" alt="@($"{model.LegalName} logo")" />
                        }
                        else
                        {
                            <span>@CompanyInitials</span>
                        }
                    </div>
                    <div class="company-logo-controls">
                        <label class="form-label">Company logo</label>
                        <InputFile @key="logoInputKey" class="form-control" OnChange="UploadLogo" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" disabled="@(!canManage || uploadingLogo)" />
                        <div class="form-text">PNG, JPEG or WebP, up to 1 MB. A wide or square logo with a transparent background works best.</div>
                        @if (branding is not null && canManage)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" disabled="@uploadingLogo" @onclick="RemoveLogo">Remove logo</button>
                        }
                    </div>
                </div>
                <div class="mb-3"><label class="form-label">Legal name</label><InputText class="form-control" @bind-Value="model.LegalName" disabled="@(!canManage)" /></div>
                <div class="mb-3"><label class="form-label">Trading name</label><InputText class="form-control" @bind-Value="model.TradingName" disabled="@(!canManage)" /></div>
                <div class="mb-3"><label class="form-label">Tax identification number</label><InputText class="form-control" @bind-Value="model.Tin" disabled="@(!canManage)" /></div>
                <div class="mb-3"><label class="form-label">Business address</label><InputTextArea class="form-control" @bind-Value="model.BusinessAddress" disabled="@(!canManage)" /><div class="form-text">Printed on customer documents where required.</div></div>
                @if (string.Equals(access.Organisation.CountryCode, "FJ", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="model.IsVatRegistered" disabled="@(!canManage)" /><label class="form-check-label"><strong>Registered for Fiji VAT</strong></label></div>
                        <div class="form-text mb-3">Only VAT-registered businesses may issue tax invoices and charge VAT.</div>
                        @if (model.IsVatRegistered)
                        {
                            <label class="form-label">VAT registration effective date</label><InputDate class="form-control" @bind-Value="model.VatRegistrationDate" disabled="@(!canManage)" />
                        }
                    </div>
                }
                else if (string.Equals(access.Organisation.CountryCode, "NZ", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="model.IsVatRegistered" disabled="@(!canManage)" /><label class="form-check-label"><strong>Registered for New Zealand GST</strong></label></div>
                        <div class="form-text mb-3">GST-registered businesses may charge 15% GST and prepare invoice-basis GST return workpapers.</div>
                        @if (model.IsVatRegistered)
                        {
                            <label class="form-label">GST registration effective date</label><InputDate class="form-control" @bind-Value="model.VatRegistrationDate" disabled="@(!canManage)" />
                        }
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Conversion date</label>
                    <InputDate class="form-control" @bind-Value="model.ConversionDate" disabled="@(!canManage)" />
                    <div class="form-text">
                        The first day transactions are entered in Account Island. Opening balances should be dated the previous day.
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Default customer invoice payment terms
                        </label>

                        <InputSelect class="form-select mb-2"
                                     @bind-Value="model.DefaultSalesInvoicePaymentTermType"
                                     disabled="@(!canManage)">
                            <option value="@PaymentTermType.DaysAfterDocumentDate">Days after invoice date</option>
                            <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                            <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                            <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                        </InputSelect>

                        @if (model.DefaultSalesInvoicePaymentTermType ==
                            PaymentTermType.DaysAfterDocumentDate)
                        {
                            <div class="input-group">
                                <InputNumber class="form-control"
                                             @bind-Value="model.DefaultSalesInvoiceDueDays"
                                             disabled="@(!canManage)" />
                                <span class="input-group-text">days</span>
                            </div>
                        }
                        else if (model.DefaultSalesInvoicePaymentTermType ==
                                 PaymentTermType.DayOfFollowingMonth)
                        {
                            <div class="input-group">
                                <InputNumber class="form-control"
                                             @bind-Value="model.DefaultSalesInvoiceDueDays"
                                             disabled="@(!canManage)" />
                                <span class="input-group-text">day</span>
                            </div>
                        }

                        <div class="form-text">
                            Used as the starting payment term for new customers.
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Default supplier bill payment terms
                        </label>

                        <InputSelect class="form-select mb-2"
                                     @bind-Value="model.DefaultSupplierBillPaymentTermType"
                                     disabled="@(!canManage)">
                            <option value="@PaymentTermType.DaysAfterDocumentDate">Days after bill date</option>
                            <option value="@PaymentTermType.DayOfFollowingMonth">Day of following month</option>
                            <option value="@PaymentTermType.EndOfCurrentMonth">End of current month</option>
                            <option value="@PaymentTermType.EndOfFollowingMonth">End of following month</option>
                        </InputSelect>

                        @if (model.DefaultSupplierBillPaymentTermType ==
                            PaymentTermType.DaysAfterDocumentDate)
                        {
                            <div class="input-group">
                                <InputNumber class="form-control"
                                             @bind-Value="model.DefaultSupplierBillDueDays"
                                             disabled="@(!canManage)" />
                                <span class="input-group-text">days</span>
                            </div>
                        }
                        else if (model.DefaultSupplierBillPaymentTermType ==
                                 PaymentTermType.DayOfFollowingMonth)
                        {
                            <div class="input-group">
                                <InputNumber class="form-control"
                                             @bind-Value="model.DefaultSupplierBillDueDays"
                                             disabled="@(!canManage)" />
                                <span class="input-group-text">day</span>
                            </div>
                        }

                        <div class="form-text">
                            Used as the starting payment term for new suppliers.
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input"
                                       @bind-Value="model.RequireSupplierPaymentApproval"
                                       disabled="@(!canManage)" />
                        <label class="form-check-label"><strong>Require independent supplier payment approval</strong></label>
                    </div>
                    <div class="form-text">
                        Payments remain pending until an eligible owner, administrator or approver approves them. The requester cannot approve or reject their own payment.
                    </div>
                </div>

                @if (canManage) { <button class="btn btn-primary">Save business details</button> }
            </EditForm>
        </section>
        <section class="settings-card">
            <h2>Project WIP posting</h2>
            <p>Accounts used when a reviewed project revenue-recognition workpaper is manually posted.</p>
            <EditForm Model="wipModel" OnValidSubmit="SaveWipAccounts" FormName="project-wip-account-settings">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="mb-3"><label class="form-label">Contract asset</label><InputSelect class="form-select" @bind-Value="wipModel.ContractAssetAccountId" disabled="@(!canManage || wipAccountsLocked)"><option value="@Guid.Empty">Select an asset account</option>@foreach (var account in assetAccounts) { <option value="@account.Id">@account.Code &mdash; @account.Name</option> }</InputSelect><div class="form-text">Debited when earned revenue is ahead of billing.</div></div>
                <div class="mb-3"><label class="form-label">Contract liability</label><InputSelect class="form-select" @bind-Value="wipModel.ContractLiabilityAccountId" disabled="@(!canManage || wipAccountsLocked)"><option value="@Guid.Empty">Select a liability account</option>@foreach (var account in liabilityAccounts) { <option value="@account.Id">@account.Code &mdash; @account.Name</option> }</InputSelect><div class="form-text">Credited when billing is ahead of earned revenue.</div></div>
                <div class="mb-3"><label class="form-label">Revenue recognition</label><InputSelect class="form-select" @bind-Value="wipModel.RevenueRecognitionAccountId" disabled="@(!canManage || wipAccountsLocked)"><option value="@Guid.Empty">Select a revenue account</option>@foreach (var account in recognitionRevenueAccounts) { <option value="@account.Id">@account.Code &mdash; @account.Name</option> }</InputSelect><div class="form-text">Receives the revenue side of each WIP true-up.</div></div>
                @if (wipAccountsLocked) { <div class="compliance-note"><strong>Posting accounts locked</strong><span>These accounts cannot change after the first WIP journal.</span></div> }
                else if (canManage) { <button class="btn btn-primary">Save WIP accounts</button> }
            </EditForm>
        </section>
        <section class="settings-card"><h2>Island jurisdiction</h2><p>Controls currency, local dates, tax terminology and compliance rules.</p>
            <dl class="jurisdiction-list"><div><dt>Country</dt><dd>@jurisdiction.CountryName</dd></div><div><dt>Base currency</dt><dd>@access.Organisation.BaseCurrency</dd></div><div><dt>Time zone</dt><dd>@access.Organisation.TimeZoneId</dd></div><div><dt>Indirect tax</dt><dd>@access.Organisation.TaxLabel</dd></div><div><dt>Financial year end</dt><dd>@FinancialYearEnd</dd></div></dl>

            @if (access.Organisation.CountryCode.Equals("FJ", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info mt-3 mb-0">
                    <strong>Seven-year record retention is active.</strong>
                    Posted accounting records and supporting documents are protected through the end of the applicable financial year plus seven years. Document exports are recorded in the audit trail.
                </div>
            }
            @if (!jurisdiction.TaxPackEnabled) { <div class="compliance-note"><strong>Posting protection is active</strong><span>Transactions remain locked until this country’s tax rules have been independently verified and activated.</span></div> }
            @if (canChangeJurisdiction) { <label class="form-label mt-3">Change jurisdiction before posting begins</label><InputSelect class="form-select" @bind-Value="selectedCountry">@foreach (var item in IslandJurisdictions.All) { <option value="@item.CountryCode">@item.CountryName — @item.CurrencyCode</option> }</InputSelect><button class="btn btn-outline-primary mt-2" @onclick="ChangeJurisdiction">Apply jurisdiction</button> }
            else if (canManage) { <small class="locked-note">Jurisdiction is locked because accounting transactions already exist.</small> }
        </section>
        <section class="settings-card">
            <h2>Transaction currencies</h2>
            <p>Enable currencies used on bills and maintain dated rates into @access.Organisation.BaseCurrency.</p>
            <div class="table-responsive mb-3">
                <table class="table mb-0">
                    <thead><tr><th>Currency</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var currency in currencies)
                        {
                            <tr>
                                <td><strong>@currency.Code</strong> - @currency.Name @(currency.IsBaseCurrency ? "(base)" : "")</td>
                                <td>@(currency.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-end">
                                    @if (canManage && !currency.IsBaseCurrency)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleCurrency(currency)">@(currency.IsActive ? "Disable" : "Enable")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (canManage)
            {
                @if (string.Equals(access.Organisation.BaseCurrency, "FJD", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <button type="button" class="btn btn-outline-primary" @onclick="RefreshOfficialRates" disabled="@refreshingRates">
                            @(refreshingRates ? "Updating rates..." : "Update official rates")
                        </button>
                        <span class="form-text">Imports the latest indicative USD, AUD and NZD rates published by the Reserve Bank of Fiji. A bank or manual rate for the same date remains in control.</span>
                    </div>
                }
                <EditForm Model="rateModel" OnValidSubmit="SaveRate" FormName="transaction-exchange-rate">
                    <DataAnnotationsValidator />
                    <div class="row align-items-end">
                        <div class="col-md-4 mb-3"><label class="form-label">Foreign currency</label><InputSelect class="form-select" @bind-Value="rateModel.Currency">@foreach (var currency in currencies.Where(x => x.IsActive && !x.IsBaseCurrency)) { <option value="@currency.Code">@currency.Code</option> }</InputSelect></div>
                        <div class="col-md-4 mb-3"><label class="form-label">Effective date</label><InputDate class="form-control" @bind-Value="rateModel.EffectiveDate" /></div>
                        <div class="col-md-4 mb-3"><label class="form-label">Rate to @access.Organisation.BaseCurrency</label><InputNumber class="form-control" @bind-Value="rateModel.Rate" step="0.00000001" /><div class="form-text">1 @rateModel.Currency equals this amount in @access.Organisation.BaseCurrency.</div></div>
                    </div>
                    <button class="btn btn-primary mb-4">Save exchange rate</button>
                </EditForm>
                <details>
                    <summary><strong>Add another currency</strong></summary>
                    <EditForm Model="currencyModel" OnValidSubmit="AddCurrency" FormName="add-transaction-currency" class="mt-3">
                        <DataAnnotationsValidator />
                        <div class="row align-items-end"><div class="col-md-4 mb-3"><label class="form-label">Three-letter code</label><InputText class="form-control text-uppercase" @bind-Value="currencyModel.Code" /></div><div class="col-md-5 mb-3"><label class="form-label">Currency name</label><InputText class="form-control" @bind-Value="currencyModel.Name" /></div><div class="col-md-3 mb-3"><button class="btn btn-outline-primary">Add currency</button></div></div>
                    </EditForm>
                </details>
            }
        </section>
        <section class="settings-card">
            <h2>Company branches</h2>
            <p>
                @groupName · @access.Organisation.LegalName. Branches represent
                operating locations within this legal entity.
            </p>
            @if (canManage)
            {
                <EditForm Model="branchModel"
                          OnValidSubmit="CreateBranch"
                          FormName="add-enterprise-branch">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Code</label>
                            <InputText class="form-control"
                                       @bind-Value="branchModel.Code" />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Branch name</label>
                            <InputText class="form-control"
                                       @bind-Value="branchModel.Name" />
                        </div>
                    </div>
                    <button class="btn btn-primary">Add branch</button>
                </EditForm>
            }
            <div class="table-responsive mt-4">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Branch</th>
                            <th>Divisions</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in branches)
                        {
                            <tr>
                                <td><strong>@branch.Code</strong></td>
                                <td>
                                    @branch.Name
                                    @if (branch.IsDefault)
                                    {
                                        <span class="badge text-bg-light ms-1">Default</span>
                                    }
                                </td>
                                <td>@branch.Divisions.Count</td>
                                <td>@(branch.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-end">
                                    @if (canManage && !branch.IsDefault)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ToggleBranch(branch)">
                                            @(branch.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="settings-card">
            <h2>Divisions</h2>
            <p>
                Divisions are business units within a branch for future profit-centre
                reporting and operational accountability.
            </p>
            @if (canManage)
            {
                <EditForm Model="divisionModel"
                          OnValidSubmit="CreateDivision"
                          FormName="add-enterprise-division">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Branch</label>
                        <InputSelect class="form-select"
                                     @bind-Value="divisionModel.BranchId">
                            @foreach (var branch in branches.Where(x => x.IsActive))
                            {
                                <option value="@branch.Id">@branch.Code · @branch.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Code</label>
                            <InputText class="form-control"
                                       @bind-Value="divisionModel.Code" />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Division name</label>
                            <InputText class="form-control"
                                       @bind-Value="divisionModel.Name" />
                        </div>
                    </div>
                    <button class="btn btn-primary">Add division</button>
                </EditForm>
            }

            @foreach (var branch in branches)
            {
                <h3 class="h6 mt-4 mb-2">
                    @branch.Name
                    @if (!branch.IsActive)
                    {
                        <span class="badge text-bg-secondary ms-1">Inactive branch</span>
                    }
                </h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Division</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var division in branch.Divisions.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Code))
                            {
                                <tr>
                                    <td><strong>@division.Code</strong></td>
                                    <td>
                                        @division.Name
                                        @if (division.IsDefault)
                                        {
                                            <span class="badge text-bg-light ms-1">Default</span>
                                        }
                                    </td>
                                    <td>@(division.IsActive ? "Active" : "Inactive")</td>
                                    <td class="text-end">
                                        @if (canManage && !division.IsDefault)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => ToggleDivision(division)">
                                                @(division.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private AccessibleOrganisation? access; private EnterpriseGroupDetails? groupDetails; private OrganisationBranding? branding; private bool canManage, canManageGroup, canChangeJurisdiction, wipAccountsLocked, uploadingLogo, refreshingRates; private int logoInputKey; private SettingsModel model = new(); private WipAccountsModel wipModel = new(); private GroupModel groupModel = new(); private CompanyModel companyModel = new(); private BranchModel branchModel = new(); private DivisionModel divisionModel = new(); private CurrencyModel currencyModel = new(); private RateModel rateModel = new(); private IReadOnlyList<CurrencyOption> currencies = []; private List<Branch> branches = []; private List<LedgerAccount> assetAccounts = []; private List<LedgerAccount> liabilityAccounts = []; private List<LedgerAccount> recognitionRevenueAccounts = []; private HashSet<Guid> accessibleCompanyIds = []; private IslandJurisdiction jurisdiction = IslandJurisdictions.All[0]; private string groupName = "Organisation group"; private string selectedCountry = "FJ"; private string userId = ""; private string? status; private string statusClass = "alert-success";
    private IReadOnlyList<Organisation> GroupCompanies => groupDetails?.Companies ?? (access is null ? [] : [access.Organisation]);
    private string FinancialYearEnd => new DateOnly(2000, access!.Organisation.FinancialYearEndMonth, access.Organisation.FinancialYearEndDay).ToString("dd MMMM");
    private string? LogoDataUrl => branding is null ? null : $"data:{branding.LogoContentType};base64,{Convert.ToBase64String(branding.LogoContent)}";
    private string CompanyInitials => string.Concat(model.LegalName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is null) return; canManage = await TenantAccess.CanManageTeamAsync(userId, OrganisationId); canChangeJurisdiction = canManage && !await Db.PostedJournals.AnyAsync(x => x.OrganisationId == OrganisationId); jurisdiction = IslandJurisdictions.Get(access.Organisation.CountryCode); selectedCountry = jurisdiction.CountryCode; model = ModelFrom(access.Organisation); branding = await BrandingService.GetAsync(userId, OrganisationId); await LoadWipSettings(); await LoadHierarchy(); await LoadCurrencies(); }
    private async Task UploadLogo(InputFileChangeEventArgs args)
    {
        if (!canManage) return;
        uploadingLogo = true;
        try
        {
            var file = args.File;
            await using var input = file.OpenReadStream(OrganisationBrandingService.MaximumLogoBytes);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);
            branding = await BrandingService.SaveAsync(
                userId,
                new OrganisationLogoUploadRequest(
                    OrganisationId,
                    file.Name,
                    file.ContentType,
                    output.ToArray()));
            logoInputKey++;
            statusClass = "alert-success";
            status = "Company logo saved.";
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = $"Company logo was not saved: {ex.Message}";
        }
        finally
        {
            uploadingLogo = false;
        }
    }
    private async Task RemoveLogo()
    {
        if (!canManage) return;
        try
        {
            await BrandingService.DeleteAsync(userId, OrganisationId);
            branding = null;
            logoInputKey++;
            statusClass = "alert-success";
            status = "Company logo removed.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = $"Company logo was not removed: {ex.Message}";
        }
    }
    private async Task Save()
    {
        if (!canManage || access is null) return;
        try
        {
            var stored = await SettingsService.UpdateAsync(
                userId,
                new UpdateOrganisationSettingsRequest(
                    OrganisationId,
                    model.LegalName,
                    model.TradingName,
                    model.Tin,
                    model.ConversionDate,
                    model.DefaultSalesInvoicePaymentTermType,
                    model.DefaultSalesInvoiceDueDays,
                    model.DefaultSupplierBillPaymentTermType,
                    model.DefaultSupplierBillDueDays,
                    model.RequireSupplierPaymentApproval,
                    model.BusinessAddress,
                    model.IsVatRegistered,
                    model.VatRegistrationDate));
            model = ModelFrom(stored);
            access = access with { Organisation = stored };
            statusClass = "alert-success";
            status = "Business details saved and verified.";
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Business details were not saved: {ex.Message}";
        }
    }
    private static string CountryName(string countryCode) =>
        IslandJurisdictions.Get(countryCode).CountryName;

    private async Task LoadWipSettings()
    {
        var accounts = await Db.LedgerAccounts.AsNoTracking()
            .Where(x => x.OrganisationId == OrganisationId && x.IsActive)
            .OrderBy(x => x.Code).ToListAsync();
        assetAccounts = accounts.Where(x => x.Type == AccountType.Asset && !x.IsBankAccount).ToList();
        liabilityAccounts = accounts.Where(x => x.Type == AccountType.Liability).ToList();
        recognitionRevenueAccounts = accounts.Where(x => x.Type == AccountType.Revenue).ToList();
        wipAccountsLocked = await Db.ProjectWipPostings.AsNoTracking()
            .AnyAsync(x => x.OrganisationId == OrganisationId);
        wipModel = new WipAccountsModel
        {
            ContractAssetAccountId = access!.Organisation.ProjectContractAssetAccountId ?? Guid.Empty,
            ContractLiabilityAccountId = access.Organisation.ProjectContractLiabilityAccountId ?? Guid.Empty,
            RevenueRecognitionAccountId = access.Organisation.ProjectRevenueRecognitionAccountId ?? Guid.Empty
        };
    }

    private async Task SaveWipAccounts()
    {
        if (!canManage || access is null) return;
        try
        {
            if (wipModel.ContractAssetAccountId == Guid.Empty ||
                wipModel.ContractLiabilityAccountId == Guid.Empty ||
                wipModel.RevenueRecognitionAccountId == Guid.Empty)
            {
                throw new InvalidOperationException("Select all three project WIP accounts.");
            }
            var organisation = await SettingsService.UpdateProjectWipAccountsAsync(
                userId,
                new UpdateProjectWipAccountsRequest(
                    OrganisationId,
                    wipModel.ContractAssetAccountId,
                    wipModel.ContractLiabilityAccountId,
                    wipModel.RevenueRecognitionAccountId));
            access = access with { Organisation = organisation };
            statusClass = "alert-success";
            status = "Project WIP posting accounts saved.";
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = $"Project WIP accounts were not saved: {ex.Message}";
        }
    }
    private async Task ChangeJurisdiction() { if (!canChangeJurisdiction || access is null) return; var organisation = await SettingsService.ChangeJurisdictionAsync(userId, OrganisationId, selectedCountry); access = access with { Organisation = organisation }; jurisdiction = IslandJurisdictions.Get(organisation.CountryCode); status = $"Jurisdiction changed to {jurisdiction.CountryName}."; }
    private async Task LoadHierarchy()
    {
        branches =
            await EnterpriseStructures.ListBranchesAsync(
                OrganisationId);

        groupDetails =
            await EnterpriseStructures.GetGroupAsync(
                userId,
                OrganisationId);
        accessibleCompanyIds =
            (await TenantAccess.ListAsync(userId))
                .Select(x => x.Organisation.Id)
                .ToHashSet();
        groupName = groupDetails?.Name ??
            (access!.Organisation.OrganisationGroupId is Guid groupId
                ? await Db.OrganisationGroups
                    .AsNoTracking()
                    .Where(x => x.Id == groupId)
                    .Select(x => x.Name)
                    .SingleAsync()
                : "Organisation group");
        canManageGroup =
            groupDetails?.Role is OrganisationGroupRole.Owner or
                OrganisationGroupRole.Administrator;
        groupModel.Name = groupName;

        if (divisionModel.BranchId == Guid.Empty ||
            branches.All(x =>
                x.Id != divisionModel.BranchId ||
                !x.IsActive))
        {
            divisionModel.BranchId =
                branches.FirstOrDefault(x => x.IsActive)?.Id ??
                Guid.Empty;
        }
    }

    private async Task SaveGroup()
    {
        if (!canManageGroup) return;

        await RunHierarchyChange(
            async () =>
            {
                await EnterpriseStructures.UpdateGroupNameAsync(
                    userId,
                    OrganisationId,
                    groupModel.Name);
                status = "Organisation group name saved.";
            });
    }

    private async Task CreateCompany()
    {
        if (!canManageGroup) return;

        await RunHierarchyChange(
            async () =>
            {
                var company =
                    await EnterpriseStructures.AddCompanyAsync(
                        userId,
                        new CreateGroupCompanyRequest(
                            OrganisationId,
                            companyModel.LegalName,
                            companyModel.TradingName,
                            companyModel.Tin,
                            companyModel.CountryCode,
                            companyModel.Kind));
                companyModel = new();
                status = $"{company.LegalName} added to {groupName}.";
            });
    }

    private async Task CreateBranch()
    {
        if (!canManage) return;

        await RunHierarchyChange(
            async () =>
            {
                var branch =
                    await EnterpriseStructures.AddBranchAsync(
                        userId,
                        OrganisationId,
                        branchModel.Code,
                        branchModel.Name);

                branchModel = new();
                divisionModel.BranchId = branch.Id;
                status = $"{branch.Name} added with a General division.";
            });
    }

    private async Task CreateDivision()
    {
        if (!canManage) return;

        await RunHierarchyChange(
            async () =>
            {
                var division =
                    await EnterpriseStructures.AddDivisionAsync(
                        userId,
                        OrganisationId,
                        divisionModel.BranchId,
                        divisionModel.Code,
                        divisionModel.Name);

                divisionModel =
                    new DivisionModel
                    {
                        BranchId = division.BranchId
                    };

                status = $"{division.Name} division added.";
            });
    }

    private Task ToggleBranch(Branch branch) =>
        RunHierarchyChange(
            async () =>
            {
                await EnterpriseStructures.ToggleBranchAsync(
                    userId,
                    OrganisationId,
                    branch.Id);

                status =
                    $"{branch.Name} is now " +
                    $"{(branch.IsActive ? "inactive" : "active")}.";
            });

    private Task ToggleDivision(Division division) =>
        RunHierarchyChange(
            async () =>
            {
                await EnterpriseStructures.ToggleDivisionAsync(
                    userId,
                    OrganisationId,
                    division.Id);

                status =
                    $"{division.Name} is now " +
                    $"{(division.IsActive ? "inactive" : "active")}.";
            });

    private async Task RunHierarchyChange(Func<Task> change)
    {
        if (!canManage) return;

        try
        {
            await change();
            statusClass = "alert-success";
            await LoadHierarchy();
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task LoadCurrencies()
    {
        currencies = await CurrencyService.ListAsync(userId, OrganisationId);
        if (string.IsNullOrWhiteSpace(rateModel.Currency) ||
            currencies.All(x => x.Code != rateModel.Currency || !x.IsActive || x.IsBaseCurrency))
        {
            rateModel.Currency = currencies.FirstOrDefault(x => x.IsActive && !x.IsBaseCurrency)?.Code ?? "USD";
        }
    }

    private async Task AddCurrency()
    {
        try
        {
            await CurrencyService.AddAsync(userId, OrganisationId, currencyModel.Code, currencyModel.Name);
            currencyModel = new();
            await LoadCurrencies();
            statusClass = "alert-success";
            status = "Currency added.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task ToggleCurrency(CurrencyOption currency)
    {
        try
        {
            await CurrencyService.SetActiveAsync(userId, OrganisationId, currency.Code, !currency.IsActive);
            await LoadCurrencies();
            statusClass = "alert-success";
            status = $"{currency.Code} {(currency.IsActive ? "disabled" : "enabled")}.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task SaveRate()
    {
        try
        {
            await CurrencyService.SaveRateAsync(userId, OrganisationId, rateModel.Currency, rateModel.EffectiveDate, rateModel.Rate);
            statusClass = "alert-success";
            status = $"{rateModel.Currency} exchange rate saved for {rateModel.EffectiveDate:dd MMM yyyy}.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }

    private async Task RefreshOfficialRates()
    {
        refreshingRates = true;
        try
        {
            var effectiveDate = await CurrencyService.RefreshOfficialRatesAsync(userId, OrganisationId);
            statusClass = "alert-success";
            status = $"Official USD, AUD and NZD reference rates updated for {effectiveDate:dd MMM yyyy}.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
