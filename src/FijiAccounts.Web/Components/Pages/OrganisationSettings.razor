    private static SettingsModel ModelFrom(Organisation organisation) => new() { LegalName = organisation.LegalName, TradingName = organisation.TradingName, Tin = organisation.Tin, BusinessAddress = organisation.BusinessAddress, IsVatRegistered = organisation.IsVatRegistered, VatRegistrationDate = organisation.VatRegistrationDate, ConversionDate = organisation.ConversionDate, DefaultSalesInvoicePaymentTermType = organisation.DefaultSalesInvoicePaymentTermType, DefaultSalesInvoiceDueDays = organisation.DefaultSalesInvoiceDueDays, DefaultSupplierBillPaymentTermType = organisation.DefaultSupplierBillPaymentTermType, DefaultSupplierBillDueDays = organisation.DefaultSupplierBillDueDays, RequireSupplierPaymentApproval = organisation.RequireSupplierPaymentApproval };
    private sealed class SettingsModel { [Required, StringLength(160)] public string LegalName { get; set; } = ""; [StringLength(80)] public string? TradingName { get; set; } [StringLength(32)] public string? Tin { get; set; } [StringLength(500)] public string? BusinessAddress { get; set; } public bool IsVatRegistered { get; set; } public DateOnly? VatRegistrationDate { get; set; } public DateOnly? ConversionDate { get; set; } public PaymentTermType DefaultSalesInvoicePaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSalesInvoiceDueDays { get; set; } = 30; public PaymentTermType DefaultSupplierBillPaymentTermType { get; set; } = PaymentTermType.DaysAfterDocumentDate; [Range(0, 365)] public int DefaultSupplierBillDueDays { get; set; } = 30; public bool RequireSupplierPaymentApproval { get; set; } }
    private sealed class WipAccountsModel { public Guid ContractAssetAccountId { get; set; } public Guid ContractLiabilityAccountId { get; set; } public Guid RevenueRecognitionAccountId { get; set; } }
    private sealed class GroupModel { [Required, StringLength(160)] public string Name { get; set; } = ""; }
    private sealed class CompanyModel { [Required, StringLength(160)] public string LegalName { get; set; } = ""; [StringLength(80)] public string? TradingName { get; set; } [StringLength(32)] public string? Tin { get; set; } [Required] public string CountryCode { get; set; } = "FJ"; public OrganisationKind Kind { get; set; } }
    private sealed class BranchModel { [Required, StringLength(20)] public string Code { get; set; } = ""; [Required, StringLength(120)] public string Name { get; set; } = ""; }
    private sealed class DivisionModel { [Required] public Guid BranchId { get; set; } [Required, StringLength(20)] public string Code { get; set; } = ""; [Required, StringLength(120)] public string Name { get; set; } = ""; }
    private sealed class CurrencyModel { [Required, StringLength(3, MinimumLength = 3)] public string Code { get; set; } = ""; [Required, StringLength(80)] public string Name { get; set; } = ""; }
    private sealed class RateModel { [Required, StringLength(3, MinimumLength = 3)] public string Currency { get; set; } = "USD"; public DateOnly EffectiveDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Range(typeof(decimal), "0.00000001", "9999999999")] public decimal Rate { get; set; } }
