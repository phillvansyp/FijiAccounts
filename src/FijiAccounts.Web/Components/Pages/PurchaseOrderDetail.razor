@page "/o/{OrganisationId:guid}/purchase-orders/{PurchaseOrderId:guid}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services

@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject PurchaseOrderService PurchaseOrderService
@inject PurchaseOrderMatchService PurchaseOrderMatchService
@inject SupplierBillDraftService BillDraftService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(order?.PurchaseOrderNumber ?? "Purchase order") Ãƒâ€šÃ‚Â· Account Island</PageTitle>

@if (order is null || access is null)
{
    <div class="alert alert-danger">
        Purchase order not found or access denied.
    </div>
}
else
{
    <div class="bill-page">

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @messageClass">@message</div>
        }

        <div class="bill-heading no-print">

            <div>

                <a class="back-link"
                   href="/o/@OrganisationId/purchase-orders">
                    ÃƒÂ¢Ã¢â‚¬Â Ã‚Â Purchase orders
                </a>

                <span class="eyebrow">
                    Purchases
                </span>

                <div class="title-row">

                    <h1>
                        @order.PurchaseOrderNumber
                    </h1>

                    <span class="bill-status">
                        @order.Status
                    </span>

                    @if (order.Status == PurchaseOrderStatus.Approved)
{
    <button type="button"
            class="btn btn-primary"
            @onclick="MarkPurchaseOrderSent">
        Mark as sent
    </button>
}

@if (order.Status == PurchaseOrderStatus.Received)
{
    <button type="button"
            class="btn btn-primary"
            @onclick="CreateSupplierBillDraft">
        Create supplier bill draft
    </button>
}

@if (order.Status != PurchaseOrderStatus.Closed &&
    order.Status != PurchaseOrderStatus.Cancelled)
{
    <button type="button"
            class="btn btn-outline-danger"
            @onclick="CancelPurchaseOrder">
        Cancel
    </button>
}

                </div>

            </div>

            @if (order.Status == PurchaseOrderStatus.Draft)
            {
                <div>
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="ApprovePurchaseOrder">
                        Approve purchase order
                    </button>
                </div>
            }

        </div>


        <section class="setup-card">

            <h2>
                Supplier details
            </h2>

            <p>
                <strong>Supplier:</strong>
                @order.Supplier.Name
            </p>

            <p>
                <strong>Order date:</strong>
                @order.OrderDate
            </p>

            @if (order.ExpectedDate is not null)
            {
                <p>
                    <strong>Expected:</strong>
                    @order.ExpectedDate
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(order.Notes))
            {
                <p>
                    <strong>Notes:</strong>
                    @order.Notes
                </p>
            }

        </section>

        <section class="setup-card">
            <div class="card-heading">
                <div>
                    <h2>Three-way matching</h2>
                    <p class="mb-0">Compares this order, received quantities and the linked supplier invoice before posting.</p>
                </div>
                <span class="bill-status">@MatchStatusLabel</span>
            </div>

            @if (organisation is not null)
            {
                <p>
                    Quantity tolerance: <strong>@organisation.PurchaseQuantityTolerancePercent.ToString("N2")%</strong>
                    &middot; Price tolerance: <strong>@organisation.PurchasePriceTolerancePercent.ToString("N2")%</strong>
                    &middot; Net total tolerance: <strong>$@organisation.PurchaseTotalToleranceAmount.ToString("N2")</strong>
                </p>
            }

            @if (order.MatchStatus != PurchaseMatchStatus.NotEvaluated)
            {
                <p><strong>Evidence:</strong> @order.MatchSummary</p>
                <p>
                    Quantity variance: <strong>@order.MatchQuantityVariance.ToString("N4")</strong>
                    &middot; Price variance: <strong>$@order.MatchPriceVariance.ToString("N2")</strong>
                    &middot; Net total variance: <strong>$@order.MatchTotalVariance.ToString("N2")</strong>
                </p>
                @if (order.MatchApprovedAt is not null)
                {
                    <p><strong>Owner approval:</strong> @order.MatchApprovalReason</p>
                }
            }

            @if (currentRole is OrganisationRole.Owner or OrganisationRole.Administrator && organisation is not null)
            {
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3"><label class="form-label">Quantity tolerance %</label><input class="form-control" type="number" min="0" max="100" step="0.01" @bind="quantityTolerance" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Price tolerance %</label><input class="form-control" type="number" min="0" max="100" step="0.01" @bind="priceTolerance" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Total tolerance</label><input class="form-control" type="number" min="0" step="0.01" @bind="totalTolerance" /></div>
                    <div class="col-md-3 mb-3"><button class="btn btn-outline-primary" type="button" disabled="@savingMatch" @onclick="SaveTolerances">Save tolerances</button></div>
                </div>
            }

            @if (order.MatchStatus == PurchaseMatchStatus.Exception && currentRole == OrganisationRole.Owner)
            {
                <div class="row align-items-end">
                    <div class="col-md-9 mb-3"><label class="form-label">Owner exception reason</label><input class="form-control" maxlength="500" @bind="approvalReason" /></div>
                    <div class="col-md-3 mb-3"><button class="btn btn-warning" type="button" disabled="@savingMatch" @onclick="ApproveMatchException">Approve exception</button></div>
                </div>
            }
        </section>


        <section class="setup-card">

            <h2>
                Order lines
            </h2>

            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var line in order.Lines)
                        {
                            <tr>

                                <td>
                                    @line.Description
                                </td>

                                <td>
                                    @line.Quantity
                                </td>

                                <td class="text-end">
                                    $@line.UnitPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    $@line.GrossAmount.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

        @if (order.Status is PurchaseOrderStatus.Sent or PurchaseOrderStatus.PartiallyReceived)
{
    <section class="setup-card">

        <h2>
            Receive items
        </h2>

        <p class="text-muted">
            Enter the quantities received from the supplier.
        </p>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Receive now</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var line in order.Lines)
                    {
                        <tr>

                            <td>
                                @line.Description
                            </td>

                            <td>
                                @line.Quantity
                            </td>

                            <td>
                                @line.QuantityReceived
                            </td>

                            <td>
                                <input type="number"
       class="form-control"
       value="@GetReceiveQuantity(line.Id)"
       @onchange="@(e => SetReceiveQuantity(line.Id, e.Value?.ToString()))" />
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="ReceivePurchaseOrder">
            Receive items
        </button>

    </section>
}

        <section class="setup-card">

            <h2>
                Totals
            </h2>

            <p>
                Subtotal:
                <strong>
                    $@order.Subtotal.ToString("N2")
                </strong>
            </p>

            <p>
                VAT:
                <strong>
                    $@order.VatTotal.ToString("N2")
                </strong>
            </p>

            <p>
                Total:
                <strong>
                    $@order.Total.ToString("N2")
                </strong>
            </p>

        </section>

    </div>
}

@code {

    [Parameter]
    public Guid OrganisationId { get; set; }

    [Parameter]
    public Guid PurchaseOrderId { get; set; }

    private AccessibleOrganisation? access;

    private PurchaseOrder? order;

    private Organisation? organisation;

    private OrganisationRole? currentRole;

    private decimal quantityTolerance;

    private decimal priceTolerance;

    private decimal totalTolerance;

    private string approvalReason = "";

    private string message = "";

    private string messageClass = "alert-success";

    private bool savingMatch;

    private string MatchStatusLabel => order?.MatchStatus switch
    {
        PurchaseMatchStatus.Matched => "Matched",
        PurchaseMatchStatus.Exception => "Exception",
        PurchaseMatchStatus.ExceptionApproved => "Exception approved",
        _ => "Not evaluated"
    };

    private Dictionary<Guid, decimal> receiveQuantities = [];

    private async Task ApprovePurchaseOrder()
{
    if (access is null)
    {
        return;
    }

    var state =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var userId =
        UserManager.GetUserId(state.User)!;

    await PurchaseOrderService.ApproveAsync(
        userId,
        OrganisationId,
        PurchaseOrderId);

    order =
        await Db.PurchaseOrders
            .AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Lines)
            .SingleAsync(
                x =>
                    x.Id == PurchaseOrderId &&
                    x.OrganisationId == OrganisationId);
}

    private async Task MarkPurchaseOrderSent()
{
    if (access is null)
    {
        return;
    }

    var state =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var userId =
        UserManager.GetUserId(state.User)!;

    await PurchaseOrderService.MarkSentAsync(
        userId,
        OrganisationId,
        PurchaseOrderId);

    await ReloadOrder();
}

private async Task CancelPurchaseOrder()
{
    if (access is null)
    {
        return;
    }

    var state =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var userId =
        UserManager.GetUserId(state.User)!;

    await PurchaseOrderService.CancelAsync(
        userId,
        OrganisationId,
        PurchaseOrderId);

    await ReloadOrder();
}

private async Task CreateSupplierBillDraft()
{
    if (order is null || access is null)
    {
        return;
    }

    var state =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var userId =
        UserManager.GetUserId(state.User)!;

    var draft =
        await BillDraftService.CreateFromPurchaseOrderAsync(
            userId,
            OrganisationId,
            PurchaseOrderId);

    Navigation.NavigateTo(
        $"/o/{OrganisationId}/purchases?draft={draft.Id}#draft-editor");
}

private async Task ReloadOrder()
{
    order =
        await Db.PurchaseOrders
            .AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Lines)
            .SingleAsync(
                x =>
                    x.Id == PurchaseOrderId &&
                    x.OrganisationId == OrganisationId);
}

private async Task SaveTolerances()
{
    await RunMatchAction(async () =>
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(state.User)!;
        await PurchaseOrderMatchService.ConfigureTolerancesAsync(
            userId,
            new PurchaseMatchToleranceRequest(
                OrganisationId,
                quantityTolerance,
                priceTolerance,
                totalTolerance));
        await LoadMatchContext(userId);
        message = "Purchase matching tolerances saved.";
    });
}

private async Task ApproveMatchException()
{
    await RunMatchAction(async () =>
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(state.User)!;
        await PurchaseOrderMatchService.ApproveExceptionAsync(
            userId,
            OrganisationId,
            PurchaseOrderId,
            approvalReason);
        approvalReason = "";
        await ReloadOrder();
        message = "Purchase match exception approved for this invoice version.";
    });
}

private async Task RunMatchAction(Func<Task> action)
{
    savingMatch = true;
    message = "";
    try
    {
        await action();
        messageClass = "alert-success";
    }
    catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
    {
        messageClass = "alert-danger";
        message = ex.Message;
    }
    finally
    {
        savingMatch = false;
    }
}

private async Task LoadMatchContext(string userId)
{
    organisation = await Db.Organisations.AsNoTracking()
        .SingleAsync(x => x.Id == OrganisationId);
    currentRole = await Db.OrganisationMemberships.AsNoTracking()
        .Where(x => x.UserId == userId && x.OrganisationId == OrganisationId)
        .Select(x => (OrganisationRole?)x.Role)
        .SingleOrDefaultAsync();
    quantityTolerance = organisation.PurchaseQuantityTolerancePercent;
    priceTolerance = organisation.PurchasePriceTolerancePercent;
    totalTolerance = organisation.PurchaseTotalToleranceAmount;
}

    private decimal GetReceiveQuantity(Guid lineId)
{
    return receiveQuantities.TryGetValue(
        lineId,
        out var quantity)
        ? quantity
        : 0m;
}

private void SetReceiveQuantity(
    Guid lineId,
    string? value)
{
    if (decimal.TryParse(value, out var quantity))
    {
        receiveQuantities[lineId] = quantity;
    }
    else
    {
        receiveQuantities[lineId] = 0m;
    }
}

    private async Task ReceivePurchaseOrder()
{
    if (access is null)
    {
        return;
    }

    var state =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var userId =
        UserManager.GetUserId(state.User)!;

    await PurchaseOrderService.ReceiveAsync(
        userId,
        OrganisationId,
        PurchaseOrderId,
        receiveQuantities);

    order =
        await Db.PurchaseOrders
            .AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Lines)
            .SingleAsync(
                x =>
                    x.Id == PurchaseOrderId &&
                    x.OrganisationId == OrganisationId);
}

        protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        await LoadMatchContext(userId);

        order =
            await Db.PurchaseOrders
                .AsNoTracking()
                .Include(x => x.Supplier)
                .Include(x => x.Lines)
                .SingleOrDefaultAsync(
                    x =>
                        x.Id == PurchaseOrderId &&
                        x.OrganisationId == OrganisationId);

        if (order is not null)
        {
            receiveQuantities =
                order.Lines.ToDictionary(
                    x => x.Id,
                    x => 0m);
        }
        }
}
