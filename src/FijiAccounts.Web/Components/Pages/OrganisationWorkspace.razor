    private async Task SetTemporaryPassword()
    {
        temporaryPasswordMessage = null;
        settingTemporaryPassword = true;
        try
        {
            var actor = await Db.OrganisationMemberships.AsNoTracking().SingleAsync(x => x.OrganisationId == OrganisationId && x.UserId == userId);
            var target = await Db.OrganisationMemberships.AsNoTracking().Include(x => x.User).SingleOrDefaultAsync(x => x.OrganisationId == OrganisationId && x.UserId == temporaryPassword.UserId)
                ?? throw new InvalidOperationException("Select a current team member.");
            if (!OrganisationCredentialPolicy.CanSetTemporaryPassword(userId, actor.Role, target.UserId, target.Role))
                throw new UnauthorizedAccessException("You cannot set a temporary password for this member.");

            var targetUser = await UserManager.FindByIdAsync(target.UserId)
                ?? throw new InvalidOperationException("The selected account was not found.");
            AccountLockoutPolicy.ClearFailureState(targetUser);
            var token = await UserManager.GeneratePasswordResetTokenAsync(targetUser);
            var result = await UserManager.ResetPasswordAsync(targetUser, token, temporaryPassword.Password);
            if (!result.Succeeded)
                throw new InvalidOperationException(string.Join(" ", result.Errors.Select(x => x.Description)));

            Db.AuditEvents.Add(new AuditEvent
            {
                OrganisationId = OrganisationId,
                UserId = userId,
                EventType = "MemberTemporaryPasswordSet",
                EntityType = nameof(ApplicationUser),
                EntityId = target.UserId,
                JsonData = JsonSerializer.Serialize(new { TargetUserId = target.UserId, target.User.Email, Role = target.Role.ToString() })
            });
            await Db.SaveChangesAsync();
            temporaryPassword = new() { UserId = target.UserId };
            temporaryPasswordMessageClass = "alert-success";
            temporaryPasswordMessage = $"A temporary password was set for {target.User.Email}.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            temporaryPasswordMessageClass = "alert-danger";
            temporaryPasswordMessage = ex.Message;
        }
        finally
        {
            settingTemporaryPassword = false;
        }
    }

    private static string DimensionAccessLabel(OrganisationMembership member) =>
        member.Role is OrganisationRole.Owner or OrganisationRole.Administrator || member.DimensionAccessMode == DimensionAccessMode.All
            ? "All dimensions"
            : "Restricted";

