    private static string PermissionSummary(OrganisationPermissionProfile profile)
    {
        var permissions = new List<string>();
        if (profile.CanManageTeam) permissions.Add("Team");
        if (profile.CanPostAccounting) permissions.Add("Accounting");
        if (profile.CanManageContacts) permissions.Add("Contacts");
        if (profile.CanApprovePurchases) permissions.Add("Purchase approvals");
        return permissions.Count == 0 ? "View only" : string.Join(", ", permissions);
    }

    private Task SetFullDimensionAccess() => SetDimensionAccessMode(DimensionAccessMode.All);
    private Task SetRestrictedDimensionAccess() => SetDimensionAccessMode(DimensionAccessMode.Restricted);

    private async Task SetDimensionAccessMode(DimensionAccessMode mode)
    {
        if (string.IsNullOrWhiteSpace(selectedMemberUserId)) return;
        try
        {
            await TenantAccess.SetDimensionAccessModeAsync(userId, OrganisationId, selectedMemberUserId, mode);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = mode == DimensionAccessMode.All ? "Full dimension access restored." : "Access is now restricted to the grants below.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task AddDimensionGrant()
    {
        var parts = selectedDimensionGrant.Split('|');
        if (parts.Length != 2 || !Guid.TryParse(parts[0], out var branchId)) return;
        var divisionId = Guid.TryParse(parts[1], out var selectedDivisionId) ? selectedDivisionId : (Guid?)null;
        try
        {
            await TenantAccess.AddDimensionAccessGrantAsync(userId, OrganisationId, selectedMemberUserId, branchId, divisionId);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = "Dimension access granted.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task RemoveDimensionGrant(Guid grantId)
    {
        try
        {
            await TenantAccess.RemoveDimensionAccessGrantAsync(userId, OrganisationId, grantId);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = "Dimension access removed.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task CreateInvitation()
    {
        invitationLink = null;
        invitationError = null;
        try
        {
            var result = await Invitations.IssueAsync(
                userId,
                OrganisationId,
                invite.Email,
                invite.Role);
            invitationLink = Navigation.ToAbsoluteUri($"invite/{result.Token}").ToString();
            if (InvitationEmailSender.IsConfigured &&
                !await DeliverInvitationEmailAsync(invite.Email, invite.Role, invitationLink))
            {
                invitationError = "The invitation was created, but its email could not be delivered. Use the invitation link below.";
            }
            invite = new();
            await LoadPendingInvitations();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            invitationError = ex.Message;
        }
    }

    private async Task LoadPendingInvitations()
    {
        pendingInvitations = canManageTeam
            ? (await Invitations.ListPendingAsync(userId, OrganisationId)).ToList()
            : [];
    }

    private async Task ReissueInvitation(PendingInvitationSummary invitation)
    {
        pendingInvitationActionId = invitation.Id;
        pendingInvitationMessage = null;
        pendingInvitationLink = null;
        try
        {
            var result = await Invitations.ReissueAsync(userId, OrganisationId, invitation.Id);
            pendingInvitationLink = Navigation.ToAbsoluteUri($"invite/{result.Token}").ToString();
            var delivered = await DeliverInvitationEmailAsync(
                result.Email,
                result.Role,
                pendingInvitationLink);
            pendingInvitationMessageClass = delivered ? "alert-success" : "alert-warning";
            pendingInvitationMessage = delivered
                ? $"A replacement invitation was sent to {result.Email}. The previous link is no longer valid."
                : InvitationEmailSender.IsConfigured
                    ? $"The replacement invitation for {result.Email} was created, but its email could not be delivered. Use the new link below."
                    : $"A replacement invitation for {result.Email} was created. Email delivery is not configured, so use the new link below.";
            pendingRevocationId = null;
            await LoadPendingInvitations();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            pendingInvitationMessageClass = "alert-danger";
            pendingInvitationMessage = ex.Message;
        }
        finally
        {
            pendingInvitationActionId = null;
        }
    }

    private void BeginInvitationRevocation(Guid invitationId) => pendingRevocationId = invitationId;
    private void CancelInvitationRevocation() => pendingRevocationId = null;

    private async Task RevokeInvitation(Guid invitationId)
    {
        pendingInvitationActionId = invitationId;
        pendingInvitationMessage = null;
        pendingInvitationLink = null;
        try
        {
            await Invitations.RevokeAsync(userId, OrganisationId, invitationId);
            pendingInvitationMessageClass = "alert-success";
            pendingInvitationMessage = "Invitation revoked. Its link can no longer be used.";
            pendingRevocationId = null;
            await LoadPendingInvitations();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            pendingInvitationMessageClass = "alert-danger";
            pendingInvitationMessage = ex.Message;
        }
        finally
        {
            pendingInvitationActionId = null;
        }
    }

    private async Task<bool> DeliverInvitationEmailAsync(
        string email,
        OrganisationRole role,
        string link)
    {
        if (!InvitationEmailSender.IsConfigured)
        {
            return false;
        }

        try
        {
            await InvitationEmailSender.SendAsync(
                email,
                access!.Organisation.LegalName,
                role,
                link);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to deliver organisation invitation {OrganisationId}",
                OrganisationId);
            return false;
        }
    }
    private static string Initials(string name) => string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])));
