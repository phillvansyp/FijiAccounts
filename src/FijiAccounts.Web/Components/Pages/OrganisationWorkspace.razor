                var outputVat = (await Db.SalesInvoices.Where(x => x.OrganisationId == OrganisationId && x.Status != InvoiceStatus.Voided).SumAsync(x => (decimal?)x.VatTotal) ?? 0) - (await Db.SalesCreditNotes.Where(x => x.OrganisationId == OrganisationId && x.Status == SalesCreditNoteStatus.Posted).SumAsync(x => (decimal?)x.VatTotal) ?? 0);
                var inputVat = (await Db.SupplierBills.Where(x => x.OrganisationId == OrganisationId && x.Status != BillStatus.Voided).SumAsync(x => (decimal?)x.VatTotal) ?? 0) - (await Db.SupplierCreditNotes.Where(x => x.OrganisationId == OrganisationId).SumAsync(x => (decimal?)x.VatTotal) ?? 0);
