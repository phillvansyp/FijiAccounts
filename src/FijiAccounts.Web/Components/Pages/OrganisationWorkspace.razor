@page "/o/{OrganisationId:guid}"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject CashflowForecastService CashflowForecastService
@inject FinancialRiskService FinancialRiskService
@inject CashRunwayService CashRunwayService
@inject OrganisationUpdateBroker Updates
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@(access?.Organisation.LegalName ?? "Organisation") · Account Island</PageTitle>
@if (loading) { <div class="dashboard-loading">Preparing your island...</div> }
else if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <section class="business-banner"><div class="business-identity"><span class="business-avatar">@Initials(access.Organisation.LegalName)</span><div><a href="organisations">All organisations</a><h1>@access.Organisation.LegalName</h1><p>@access.AccessLabel · @access.Organisation.BaseCurrency · @(access.IsClient ? "Accountant client" : "Direct access")</p></div></div><div class="banner-actions"><a href="help?from=o/@OrganisationId">Dashboard help</a><a class="primary-action" href="o/@OrganisationId/sales">＋ New invoice</a></div></section>

    <section class="dashboard-intro"><div><span class="eyebrow">Business overview</span><h2>Your finances, without the fog.</h2><p>Live balances and the work that needs attention, drawn directly from the ledger.</p></div><span class="as-at">As at @DateTime.Today.ToString("dd MMM yyyy")</span></section>
    <section class="kpi-grid">
        <a href="o/@OrganisationId/journals" class="kpi-card cash"><span>Cash position</span><strong>$@cashPosition.ToString("N2")</strong><small>Posted bank ledger balance</small><i>↗</i></a>
        <a href="o/@OrganisationId/sales" class="kpi-card"><span>Receivables</span><strong>$@receivables.ToString("N2")</strong><small>@overdueInvoices overdue invoice@(overdueInvoices == 1 ? "" : "s")</small><i>↗</i></a>
        <a href="o/@OrganisationId/purchases" class="kpi-card"><span>Payables</span><strong>$@payables.ToString("N2")</strong><small>@overdueBills overdue bill@(overdueBills == 1 ? "" : "s")</small><i>↗</i></a>
        <a id="tax-position" href="help?from=vat" class="kpi-card tax"><span>Net VAT position</span><strong>$@vatPosition.ToString("N2")</strong><small>@(vatPosition >= 0 ? "Collected less purchase VAT" : "Potential VAT credit")</small><i>↗</i></a>
    </section>

    <section class="dashboard-grid"><article class="work-card"><div class="card-heading"><div><span class="eyebrow">Work queue</span><h2>Needs attention</h2></div><span class="count-badge">@(overdueInvoices + overdueBills)</span></div>
        <a href="o/@OrganisationId/sales"><span class="task-icon sales">↗</span><span><strong>Overdue customer invoices</strong><small>Follow up money owed to the business</small></span><b>@overdueInvoices</b></a>
        <a href="o/@OrganisationId/purchases"><span class="task-icon purchases">↙</span><span><strong>Overdue supplier bills</strong><small>Review bills that have passed their due date</small></span><b>@overdueBills</b></a>
        <a href="o/@OrganisationId/notifications?category=financial">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>Financial alerts</strong>
                <small>Invoices and supplier bills needing attention</small>
            </span>
            <b>@financialAlertCount</b>
        </a>
        <a href="o/@OrganisationId/notifications?category=documents">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>Documents expiring</strong>
                <small>Documents requiring review</small>
            </span>
            <b>@documentAlertCount</b>
        </a>
        <a href="o/@OrganisationId/notifications?category=system">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>System alerts</strong>
                <small>System notifications</small>
            </span>
            <b>@systemAlertCount</b>
        </a>
        <a href="o/@OrganisationId/contacts"><span class="task-icon contacts">◎</span><span><strong>Business contacts</strong><small>Customers and suppliers in this organisation</small></span><b>@contactCount</b></a>
    </article>
<article class="quick-card"><span class="eyebrow">Shortcuts</span><h2>Keep work moving</h2><div class="shortcut-grid"><a href="o/@OrganisationId/sales"><b>＋</b><span>Sales invoice</span></a><a href="o/@OrganisationId/purchases"><b>＋</b><span>Supplier bill</span></a><a href="o/@OrganisationId/receipts"><b>✓</b><span>Customer receipt</span></a><a href="o/@OrganisationId/journals"><b>≡</b><span>Manual journal</span></a></div></article></section>

    @if (cashflowForecast is not null)
    {
        <section class="detail-card cashflow-card">
            <div class="card-heading">
                <div>
                    <span class="eyebrow">Cashflow</span>
                    <h2>Forecast timeline</h2>
                </div>
                <span class="@GetCashflowStatusClass()">@GetCashflowStatus()</span>
            </div>
            <p class="cashflow-description">
                Outstanding invoices and bills due from today through each forecast horizon.
            </p>
            <div class="table-responsive">
                <table class="cashflow-chart">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Money in</th>
                            <th>Money out</th>
                            <th>Projected movement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var period in GetCashflowPeriods())
                        {
                            <tr>
                                <th scope="row">@period.Label</th>
                                <td>
                                    <span>$@period.Summary.ExpectedReceipts.ToString("N2")</span>
                                    <i aria-hidden="true" class="cashflow-bar receipts" style="--bar-width: @GetCashflowBarWidth(period.Summary.ExpectedReceipts)%"></i>
                                </td>
                                <td>
                                    <span>$@period.Summary.ExpectedPayments.ToString("N2")</span>
                                    <i aria-hidden="true" class="cashflow-bar payments" style="--bar-width: @GetCashflowBarWidth(period.Summary.ExpectedPayments)%"></i>
                                </td>
                                <td>
                                    <span>@FormatCashflowAmount(period.Summary.NetMovement)</span>
                                    <i aria-hidden="true" class="cashflow-bar @(period.Summary.NetMovement >= 0 ? "movement-positive" : "movement-negative")"
                                       style="--bar-width: @GetCashflowBarWidth(period.Summary.NetMovement)%"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (cashflowForecast is not null && financialRisk is not null && cashRunway is not null)
    {
        <section class="detail-card intelligence-card">
            <div class="card-heading">
                <div>
                    <span class="eyebrow">Financial intelligence</span>
                    <h2>Collections, obligations and ageing risk</h2>
                </div>
                <span>Next 30 days</span>
            </div>
            <div class="runway-summary @GetCashRunwayClass()">
                <div>
                    <span>Cash runway</span>
                    <strong>@GetCashRunwayLabel()</strong>
                    <small>@GetCashRunwayDescription()</small>
                </div>
                <dl>
                    <div>
                        <dt>Cash now</dt>
                        <dd>@FormatCashflowAmount(cashRunway.OpeningCash)</dd>
                    </div>
                    <div>
                        <dt>30-day balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.ProjectedBalance30Days)</dd>
                    </div>
                    <div>
                        <dt>90-day balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.ProjectedBalance90Days)</dd>
                    </div>
                    <div>
                        <dt>Lowest balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.LowestProjectedBalance)</dd>
                    </div>
                </dl>
            </div>
            <div class="intelligence-grid">
                <a href="o/@OrganisationId/sales" class="intelligence-metric">
                    <span>Expected collections</span>
                    <strong>$@cashflowForecast.Next30Days.ExpectedReceipts.ToString("N2")</strong>
                    <small>Outstanding customer invoices due within 30 days</small>
                </a>
                <a href="o/@OrganisationId/purchases" class="intelligence-metric">
                    <span>Upcoming obligations</span>
                    <strong>$@cashflowForecast.Next30Days.ExpectedPayments.ToString("N2")</strong>
                    <small>Outstanding supplier bills due within 30 days</small>
                </a>
                <a href="o/@OrganisationId/reports/aging/receivables" class="intelligence-metric">
                    <span>
                        Receivables risk
                        <b class="@GetRiskClass(financialRisk.Receivables.RiskLevel)">@GetRiskLabel(financialRisk.Receivables.RiskLevel)</b>
                    </span>
                    <strong>$@financialRisk.Receivables.Overdue.ToString("N2")</strong>
                    <small>@financialRisk.Receivables.OverduePercentage.ToString("N0")% overdue · $@financialRisk.Receivables.Over90.ToString("N2") over 90 days</small>
                </a>
                <a href="o/@OrganisationId/reports/aging/payables" class="intelligence-metric">
                    <span>
                        Payables risk
                        <b class="@GetRiskClass(financialRisk.Payables.RiskLevel)">@GetRiskLabel(financialRisk.Payables.RiskLevel)</b>
                    </span>
                    <strong>$@financialRisk.Payables.Overdue.ToString("N2")</strong>
                    <small>@financialRisk.Payables.OverduePercentage.ToString("N0")% overdue · $@financialRisk.Payables.Over90.ToString("N2") over 90 days</small>
                </a>
            </div>
        </section>
    }

    <section id="chart-of-accounts" class="detail-card"><div class="card-heading"><div><span class="eyebrow">Accounting</span><h2>Chart of accounts</h2></div><span>@accounts.Count accounts</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach (var account in accounts) { <tr><td><code>@account.Code</code></td><td>@account.Name</td><td>@account.Type</td><td><span class="status-pill">@(account.IsActive ? "Active" : "Archived")</span></td></tr> }</tbody></table></div></section>
    <section id="team" class="detail-card"><div class="card-heading"><div><span class="eyebrow">Access</span><h2>Team &amp; permissions</h2></div><span>@members.Count members</span></div><div class="table-responsive"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Branch / division access</th></tr></thead><tbody>@foreach (var member in members) { <tr><td>@member.User.Email</td><td>@member.Role</td><td>@DimensionAccessLabel(member)</td></tr> }</tbody></table></div>
    @if (canManageTeam && RestrictableMembers.Count > 0)
    {
        <details class="invite-panel">
            <summary>Manage branch and division access</summary>
            @if (dimensionAccessMessage is not null) { <div class="alert @dimensionAccessMessageClass mt-3">@dimensionAccessMessage</div> }
            <div class="invite-fields">
                <div><label class="form-label">Team member</label><InputSelect class="form-select" @bind-Value="selectedMemberUserId">@foreach (var member in RestrictableMembers) { <option value="@member.UserId">@member.User.Email — @member.Role</option> }</InputSelect></div>
                <div><label class="form-label">Access mode</label><div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary" @onclick="SetFullDimensionAccess">All</button><button type="button" class="btn btn-outline-secondary" @onclick="SetRestrictedDimensionAccess">Restricted</button></div></div>
            </div>
            @if (SelectedMember?.DimensionAccessMode == DimensionAccessMode.Restricted)
            {
                <div class="invite-fields">
                    <div><label class="form-label">Branch or division</label><InputSelect class="form-select" @bind-Value="selectedDimensionGrant">@foreach (var branch in branches) { <option value="@($"{branch.Id}|")">@branch.Code — @branch.Name (entire branch)</option>@foreach (var division in branch.Divisions.Where(x => x.IsActive)) { <option value="@($"{branch.Id}|{division.Id}")">@branch.Code / @division.Code — @division.Name</option> } }</InputSelect></div>
                    <button type="button" class="btn btn-primary" @onclick="AddDimensionGrant">Add grant</button>
                </div>
                <div class="mt-3">
                    @if (SelectedMemberGrants.Count == 0) { <p class="text-muted">No dimensions are currently accessible.</p> }
                    else { @foreach (var grant in SelectedMemberGrants) { <div class="d-flex justify-content-between align-items-center border-top py-2"><span>@grant.Branch.Code — @grant.Branch.Name / @(grant.Division is null ? "All divisions" : $"{grant.Division.Code} — {grant.Division.Name}")</span><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDimensionGrant(grant.Id)">Remove</button></div> } }
                </div>
            }
        </details>
    }
    @if (canManageTeam) { <details class="invite-panel"><summary>＋ Invite team member</summary><EditForm Model="invite" OnValidSubmit="CreateInvitation" FormName="invite-member"><DataAnnotationsValidator /><ValidationSummary /><div class="invite-fields"><div><label class="form-label">Email</label><InputText class="form-control" @bind-Value="invite.Email" /></div><div><label class="form-label">Role</label><InputSelect class="form-select" @bind-Value="invite.Role">@foreach (var role in inviteRoles) { <option value="@role">@role</option> }</InputSelect></div><button class="btn btn-primary">Create invitation</button></div></EditForm>@if (invitationLink is not null) { <div class="alert alert-success mt-3"><strong>Invitation created.</strong><br /><a href="@invitationLink">@invitationLink</a></div> }</details> }
    </section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private bool loading = true, canManageTeam; private AccessibleOrganisation? access; private List<LedgerAccount> accounts = []; private List<OrganisationMembership> members = []; private List<Branch> branches = []; private List<OrganisationDimensionAccessGrant> dimensionGrants = []; private InviteModel invite = new(); private string? invitationLink; private string userId = ""; private string selectedMemberUserId = ""; private string selectedDimensionGrant = ""; private string? dimensionAccessMessage; private string dimensionAccessMessageClass = "alert-success"; private decimal cashPosition, receivables, payables, vatPosition; private int overdueInvoices, overdueBills, contactCount; private int financialAlertCount, documentAlertCount, systemAlertCount;
    private List<OrganisationMembership> RestrictableMembers => members.Where(x => x.Role is not OrganisationRole.Owner and not OrganisationRole.Administrator).OrderBy(x => x.User.Email).ToList();
    private OrganisationMembership? SelectedMember => members.SingleOrDefault(x => x.UserId == selectedMemberUserId);
    private List<OrganisationDimensionAccessGrant> SelectedMemberGrants => dimensionGrants.Where(x => x.UserId == selectedMemberUserId).OrderBy(x => x.Branch.Code).ThenBy(x => x.Division == null ? "" : x.Division.Code).ToList();
    private CashflowForecast? cashflowForecast;
    private FinancialRiskSummary? financialRisk;
    private CashRunwayForecast? cashRunway;
    private IDisposable? updateSubscription;
    private bool liveRefreshInProgress;
    private bool liveRefreshRequested;
    private readonly OrganisationRole[] inviteRoles = [OrganisationRole.Administrator, OrganisationRole.Accountant, OrganisationRole.Bookkeeper, OrganisationRole.Payroll, OrganisationRole.Sales, OrganisationRole.ReadOnly];
    protected override void OnInitialized() { updateSubscription = Updates.Subscribe(OrganisationUpdated); }
    protected override async Task OnParametersSetAsync() { loading = true; var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is not null) { accounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId).OrderBy(x => x.Code).ToListAsync(); canManageTeam = await TenantAccess.CanManageTeamAsync(userId, OrganisationId); await LoadAccessManagement(); contactCount=await Db.BusinessParties.CountAsync(x=>x.OrganisationId==OrganisationId && x.IsActive);

await LoadFinancialInsightsAsync(
    Db,
    NotificationService,
    CashflowForecastService,
    FinancialRiskService,
    CashRunwayService);
var outputVat=(await Db.SalesInvoices.Where(x=>x.OrganisationId==OrganisationId && x.Status!=InvoiceStatus.Voided).SumAsync(x=>(decimal?)x.VatTotal)??0)-(await Db.SalesCreditNotes.Where(x=>x.OrganisationId==OrganisationId).SumAsync(x=>(decimal?)x.VatTotal)??0); var inputVat=(await Db.SupplierBills.Where(x=>x.OrganisationId==OrganisationId && x.Status!=BillStatus.Voided).SumAsync(x=>(decimal?)x.VatTotal)??0)-(await Db.SupplierCreditNotes.Where(x=>x.OrganisationId==OrganisationId).SumAsync(x=>(decimal?)x.VatTotal)??0); vatPosition=outputVat-inputVat; } loading=false; }

    private async Task LoadFinancialInsightsAsync(
        ApplicationDbContext db,
        NotificationService notifications,
        CashflowForecastService cashflow,
        FinancialRiskService risk,
        CashRunwayService runway)
    {
        var today =
            DateOnly.FromDateTime(DateTime.Today);

        receivables =
            await db.SalesInvoices
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.Status != InvoiceStatus.Draft &&
                    x.Status != InvoiceStatus.Voided &&
                    x.AmountPaid + x.AmountCredited < x.Total)
                .SumAsync(x => (decimal?)(x.Total - x.AmountPaid - x.AmountCredited)) ?? 0;

        payables =
            await db.SupplierBills
                .AsNoTracking()
                .Where(x =>
                    x.OrganisationId == OrganisationId &&
                    x.Status != BillStatus.Voided &&
                    x.AmountPaid + x.AmountCredited < x.Total)
                .SumAsync(x => (decimal?)(x.Total - x.AmountPaid - x.AmountCredited)) ?? 0;

        overdueInvoices =
            await db.SalesInvoices.CountAsync(x =>
                x.OrganisationId == OrganisationId &&
                x.DueDate < today &&
                x.AmountPaid + x.AmountCredited < x.Total &&
                x.Status != InvoiceStatus.Draft &&
                x.Status != InvoiceStatus.Voided);

        overdueBills =
            await db.SupplierBills.CountAsync(x =>
                x.OrganisationId == OrganisationId &&
                x.DueDate < today &&
                x.AmountPaid + x.AmountCredited < x.Total &&
                x.Status != BillStatus.Voided);

        financialAlertCount =
            await notifications.GetFinancialAlertCountAsync(OrganisationId);
        documentAlertCount =
            await notifications.GetDocumentAlertCountAsync(OrganisationId);
        systemAlertCount =
            await notifications.GetSystemAlertCountAsync(OrganisationId);
        cashflowForecast =
            await cashflow.GetAsync(OrganisationId);
        financialRisk =
            await risk.GetAsync(OrganisationId);
        cashRunway =
            await runway.GetAsync(OrganisationId);
        cashPosition = cashRunway.OpeningCash;
    }

    private void OrganisationUpdated(Guid organisationId)
    {
        if (organisationId != OrganisationId)
        {
            return;
        }

        _ = InvokeAsync(RefreshFinancialInsightsAsync);
    }

    private async Task RefreshFinancialInsightsAsync()
    {
        liveRefreshRequested = true;

        if (liveRefreshInProgress)
        {
            return;
        }

        liveRefreshInProgress = true;

        try
        {
            while (liveRefreshRequested)
            {
                liveRefreshRequested = false;

                await using var scope =
                    ScopeFactory.CreateAsyncScope();

                await LoadFinancialInsightsAsync(
                    scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(),
                    scope.ServiceProvider.GetRequiredService<NotificationService>(),
                    scope.ServiceProvider.GetRequiredService<CashflowForecastService>(),
                    scope.ServiceProvider.GetRequiredService<FinancialRiskService>(),
                    scope.ServiceProvider.GetRequiredService<CashRunwayService>());

                StateHasChanged();
            }
        }
        finally
        {
            liveRefreshInProgress = false;
        }
    }

    public void Dispose() =>
        updateSubscription?.Dispose();

    private IEnumerable<(string Label, CashflowPeriodSummary Summary)> GetCashflowPeriods()
    {
        if (cashflowForecast is null)
        {
            return [];
        }

        return
        [
            ("Today", cashflowForecast.Today),
            ("7 days", cashflowForecast.Next7Days),
            ("30 days", cashflowForecast.Next30Days),
            ("60 days", cashflowForecast.Next60Days),
            ("90 days", cashflowForecast.Next90Days)
        ];
    }

    private decimal GetCashflowBarWidth(decimal amount)
    {
        if (cashflowForecast is null)
        {
            return 0;
        }

        var maximum =
            GetCashflowPeriods()
                .SelectMany(
                    x =>
                    new decimal[]
                    {
                        x.Summary.ExpectedReceipts,
                        x.Summary.ExpectedPayments,
                        Math.Abs(x.Summary.NetMovement)
                    })
                .DefaultIfEmpty()
                .Max();

        return maximum == 0
            ? 0
            : Math.Round(Math.Abs(amount) / maximum * 100, 2);
    }

    private static string FormatCashflowAmount(decimal amount) =>
        amount < 0
            ? $"-${Math.Abs(amount):N2}"
            : $"${amount:N2}";

    private static string GetRiskLabel(FinancialRiskLevel riskLevel) =>
        riskLevel switch
        {
            FinancialRiskLevel.High => "High risk",
            FinancialRiskLevel.Watch => "Watch",
            _ => "Current"
        };

    private static string GetRiskClass(FinancialRiskLevel riskLevel) =>
        riskLevel switch
        {
            FinancialRiskLevel.High => "risk-badge high",
            FinancialRiskLevel.Watch => "risk-badge watch",
            _ => "risk-badge current"
        };

    private string GetCashRunwayLabel()
    {
        if (cashRunway?.DaysUntilShortfall is null)
        {
            return "90+ days";
        }

        return cashRunway.DaysUntilShortfall == 0
            ? "Immediate pressure"
            : $"{cashRunway.DaysUntilShortfall} days";
    }

    private string GetCashRunwayDescription()
    {
        if (cashRunway?.FirstShortfallDate is null)
        {
            return "No projected cash shortfall within 90 days.";
        }

        return cashRunway.DaysUntilShortfall == 0
            ? "Projected obligations exceed available cash now."
            : $"First projected shortfall on {cashRunway.FirstShortfallDate:dd MMM yyyy}.";
    }

    private string GetCashRunwayClass() =>
        cashRunway?.FirstShortfallDate is null
            ? "runway-stable"
            : "runway-pressure";

    private string GetCashflowStatus()
    {
        if (cashflowForecast is null)
        {
            return "";
        }

        return cashflowForecast.Next7Days.NetMovement >= 0
            ? "✓ Positive cash movement"
            : "⚠ Cash pressure expected";
    }

    private string GetCashflowStatusClass()
    {
        if (cashflowForecast is null)
        {
            return "";
        }

        return cashflowForecast.Next7Days.NetMovement >= 0
            ? "cashflow-positive"
            : "cashflow-warning";
    }

    private async Task LoadAccessManagement()
    {
        members = await Db.OrganisationMemberships.AsNoTracking().Include(x => x.User).Where(x => x.OrganisationId == OrganisationId).OrderBy(x => x.User.Email).ToListAsync();
        branches = await Db.Branches.AsNoTracking().Include(x => x.Divisions).Where(x => x.OrganisationId == OrganisationId && x.IsActive).OrderByDescending(x => x.IsDefault).ThenBy(x => x.Code).ToListAsync();
        dimensionGrants = await Db.OrganisationDimensionAccessGrants.AsNoTracking().Include(x => x.Branch).Include(x => x.Division).Where(x => x.OrganisationId == OrganisationId).ToListAsync();
        if (!RestrictableMembers.Any(x => x.UserId == selectedMemberUserId)) selectedMemberUserId = RestrictableMembers.FirstOrDefault()?.UserId ?? "";
        if (string.IsNullOrWhiteSpace(selectedDimensionGrant) && branches.FirstOrDefault() is Branch branch) selectedDimensionGrant = $"{branch.Id}|";
    }

    private static string DimensionAccessLabel(OrganisationMembership member) =>
        member.Role is OrganisationRole.Owner or OrganisationRole.Administrator || member.DimensionAccessMode == DimensionAccessMode.All
            ? "All dimensions"
            : "Restricted";

    private Task SetFullDimensionAccess() => SetDimensionAccessMode(DimensionAccessMode.All);
    private Task SetRestrictedDimensionAccess() => SetDimensionAccessMode(DimensionAccessMode.Restricted);

    private async Task SetDimensionAccessMode(DimensionAccessMode mode)
    {
        if (string.IsNullOrWhiteSpace(selectedMemberUserId)) return;
        try
        {
            await TenantAccess.SetDimensionAccessModeAsync(userId, OrganisationId, selectedMemberUserId, mode);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = mode == DimensionAccessMode.All ? "Full dimension access restored." : "Access is now restricted to the grants below.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task AddDimensionGrant()
    {
        var parts = selectedDimensionGrant.Split('|');
        if (parts.Length != 2 || !Guid.TryParse(parts[0], out var branchId)) return;
        var divisionId = Guid.TryParse(parts[1], out var selectedDivisionId) ? selectedDivisionId : (Guid?)null;
        try
        {
            await TenantAccess.AddDimensionAccessGrantAsync(userId, OrganisationId, selectedMemberUserId, branchId, divisionId);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = "Dimension access granted.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task RemoveDimensionGrant(Guid grantId)
    {
        try
        {
            await TenantAccess.RemoveDimensionAccessGrantAsync(userId, OrganisationId, grantId);
            dimensionAccessMessageClass = "alert-success";
            dimensionAccessMessage = "Dimension access removed.";
            await LoadAccessManagement();
        }
        catch (Exception ex)
        {
            dimensionAccessMessageClass = "alert-danger";
            dimensionAccessMessage = ex.Message;
        }
    }

    private async Task CreateInvitation() { if (!await TenantAccess.CanManageTeamAsync(userId, OrganisationId)) return; var token = Convert.ToHexString(RandomNumberGenerator.GetBytes(32)); var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(token))); Db.OrganisationInvitations.Add(new OrganisationInvitation { OrganisationId = OrganisationId, Email = invite.Email.Trim().ToLowerInvariant(), Role = invite.Role, TokenHash = hash, ExpiresAt = DateTimeOffset.UtcNow.AddDays(7) }); await Db.SaveChangesAsync(); invitationLink = Navigation.ToAbsoluteUri($"invite/{token}").ToString(); invite = new(); }
    private static string Initials(string name) => string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])));
    private sealed class InviteModel { [Required, EmailAddress] public string Email { get; set; } = string.Empty; public OrganisationRole Role { get; set; } = OrganisationRole.Bookkeeper; }
}
