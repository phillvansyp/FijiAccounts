@page "/o/{OrganisationId:guid}"
@page "/o/{OrganisationId:guid}/team"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Components.Account
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject OrganisationInvitationService Invitations
@inject OrganisationPermissionProfileService PermissionProfiles
@inject IOrganisationInvitationEmailSender InvitationEmailSender
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject CashflowForecastService CashflowForecastService
@inject FinancialRiskService FinancialRiskService
@inject FinancialControlService FinancialControlService
@inject FinancialIntelligenceService FinancialIntelligenceService
@inject CashRunwayService CashRunwayService
@inject OrganisationUpdateBroker Updates
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<OrganisationWorkspace> Logger

<PageTitle>@(IsTeamPage ? "Team & permissions" : access?.Organisation.LegalName ?? "Organisation") · Account Island</PageTitle>
@if (loading) { <div class="dashboard-loading">Preparing your island...</div> }
else if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    @if (!IsTeamPage)
    {
    <section class="business-banner"><div class="business-identity"><span class="business-avatar">@Initials(access.Organisation.LegalName)</span><div><a href="organisations">All organisations</a><h1>@access.Organisation.LegalName</h1><p>@access.AccessLabel · @access.Organisation.BaseCurrency · @(access.IsClient ? "Accountant client" : "Direct access")</p></div></div><div class="banner-actions"><a href="help?from=o/@OrganisationId">Dashboard help</a><a class="primary-action" href="o/@OrganisationId/sales">＋ New invoice</a></div></section>

    <section class="dashboard-intro"><div><span class="eyebrow">Business overview</span><h2>Your finances, without the fog.</h2><p>Live balances and the work that needs attention, drawn directly from the ledger.</p></div><span class="as-at">As at @DateTime.Today.ToString("dd MMM yyyy")</span></section>
    <section class="kpi-grid">
        <a href="o/@OrganisationId/journals" class="kpi-card cash"><span>Cash position</span><strong>$@cashPosition.ToString("N2")</strong><small>Posted bank ledger balance</small><i>↗</i></a>
        <a href="o/@OrganisationId/sales" class="kpi-card"><span>Receivables</span><strong>$@receivables.ToString("N2")</strong><small>@overdueInvoices overdue invoice@(overdueInvoices == 1 ? "" : "s")</small><i>↗</i></a>
        <a href="o/@OrganisationId/purchases" class="kpi-card"><span>Payables</span><strong>$@payables.ToString("N2")</strong><small>@overdueBills overdue bill@(overdueBills == 1 ? "" : "s")</small><i>↗</i></a>
        <a id="tax-position" href="help?from=vat" class="kpi-card tax"><span>Net VAT position</span><strong>$@vatPosition.ToString("N2")</strong><small>@(vatPosition >= 0 ? "Collected less purchase VAT" : "Potential VAT credit")</small><i>↗</i></a>
    </section>

    <section class="dashboard-grid"><article class="work-card"><div class="card-heading"><div><span class="eyebrow">Work queue</span><h2>Needs attention</h2></div><span class="count-badge">@(overdueInvoices + overdueBills)</span></div>
        <a href="o/@OrganisationId/sales"><span class="task-icon sales">↗</span><span><strong>Overdue customer invoices</strong><small>Follow up money owed to the business</small></span><b>@overdueInvoices</b></a>
        <a href="o/@OrganisationId/purchases"><span class="task-icon purchases">↙</span><span><strong>Overdue supplier bills</strong><small>Review bills that have passed their due date</small></span><b>@overdueBills</b></a>
        <a href="o/@OrganisationId/notifications?category=financial">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>Financial alerts</strong>
                <small>Invoices and supplier bills needing attention</small>
            </span>
            <b>@financialAlertCount</b>
        </a>
        <a href="o/@OrganisationId/notifications?category=documents">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>Documents expiring</strong>
                <small>Documents requiring review</small>
            </span>
            <b>@documentAlertCount</b>
        </a>
        <a href="o/@OrganisationId/notifications?category=system">
            <span class="task-icon alerts">!</span>
            <span>
                <strong>System alerts</strong>
                <small>System notifications</small>
            </span>
            <b>@systemAlertCount</b>
        </a>
        <a href="o/@OrganisationId/contacts"><span class="task-icon contacts">◎</span><span><strong>Business contacts</strong><small>Customers and suppliers in this organisation</small></span><b>@contactCount</b></a>
    </article>
<article class="quick-card"><span class="eyebrow">Shortcuts</span><h2>Keep work moving</h2><div class="shortcut-grid"><a href="o/@OrganisationId/sales"><b>＋</b><span>Sales invoice</span></a><a href="o/@OrganisationId/purchases"><b>＋</b><span>Supplier bill</span></a><a href="o/@OrganisationId/receipts"><b>✓</b><span>Customer receipt</span></a><a href="o/@OrganisationId/journals"><b>≡</b><span>Manual journal</span></a></div></article></section>

    @if (cashflowForecast is not null)
    {
        <section class="detail-card cashflow-card">
            <div class="card-heading">
                <div>
                    <span class="eyebrow">Cashflow</span>
                    <h2>Forecast timeline</h2>
                </div>
                <div class="d-flex align-items-center gap-3"><a href="o/@OrganisationId/scenarios">Model scenarios</a><span class="@GetCashflowStatusClass()">@GetCashflowStatus()</span></div>
            </div>
            <p class="cashflow-description">
                Outstanding invoices and bills due from today through each forecast horizon.
            </p>
            <div class="table-responsive">
                <table class="cashflow-chart">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Money in</th>
                            <th>Money out</th>
                            <th>Projected movement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var period in GetCashflowPeriods())
                        {
                            <tr>
                                <th scope="row">@period.Label</th>
                                <td>
                                    <span>$@period.Summary.ExpectedReceipts.ToString("N2")</span>
                                    <i aria-hidden="true" class="cashflow-bar receipts" style="--bar-width: @GetCashflowBarWidth(period.Summary.ExpectedReceipts)%"></i>
                                </td>
                                <td>
                                    <span>$@period.Summary.ExpectedPayments.ToString("N2")</span>
                                    <i aria-hidden="true" class="cashflow-bar payments" style="--bar-width: @GetCashflowBarWidth(period.Summary.ExpectedPayments)%"></i>
                                </td>
                                <td>
                                    <span>@FormatCashflowAmount(period.Summary.NetMovement)</span>
                                    <i aria-hidden="true" class="cashflow-bar @(period.Summary.NetMovement >= 0 ? "movement-positive" : "movement-negative")"
                                       style="--bar-width: @GetCashflowBarWidth(period.Summary.NetMovement)%"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <details class="forecast-detail">
                <summary>View 12-month source breakdown</summary>
                <div class="table-responsive mt-3">
                    <table class="table">
                        <thead><tr><th>Month</th><th class="text-end">Posted receipts</th><th class="text-end">Recurring receipts</th><th class="text-end">Posted bills</th><th class="text-end">Recurring bills</th><th class="text-end">Planned purchases</th><th class="text-end">Net</th></tr></thead>
                        <tbody>
                            @foreach (var month in cashflowForecast.Monthly)
                            {
                                <tr>
                                    <th scope="row">@month.MonthStart.ToString("MMM yyyy")</th>
                                    <td class="text-end">$@month.Sources.PostedReceipts.ToString("N2")</td>
                                    <td class="text-end">$@month.Sources.RecurringReceipts.ToString("N2")</td>
                                    <td class="text-end">$@month.Sources.PostedPayments.ToString("N2")</td>
                                    <td class="text-end">$@month.Sources.RecurringPayments.ToString("N2")</td>
                                    <td class="text-end">$@month.Sources.PlannedPurchasePayments.ToString("N2")</td>
                                    <td class="text-end"><strong>@FormatCashflowAmount(month.Summary.NetMovement)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </section>
    }

    @if (cashflowForecast is not null && financialRisk is not null && cashRunway is not null && financialIntelligence is not null)
    {
        <section class="detail-card intelligence-card">
            <div class="card-heading">
                <div>
                    <span class="eyebrow">Financial intelligence</span>
                    <h2>Collections, obligations and ageing risk</h2>
                </div>
                <span>Next 30 days</span>
            </div>
            <div class="runway-summary @GetCashRunwayClass()">
                <div>
                    <span>Cash runway</span>
                    <strong>@GetCashRunwayLabel()</strong>
                    <small>@GetCashRunwayDescription()</small>
                </div>
                <dl>
                    <div>
                        <dt>Cash now</dt>
                        <dd>@FormatCashflowAmount(cashRunway.OpeningCash)</dd>
                    </div>
                    <div>
                        <dt>30-day balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.ProjectedBalance30Days)</dd>
                    </div>
                    <div>
                        <dt>90-day balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.ProjectedBalance90Days)</dd>
                    </div>
                    <div>
                        <dt>Lowest balance</dt>
                        <dd>@FormatCashflowAmount(cashRunway.LowestProjectedBalance)</dd>
                    </div>
                </dl>
            </div>
            <div class="intelligence-grid">
                <a href="o/@OrganisationId/sales" class="intelligence-metric">
                    <span>Expected collections</span>
                    <strong>$@cashflowForecast.Next30Days.ExpectedReceipts.ToString("N2")</strong>
                    <small>Outstanding customer invoices due within 30 days</small>
                </a>
                <a href="o/@OrganisationId/purchases" class="intelligence-metric">
                    <span>Upcoming obligations</span>
                    <strong>$@cashflowForecast.Next30Days.ExpectedPayments.ToString("N2")</strong>
                    <small>Outstanding supplier bills due within 30 days</small>
                </a>
                <a href="o/@OrganisationId/reports/aging/receivables" class="intelligence-metric">
                    <span>
                        Receivables risk
                        <b class="@GetRiskClass(financialRisk.Receivables.RiskLevel)">@GetRiskLabel(financialRisk.Receivables.RiskLevel)</b>
                    </span>
                    <strong>$@financialRisk.Receivables.Overdue.ToString("N2")</strong>
                    <small>@financialRisk.Receivables.OverduePercentage.ToString("N0")% overdue · $@financialRisk.Receivables.Over90.ToString("N2") over 90 days</small>
                </a>
                <a href="o/@OrganisationId/reports/aging/payables" class="intelligence-metric">
                    <span>
                        Payables risk
                        <b class="@GetRiskClass(financialRisk.Payables.RiskLevel)">@GetRiskLabel(financialRisk.Payables.RiskLevel)</b>
                    </span>
                    <strong>$@financialRisk.Payables.Overdue.ToString("N2")</strong>
                    <small>@financialRisk.Payables.OverduePercentage.ToString("N0")% overdue · $@financialRisk.Payables.Over90.ToString("N2") over 90 days</small>
                </a>
            </div>
            <div class="trend-intelligence">
                <div class="margin-snapshot">
                    <span>Gross margin &middot; latest 30 days</span>
                    <strong>@FormatMargin(financialIntelligence.CurrentGrossMarginPercent)</strong>
                    <small>
                        Revenue $@financialIntelligence.CurrentRevenue.ToString("N2")
                        &middot; Gross profit $@financialIntelligence.CurrentGrossProfit.ToString("N2")
                        @if (financialIntelligence.PriorGrossMarginPercent is decimal priorMargin)
                        {
                            <text>&middot; Previous @priorMargin.ToString("N1")%</text>
                        }
                    </small>
                </div>
                <div class="health-signals">
                    <div class="health-signals-heading">
                        <div><span class="eyebrow">Trend signals</span><h3>Financial health checks</h3></div>
                        <span>@financialIntelligence.Insights.Count signal@(financialIntelligence.Insights.Count == 1 ? "" : "s")</span>
                    </div>
                    @if (financialIntelligence.Insights.Count == 0)
                    {
                        <p class="health-clear">No material margin, supplier-cost or concentration warnings were detected.</p>
                    }
                    else
                    {
                        @foreach (var insight in financialIntelligence.Insights)
                        {
                            <a class="health-signal" href="@InsightLink(insight.Category)">
                                <span class="risk-badge @(insight.Severity == FinancialInsightSeverity.High ? "high" : "watch")">@insight.Severity</span>
                                <span><strong>@insight.Title</strong><small>@insight.Explanation</small></span>
                            </a>
                        }
                    }
                </div>
            </div>
        </section>
    }

    @if (financialControls is not null)
    {
        <section class="detail-card">
            <div class="card-heading">
                <div>
                    <span class="eyebrow">Audit &amp; fraud controls</span>
                    <h2>Financial control review</h2>
                </div>
                <span>@financialControls.Alerts.Count alert@(financialControls.Alerts.Count == 1 ? "" : "s") · last 12 months</span>
            </div>
            @if (financialControls.Alerts.Count == 0)
            {
                <p class="health-clear">No duplicate transaction or supplier payment-destination risks were detected.</p>
            }
            else
            {
                <div class="health-signals">
                    @foreach (var alert in financialControls.Alerts)
                    {
                        <a class="health-signal" href="@FinancialControlLink(alert.Type)">
                            <span class="risk-badge @(alert.Severity == FinancialControlSeverity.High ? "high" : "watch")">@alert.Severity</span>
                            <span>
                                <strong>@alert.Title</strong>
                                <small>@alert.Explanation · @alert.TransactionDate.ToString("dd MMM yyyy") · $@alert.Amount.ToString("N2")</small>
                            </span>
                        </a>
                    }
                </div>
            }
        </section>
    }

    <section id="chart-of-accounts" class="detail-card"><div class="card-heading"><div><span class="eyebrow">Accounting</span><h2>Chart of accounts</h2></div><span>@accounts.Count accounts</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach (var account in accounts) { <tr><td><code>@account.Code</code></td><td>@account.Name</td><td>@account.Type</td><td><span class="status-pill">@(account.IsActive ? "Active" : "Archived")</span></td></tr> }</tbody></table></div></section>
    }
    @if (IsTeamPage)
    {
    <section class="business-banner"><div class="business-identity"><span class="business-avatar">@Initials(access.Organisation.LegalName)</span><div><a href="o/@OrganisationId">← Organisation overview</a><h1>Team &amp; permissions</h1><p>@access.Organisation.LegalName · Manage users, permission profiles and access</p></div></div><div class="banner-actions"><a href="o/@OrganisationId/settings">Organisation settings</a></div></section>
    <section id="team" class="detail-card"><div class="card-heading"><div><span class="eyebrow">Access</span><h2>Team &amp; permissions</h2></div><span>@members.Count members</span></div><div class="table-responsive"><table class="table"><thead><tr><th>User</th><th>Permission profile</th><th>Branch / division access</th></tr></thead><tbody>@foreach (var member in members) { <tr><td>@member.User.Email</td><td>@PermissionProfileLabel(member)</td><td>@DimensionAccessLabel(member)</td></tr> }</tbody></table></div>
    @if (canManageTeam)
    {
        <details class="invite-panel" open="@(permissionProfiles.Count == 0)">
            <summary>Permission profiles (@permissionProfiles.Count)</summary>
            <p class="text-muted mt-3">Create reusable profiles, choose what each profile can do, then assign one to each team member. The Owner profile remains protected.</p>
            @if (permissionProfileMessage is not null) { <div class="alert @permissionProfileMessageClass">@permissionProfileMessage</div> }
            <EditForm Model="permissionProfileEditor" OnValidSubmit="SavePermissionProfile" FormName="permission-profile">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="invite-fields">
                    <div><label class="form-label" for="profile-name">Profile name</label><input id="profile-name" name="permissionProfileEditor.Name" class="form-control" @bind="permissionProfileEditor.Name" @bind:event="oninput" /></div>
                    <div><label class="form-label" for="profile-description">Description</label><input id="profile-description" name="permissionProfileEditor.Description" class="form-control" @bind="permissionProfileEditor.Description" @bind:event="oninput" /></div>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-md-6"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="permissionProfileEditor.CanManageTeam" /><span class="form-check-label">Manage team and permission profiles</span></label></div>
                    <div class="col-md-6"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="permissionProfileEditor.CanPostAccounting" /><span class="form-check-label">Post accounting and journals</span></label></div>
                    <div class="col-md-6"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="permissionProfileEditor.CanManageContacts" /><span class="form-check-label">Create and edit contacts</span></label></div>
                    <div class="col-md-6"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="permissionProfileEditor.CanApprovePurchases" /><span class="form-check-label">Approve purchases</span></label></div>
                </div>
                <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" disabled="@savingPermissionProfile">@(editingPermissionProfileId is null ? "Create profile" : "Save profile")</button>@if (editingPermissionProfileId is not null) { <button type="button" class="btn btn-outline-secondary" @onclick="CancelPermissionProfileEdit">Cancel</button> }</div>
            </EditForm>
            @if (permissionProfiles.Count > 0)
            {
                <div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Profile</th><th>Authorisations</th><th>Members</th><th class="text-end">Actions</th></tr></thead><tbody>
                @foreach (var profile in permissionProfiles)
                {
                    <tr><td><strong>@profile.Name</strong>@if (!string.IsNullOrWhiteSpace(profile.Description)) { <br /><small class="text-muted">@profile.Description</small> }</td><td>@PermissionSummary(profile)</td><td>@members.Count(x => x.PermissionProfileId == profile.Id)</td><td class="text-end"><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditPermissionProfile(profile)">Edit</button><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePermissionProfile(profile.Id)">Delete</button></div></td></tr>
                }
                </tbody></table></div>
            }
        </details>
        @if (ProfileAssignableMembers.Count > 0)
        {
            <details class="invite-panel">
                <summary>Assign permission profiles</summary>
                <p class="text-muted mt-3">Choose “Standard role defaults” to use the member's original role permissions.</p>
                @if (profileAssignmentMessage is not null) { <div class="alert @profileAssignmentMessageClass">@profileAssignmentMessage</div> }
                <div class="invite-fields">
                    <div><label class="form-label">Team member</label><InputSelect class="form-select" @bind-Value="selectedProfileMemberUserId" @bind-Value:after="SelectedProfileMemberChanged">@foreach (var member in ProfileAssignableMembers) { <option value="@member.UserId">@member.User.Email — @PermissionProfileLabel(member)</option> }</InputSelect></div>
                    <div><label class="form-label">Permission profile</label><InputSelect class="form-select" @bind-Value="selectedPermissionProfileId"><option value="">Standard role defaults</option>@foreach (var profile in permissionProfiles) { <option value="@profile.Id.ToString()">@profile.Name</option> }</InputSelect></div>
                    <button type="button" class="btn btn-primary" @onclick="AssignPermissionProfile">Apply profile</button>
                </div>
            </details>
        }
        <details class="invite-panel" open="@(pendingInvitations.Count > 0)">
            <summary>Pending invitations (@pendingInvitations.Count)</summary>
            @if (pendingInvitationMessage is not null)
            {
                <div class="alert @pendingInvitationMessageClass mt-3">
                    @pendingInvitationMessage
                    @if (pendingInvitationLink is not null)
                    {
                        <br /><a href="@pendingInvitationLink">@pendingInvitationLink</a>
                    }
                </div>
            }
            @if (pendingInvitations.Count == 0)
            {
                <p class="text-muted mt-3 mb-0">There are no pending invitations.</p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table align-middle">
                        <thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var invitation in pendingInvitations)
                            {
                                <tr>
                                    <td>@invitation.Email</td>
                                    <td>@invitation.Role</td>
                                    <td><span class="status-pill @(invitation.IsExpired ? "invitation-expired" : "")">@(invitation.IsExpired ? "Expired" : "Pending")</span></td>
                                    <td>@invitation.ExpiresAt.UtcDateTime.ToString("dd MMM yyyy HH:mm 'UTC'")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(pendingInvitationActionId is not null)" @onclick="() => ReissueInvitation(invitation)">Resend</button>
                                            @if (pendingRevocationId == invitation.Id)
                                            {
                                                <button type="button" class="btn btn-sm btn-danger" disabled="@(pendingInvitationActionId is not null)" @onclick="() => RevokeInvitation(invitation.Id)">Confirm revoke</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(pendingInvitationActionId is not null)" @onclick="CancelInvitationRevocation">Cancel</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(pendingInvitationActionId is not null)" @onclick="() => BeginInvitationRevocation(invitation.Id)">Revoke</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </details>
    }
    @if (canManageTeam && RestrictableMembers.Count > 0)
    {
        <details class="invite-panel">
            <summary>Manage branch and division access</summary>
            @if (dimensionAccessMessage is not null) { <div class="alert @dimensionAccessMessageClass mt-3">@dimensionAccessMessage</div> }
            <div class="invite-fields">
                <div><label class="form-label">Team member</label><InputSelect class="form-select" @bind-Value="selectedMemberUserId">@foreach (var member in RestrictableMembers) { <option value="@member.UserId">@member.User.Email — @member.Role</option> }</InputSelect></div>
                <div><label class="form-label">Access mode</label><div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary" @onclick="SetFullDimensionAccess">All</button><button type="button" class="btn btn-outline-secondary" @onclick="SetRestrictedDimensionAccess">Restricted</button></div></div>
            </div>
            @if (SelectedMember?.DimensionAccessMode == DimensionAccessMode.Restricted)
            {
                <div class="invite-fields">
                    <div><label class="form-label">Branch or division</label><InputSelect class="form-select" @bind-Value="selectedDimensionGrant">@foreach (var branch in branches) { <option value="@($"{branch.Id}|")">@branch.Code — @branch.Name (entire branch)</option>@foreach (var division in branch.Divisions.Where(x => x.IsActive)) { <option value="@($"{branch.Id}|{division.Id}")">@branch.Code / @division.Code — @division.Name</option> } }</InputSelect></div>
                    <button type="button" class="btn btn-primary" @onclick="AddDimensionGrant">Add grant</button>
                </div>
                <div class="mt-3">
                    @if (SelectedMemberGrants.Count == 0) { <p class="text-muted">No dimensions are currently accessible.</p> }
                    else { @foreach (var grant in SelectedMemberGrants) { <div class="d-flex justify-content-between align-items-center border-top py-2"><span>@grant.Branch.Code — @grant.Branch.Name / @(grant.Division is null ? "All divisions" : $"{grant.Division.Code} — {grant.Division.Name}")</span><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDimensionGrant(grant.Id)">Remove</button></div> } }
                </div>
            }
        </details>
    }
    @if (canManageTeam && CredentialResettableMembers.Count > 0)
    {
        <details class="invite-panel">
            <summary>Set temporary password</summary>
            <p class="text-muted mt-3">Use only when the member cannot receive a password reset email. The action is recorded in the audit trail.</p>
            @if (temporaryPasswordMessage is not null) { <div class="alert @temporaryPasswordMessageClass">@temporaryPasswordMessage</div> }
            <EditForm Model="temporaryPassword" OnValidSubmit="SetTemporaryPassword" FormName="set-temporary-password">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="invite-fields">
                    <div><label class="form-label">Team member</label><InputSelect class="form-select" @bind-Value="temporaryPassword.UserId">@foreach (var member in CredentialResettableMembers) { <option value="@member.UserId">@member.User.Email — @member.Role</option> }</InputSelect></div>
                    <div><label class="form-label" for="temporary-password">Temporary password</label><input id="temporary-password" name="temporaryPassword.Password" type="password" class="form-control" autocomplete="new-password" @bind="temporaryPassword.Password" @bind:event="oninput" /></div>
                    <div><label class="form-label" for="temporary-password-confirmation">Confirm password</label><input id="temporary-password-confirmation" name="temporaryPassword.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" @bind="temporaryPassword.ConfirmPassword" @bind:event="oninput" /></div>
                    <button class="btn btn-primary" disabled="@settingTemporaryPassword">@(settingTemporaryPassword ? "Setting…" : "Set password")</button>
                </div>
            </EditForm>
        </details>
    }
    @if (canManageTeam) { <details class="invite-panel"><summary>＋ Invite team member</summary><EditForm Model="invite" OnValidSubmit="CreateInvitation" FormName="invite-member"><DataAnnotationsValidator /><ValidationSummary /><div class="invite-fields"><div><label class="form-label" for="invite-email">Email</label><input id="invite-email" name="invite.Email" type="email" class="form-control" @bind="invite.Email" @bind:event="oninput" /></div><div><label class="form-label">Role</label><InputSelect class="form-select" @bind-Value="invite.Role">@foreach (var role in inviteRoles) { <option value="@role">@role</option> }</InputSelect></div><button class="btn btn-primary">Create invitation</button></div></EditForm>@if (invitationError is not null) { <div class="alert alert-danger mt-3">@invitationError</div> }@if (invitationLink is not null) { <div class="alert alert-success mt-3"><strong>Invitation created.</strong><br /><a href="@invitationLink">@invitationLink</a></div> }</details> }
    </section>
    }
