@page "/o/{OrganisationId:guid}/bank-rules"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject BankRuleService RuleService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Bank rules · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> } else { <div class="page-heading"><div><p class="eyebrow">Banking automation</p><h1>Bank rules</h1><p class="page-intro">Code repeat statement transactions consistently and reconcile them in one step.</p></div><a class="btn btn-outline-primary" href="o/@OrganisationId/banking">Bank reconciliation</a></div><div class="alert alert-info"><strong>Safe first release:</strong> rules post as tax out of scope. Use invoices and bills for taxable activity.</div>
@if (canManage) { <details class="setup-card mb-4"><summary><strong>+ Create bank rule</strong></summary><EditForm Model="model" OnValidSubmit="Create" FormName="bank-rule" class="mt-3"><DataAnnotationsValidator /><ValidationSummary /><div class="row"><div class="col-md-3 mb-3"><label class="form-label">Rule name</label><InputText class="form-control" @bind-Value="model.Name" /></div><div class="col-md-3 mb-3"><label class="form-label">Description contains</label><InputText class="form-control" @bind-Value="model.Pattern" /></div><div class="col-md-2 mb-3"><label class="form-label">Direction</label><InputSelect class="form-select" @bind-Value="model.Direction">@foreach (var item in Enum.GetValues<BankRuleDirection>()) { <option value="@item">@item</option> }</InputSelect></div><div class="col-md-4 mb-3"><label class="form-label">Target account</label><InputSelect class="form-select" @bind-Value="model.TargetAccountId">@foreach (var item in targetAccounts) { <option value="@item.Id">@item.Code — @item.Name</option> }</InputSelect></div></div><button class="btn btn-primary">Save rule</button></EditForm></details> }
@if (message is not null) { <div class="alert @messageClass">@message</div> }
<section class="detail-card"><div class="card-heading"><div><span class="eyebrow">Suggestions</span><h2>Matching statement lines</h2></div><span>@unreconciled.Count unreconciled</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Description</th><th class="text-end">Amount</th><th>Suggested rule</th><th></th></tr></thead><tbody>@foreach (var line in unreconciled) { var rule = rules.FirstOrDefault(x => BankRuleService.Matches(x, line)); <tr><td>@line.TransactionDate.ToString("dd MMM yyyy")</td><td>@line.Description</td><td class="text-end">$@line.Amount.ToString("N2")</td><td>@(rule?.Name ?? "No match")</td><td class="text-end">@if (rule is not null && canManage) { <button class="btn btn-sm btn-primary" @onclick="() => Apply(rule.Id, line.Id)">Apply &amp; reconcile</button> }</td></tr> }</tbody></table></div></section>
<section class="detail-card mt-4"><div class="card-heading"><h2>Active rules</h2><span>@rules.Count</span></div><table class="table"><thead><tr><th>Name</th><th>Match</th><th>Direction</th><th>Target</th></tr></thead><tbody>@foreach (var rule in rules) { <tr><td>@rule.Name</td><td>Contains “@rule.DescriptionContains”</td><td>@rule.Direction</td><td>@rule.TargetAccount.Code — @rule.TargetAccount.Name</td></tr> }</tbody></table></section> }
@code { [Parameter] public Guid OrganisationId { get; set; } private AccessibleOrganisation? access; private string userId=""; private bool canManage; private List<LedgerAccount> targetAccounts=[]; private List<BankRule> rules=[]; private List<BankStatementLine> unreconciled=[]; private RuleModel model=new(); private string? message; private string messageClass="alert-success"; protected override async Task OnParametersSetAsync(){var state=await AuthenticationStateProvider.GetAuthenticationStateAsync();userId=UserManager.GetUserId(state.User)!;access=await TenantAccess.FindAsync(userId,OrganisationId);if(access is null)return;canManage=await TenantAccess.CanPostJournalsAsync(userId,OrganisationId);targetAccounts=await Db.LedgerAccounts.AsNoTracking().Where(x=>x.OrganisationId==OrganisationId&&x.IsActive&&!x.IsBankAccount).OrderBy(x=>x.Code).ToListAsync();model.TargetAccountId=targetAccounts.FirstOrDefault()?.Id??Guid.Empty;await Reload();} private async Task Reload(){rules=await Db.BankRules.AsNoTracking().Include(x=>x.TargetAccount).Where(x=>x.OrganisationId==OrganisationId&&x.IsActive).OrderBy(x=>x.Name).ToListAsync();unreconciled=await Db.BankStatementLines.AsNoTracking().Where(x=>x.OrganisationId==OrganisationId&&x.ReconciledAt==null).OrderByDescending(x=>x.TransactionDate).Take(200).ToListAsync();} private async Task Create(){try{var rule=await RuleService.CreateAsync(userId,new(OrganisationId,model.Name,model.Pattern,model.Direction,model.TargetAccountId));messageClass="alert-success";message=$"Rule {rule.Name} created.";model=new(){TargetAccountId=targetAccounts.FirstOrDefault()?.Id??Guid.Empty};await Reload();}catch(Exception ex){messageClass="alert-danger";message=ex.Message;}} private async Task Apply(Guid ruleId,Guid lineId){try{await RuleService.ApplyAsync(userId,OrganisationId,ruleId,lineId);messageClass="alert-success";message="Rule applied and statement line reconciled.";await Reload();}catch(Exception ex){messageClass="alert-danger";message=ex.Message;}} private sealed class RuleModel{[Required,StringLength(120)]public string Name{get;set;}="";[Required,StringLength(160,MinimumLength=2)]public string Pattern{get;set;}="";public BankRuleDirection Direction{get;set;}public Guid TargetAccountId{get;set;}} }
