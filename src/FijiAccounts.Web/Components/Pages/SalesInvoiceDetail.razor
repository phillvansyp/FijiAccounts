@page "/o/{OrganisationId:guid}/sales/{InvoiceId:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject SalesInvoiceService InvoiceService
@inject SalesCreditNoteService CreditNoteService
@inject OrganisationBrandingService BrandingService
@inject SalesInvoiceEmailSender InvoiceEmailSender
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(invoice?.InvoiceNumber ?? "Invoice") · Account Island</PageTitle>
@if (invoice is null || access is null) { <div class="alert alert-danger">Invoice not found or access denied.</div> }
else
{
    <div class="detail-actions no-print"><a href="o/@OrganisationId/sales">← Invoices</a><div>@if (invoice.Status == InvoiceStatus.Draft && canPost) { <a class="btn btn-outline-primary" href="o/@OrganisationId/sales/@InvoiceId/edit">Edit draft</a><button class="btn btn-primary" @onclick="PostDraft">Approve and post</button> }@if (canPost &&
    invoice.Status is InvoiceStatus.Posted or
        InvoiceStatus.PartPaid or
        InvoiceStatus.Paid)
{
    <button class="btn btn-outline-primary"
            @onclick="OpenCredit">
        Credit note
    </button>
}

@if (canPost &&
    invoice.Status == InvoiceStatus.Posted &&
    invoice.AmountPaid == 0 &&
    invoice.AmountCredited == 0)
{
    <button class="btn btn-outline-danger"
            @onclick="() => showVoid = !showVoid">
        Void invoice
    </button>
}<button class="btn btn-outline-secondary" @onclick="CopyInvoice">Copy invoice</button>@if (canPost && (invoice.Status is InvoiceStatus.Posted or InvoiceStatus.PartPaid or InvoiceStatus.Paid)) { <button class="btn btn-outline-primary" @onclick="OpenEmailInvoice">Email invoice</button> }<button class="btn btn-outline-secondary" onclick="window.print()">Print / Save PDF</button></div></div>
    @if (showEmailInvoice) { <div class="void-panel no-print"><div><strong>Email @invoice.InvoiceNumber</strong><span>A PDF copy will be attached. The accounts email is used first, then the primary contact email.</span></div><input type="email" class="form-control reason" @bind="invoiceEmailRecipient" @bind:event="oninput" placeholder="Recipient email" /><button class="btn btn-primary" disabled="@sendingInvoiceEmail" @onclick="SendInvoiceEmail">@(sendingInvoiceEmail ? "Sending..." : "Send invoice")</button><button class="btn btn-outline-secondary" disabled="@sendingInvoiceEmail" @onclick="() => showEmailInvoice = false">Cancel</button></div> }
    @if (invoiceEmailStatus is not null) { <div class="alert @(invoiceEmailSucceeded ? "alert-success" : "alert-danger") no-print">@invoiceEmailStatus</div> }
    @if (showVoid) { <div class="void-panel no-print"><div><strong>Void this invoice?</strong><span>A reversing journal will be posted and retained in the audit trail.</span></div><InputDate class="form-control" @bind-Value="voidDate" /><button class="btn btn-danger" @onclick="VoidInvoice">Post reversal</button><button class="btn btn-outline-secondary" @onclick="() => showVoid = false">Cancel</button></div> }
    @if (showCredit) { <div class="void-panel credit-panel no-print"><div><strong>Issue credit note</strong><span>Maximum: $@AvailableCredit.ToString("N2")</span></div><InputDate class="form-control" @bind-Value="creditDate" /><InputText class="form-control reason" @bind-Value="creditReason" placeholder="Reason" /><InputNumber class="form-control" @bind-Value="creditAmount" />@if (HasMixedVatRates) { <div><label class="form-label">VAT adjustment</label><InputNumber TValue="decimal?" class="form-control" @bind-Value="creditVatAmount" /></div> }<label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="restockTrackedItems" /><span class="form-check-label">Return tracked items to stock</span></label><button class="btn btn-primary" @onclick="CreateCredit">Post credit</button><button class="btn btn-outline-secondary" @onclick="() => showCredit = false">Cancel</button></div> }
    @if (status is not null) { <div class="alert alert-danger no-print">@status</div> }
    <article class="invoice-document"><header><h1>@DocumentTitle</h1><div class="document-header-row"><div class="document-heading">@if (logoDataUrl is not null) { <img class="company-logo" src="@logoDataUrl" alt="@($"{SupplierName} logo")" /> } else { <span class="document-brand">Account Island</span> }</div><div class="document-number"><strong>@invoice.InvoiceNumber</strong><span class="status-badge">@(invoice.Status == InvoiceStatus.PartPaid ? "Part paid" : invoice.Status.ToString())</span></div></div></header>
        <section class="invoice-meta"><div><small>From</small><strong>@SupplierName</strong><span>@SupplierAddress</span>@if (!string.IsNullOrWhiteSpace(SupplierTin)) { <span>TIN: @SupplierTin</span> }</div><div><small>Bill to</small><strong>@RecipientName</strong><span>@RecipientAddress</span>@if (!string.IsNullOrWhiteSpace(RecipientTin)) { <span>TIN: @RecipientTin</span> }</div><dl><dt>Issue date</dt><dd>@invoice.IssueDate.ToString("dd MMM yyyy")</dd><dt>Due date</dt><dd>@invoice.DueDate.ToString("dd MMM yyyy")</dd><dt>Currency</dt><dd>@invoice.Currency</dd><dt>Branch / division</dt><dd>@invoice.Branch?.Name / @invoice.Division?.Name</dd></dl></section>
        <table class="document-lines"><thead><tr><th>Description</th><th>Project</th><th>Customer PO</th><th class="number">Qty</th><th class="number">Unit price</th><th>Tax treatment</th><th class="number">VAT excl.</th></tr></thead><tbody>@foreach (var line in invoice.Lines) { <tr><td>@line.Description</td><td>@ProjectLabel(line)</td><td>@(string.IsNullOrWhiteSpace(line.CustomerPurchaseOrderNumber) ? "—" : line.CustomerPurchaseOrderNumber)</td><td class="number">@line.Quantity.ToString("N2")</td><td class="number">@invoice.Currency @line.TransactionUnitPrice.ToString("N2")</td><td>@FijiTaxDocumentCompliance.TaxLabel(line)</td><td class="number">@invoice.Currency @line.TransactionNetAmount.ToString("N2")</td></tr> }</tbody></table>
        <section class="document-totals"><div><span>VAT exclusive</span><strong>@invoice.Currency @invoice.TransactionSubtotal.ToString("N2")</strong></div>@foreach (var supplyTotal in SupplyTotals) { <div><span>@supplyTotal.Label</span><strong>@invoice.Currency @supplyTotal.Amount.ToString("N2")</strong></div> }<div><span>@access.Organisation.TaxLabel</span><strong>@invoice.Currency @invoice.TransactionVatTotal.ToString("N2")</strong></div><div class="grand-total"><span>VAT inclusive</span><strong>@invoice.Currency @invoice.TransactionTotal.ToString("N2")</strong></div>@if (!string.Equals(invoice.Currency, access.Organisation.BaseCurrency, StringComparison.OrdinalIgnoreCase)) { <div><span>Exchange rate</span><strong>1 @invoice.Currency = @invoice.ExchangeRateToBase.ToString("0.########") @access.Organisation.BaseCurrency</strong></div><div><span>Posted value</span><strong>@access.Organisation.BaseCurrency @invoice.Total.ToString("N2")</strong></div> }<div><span>Credits (base)</span><strong>@access.Organisation.BaseCurrency @invoice.AmountCredited.ToString("N2")</strong></div><div><span>Paid (base)</span><strong>@access.Organisation.BaseCurrency @invoice.AmountPaid.ToString("N2")</strong></div><div><span>Amount due (base)</span><strong>@access.Organisation.BaseCurrency @AvailableCredit.ToString("N2")</strong></div></section>
        @if (invoice.Status == InvoiceStatus.Draft) { <footer>DRAFT — Not posted to the ledger</footer> }
        else if (invoice.IsSimplifiedTaxInvoice) { <div class="alert alert-info mt-4">Price payable is inclusive of VAT.</div> }
        else if (invoice.IsTaxInvoice is null) { <div class="alert alert-secondary mt-4">Legacy document — the compliance profile was not captured when this invoice was issued.</div> }
    </article>
    <div class="no-print"><CustomerReceiptHistory OrganisationId="OrganisationId" InvoiceId="InvoiceId" OnChanged="Reload" /></div>

    @if (credits.Count > 0)
{
    <section class="history-card no-print mt-4">
        <div class="history-heading">
            <span class="eyebrow">Credit history</span>
            <h2>Sales credit notes</h2>
        </div>

        <div class="table-responsive">
            <table class="table history-table">
                <thead>
                    <tr>
                        <th>Credit note</th>
                        <th>Date</th>
                        <th>Reason</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var credit in credits)
                    {
                        <tr>
                            <td>
                                <a href="o/@OrganisationId/sales/credits/@credit.Id"><strong>@credit.CreditNoteNumber</strong></a>
                            </td>

                            <td>
                                @credit.CreditDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@credit.Reason</td>

                            <td class="text-end">
                                <strong>
                                    $@credit.Total.ToString("N2")
                                </strong>
                            </td>

                            @if (creditReversals.TryGetValue(
                                credit.Id,
                                out var reversal))
                            {
                                <td>
                                    <span class="badge text-bg-secondary">
                                        Reversed
                                    </span>

                                    <div class="small text-muted mt-1">
                                        @reversal.ReversalDate.ToString(
                                            "dd MMM yyyy")
                                    </div>
                                </td>

                                <td class="text-end">
                                    <span class="small text-muted">
                                        @reversal.Reason
                                    </span>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge text-bg-success">
                                        Posted
                                    </span>
                                </td>

                                <td class="text-end">
                                    @if (canPost)
                                    {
                                        <button
                                            class="btn btn-sm btn-outline-danger"
                                            @onclick="() => OpenCreditReversal(credit.Id)">
                                            Reverse
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

    @if (reversingCreditId is not null)
{
    var selectedCredit =
        credits.FirstOrDefault(
            x => x.Id == reversingCreditId.Value);

    if (selectedCredit is not null)
    {
        <section class="void-panel credit-panel no-print mt-3">
            <div>
                <strong>
                    Reverse @selectedCredit.CreditNoteNumber
                </strong>

                <span>
                    A reversing journal will be posted and retained
                    in the audit trail. Any tracked stock restored by
                    this credit note will also be reversed.
                </span>
            </div>

            <InputDate
                class="form-control"
                @bind-Value="creditReversalDate" />

            <InputText
                class="form-control reason"
                @bind-Value="creditReversalReason"
                placeholder="Reason for reversal" />

            <button
                class="btn btn-danger"
                @onclick="ReverseCredit">
                Post reversal
            </button>

            <button
                class="btn btn-outline-secondary"
                @onclick="CancelCreditReversal">
                Cancel
            </button>
        </section>
    }
}
}
@code {
    [Parameter]
    public Guid OrganisationId { get; set; }

    [Parameter]
    public Guid InvoiceId { get; set; }

    private AccessibleOrganisation? access;
    private SalesInvoice? invoice;
    private string? logoDataUrl;

    private List<SalesCreditNote> credits = [];
    private Dictionary<Guid, SalesCreditNoteReversal> creditReversals = [];

    private string userId = "";

    private bool canPost;
    private bool showVoid;
    private bool showEmailInvoice;
    private bool sendingInvoiceEmail;
    private bool invoiceEmailSucceeded;
    private string invoiceEmailRecipient = string.Empty;
    private string? invoiceEmailStatus;

    private DateOnly voidDate =
        DateOnly.FromDateTime(DateTime.Today);

    private Guid? reversingCreditId;

    private DateOnly creditReversalDate =
        DateOnly.FromDateTime(DateTime.Today);

    private string creditReversalReason = "";

    private string? status;

    protected override async Task OnParametersSetAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        userId =
            UserManager.GetUserId(state.User)!;

        access =
            await TenantAccess.FindAsync(
                userId,
                OrganisationId);

        if (access is null)
        {
            return;
        }

        canPost =
            await TenantAccess.CanPostJournalsAsync(
                userId,
                OrganisationId);

        var branding = await BrandingService.GetAsync(userId, OrganisationId);
        logoDataUrl = branding is null
            ? null
            : $"data:{branding.LogoContentType};base64,{Convert.ToBase64String(branding.LogoContent)}";

        await Reload();
    }

    private async Task Reload()
    {
        var accessibleDivisionIds = await TenantAccess.ListAccessibleDivisionIdsAsync(userId, OrganisationId);
        invoice =
            await Db.SalesInvoices
                .AsNoTracking()
                .Include(x => x.Customer)
                .Include(x => x.Branch)
                .Include(x => x.Division)
                .Include(x => x.Lines)
                    .ThenInclude(x => x.Project)
                .Include(x => x.Lines)
                    .ThenInclude(x => x.ProjectCostCode)
                .SingleOrDefaultAsync(
                    x =>
                        x.Id == InvoiceId &&
                        x.OrganisationId == OrganisationId &&
                        x.DivisionId != null &&
                        accessibleDivisionIds.Contains(x.DivisionId.Value));

        credits =
            await Db.SalesCreditNotes
                .AsNoTracking()
                .Where(
                    x =>
                        x.SalesInvoiceId == InvoiceId &&
                        x.OrganisationId == OrganisationId)
                .OrderByDescending(x => x.CreditDate)
                .ToListAsync();

        var creditIds =
            credits.Select(x => x.Id).ToArray();

        creditReversals =
            (await Db.SalesCreditNoteReversals
                .AsNoTracking()
                .Where(
                    x =>
                        x.OrganisationId == OrganisationId &&
                        creditIds.Contains(x.SalesCreditNoteId))
                .ToListAsync())
            .ToDictionary(x => x.SalesCreditNoteId);
    }

    private async Task CopyInvoice()
    {
        if (invoice is null || !canPost)
        {
            return;
        }

        try
        {
            var issueDate =
                DateOnly.FromDateTime(DateTime.Today);

            var dueDate =
                issueDate.AddDays(
                    invoice.Customer.DefaultSalesInvoiceDueDays);

            var request =
                new SalesInvoiceRequest(
                    OrganisationId,
                    invoice.CustomerId,
                    issueDate,
                    dueDate,
                    invoice.Lines
                        .Select(line =>
                            new SalesInvoiceLineRequest(
                                line.Description,
                                line.Quantity,
                                line.UnitPrice,
                                line.VatTreatment,
                                line.RevenueAccountId,
                                line.ProductItemId,
                                line.CustomerPurchaseOrderNumber,
                                line.ProjectId,
                                line.ProjectCostCodeId))
                        .ToList(),
                    invoice.BranchId,
                    invoice.DivisionId);

            var copied =
                await InvoiceService.CreateDraftAsync(
                    userId,
                    request);

            Navigation.NavigateTo(
                $"o/{OrganisationId}/sales/{copied.Id}/edit");
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            status = ex.Message;
        }
    }

    private void OpenEmailInvoice()
    {
        if (invoice is null) return;
        invoiceEmailRecipient = invoice.Customer.AccountsEmail ?? invoice.Customer.Email ?? string.Empty;
        invoiceEmailStatus = null;
        invoiceEmailSucceeded = false;
        showEmailInvoice = true;
    }

    private async Task SendInvoiceEmail()
    {
        if (invoice is null || sendingInvoiceEmail) return;
        sendingInvoiceEmail = true;
        invoiceEmailStatus = null;
        try
        {
            await InvoiceEmailSender.SendAsync(userId, OrganisationId, InvoiceId, invoiceEmailRecipient);
            invoiceEmailSucceeded = true;
            invoiceEmailStatus = $"Invoice {invoice.InvoiceNumber} sent to {invoiceEmailRecipient.Trim()}.";
            showEmailInvoice = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            invoiceEmailSucceeded = false;
            invoiceEmailStatus = ex.Message;
        }
        finally
        {
            sendingInvoiceEmail = false;
        }
    }

    private async Task PostDraft()
    {
        try
        {
            await InvoiceService.PostDraftAsync(
                userId,
                OrganisationId,
                InvoiceId);

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            status = ex.Message;
        }
    }

    private async Task VoidInvoice()
    {
        try
        {
            await InvoiceService.VoidAsync(
                userId,
                OrganisationId,
                InvoiceId,
                voidDate);

            showVoid = false;

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            status = ex.Message;
        }
    }

    private static string ProjectLabel(SalesInvoiceLine line) => line.Project is null
        ? "—"
        : $"{line.Project.ProjectNumber}{(line.ProjectCostCode is null ? "" : $" / {line.ProjectCostCode.Code}")}";

    private void OpenCreditReversal(Guid creditNoteId)
    {
        reversingCreditId = creditNoteId;

        creditReversalDate =
            DateOnly.FromDateTime(DateTime.Today);

        creditReversalReason = "";

        showCredit = false;
        showVoid = false;
    }

    private void CancelCreditReversal()
    {
        reversingCreditId = null;
        creditReversalReason = "";
    }

    private async Task ReverseCredit()
    {
        if (reversingCreditId is null)
        {
            return;
        }

        try
        {
            var credit =
                credits.Single(
                    x => x.Id == reversingCreditId.Value);

            await CreditNoteService.ReverseAsync(
                userId,
                OrganisationId,
                reversingCreditId.Value,
                creditReversalDate,
                creditReversalReason);

            reversingCreditId = null;
            creditReversalReason = "";

            status =
                $"Credit note {credit.CreditNoteNumber} reversed.";

            await Reload();
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                  or UnauthorizedAccessException)
        {
            status = ex.Message;
        }
    }
}
