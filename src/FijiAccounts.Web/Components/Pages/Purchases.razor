    private async Task GenerateRecurringBills()
    {
        try
        {
            var generated =
                await RecurringBills.GenerateDueDraftsAsync(
                    userId,
                    OrganisationId,
                    DateOnly.FromDateTime(DateTime.Today));

            await Reload();
            ResetPayment();

            statusClass = "alert-success";
            status = generated.Count == 0
                ? "No recurring supplier bill drafts are due today."
                : $"Generated {generated.Count} supplier bill draft{(generated.Count == 1 ? "" : "s")} for review.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException or
            DomainException or
            DbUpdateException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }
    private async Task SubmitBill()
    {
        if (isRecurringBill)
        {
            await CreateRecurringBill();
            return;
        }

        await PostBill();
    }
    private async Task PostBill()
    {
        try
        {
            var lines =
                new List<SupplierBillLineRequest>
                {
                    new(
                        bill.Description,
                        bill.Quantity,
                        bill.UnitPrice,
                        bill.VatTreatment,
                        bill.ExpenseAccountId,
                        bill.ProductItemId)
                };

            lines.AddRange(
                additionalBillLines.Select(
                    x =>
                        new SupplierBillLineRequest(
                            x.Description,
                            x.Quantity,
                            x.UnitPrice,
                            x.VatTreatment,
                            x.ExpenseAccountId,
                            x.ProductItemId)));

            var request =
                new SupplierBillRequest(
                    OrganisationId,
                    bill.SupplierId,
                    bill.SupplierReference,
                    bill.BillDate,
                    bill.DueDate,
                    lines,
                    DivisionId: bill.DivisionId);

            SupplierBill result;
            SupplierBillAttachmentRequest? attachment =
                pendingAttachment is null
                    ? null
                    : new SupplierBillAttachmentRequest(
                        pendingAttachment.FileName,
                        pendingAttachment.ContentType,
                        pendingAttachment.OriginalSize,
                        pendingAttachment.Content,
                        pendingAttachment.IsCompressed);

            if (editingDraftId is Guid draftId)
            {
                result =
                    await Purchasing.PostDraftBillAsync(
                        userId,
                        draftId,
                        request,
                        attachment);
            }
            else
            {
                result = attachment is null
                    ? await Purchasing.PostBillAsync(userId, request)
                    : await Purchasing.PostBillAsync(userId, request, attachment);
            }

            var hadAttachment =
                pendingAttachment is not null;

            await BusinessParties.LearnSupplierPurchaseDefaultsAsync(
                userId,
                new LearnSupplierPurchaseDefaultsRequest(
                    OrganisationId,
                    bill.SupplierId,
                    bill.ExpenseAccountId,
                    bill.VatTreatment));

            ResetBillForm();
            showBillForm = false;

            await Reload();
            ResetPayment();

            statusClass =
                "alert-success";

            status =
                $"{result.BillNumber} posted for ${result.Total:N2}" +
                (hadAttachment
                    ? " with its attachment."
                    : ".");
        }
        catch (Exception ex)
            when (ex is InvalidOperationException
                or UnauthorizedAccessException
                or DomainException
                or DbUpdateException)
        {
            statusClass =
                "alert-danger";

            status =
                ex.Message;
        }
    }
    private async Task PayBill() { try { var result = await Purchasing.PayBillAsync(userId, new(OrganisationId, payment.BillId, payment.Date, payment.Reference, payment.Amount, payment.BankAccountId)); statusClass="alert-success"; status=$"Payment {result.Reference} recorded for ${result.Amount:N2}."; await Reload(); ResetPayment(); } catch(Exception ex) when(ex is InvalidOperationException or UnauthorizedAccessException or DomainException) { statusClass="alert-danger"; status=ex.Message; } }
    private static bool IsOverdue(SupplierBill item) => item.Status is not BillStatus.Paid and not BillStatus.Credited and not BillStatus.Voided && item.DueDate < DateOnly.FromDateTime(DateTime.Today) && item.AmountPaid + item.AmountCredited < item.Total;
    private int OverdueCount => bills.Count(IsOverdue);
    private decimal OverdueTotal => bills.Where(IsOverdue).Sum(x => x.Total - x.AmountPaid - x.AmountCredited);
