@page "/o/{OrganisationId:guid}/purchases"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.IO.Compression
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@using UglyToad.PdfPig
@using UglyToad.PdfPig.DocumentLayoutAnalysis.TextExtractor
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject PurchasingService Purchasing
@inject RecurringSupplierBillService RecurringBills
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Purchases · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> }
else
{
    <div class="page-heading"><div><p class="eyebrow">Money out</p><h1>Supplier bills</h1><p class="page-intro">Capture expenses, see what is due, and record supplier payments.</p></div><div class="d-flex gap-2"><button type="button" class="btn btn-primary" @onclick="StartNewBill">+ New bill</button>@if (bills.Count > 0) { <a class="btn btn-outline-primary" href="o/@OrganisationId/purchases/@bills[0].Id">View latest bill</a> }</div></div>
    <div class="bill-summary">
        <article><span>Total bills</span><strong>$@bills.Sum(x => x.Total).ToString("N2")</strong><small>@bills.Count bill@(bills.Count == 1 ? "" : "s")</small></article>
        <article><span>Outstanding</span><strong>$@bills.Where(x => x.Status != BillStatus.Voided).Sum(x => x.Total - x.AmountPaid - x.AmountCredited).ToString("N2")</strong><small>Still to pay</small></article>
        <article class="@(OverdueTotal > 0 ? "needs-attention" : null)"><span>Overdue</span><strong>$@OverdueTotal.ToString("N2")</strong><small>@OverdueCount bill@(OverdueCount == 1 ? "" : "s") past due</small></article>
    </div>
        RenderFragment supplierBillEditor = @<text>
        <div class="setup-card mb-5" id="new-bill">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2>@(editingRecurringBillId is not null ? "Edit recurring bill" : editingDraftId is null ? "New supplier bill" : "Edit draft bill")</h2>
                    <p class="text-muted">Enter the bill or attach a document to prefill it. Nothing is posted until you approve it.</p>
                </div>
                <div class="d-flex gap-2">
                    @if (editingDraftId is null)
                    {
                        <button type="button"
                                class="btn @(isRecurringBill ? "btn-primary" : "btn-outline-primary")"
                                @onclick="ToggleRecurringBill">
                            @(isRecurringBill ? "Recurring bill" : "Make recurring")
                        </button>
                    }
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseBillForm">
                        Close
                    </button>
                </div>
            </div>

            <EditForm Model="bill"
                      OnValidSubmit="SubmitBill"
                      FormName="supplier-bill">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <CatalogProductPicker OrganisationId="OrganisationId"
                                      ForPurchases="true"
                                      OnSelected="AddPurchaseProduct" />
            <div class="mb-3"><label class="form-label">Supplier</label><InputSelect class="form-select" @bind-Value="bill.SupplierId" @bind-Value:after="ApplySelectedSupplierDefaults"><option value="@Guid.Empty">Choose a supplier</option>@foreach (var supplier in suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</InputSelect></div>
            <div class="row"><div class="col-md-4 mb-3"><label class="form-label">Supplier reference</label><InputText class="form-control" @bind-Value="bill.SupplierReference" /></div><div class="col-md-4 mb-3"><label class="form-label">Bill date</label><InputDate class="form-control" @bind-Value="bill.BillDate" /></div><div class="col-md-4 mb-3"><label class="form-label">Due date</label><InputDate class="form-control" @bind-Value="bill.DueDate" /></div></div>

            @if (isRecurringBill)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Recurring options</strong>
                            <div class="text-muted small">
                                These settings control future bills generated from this template.
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="ToggleRecurringBill">
                            Remove recurring
                        </button>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Frequency</label>
                            <InputSelect class="form-select"
                                         @bind-Value="recurringBill.Frequency">
                                @foreach (var frequency in Enum.GetValues<RecurringSupplierBillFrequency>())
                                {
                                    <option value="@frequency">@frequency</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Start date</label>
                            <InputDate class="form-control"
                                       @bind-Value="recurringBill.StartDate" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Due days</label>
                            <InputNumber class="form-control"
                                         @bind-Value="recurringBill.DueDays" />
                        </div>
                    </div>
                </div>
            }
            <div class="mb-3"><label class="form-label">Description</label><InputText class="form-control" @bind-Value="bill.Description" /></div>
            <div class="row"><div class="col-md-3 mb-3"><label class="form-label">Quantity</label><InputNumber class="form-control" @bind-Value="bill.Quantity" /></div><div class="col-md-3 mb-3"><label class="form-label">Unit price excl. VAT</label><InputNumber class="form-control" @bind-Value="bill.UnitPrice" /></div><div class="col-md-3 mb-3"><label class="form-label">VAT</label><InputSelect class="form-select" @bind-Value="bill.VatTreatment">@foreach (var item in Enum.GetValues<VatTreatment>()) { <option value="@item">@item</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Account</label><InputSelect class="form-select" @bind-Value="bill.ExpenseAccountId">@foreach (var account in expenseAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div></div>
            @for (var index = 0; index < additionalBillLines.Count; index++) { var line = additionalBillLines[index]; var captured = index; <div class="row border-top pt-3 mt-2"><div class="col-md-4 mb-3"><label class="form-label">Additional description</label><InputText class="form-control" @bind-Value="line.Description" /></div><div class="col-md-2 mb-3"><label class="form-label">Quantity</label><InputNumber class="form-control" @bind-Value="line.Quantity" /></div><div class="col-md-2 mb-3"><label class="form-label">Unit price</label><InputNumber class="form-control" @bind-Value="line.UnitPrice" /></div><div class="col-md-2 mb-3"><label class="form-label">Tax</label><InputSelect class="form-select" @bind-Value="line.VatTreatment">@foreach (var item in Enum.GetValues<VatTreatment>()) { <option value="@item">@item</option> }</InputSelect></div><div class="col-md-2 mb-3"><label class="form-label">Account</label><InputSelect class="form-select" @bind-Value="line.ExpenseAccountId">@foreach (var account in expenseAccounts) { <option value="@account.Id">@account.Code</option> }</InputSelect><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => RemoveBillLine(captured)">Remove</button></div></div> }
            @if (!isRecurringBill)
            {
                <div class="bill-attachment mb-4"><label class="bill-drop-zone"><InputFile class="bill-file-input" OnChange="SelectBillAttachment" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx,.csv" /><strong>Drop the supplier invoice or receipt here</strong><span>or click to choose a file. Searchable PDFs and CSV files will be read to prefill the form. Maximum 10 MB.</span></label>@if (pendingAttachment is not null) { <div class="selected-attachment"><div><strong>@pendingAttachment.FileName</strong><span>@FormatBytes(pendingAttachment.OriginalSize) · @(pendingAttachment.IsCompressed ? $"compressed to {FormatBytes(pendingAttachment.Content.LongLength)}" : "already compact")</span></div><button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveAttachment">Remove</button></div> }@if (documentReadMessage is not null) { <div class="alert alert-info mt-2 mb-0">@documentReadMessage</div> }@if (attachmentError is not null) { <div class="text-danger mt-2">@attachmentError</div> }</div>
            }
            <div class="d-flex justify-content-between align-items-center">
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="AddBillLine">
                    + Add bill line
                </button>

                <div>
                    <strong class="me-3">
                        Subtotal $@BillSubtotal.ToString("N2")
                    </strong>

                    @if (!isRecurringBill)
                    {
                        <button type="button"
                                class="btn btn-outline-primary me-2"
                                @onclick="SaveDraft">
                            @(editingDraftId is null ? "Save draft" : "Update draft")
                        </button>

                        <button class="btn btn-primary">
                            Approve and post bill
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary">
                            @(editingRecurringBillId is not null
                                ? "Update recurring bill"
                                : "Create recurring bill")
                        </button>
                    }
                </div>
            </div>
        </EditForm></div>

    </text>;

    @if (showBillForm && editingDraftId is null && editingRecurringBillId is null && canPost && suppliers.Count > 0 && expenseAccounts.Count > 0)
    {
        @supplierBillEditor
    }    else if (showBillForm && suppliers.Count == 0) { <div class="alert alert-info">Add a supplier first. <a href="o/@OrganisationId/contacts">Open contacts</a></div> }

    @if (canPost && openBills.Count > 0 && bankAccounts.Count > 0)
    {
        <div class="setup-card mb-5"><h2>Pay supplier bill</h2><EditForm Model="payment" OnValidSubmit="PayBill" FormName="supplier-payment"><DataAnnotationsValidator /><ValidationSummary />
            <div class="mb-3"><label class="form-label">Bill</label><InputSelect class="form-select" @bind-Value="payment.BillId" @bind-Value:after="SetOutstanding">@foreach (var item in openBills) { <option value="@item.Id">@item.BillNumber — @item.Supplier.Name — $@((item.Total-item.AmountPaid-item.AmountCredited).ToString("N2")) due</option> }</InputSelect></div>
            <div class="row"><div class="col-md-3 mb-3"><label class="form-label">Date</label><InputDate class="form-control" @bind-Value="payment.Date" /></div><div class="col-md-3 mb-3"><label class="form-label">Reference</label><InputText class="form-control" @bind-Value="payment.Reference" /></div><div class="col-md-3 mb-3"><label class="form-label">Bank account</label><InputSelect class="form-select" @bind-Value="payment.BankAccountId">@foreach (var account in bankAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-3 mb-3"><label class="form-label">Amount</label><InputNumber class="form-control" @bind-Value="payment.Amount" /></div></div>
            <button class="btn btn-primary">Record payment</button>
        </EditForm></div>
    }
    @if (canPost)
    {
        <div class="setup-card mb-5">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h2>Recurring bills</h2>
                    <p class="text-muted mb-0">
                        Existing supplier bill schedules.
                    </p>
                </div>

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="GenerateRecurringBills">
                    Generate due bills
                </button>
            </div>

            @if (recurringBills.Count == 0)
            {
                <div class="empty-state">
                    <strong>No recurring supplier bills yet</strong>
                    <span>Open New bill and choose Make recurring to create one.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Supplier</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Frequency</th>
                                <th>Next bill</th>
                                <th>Due terms</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recurringBills)
                            {
                                <tr>
                                    <td>@item.Supplier.Name</td>
                                    <td>@item.SupplierReference</td>
                                    <td>
                                        @if (item.Status == RecurringSupplierBillStatus.Active)
                                        {
                                            <span class="status-badge status-paid">Active</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-draft">Paused</span>
                                        }
                                    </td>
                                    <td>@item.Frequency</td>
                                    <td>@item.NextBillDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.DueDays day@(item.DueDays == 1 ? "" : "s")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => EditRecurringBill(item)">
                                                Edit
                                            </button>

                                            @if (item.Status == RecurringSupplierBillStatus.Active)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => PauseRecurringBill(item)">
                                                    Pause
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EndRecurringBill(item)">
                                                    End
                                                </button>
                                            }
                                            else if (item.Status == RecurringSupplierBillStatus.Paused)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success"
                                                        @onclick="() => ResumeRecurringBill(item)">
                                                    Resume
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EndRecurringBill(item)">
                                                    End
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @if (showBillForm &&
                                     editingRecurringBillId == item.Id)
                                {
                                    <tr>
                                        <td colspan="7"
                                            class="p-0 border-0">
                                            <div class="mt-3 mb-4">
                                                @supplierBillEditor
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    @if (status is not null) { <div class="alert @statusClass">@status</div> }
@if (drafts.Count > 0)
{
    <section class="bill-list bill-register mb-4">
        <div class="list-heading">
            <div>
                <h2>Drafts</h2>
                <p>Supplier bills saved for later</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="status-badge status-draft">
                    @drafts.Count draft@(drafts.Count == 1 ? "" : "s")
                </span>

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="() => showDrafts = !showDrafts">
                    @(showDrafts
                        ? "Hide drafts"
                        : "Open drafts")
                </button>
            </div>
        </div>

        @if (showDrafts)
        {
            <div class="table-responsive">
                <table class="table bill-register-table">
                    <thead>
                        <tr>
                            <th>View</th>
                            <th>From</th>
                            <th>Status</th>
                            <th>Reference</th>
                            <th>Date</th>
                            <th>Due date</th>
                            <th class="text-end">Due</th>
                            <th class="text-center">Files</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in drafts)
                        {
                            <tr>
                                <td>
                                    <div class="bill-view-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="Open draft"
                                                @onclick="() => EditDraft(item)">
                                            View
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete draft"
                                                @onclick="() => DeleteDraft(item.Id)">
                                            ×
                                        </button>
                                    </div>
                                </td>

                                <td class="bill-register-from">
                                    @(item.Supplier?.Name ?? "Supplier not selected")
                                </td>

                                <td>
                                    <span class="status-badge status-draft">
                                        Draft
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.SupplierReference)
                                        ? "—"
                                        : item.SupplierReference)
                                </td>

                                <td>@item.BillDate.ToString("dd MMM yyyy")</td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>

                                <td class="text-end outstanding">
                                    $@DraftTotal(item).ToString("N2")
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="bill-file-link"
                                            title="Open draft attachments"
                                            @onclick="() => EditDraft(item)">
                                        <span>@(item.AttachmentContent is null ? 0 : 1)</span>
                                        <span aria-hidden="true">&#128196;</span>
                                    </button>
                                </td>
                            </tr>

                            @if (showBillForm &&
                                 editingDraftId == item.Id)
                            {
                                <tr>
                                    <td colspan="8"
                                        class="p-0 border-0">
                                        <div class="mt-3 mb-4">
                                            @supplierBillEditor
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<section class="bill-list bill-register">
    <div class="list-heading">
        <div>
            <h2>Bills</h2>
            <p>Awaiting payment and paid supplier bills</p>
        </div>

        <span class="status-badge status-draft">
            @bills.Count total
        </span>
    </div>

    @if (bills.Count == 0)
    {
        <div class="empty-state">
            <strong>No posted supplier bills yet</strong>
            <span>Create a new bill and approve it when ready.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table bill-register-table">
                <thead>
                    <tr>
                        <th>View</th>
                        <th>From</th>
                        <th>Status</th>
                        <th>Reference</th>
                        <th>Date</th>
                        <th>Due date</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Due</th>
                        <th class="text-center">Files</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in bills)
                    {
                        <tr class="@(IsOverdue(item) ? "overdue-row" : null)">
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   title="View bill"
                                   href="o/@OrganisationId/purchases/@item.Id">
                                    View
                                </a>
                            </td>

                            <td class="bill-register-from">
                                @item.Supplier.Name
                            </td>

                            <td>
                                <span class="status-badge @BillRegisterStatusClass(item)">
                                    @BillRegisterStatus(item)
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.SupplierReference)
                                    ? item.BillNumber
                                    : item.SupplierReference)
                            </td>

                            <td>@item.BillDate.ToString("dd MMM yyyy")</td>
                            <td>@item.DueDate.ToString("dd MMM yyyy")</td>

                            <td class="text-end">
                                $@item.AmountPaid.ToString("N2")
                            </td>

                            <td class="text-end outstanding">
                                $@Outstanding(item).ToString("N2")
                            </td>

                            <td class="text-center">
                                <a class="bill-file-link"
                                   title="View bill attachments"
                                   href="o/@OrganisationId/purchases/@item.Id">
                                    <span>@item.Attachments.Count</span>
                                    <span aria-hidden="true">&#128196;</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }
    private const long MaxAttachmentBytes = 10 * 1024 * 1024;
    private static readonly HashSet<string> AllowedAttachmentExtensions = new(StringComparer.OrdinalIgnoreCase) { ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".doc", ".docx", ".xls", ".xlsx", ".csv" };
private AccessibleOrganisation? access; private string userId = string.Empty; private bool canPost; private bool showBillForm; private bool showDrafts; private bool isRecurringBill; private List<BusinessParty> suppliers = []; private List<LedgerAccount> expenseAccounts = [], bankAccounts = []; private List<SupplierBill> bills = [], openBills = []; private List<SupplierBillDraft> drafts = []; private List<RecurringSupplierBill> recurringBills = []; private Guid? editingDraftId; private Guid? editingRecurringBillId; private BillModel bill = new(); private List<BillLineModel> additionalBillLines = []; private PaymentModel payment = new(); private RecurringBillModel recurringBill = new(); private PendingAttachment? pendingAttachment; private string? attachmentError; private string? documentReadMessage; private string? status; private string statusClass = "alert-success"; private decimal BillSubtotal => bill.Quantity * bill.UnitPrice + additionalBillLines.Sum(x => x.Quantity * x.UnitPrice);
protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); userId = UserManager.GetUserId(state.User)!; access = await TenantAccess.FindAsync(userId, OrganisationId); if (access is null) return; canPost = await TenantAccess.CanPostJournalsAsync(userId, OrganisationId); suppliers = await Db.BusinessParties.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type & PartyType.Supplier) != 0).OrderBy(x => x.Name).ToListAsync(); expenseAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && (x.Type == AccountType.Expense || x.Code == "1200" || x.Code == "1500")).OrderBy(x => x.Code).ToListAsync(); bankAccounts = await Db.LedgerAccounts.AsNoTracking().Where(x => x.OrganisationId == OrganisationId && x.IsActive && x.IsBankAccount).OrderBy(x => x.Code).ToListAsync(); await Reload(); ResetBillForm(); ResetPayment(); ResetRecurringBill(); showBillForm = false; }
    private async Task Reload() { bills = (await Db.SupplierBills.AsNoTracking().Include(x => x.Supplier).Include(x => x.Attachments).Where(x => x.OrganisationId == OrganisationId).ToListAsync()).OrderByDescending(x => x.SequenceNumber).Take(100).ToList(); drafts = (await Db.SupplierBillDrafts.AsNoTracking().Include(x => x.Supplier).Where(x => x.OrganisationId == OrganisationId).ToListAsync()).OrderByDescending(x => x.UpdatedAt).ToList(); recurringBills = await Db.RecurringSupplierBills.AsNoTracking().Include(x => x.Supplier).Include(x => x.Lines).Where(x => x.OrganisationId == OrganisationId && x.Status != RecurringSupplierBillStatus.Ended).OrderBy(x => x.Status).ThenBy(x => x.NextBillDate).ToListAsync(); openBills = bills.Where(x => x.Status is BillStatus.Posted or BillStatus.PartPaid).Where(x => Outstanding(x) > 0).OrderBy(x => x.DueDate).ToList(); }

    private static decimal Outstanding(SupplierBill item) => Math.Max(0m, item.Total - item.AmountPaid - item.AmountCredited);
    private string BillRegisterStatus(SupplierBill item) => IsOverdue(item) ? "Overdue" : item.Status switch { BillStatus.Posted => "Awaiting payment", BillStatus.PartPaid => "Part paid", BillStatus.Paid => "Paid", BillStatus.Credited => "Credited", BillStatus.Voided => "Voided", _ => item.Status.ToString() };
    private string BillRegisterStatusClass(SupplierBill item) => IsOverdue(item) ? "status-overdue" : item.Status switch { BillStatus.Posted => "status-awaiting", BillStatus.PartPaid => "status-partpaid", BillStatus.Paid => "status-paid", BillStatus.Credited => "status-credited", BillStatus.Voided => "status-voided", _ => "status-draft" };
    private void ResetBillForm() { bill = new BillModel { SupplierId = Guid.Empty, ExpenseAccountId = expenseAccounts.FirstOrDefault()?.Id ?? Guid.Empty, VatTreatment = VatTreatment.Standard }; additionalBillLines = []; editingDraftId = null; editingRecurringBillId = null; pendingAttachment = null; attachmentError = null; documentReadMessage = null; isRecurringBill = false; ResetRecurringBill(); }
    private void ResetPayment() { payment = new(); if (openBills.Count > 0) { payment.BillId = openBills[0].Id; SetOutstanding(); } if (bankAccounts.Count > 0) payment.BankAccountId = bankAccounts[0].Id; }
    private void ResetRecurringBill()
    {
        recurringBill = new RecurringBillModel();
    }
