    private static decimal DraftTotal(SupplierBillDraft draft)
    {
        var total = draft.Quantity * draft.UnitPrice;
        try { total += JsonSerializer.Deserialize<List<DraftLineData>>(draft.AdditionalLinesJson)?.Sum(x => x.Quantity * x.UnitPrice) ?? 0; } catch (JsonException) { }
        return total;
    }
    private async Task<SupplierCodingSuggestion?> GetSupplierCodingSuggestionAsync(Guid supplierId)
    {
        if (supplierId == Guid.Empty) return null;
        var supplier = suppliers.FirstOrDefault(x => x.Id == supplierId);
        if (supplier is null) return null;

        Guid? accountId = supplier.DefaultPurchaseAccountId is Guid defaultAccountId && expenseAccounts.Any(x => x.Id == defaultAccountId)
            ? defaultAccountId
            : null;
        var vatTreatment = supplier.DefaultPurchaseVatTreatment;
        var source = supplier.DefaultPurchaseAccountId is not null || supplier.DefaultPurchaseVatTreatment is not null
            ? "supplier settings"
            : null;

        if (accountId is not null && vatTreatment is not null) return new SupplierCodingSuggestion(accountId, vatTreatment, source ?? "supplier settings");

        var previousLine = await Db.SupplierBillLines.AsNoTracking()
            .Where(x => x.SupplierBill.OrganisationId == OrganisationId && x.SupplierBill.SupplierId == supplierId)
            .OrderByDescending(x => x.SupplierBill.SequenceNumber)
            .ThenByDescending(x => x.Id)
            .Select(x => new { x.ExpenseAccountId, x.VatTreatment })
            .FirstOrDefaultAsync();
        if (previousLine is null)
        {
            if (accountId is null && vatTreatment is null) return null;
            return new SupplierCodingSuggestion(accountId, vatTreatment, source ?? "latest supplier coding");
        }

        Guid? fallbackAccount = expenseAccounts.Any(x => x.Id == previousLine.ExpenseAccountId) ? previousLine.ExpenseAccountId : null;
        var fallbackVat = vatTreatment ?? previousLine.VatTreatment;
        var combinedSource = source is null
            ? "latest supplier coding"
            : accountId is null || vatTreatment is null
                ? $"{source}; latest supplier coding"
                : source;

        return new SupplierCodingSuggestion(
            ExpenseAccountId: accountId ?? fallbackAccount,
            VatTreatment: fallbackVat,
            Source: combinedSource);
    }
    private async Task CreateRecurringBill()
    {
        try
        {
            var lines =
                new List<RecurringSupplierBillLineRequest>
                {
                    new(
                        bill.Description,
                        bill.Quantity,
                        bill.UnitPrice,
                        bill.VatTreatment,
                        bill.ExpenseAccountId,
                        bill.ProductItemId)
                };

            lines.AddRange(
                additionalBillLines.Select(
                    x =>
                        new RecurringSupplierBillLineRequest(
                            x.Description,
                            x.Quantity,
                            x.UnitPrice,
                            x.VatTreatment,
                            x.ExpenseAccountId,
                            x.ProductItemId)));

            var request =
                new RecurringSupplierBillRequest(
                    OrganisationId,
                    bill.SupplierId,
                    bill.SupplierReference,
                    recurringBill.Frequency,
                    recurringBill.StartDate,
                    recurringBill.DueDays,
                    lines);

            var wasEditing =
                editingRecurringBillId is not null;

            if (editingRecurringBillId is Guid recurringId)
            {
                await RecurringBills.UpdateAsync(
                    userId,
                    recurringId,
                    request);
            }
            else
            {
                await RecurringBills.CreateAsync(
                    userId,
                    request);
            }

            await Reload();

            ResetBillForm();
            showBillForm = false;

            statusClass = "alert-success";
            status = wasEditing
                ? "Recurring supplier bill updated."
                : "Recurring supplier bill created.";
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException or
            DbUpdateException)
        {
            statusClass = "alert-danger";
            status = ex.Message;
        }
    }
    private void EditRecurringBill(
        RecurringSupplierBill item)
    {
        ResetBillForm();

        editingRecurringBillId =
            item.Id;

        isRecurringBill = true;

        var firstLine =
            item.Lines.FirstOrDefault();

        bill.SupplierId =
            item.SupplierId;

        bill.SupplierReference =
            item.SupplierReference;

        bill.BillDate =
            item.NextBillDate;

        bill.DueDate =
            item.NextBillDate.AddDays(
                item.DueDays);

        if (firstLine is not null)
        {
            bill.Description =
                firstLine.Description;

            bill.Quantity =
                firstLine.Quantity;

            bill.UnitPrice =
                firstLine.UnitPrice;

            bill.VatTreatment =
                firstLine.VatTreatment;

            bill.ExpenseAccountId =
                firstLine.ExpenseAccountId;

            bill.ProductItemId =
                firstLine.ProductItemId;
        }

        additionalBillLines =
            item.Lines
                .Skip(1)
                .Select(x =>
                    new BillLineModel
                    {
                        Description =
                            x.Description,
                        Quantity =
                            x.Quantity,
                        UnitPrice =
                            x.UnitPrice,
                        VatTreatment =
                            x.VatTreatment,
                        ExpenseAccountId =
                            x.ExpenseAccountId,
                        ProductItemId =
                            x.ProductItemId
                    })
                .ToList();

        recurringBill.Frequency =
            item.Frequency;

        recurringBill.StartDate =
            item.NextBillDate;

        recurringBill.DueDays =
            item.DueDays;

        status = null;
        showBillForm = true;
    }
