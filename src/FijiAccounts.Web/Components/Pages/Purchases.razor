    private async Task SelectBillAttachment(InputFileChangeEventArgs args)
    {
        attachmentError = null;
        documentReadMessage = null;

        if (args.FileCount != 1)
        {
            pendingAttachment = null;
            attachmentError = "Drop or choose one supplier invoice at a time.";
            ResetBillAttachmentInput();
            return;
        }

        var file = args.File;
        if (!AllowedAttachmentExtensions.Contains(Path.GetExtension(file.Name))) { pendingAttachment = null; attachmentError = "Choose a PDF, image, Office document or CSV file."; ResetBillAttachmentInput(); return; }
        if (file.Size > MaxAttachmentBytes) { pendingAttachment = null; attachmentError = "The attachment must be 10 MB or smaller."; ResetBillAttachmentInput(); return; }
        try
        {
            await using var input = file.OpenReadStream(MaxAttachmentBytes);
            using var original = new MemoryStream();
            await input.CopyToAsync(original);
            var originalBytes = original.ToArray();

            isReadingBillAttachment = true;
            await InvokeAsync(StateHasChanged);
            await PopulateBillFromDocument(file.Name, originalBytes);

            using var compressed = new MemoryStream();
            await using (var brotli = new BrotliStream(compressed, CompressionLevel.SmallestSize, leaveOpen: true)) await brotli.WriteAsync(originalBytes);
            var compressedBytes = compressed.ToArray();
            var useCompression = compressedBytes.Length < originalBytes.Length;
            pendingAttachment = new(Path.GetFileName(file.Name), string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType, originalBytes.LongLength, useCompression ? compressedBytes : originalBytes, useCompression);
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or InvalidOperationException)
        {
            pendingAttachment = null;
            attachmentError = "We could not read that attachment. Please drop or choose the file again.";
        }
        finally
        {
            isReadingBillAttachment = false;
            ResetBillAttachmentInput();
        }
    }
    private async Task PopulateBillFromDocument(string fileName, byte[] content)
    {
        documentReadMessage = null;
        var extension = Path.GetExtension(fileName);
        string text;
        try
        {
            if (extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                using var stream = new MemoryStream(content);
                using var document = PdfDocument.Open(stream);
                var extracted = new StringBuilder();
                foreach (var page in document.GetPages()) extracted.AppendLine(ContentOrderTextExtractor.GetText(page));
                text = extracted.ToString();
            }
            else if (extension.Equals(".csv", StringComparison.OrdinalIgnoreCase)) text = Encoding.UTF8.GetString(content);
            else
            {
                documentReadMessage = "File attached. Automatic prefilling currently supports searchable PDFs and CSV files. Please enter and check the bill details before posting.";
                return;
            }
        }
        catch
        {
            documentReadMessage = "File attached, but its text could not be read. Please enter the bill details manually; the original file will still be stored with the bill.";
            return;
        }

        if (string.IsNullOrWhiteSpace(text) || text.Count(char.IsLetterOrDigit) < 20)
        {
            documentReadMessage = "File attached, but it appears to be a scanned image rather than a searchable document. Please enter the bill details manually.";
            return;
        }

        var populated = new List<string>();
        var normalizedText = NormalizeDocumentText(text);
        var matchedSupplier = suppliers
            .OrderByDescending(x => NormalizeDocumentText(x.Name).Length)
            .FirstOrDefault(x => normalizedText.Contains(NormalizeDocumentText(x.Name), StringComparison.Ordinal));
        if (matchedSupplier is not null)
        {
            bill.SupplierId = matchedSupplier.Id;
            populated.Add("supplier");
            var suggestion = await GetSupplierCodingSuggestionAsync(matchedSupplier.Id);
            if (suggestion is not null)
            {
                if (suggestion.ExpenseAccountId is not null) bill.ExpenseAccountId = suggestion.ExpenseAccountId.Value;
                if (suggestion.VatTreatment is not null) bill.VatTreatment = suggestion.VatTreatment.Value;
                populated.Add(suggestion.Source);
            }
        }

        var reference = SupplierBillDocumentFieldParser.ExtractReference(text, fileName);
        if (reference is not null) { bill.SupplierReference = reference; populated.Add("reference"); }
        if (TryExtractDate(text, @"(?:invoice\s+date|bill\s+date|issue\s+date|date\s+issued)", out var billDate)) { bill.BillDate = billDate; populated.Add("bill date"); }
        if (TryExtractDate(text, @"(?:due\s+date|date\s+due|payment\s+due|pay(?:able)?\s+by|due\s+on)", out var dueDate)) { bill.DueDate = dueDate; populated.Add("due date"); }
        else if (TryExtractPaymentTerms(text, out var paymentDays)) { bill.DueDate = bill.BillDate.AddDays(paymentDays); populated.Add($"due date from {paymentDays}-day terms"); }

        bill.Description = Path.GetFileNameWithoutExtension(fileName);
        populated.Add("description");
        var hasGross = TryExtractMoney(text, @"(?:amount\s+due|total\s+due|grand\s+total|invoice\s+(?:total|amount)|total\s+(?:amount|incl(?:uding)?\s+(?:vat|tax))|balance\s+due)", out var gross);
        var hasNet = TryExtractMoney(text, @"(?:sub\s*total|net\s+(?:total|amount)|total\s+excl(?:uding)?\s+(?:vat|tax))", out var net);
        var hasVat = TryExtractMoney(text, @"(?:(?:total\s+)?vat|tax)\s*(?:total|amount)?", out var vat);
        if (hasNet || hasGross)
        {
            if (hasNet)
            {
                bill.UnitPrice = net;
                if (hasVat) bill.VatTreatment = vat > 0 ? VatTreatment.Standard : VatTreatment.OutOfScope;
                populated.Add(hasVat ? "cost and VAT" : "cost");
            }
            else if (hasVat && vat >= 0 && gross >= vat)
            {
                bill.UnitPrice = gross - vat;
                bill.VatTreatment = vat > 0 ? VatTreatment.Standard : VatTreatment.OutOfScope;
                populated.Add("cost and VAT");
            }
            else if (Regex.IsMatch(text, @"(?i)(?:incl(?:uding)?\s+(?:vat|tax)|(?:vat|tax)\s+inclusive)"))
            {
                bill.UnitPrice = decimal.Round(gross / 1.125m, 2, MidpointRounding.AwayFromZero);
                bill.VatTreatment = VatTreatment.Standard;
                populated.Add("VAT-inclusive cost");
            }
            else { bill.UnitPrice = gross; populated.Add("cost"); }
        }

        documentReadMessage = populated.Count == 0
            ? "File attached, but no reliable bill details were found. Please enter them manually."
            : $"Prefilled {string.Join(", ", populated.Distinct())}. Please review every field, especially the amount, VAT and account, before approving.";
    }
    private static string NormalizeDocumentText(string value) => Regex.Replace(value.ToUpperInvariant(), @"[^A-Z0-9]+", " ").Trim();
    private static bool TryExtractDate(string text, string labelPattern, out DateOnly value)
    {
        value = default;
        var match = Regex.Match(text, $@"(?im){labelPattern}\s*[:\-]?\s*(\d{{1,2}}[/-]\d{{1,2}}[/-]\d{{2,4}}|\d{{1,2}}\s+[A-Za-z]{{3,9}}\s+\d{{2,4}}|\d{{4}}-\d{{1,2}}-\d{{1,2}})");
        if (!match.Success) return false;
        var formats = new[] { "d/M/yyyy", "dd/MM/yyyy", "d-M-yyyy", "dd-MM-yyyy", "d MMM yyyy", "dd MMM yyyy", "d MMMM yyyy", "dd MMMM yyyy", "yyyy-M-d", "yyyy-MM-dd", "d/M/yy", "dd/MM/yy" };
        return DateOnly.TryParseExact(match.Groups[1].Value.Trim(), formats, CultureInfo.GetCultureInfo("en-AU"), DateTimeStyles.AllowWhiteSpaces, out value);
    }
    private static bool TryExtractPaymentTerms(string text, out int days)
    {
        days = 0;
        var match = Regex.Match(text, @"(?im)(?:payment\s+terms?|terms?)\s*[:\-]?\s*(?:net\s*)?(\d{1,3})\s*days?");
        if (!match.Success) match = Regex.Match(text, @"(?im)due\s+(?:within|in)\s+(\d{1,3})\s*days?");
        return match.Success && int.TryParse(match.Groups[1].Value, out days) && days is >= 0 and <= 365;
    }
    private static bool TryExtractMoney(string text, string labelPattern, out decimal value)
    {
        value = 0;
        const string amount = @"(?:FJD\s*|\$\s*)?([0-9][0-9,]*\.\d{2})";
        var match = Regex.Match(text, $@"(?im){labelPattern}[^\r\n0-9]{{0,80}}{amount}");
        if (!match.Success) match = Regex.Match(text, $@"(?im){amount}[^\r\nA-Za-z]{{0,20}}{labelPattern}");
        return match.Success && decimal.TryParse(match.Groups[1].Value.Replace(",", ""), NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }
