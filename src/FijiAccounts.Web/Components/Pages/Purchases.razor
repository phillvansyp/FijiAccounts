    private async Task SaveDraft()
    {
        try
        {
            var draft = editingDraftId is Guid id
                ? await Db.SupplierBillDrafts.SingleOrDefaultAsync(x => x.Id == id && x.OrganisationId == OrganisationId)
                : null;
            var isNew = draft is null;
            if (draft is null)
            {
                draft = new SupplierBillDraft { OrganisationId = OrganisationId, CreatedByUserId = userId };
                Db.SupplierBillDrafts.Add(draft);
            }
            draft.SupplierId = bill.SupplierId == Guid.Empty ? null : bill.SupplierId;
            draft.SupplierReference = bill.SupplierReference.Trim();
            draft.BillDate = bill.BillDate;
            draft.DueDate = bill.DueDate;
            draft.Description = bill.Description.Trim();
            draft.Quantity = bill.Quantity;
            draft.UnitPrice = bill.UnitPrice;
            draft.VatTreatment = bill.VatTreatment;
            draft.ExpenseAccountId = bill.ExpenseAccountId == Guid.Empty ? null : bill.ExpenseAccountId;
            draft.ProductItemId = bill.ProductItemId;
            draft.AdditionalLinesJson = JsonSerializer.Serialize(additionalBillLines.Select(x => new DraftLineData(x.Description, x.Quantity, x.UnitPrice, x.VatTreatment, x.ExpenseAccountId, x.ProductItemId)));
            draft.AttachmentFileName = pendingAttachment?.FileName;
            draft.AttachmentContentType = pendingAttachment?.ContentType;
            draft.AttachmentOriginalSize = pendingAttachment?.OriginalSize;
            draft.AttachmentIsCompressed = pendingAttachment?.IsCompressed ?? false;
            draft.AttachmentContent = pendingAttachment?.Content;
            draft.UpdatedAt = DateTimeOffset.UtcNow;
            await Db.SaveChangesAsync();
            var message = isNew
                ? "Draft bill saved. Nothing has been posted to the ledger."
                : "Draft bill updated. Nothing has been posted to the ledger.";
            ResetBillForm();
            showBillForm = false;
            await Reload();
            statusClass = "alert-success";
            status = message;
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException)
        {
            statusClass = "alert-danger";
            status = $"Could not save draft: {ex.Message}";
        }
    }
