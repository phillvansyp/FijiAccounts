    private async Task SaveDraft()
    {
        try
        {
            var isNew = editingDraftId is null;
            var selectedDimension = branches
                .SelectMany(branch => branch.Divisions.Select(
                    division => new { Branch = branch, Division = division }))
                .Single(x => x.Division.Id == bill.DivisionId);
            var lines = new List<SupplierBillDraftLineRequest>
            {
                new(
                    bill.Description,
                    bill.Quantity,
                    bill.UnitPrice,
                    bill.VatTreatment,
                    bill.ExpenseAccountId == Guid.Empty
                        ? null
                        : bill.ExpenseAccountId,
                    bill.ProductItemId)
            };
            lines.AddRange(additionalBillLines.Select(x =>
                new SupplierBillDraftLineRequest(
                    x.Description,
                    x.Quantity,
                    x.UnitPrice,
                    x.VatTreatment,
                    x.ExpenseAccountId,
                    x.ProductItemId)));
            var attachment = pendingAttachment is null
                ? null
                : new SupplierBillAttachmentRequest(
                    pendingAttachment.FileName,
                    pendingAttachment.ContentType,
                    pendingAttachment.OriginalSize,
                    pendingAttachment.Content,
                    pendingAttachment.IsCompressed);

            await BillDrafts.SaveAsync(
                userId,
                new SaveSupplierBillDraftRequest(
                    OrganisationId,
                    editingDraftId,
                    bill.SupplierId == Guid.Empty ? null : bill.SupplierId,
                    selectedDimension.Branch.Id,
                    selectedDimension.Division.Id,
                    bill.SupplierReference,
                    bill.BillDate,
                    bill.DueDate,
                    lines,
                    attachment));
            var message = isNew
                ? "Draft bill saved. Nothing has been posted to the ledger."
                : "Draft bill updated. Nothing has been posted to the ledger.";
            ResetBillForm();
            showBillForm = false;
            await Reload();
            statusClass = "alert-success";
            status = message;
        }
        catch (Exception ex) when (
            ex is InvalidOperationException or
            UnauthorizedAccessException or
            DbUpdateException)
        {
            statusClass = "alert-danger";
            status = $"Could not save draft: {ex.Message}";
        }
    }
