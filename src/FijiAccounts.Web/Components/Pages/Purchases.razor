    {
        billRegisterFilter = "Drafts";
        EditDraft(draft);
    }
}
}
    private async Task Reload() { var accessibleDivisionIds = branches.SelectMany(x => x.Divisions).Select(x => x.Id).ToArray(); bills = (await Db.SupplierBills.AsNoTracking().Include(x => x.Supplier).Include(x => x.Attachments).Where(x => x.OrganisationId == OrganisationId && x.DivisionId != null && accessibleDivisionIds.Contains(x.DivisionId.Value)).ToListAsync()).OrderByDescending(x => x.SequenceNumber).Take(100).ToList(); drafts = (await Db.SupplierBillDrafts.AsNoTracking().Include(x => x.Supplier).Where(x => x.OrganisationId == OrganisationId && x.DivisionId != null && accessibleDivisionIds.Contains(x.DivisionId.Value)).ToListAsync()).OrderByDescending(x => x.UpdatedAt).ToList(); recurringBills = await Db.RecurringSupplierBills.AsNoTracking().Include(x => x.Supplier).Include(x => x.Lines).Where(x => x.OrganisationId == OrganisationId && x.DivisionId != null && accessibleDivisionIds.Contains(x.DivisionId.Value) && x.Status != RecurringSupplierBillStatus.Ended).OrderBy(x => x.Status).ThenBy(x => x.NextBillDate).ToListAsync(); openBills = bills.Where(x => x.Status is BillStatus.Posted or BillStatus.PartPaid).Where(x => Outstanding(x) > 0).OrderBy(x => x.DueDate).ToList(); }

    private static decimal Outstanding(SupplierBill item) => Math.Max(0m, item.Total - item.AmountPaid - item.AmountCredited);
    private string BillRegisterStatus(SupplierBill item) => IsOverdue(item) ? "Overdue" : item.Status switch { BillStatus.Posted => "Awaiting payment", BillStatus.PartPaid => "Part paid", BillStatus.Paid => "Paid", BillStatus.Credited => "Credited", BillStatus.Voided => "Voided", _ => item.Status.ToString() };
    private string BillRegisterStatusClass(SupplierBill item) => IsOverdue(item) ? "status-overdue" : item.Status switch { BillStatus.Posted => "status-awaiting", BillStatus.PartPaid => "status-partpaid", BillStatus.Paid => "status-paid", BillStatus.Credited => "status-credited", BillStatus.Voided => "status-voided", _ => "status-draft" };

    private int FilteredBillRegisterCount =>
        billRegisterFilter == "Drafts"
            ? FilteredDrafts.Count()
            : FilteredAndSortedBills.Count();

    private IEnumerable<SupplierBillDraft> FilteredDrafts =>
        drafts.Where(item =>
            string.IsNullOrWhiteSpace(billRegisterSearch) ||
            (item.Supplier?.Name?.Contains(
                billRegisterSearch,
                StringComparison.OrdinalIgnoreCase) ?? false) ||
            (!string.IsNullOrWhiteSpace(item.SupplierReference) &&
             item.SupplierReference.Contains(
                 billRegisterSearch,
                 StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<SupplierBill> FilteredAndSortedBills
    {
        get
        {
            IEnumerable<SupplierBill> result = billRegisterFilter switch
            {
                "Awaiting" => bills.Where(x =>
                    x.Status is BillStatus.Posted or BillStatus.PartPaid &&
                    Outstanding(x) > 0),

                "Paid" => bills.Where(x =>
                    x.Status == BillStatus.Paid),

                "Overdue" => bills.Where(IsOverdue),

                "All" => bills,

                _ => bills
            };

            if (!string.IsNullOrWhiteSpace(billRegisterSearch))
            {
                result =
                    result.Where(item =>
                        item.Supplier.Name.Contains(
                            billRegisterSearch,
                            StringComparison.OrdinalIgnoreCase) ||
                        item.BillNumber.Contains(
                            billRegisterSearch,
                            StringComparison.OrdinalIgnoreCase) ||
                        (!string.IsNullOrWhiteSpace(item.SupplierReference) &&
                         item.SupplierReference.Contains(
                             billRegisterSearch,
                             StringComparison.OrdinalIgnoreCase)));
            }

            result = billRegisterSort switch
            {
                "From" => billRegisterSortDescending
                    ? result.OrderByDescending(x => x.Supplier.Name)
                    : result.OrderBy(x => x.Supplier.Name),

                "Status" => billRegisterSortDescending
                    ? result.OrderByDescending(BillRegisterStatus)
                    : result.OrderBy(BillRegisterStatus),

                "Date" => billRegisterSortDescending
                    ? result.OrderByDescending(x => x.BillDate)
                    : result.OrderBy(x => x.BillDate),

                _ => billRegisterSortDescending
                    ? result.OrderByDescending(x => x.DueDate)
                    : result.OrderBy(x => x.DueDate)
            };

            return result;
        }
    }

    private void SetBillRegisterFilter(string filter)
    {
        billRegisterFilter = filter;
    }

    private void SortBillRegisterBy(string sort)
    {
        if (billRegisterSort == sort)
        {
            billRegisterSortDescending =
                !billRegisterSortDescending;
            return;
        }

        billRegisterSort = sort;
        billRegisterSortDescending = false;
    }
