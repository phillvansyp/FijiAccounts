@page "/o/{OrganisationId:guid}/products"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FijiAccounts.Domain.Accounting
@using FijiAccounts.Domain.Tax
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject ApplicationDbContext Db
@inject TenantAccessService TenantAccess
@inject ProductCatalogService Catalog
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Products &amp; services · Account Island</PageTitle>
@if (access is null) { <div class="alert alert-danger">You do not have access to this organisation.</div> } else { <div class="page-heading"><div><p class="eyebrow">Commercial setup</p><h1>Products &amp; services</h1><p class="page-intro">Save reusable descriptions, prices, tax treatments and ledger coding.</p></div><span class="status-pill">@items.Count(x => x.IsActive) active items</span></div>
@if (canManage) { <details class="setup-card mb-4"><summary><strong>+ Add product or service</strong></summary><EditForm Model="model" OnValidSubmit="Create" FormName="product-item" class="mt-3"><DataAnnotationsValidator /><ValidationSummary /><div class="row"><div class="col-md-2 mb-3"><label class="form-label">Code</label><input class="form-control" @bind="model.Code" @bind:event="oninput" /></div><div class="col-md-4 mb-3"><label class="form-label">Name</label><input class="form-control" @bind="model.Name" @bind:event="oninput" /></div><div class="col-md-4 mb-3"><label class="form-label">Description</label><input class="form-control" @bind="model.Description" @bind:event="oninput" /></div><div class="col-md-2 mb-3"><label class="form-label">Type</label><InputSelect class="form-select" @bind-Value="model.Kind">@foreach (var item in Enum.GetValues<ProductKind>()) { <option value="@item">@Friendly(item.ToString())</option> }</InputSelect></div></div><div class="row"><div class="col-md-2 mb-3"><label class="form-label">Sale price</label><input type="number" step="0.01" class="form-control" @bind="model.SalePrice" @bind:event="oninput" /></div><div class="col-md-2 mb-3"><label class="form-label">Sale tax</label><InputSelect class="form-select" @bind-Value="model.SaleTax">@foreach (var tax in Enum.GetValues<VatTreatment>()) { <option value="@tax">@tax</option> }</InputSelect></div><div class="col-md-2 mb-3"><label class="form-label">Revenue account</label><InputSelect class="form-select" @bind-Value="model.RevenueAccountId">@foreach (var account in revenueAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div><div class="col-md-2 mb-3"><label class="form-label">Purchase price</label><input type="number" step="0.01" class="form-control" @bind="model.PurchasePrice" @bind:event="oninput" /></div><div class="col-md-2 mb-3"><label class="form-label">Purchase tax</label><InputSelect class="form-select" @bind-Value="model.PurchaseTax">@foreach (var tax in Enum.GetValues<VatTreatment>()) { <option value="@tax">@tax</option> }</InputSelect></div><div class="col-md-2 mb-3"><label class="form-label">Expense account</label><InputSelect class="form-select" @bind-Value="model.ExpenseAccountId">@foreach (var account in expenseAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</InputSelect></div></div><button class="btn btn-primary">Save item</button></EditForm></details> }
@if (message is not null) { <div class="alert @messageClass">@message</div> }
<section class="detail-card"><div class="card-heading"><div><span class="eyebrow">Catalogue</span><h2>Items</h2></div><InputText class="form-control" style="max-width:18rem" @bind-Value="search" placeholder="Search code or name" /></div>@if (!Filtered.Any()) { <div class="empty-state"><strong>No catalogue items</strong><span>Add services, non-tracked products or tracked inventory.</span></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Item</th><th>Type</th><th class="text-end">Sale price</th><th class="text-end">Purchase price</th><th>Tax</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Filtered) { <tr><td><code>@item.Code</code></td><td><strong>@item.Name</strong><small class="d-block text-muted">@item.Description</small></td><td>@Friendly(item.Kind.ToString())</td><td class="text-end">$@item.SalePrice.ToString("N2")</td><td class="text-end">$@item.PurchasePrice.ToString("N2")</td><td>@item.SaleTaxTreatment / @item.PurchaseTaxTreatment</td><td><span class="status-pill">@(item.IsActive ? "Active" : "Archived")</span></td><td>@if (canManage) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(item)">@(item.IsActive ? "Archive" : "Reactivate")</button> }</td></tr> }</tbody></table></div> }</section><div class="alert alert-info mt-4">Tracked items appear in the <a href="@($"o/{OrganisationId}/inventory")">inventory register</a>, where opening stock, adjustments, reorder levels and valuation are maintained.</div> }
@code { [Parameter] public Guid OrganisationId{get;set;} private AccessibleOrganisation? access;private string userId="";private bool canManage;private List<ProductItem> items=[];private List<LedgerAccount> revenueAccounts=[],expenseAccounts=[];private ItemModel model=new();private string search="";private string? message;private string messageClass="alert-success";private IEnumerable<ProductItem> Filtered=>items.Where(x=>string.IsNullOrWhiteSpace(search)||x.Code.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase));protected override async Task OnParametersSetAsync(){var state=await AuthenticationStateProvider.GetAuthenticationStateAsync();userId=UserManager.GetUserId(state.User)!;access=await TenantAccess.FindAsync(userId,OrganisationId);if(access is null)return;canManage=await TenantAccess.CanPostJournalsAsync(userId,OrganisationId);revenueAccounts=await Db.LedgerAccounts.AsNoTracking().Where(x=>x.OrganisationId==OrganisationId&&x.IsActive&&x.Type==AccountType.Revenue).OrderBy(x=>x.Code).ToListAsync();expenseAccounts=await Db.LedgerAccounts.AsNoTracking().Where(x=>x.OrganisationId==OrganisationId&&x.IsActive&&(x.Type==AccountType.Expense||x.Type==AccountType.Asset)).OrderBy(x=>x.Code).ToListAsync();Reset();await Reload();}private async Task Reload()=>items=await Db.ProductItems.AsNoTracking().Where(x=>x.OrganisationId==OrganisationId).OrderBy(x=>x.Code).ToListAsync();private void Reset()=>model=new(){RevenueAccountId=revenueAccounts.FirstOrDefault()?.Id,ExpenseAccountId=expenseAccounts.FirstOrDefault()?.Id};private async Task Create(){try{var item=await Catalog.CreateAsync(userId,new(OrganisationId,model.Code,model.Name,model.Description,model.Kind,model.SalePrice,model.PurchasePrice,model.SaleTax,model.PurchaseTax,model.RevenueAccountId,model.ExpenseAccountId));messageClass="alert-success";message=$"Item {item.Code} saved.";Reset();await Reload();}catch(Exception ex){messageClass="alert-danger";message=ex.Message;}}private async Task Toggle(ProductItem item){try{await Catalog.SetActiveAsync(userId,OrganisationId,item.Id,!item.IsActive);await Reload();}catch(Exception ex){messageClass="alert-danger";message=ex.Message;}}private static string Friendly(string value)=>value.Replace("NonTracked","Non-tracked ");private sealed class ItemModel{[Required,StringLength(40)]public string Code{get;set;}="";[Required,StringLength(160)]public string Name{get;set;}="";[StringLength(500)]public string? Description{get;set;}public ProductKind Kind{get;set;}=ProductKind.Service;[Range(0,999999999)]public decimal SalePrice{get;set;}[Range(0,999999999)]public decimal PurchasePrice{get;set;}public VatTreatment SaleTax{get;set;}=VatTreatment.Standard;public VatTreatment PurchaseTax{get;set;}=VatTreatment.Standard;public Guid? RevenueAccountId{get;set;}public Guid? ExpenseAccountId{get;set;}} }
