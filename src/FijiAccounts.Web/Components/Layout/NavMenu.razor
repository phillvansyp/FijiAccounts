@implements IDisposable
@using Microsoft.AspNetCore.Identity
@using FijiAccounts.Web.Data
@using FijiAccounts.Web.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject TenantAccessService TenantAccess
@inject OrganisationSelectionService OrganisationSelection

@inject OrganisationUpdateBroker Updates
@inject IServiceScopeFactory ScopeFactory

<header class="app-header"><nav class="nav-inner" aria-label="Primary navigation" data-enhance-nav="false">
    <a class="brand brand-landscape" href="" aria-label="Account Island home"><img src="account-island-landscape-header.png" alt="Account Island — Escape the Admin" /></a>
    <input id="menu-toggle" class="menu-toggle" type="checkbox" aria-label="Toggle navigation" /><label class="menu-button" for="menu-toggle"><span></span><span></span><span></span></label>
    <AuthorizeView><Authorized>

        @if (activeOrganisationId is not null)
        {
            <div class="primary-links">
                <NavLink href="@OrgUrl()" Match="NavLinkMatch.All" title="Overview" aria-label="Overview"><NavMenuIcon Name="home" /><span class="nav-label">Overview</span></NavLink>
                <NavLink href="accountant/work" title="Review work" aria-label="Review work"><NavMenuIcon Name="review" /><span class="nav-label">Review work</span></NavLink>
                <details class="module-menu" name="account-island-top-menu"><summary title="Sales" aria-label="Sales"><NavMenuIcon Name="sales" /><span class="nav-label">Sales</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Money in</strong><a href="@OrgUrl("sales")">Sales invoices</a><a href="@OrgUrl("quotes")">Quotes</a><a href="@OrgUrl("products")">Products &amp; services</a><a href="@OrgUrl("receipts")">Customer receipts</a><a href="@OrgUrl("contacts/customers")">Customers</a><small>Create quotes and invoices, track balances and record payments.</small></div></details>
                <details class="module-menu" name="account-island-top-menu"><summary title="Purchases" aria-label="Purchases"><NavMenuIcon Name="purchases" /><span class="nav-label">Purchases</span>@if (pendingReceiptCount > 0) { <span class="nav-badge badge bg-danger" title="Receipts awaiting review" aria-label="@(pendingReceiptCount + " receipts awaiting review")">@pendingReceiptCount</span> }</summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Money out</strong><a class="receipt-menu-link" href="@ReceiptsUrl">Receipts @if (pendingReceiptCount > 0) { <span class="badge bg-danger ms-1" title="Receipts awaiting review" aria-label="@(pendingReceiptCount + " receipts awaiting review")">@pendingReceiptCount</span> }</a><a href="@OrgUrl("purchases")">Supplier bills</a><a href="@OrgUrl("requisitions")">Purchase requisitions</a><a href="@OrgUrl("purchase-orders")">Purchase orders</a><a href="@OrgUrl("inventory")">Inventory</a><a href="@OrgUrl("contacts/suppliers")">Suppliers</a><small>Capture purchases, control stock and manage what you owe.</small></div></details>
                <details class="module-menu" name="account-island-top-menu"><summary title="Reporting" aria-label="Reporting"><NavMenuIcon Name="reporting" /><span class="nav-label">Reporting</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Financial reports</strong><a href="@OrgUrl("reports/profit-loss")">Profit &amp; Loss</a><a href="@OrgUrl("reports/balance-sheet")">Balance Sheet</a><a href="@OrgUrl("reports/trial-balance")">Trial Balance</a><a href="@OrgUrl("reports/group")">Group consolidation</a><a href="@OrgUrl("reports/cash-summary")">Cash summary</a><a href="@OrgUrl("scenarios")">Scenario planning</a><a href="@OrgUrl("budgets")">Budget vs actual</a><a href="@OrgUrl("general-ledger")">General ledger</a><a href="@OrgUrl("reports/aging")">Ageing reports</a><a href="@OrgUrl("reports/aging/receivables")">Receivables ageing</a><a href="@OrgUrl("reports/aging/payables")">Payables ageing</a><small>Live reports generated from posted ledger entries.</small></div></details>
                <details class="module-menu" name="account-island-top-menu"><summary title="Accounting" aria-label="Accounting"><NavMenuIcon Name="accounting" /><span class="nav-label">Accounting</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Books &amp; controls</strong><a href="@OrgUrl("banking")">Bank accounts</a><a href="@OrgUrl("bank-transfers")">Bank transfers</a><a href="@OrgUrl("bank-rules")">Bank rules</a><a href="@OrgUrl("accounts")">Chart of accounts</a>@if (ActiveOrganisation.CountryCode.Equals("NZ", StringComparison.OrdinalIgnoreCase)) { <a href="@OrgUrl("integrations/xero")">@(xeroConnected ? "Xero sync" : "Set up Xero")</a> }<a href="@OrgUrl("integrations/payroll-island")">Payroll Island</a><a href="@OrgUrl("projects")">Projects &amp; jobs</a><a href="@OrgUrl("inventory")">Inventory valuation</a><a href="@OrgUrl("assets")">Fixed assets</a><a href="@OrgUrl("journals")">Manual journals</a><a href="@OrgUrl("periods")">Accounting periods</a><a href="@OrgUrl("audit")">Audit trail</a><small>Maintain the ledger, controls and audit access.</small></div></details>
                <details class="module-menu" name="account-island-top-menu"><summary title="Tax" aria-label="Tax"><NavMenuIcon Name="tax" /><span class="nav-label">Tax</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Fiji compliance</strong><a href="@OrgUrl("tax")">Tax centre</a><a href="@OrgUrl("tax/fiscalisation")">Fiscalisation readiness</a><a href="@OrgUrl("tax/retention")">Record retention</a><a href="@OrgUrl()#tax-position">Tax position</a><a href="help?from=vat">Fiji tax guidance</a><a href="@OrgUrl("tax")#vat-report">VAT report</a><small>Verified, effective-dated Fiji tax treatment.</small></div></details>
                <details class="module-menu" name="account-island-top-menu"><summary title="Contacts" aria-label="Contacts"><NavMenuIcon Name="contacts" /><span class="nav-label">Contacts</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><strong>Contacts</strong><a href="@OrgUrl("contacts")">All contacts</a><a href="@OrgUrl("contacts/customers")">Customers</a><a href="@OrgUrl("contacts/suppliers")">Suppliers</a><small>Manage the people and businesses you sell to and buy from.</small></div></details><NavLink href="@OrgUrl("notifications")" title="Notifications" aria-label="Notifications"><NavMenuIcon Name="notifications" /><span class="nav-label">Notifications</span>

    @if (unreadNotificationCount > 0)
    {
        <span class="badge bg-danger ms-1">
            @unreadNotificationCount
        </span>
    }
</NavLink>
            </div>
        }
        else
        {
            <div class="primary-links"><details class="module-menu" name="account-island-top-menu"><summary title="Purchases" aria-label="Purchases"><NavMenuIcon Name="purchases" /><span class="nav-label">Purchases</span></summary><div class="mega-menu" onclick="this.closest('details').removeAttribute('open')"><a href="@ReceiptsUrl">Receipts</a></div></details></div>
        }
    </Authorized><NotAuthorized><div class="primary-links"><NavLink href="" Match="NavLinkMatch.All" title="Home" aria-label="Home"><NavMenuIcon Name="home" /><span class="nav-label">Home</span></NavLink></div></NotAuthorized></AuthorizeView>
    <div class="nav-actions">
        @if (activeOrganisationId is not null) { <details class="quick-menu"><summary title="Quick create">+</summary><div class="action-panel"><strong>Quick create</strong><a href="@OrgUrl("sales/new")"><span>↗</span> Sales invoice</a><a href="@OrgUrl("quotes")"><span>↗</span> Quote</a><a href="@OrgUrl("purchases")"><span>↙</span> Supplier bill</a><a href="@OrgUrl("receipts")"><span>✓</span> Customer receipt</a><a href="@OrgUrl("journals")"><span>☰</span> Manual journal</a></div></details> }
        <a class="icon-link" href="@SearchUrl" title="Search this organisation">⌕</a><a class="icon-link" href="@ContextHelpUrl" title="Help for this page">?</a>
        <AuthorizeView><Authorized>
            @if (accessibleOrganisations.Count > 0)
            {
                <details class="org-switch org-picker" name="account-island-top-menu"><summary @onclick="RefreshOrganisationListAsync" title="@($"Change workspace · {ActiveOrganisationDisplayName} · {OrganisationDisplay.WorkspaceId(ActiveOrganisation)}")" aria-label="@($"Change workspace. Current workspace {ActiveOrganisationDisplayName}, ID {OrganisationDisplay.WorkspaceId(ActiveOrganisation)}")"><span class="org-avatar">@OrganisationDisplay.WorkspaceBadge(ActiveOrganisation, accessibleOrganisations.Select(x => x.Organisation))</span></summary>
                    <div class="org-panel workspace-panel" onclick="if (event.target.closest('a')) this.closest('details').removeAttribute('open')">
                        <div class="workspace-heading">
                            <div><span class="workspace-kicker">Account Island workspaces</span><strong>Where would you like to work?</strong><small>Each workspace has a unique ID and keeps its country, currency and tax settings together.</small></div>
                            <a class="manage-organisations" href="organisations">Manage all</a>
                        </div>
                        <div class="workspace-grid">
                            @foreach (var item in accessibleOrganisations)
                            {
                                var isCurrentOrganisation = item.Organisation.Id == activeOrganisationId;
                                <article class="workspace-card-shell @(isCurrentOrganisation ? "is-current" : null)">
                                    <a class="workspace-card" href="@OrganisationUrl(item.Organisation.Id)" aria-current="@(isCurrentOrganisation ? "page" : null)">
                                        <span class="workspace-card-top"><span class="org-avatar">@OrganisationDisplay.WorkspaceBadge(item.Organisation, accessibleOrganisations.Select(x => x.Organisation))</span><span class="workspace-card-identifiers"><span class="country-tag">@OrganisationDisplay.CountryTag(item.Organisation.CountryCode)</span><span class="workspace-id">@OrganisationDisplay.WorkspaceId(item.Organisation)</span></span></span>
                                        <span class="workspace-card-name" title="@OrganisationDisplay.NameWithCountry(item.Organisation)">@OrganisationDisplay.NameWithCountry(item.Organisation)</span>
                                        <small>@(item.IsClient ? "Accountant client" : item.AccessLabel) · @item.Organisation.BaseCurrency</small>
                                        <span class="workspace-card-action">@(isCurrentOrganisation ? "Open company" : "Switch to company →")</span>
                                    </a>
                                    <div class="workspace-card-tools" aria-label="@($"Manage {OrganisationDisplay.NameWithCountry(item.Organisation)}")">
                                        <a href="@OrganisationUrl(item.Organisation.Id, "settings")" title="@($"Open settings for {OrganisationDisplay.NameWithCountry(item.Organisation)}")"><span class="workspace-tool-icon" aria-hidden="true">⚙</span><span><b>Settings</b><small>@OrganisationDisplay.CountryTag(item.Organisation.CountryCode) · @item.Organisation.BaseCurrency</small></span></a>
                                        <a href="@OrganisationUrl(item.Organisation.Id, "team")" title="@($"Manage the team for {OrganisationDisplay.NameWithCountry(item.Organisation)}")"><span class="workspace-tool-icon" aria-hidden="true">👥</span><span><b>Team</b><small>Users &amp; permissions</small></span></a>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </details>
            }
            else { <div class="org-switch"><a href="organisations" title="Create organisation" aria-label="Create organisation"><span class="org-avatar">+</span></a></div> }
            <details class="profile-menu"><summary><span class="avatar">@Initial(context.User.Identity?.Name)</span></summary><div class="profile-panel"><div class="profile-email">@context.User.Identity?.Name</div><a href="accountant/work">Review work</a><a href="Account/Manage">Profile &amp; security</a><AuthorizeView Roles="@PlatformAdminAccessService.RoleName"><Authorized Context="platformContext"><a href="platform">Platform administration</a></Authorized></AuthorizeView><button type="button" class="install-app-action" data-install-app hidden onclick="window.accountIslandInstall?.prompt()"><span aria-hidden="true">⇩</span> Install Account Island</button><a href="help">Help centre</a><form action="Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="@currentUrl" /><button type="submit">Sign out</button></form></div></details>
        </Authorized><NotAuthorized><a class="signin-link" href="Account/Login">Sign in</a><a class="join-link" href="Account/Register">Get started</a></NotAuthorized></AuthorizeView>
    </div>
</nav></header>

@code {
    private string currentUrl = string.Empty; private Guid? activeOrganisationId; private string? activeOrganisationName; private string? activeUserId; private List<AccessibleOrganisation> accessibleOrganisations = []; private int unreadNotificationCount, pendingReceiptCount; private IDisposable? updateSubscription; private bool liveRefreshInProgress, liveRefreshRequested, xeroConnected;
    private Organisation ActiveOrganisation => accessibleOrganisations.FirstOrDefault(x => x.Organisation.Id == activeOrganisationId)?.Organisation ?? accessibleOrganisations[0].Organisation;
    private string ActiveOrganisationDisplayName => OrganisationDisplay.NameWithCountry(ActiveOrganisation);
    private string ActiveCountryTag => OrganisationDisplay.CountryTag(ActiveOrganisation.CountryCode);
    private string ReceiptsUrl => activeOrganisationId is Guid id ? $"/receipts?org={id}" : "/receipts";
    private string SearchUrl => activeOrganisationId is null ? "help" : $"o/{activeOrganisationId}/search";
    private string ContextHelpUrl => $"help?from={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}";
    protected override async Task OnInitializedAsync() { updateSubscription = Updates.Subscribe(OrganisationUpdated); await UpdateContext(); Navigation.LocationChanged += LocationChanged; }
    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () => { await ApplyLocationAsync(e.Location); StateHasChanged(); });
    }

    private bool refreshingOrganisations;
    private async Task RefreshOrganisationListAsync()
    {
        if (refreshingOrganisations || activeUserId is null) return;
        refreshingOrganisations = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            accessibleOrganisations = await scope.ServiceProvider.GetRequiredService<TenantAccessService>().ListAsync(activeUserId);
            await ApplyLocationAsync(Navigation.Uri);
        }
        finally { refreshingOrganisations = false; }
    }

    private async Task UpdateContext()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        activeUserId = UserManager.GetUserId(state.User);
        accessibleOrganisations = activeUserId is null ? [] : await TenantAccess.ListAsync(activeUserId);
        activeOrganisationId = activeUserId is null ? null : await OrganisationSelection.GetAsync(activeUserId);
        await ApplyLocationAsync(Navigation.Uri);

    }

    private async Task ApplyLocationAsync(string location)
    {
        currentUrl = Navigation.ToBaseRelativePath(location);
        var requestedOrganisationId = ExtractOrganisationId(new Uri(location).AbsolutePath.TrimStart('/'));
        if (requestedOrganisationId is null && currentUrl.StartsWith("receipts?", StringComparison.OrdinalIgnoreCase))
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(location).Query);
            if (Guid.TryParse(query["org"], out var receiptOrganisationId)) requestedOrganisationId = receiptOrganisationId;
        }

        var requestedOrganisation = requestedOrganisationId is null
            ? null
            : accessibleOrganisations.FirstOrDefault(x => x.Organisation.Id == requestedOrganisationId);
        if (requestedOrganisation is not null)
        {
            activeOrganisationId = requestedOrganisation.Organisation.Id;
            activeOrganisationName = requestedOrganisation.Organisation.LegalName;
            if (activeUserId is not null) await OrganisationSelection.SelectAsync(activeUserId, activeOrganisationId.Value);
        }
        else if (requestedOrganisationId is null && accessibleOrganisations.Count > 0)
        {
            var selected = accessibleOrganisations.FirstOrDefault(x => x.Organisation.Id == activeOrganisationId)
                ?? accessibleOrganisations[0];
            activeOrganisationId = selected.Organisation.Id;
            activeOrganisationName = selected.Organisation.LegalName;
        }
        else
        {
            activeOrganisationId = null;
            activeOrganisationName = null;
        }
        await RefreshNavigationCountsAsync();
    }
    private static Guid? ExtractOrganisationId(string path) { var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries); return parts.Length > 1 && parts[0].Equals("o", StringComparison.OrdinalIgnoreCase) && Guid.TryParse(parts[1], out var id) ? id : null; }
    private static string OrganisationUrl(Guid organisationId, string? module = null) => module is null ? $"/o/{organisationId}" : $"/o/{organisationId}/{module}";
    private string OrgUrl(string? module = null) => activeOrganisationId is null ? "/organisations" : OrganisationUrl(activeOrganisationId.Value, module);
    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
    private void OrganisationUpdated(Guid organisationId) { if (organisationId != activeOrganisationId) return; _ = InvokeAsync(RefreshNavigationCountsAsync); }
    private async Task RefreshNavigationCountsAsync()
    {
        liveRefreshRequested = true;
        if (liveRefreshInProgress) return;
        liveRefreshInProgress = true;
        try
        {
            while (liveRefreshRequested)
            {
                liveRefreshRequested = false;
                var org = activeOrganisationId;
                var user = activeUserId;
                if (org is null || user is null)
                {
                    unreadNotificationCount = pendingReceiptCount = 0;
                    xeroConnected = false;
                    StateHasChanged();
                    continue;
                }
                await using var scope = ScopeFactory.CreateAsyncScope();
                var notifications = await scope.ServiceProvider.GetRequiredService<NotificationService>()
                    .GetUnreadCountAsync(user, org.Value);
                var receipts = await scope.ServiceProvider.GetRequiredService<EmployeeReceiptService>()
                    .GetPendingReviewCountAsync(user, org.Value);
                var organisation = accessibleOrganisations.FirstOrDefault(x => x.Organisation.Id == org)?.Organisation;
                var hasXeroConnection = organisation?.CountryCode.Equals("NZ", StringComparison.OrdinalIgnoreCase) == true &&
                    (await scope.ServiceProvider.GetRequiredService<XeroConnectionService>()
                        .GetStatusAsync(user, org.Value)).IsConnected;
                if (activeOrganisationId != org || activeUserId != user)
                {
                    liveRefreshRequested = true;
                    continue;
                }
                unreadNotificationCount = notifications;
                pendingReceiptCount = receipts;
                xeroConnected = hasXeroConnection;
                StateHasChanged();
            }
        }
        finally { liveRefreshInProgress = false; }
    }
    public void Dispose() { Navigation.LocationChanged -= LocationChanged; updateSubscription?.Dispose(); }
}
