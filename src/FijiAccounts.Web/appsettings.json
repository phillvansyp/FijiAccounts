{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/app.db;Cache=Shared"
  },
  "Email": {
    "FromAddress": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "TimeoutMilliseconds": 15000,
      "Username": ""
    }
  },
  "MobileApi": {
    "MinimumIosVersion": "1.0.0",
    "MinimumAndroidVersion": "1.0.0",
    "RateLimitPermitLimit": 120,
    "RateLimitWindowSeconds": 60
  },
  "MobileAuthentication": {
    "Enabled": false,
    "ClientId": "account-island-mobile",
    "IosRedirectUri": "https://app.accountisland.com/mobile/callback/ios",
    "AndroidRedirectUri": "https://app.accountisland.com/mobile/callback/android"
  },
  "DocumentStorage": {
    "Provider": "database",
    "RequireNativeRetentionLock": true,
    "RequiredRetentionYears": 7
  },
  "Xero": {
    "ClientId": "",
    "ClientSecret": "",
    "WebhookKey": "",
    "RedirectUri": "https://app.accountisland.com/api/integrations/xero/callback",
    "SyncIntervalMinutes": 15,
    "FullReconciliationHours": 24,
    "Scopes": "openid profile email offline_access accounting.settings.read accounting.contacts.read accounting.invoices.read accounting.payments.read accounting.banktransactions.read accounting.manualjournals.read accounting.reports.trialbalance.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read accounting.reports.aged.read accounting.attachments.read accounting.budgets.read assets.read"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
